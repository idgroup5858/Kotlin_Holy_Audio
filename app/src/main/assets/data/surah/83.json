{"id":83,"number":83,"nameArabic":"المطففين","nameUz":"Mutaffifin","meaningUz":"Oʻlchovdan uruvchilar","revelationPlace":"makka","totalAyahs":36,"startPage":587,"ayahs":[{"id":5849,"surahId":83,"numberInSurah":1,"textArabic":" وَيْلٌ لِّلْمُطَفِّفِينَ","translationUz":"Vayl bo`lsin o`lchovdan urib qoluvchilarga.","transcription":null,"tafsirUz":null,"pageNumber":587,"juz":30,"createdAt":"2026-09-17T18:46:10.132Z","updatedAt":"2026-09-17T18:46:10.132Z"},{"id":5850,"surahId":83,"numberInSurah":2,"textArabic":"ٱلَّذِينَ إِذَا ٱكْتَالُوا۟ عَلَى ٱلنَّاسِ يَسْتَوْفُونَ","translationUz":"Ular odamlardan narsa o`lchab olsalar, to`liq olarlar.","transcription":null,"tafsirUz":null,"pageNumber":587,"juz":30,"createdAt":"2026-09-17T18:46:10.137Z","updatedAt":"2026-09-17T18:46:10.137Z"},{"id":5851,"surahId":83,"numberInSurah":3,"textArabic":"وَإِذَا كَالُوهُمْ أَو وَّزَنُوهُمْ يُخْسِرُونَ","translationUz":"Va agar odamlarga o`lchab yoki tortib bersalar, kamaytirarlar.","transcription":null,"tafsirUz":null,"pageNumber":587,"juz":30,"createdAt":"2026-09-17T18:46:10.141Z","updatedAt":"2026-09-17T18:46:10.141Z"},{"id":5852,"surahId":83,"numberInSurah":4,"textArabic":"أَلَا يَظُنُّ أُو۟لَـٰٓئِكَ أَنَّهُم مَّبْعُوثُونَ","translationUz":"Ana shular, albatta, qayta tiriltirilishlarini o`ylamaydilarmi?","transcription":null,"tafsirUz":null,"pageNumber":587,"juz":30,"createdAt":"2026-09-17T18:46:10.145Z","updatedAt":"2026-09-17T18:46:10.145Z"},{"id":5853,"surahId":83,"numberInSurah":5,"textArabic":"لِيَوْمٍ عَظِيمٍ","translationUz":"Ulug` bir kunda.","transcription":null,"tafsirUz":null,"pageNumber":587,"juz":30,"createdAt":"2026-09-17T18:46:10.149Z","updatedAt":"2026-09-17T18:46:10.149Z"},{"id":5854,"surahId":83,"numberInSurah":6,"textArabic":"يَوْمَ يَقُومُ ٱلنَّاسُ لِرَبِّ ٱلْعَـٰلَمِينَ","translationUz":"U kunda odamlar olamlarning Robbi huzurida tik turarlar.","transcription":null,"tafsirUz":null,"pageNumber":587,"juz":30,"createdAt":"2026-09-17T18:46:10.153Z","updatedAt":"2026-09-17T18:46:10.153Z"},{"id":5855,"surahId":83,"numberInSurah":7,"textArabic":"كَلَّآ إِنَّ كِتَـٰبَ ٱلْفُجَّارِ لَفِى سِجِّينٍ","translationUz":"Yo`q! Albatta fojirlarlarning kitobi «sijjiyn»dadir.","transcription":null,"tafsirUz":null,"pageNumber":588,"juz":30,"createdAt":"2026-09-17T18:46:10.157Z","updatedAt":"2026-09-17T18:46:10.157Z"},{"id":5856,"surahId":83,"numberInSurah":8,"textArabic":"وَمَآ أَدْرَىٰكَ مَا سِجِّينٌ","translationUz":"«Sijjiyn» qanday narsa ekanini senga nima bildirdi?!","transcription":null,"tafsirUz":null,"pageNumber":588,"juz":30,"createdAt":"2026-09-17T18:46:10.161Z","updatedAt":"2026-09-17T18:46:10.161Z"},{"id":5857,"surahId":83,"numberInSurah":9,"textArabic":"كِتَـٰبٌ مَّرْقُومٌ","translationUz":"U(Sijjiyn) yozilgan kitobdur.","transcription":null,"tafsirUz":null,"pageNumber":588,"juz":30,"createdAt":"2026-09-17T18:46:10.165Z","updatedAt":"2026-09-17T18:46:10.165Z"},{"id":5858,"surahId":83,"numberInSurah":10,"textArabic":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ","translationUz":"O`sha kunda yolg`onga chiqaruvchilarga vayl bo`lsin!","transcription":null,"tafsirUz":null,"pageNumber":588,"juz":30,"createdAt":"2026-09-17T18:46:10.169Z","updatedAt":"2026-09-17T18:46:10.169Z"},{"id":5859,"surahId":83,"numberInSurah":11,"textArabic":"ٱلَّذِينَ يُكَذِّبُونَ بِيَوْمِ ٱلدِّينِ","translationUz":"Ular jazo (qiyomat) kunini yolg`onga chiqarurlar.","transcription":null,"tafsirUz":null,"pageNumber":588,"juz":30,"createdAt":"2026-09-17T18:46:10.173Z","updatedAt":"2026-09-17T18:46:10.173Z"},{"id":5860,"surahId":83,"numberInSurah":12,"textArabic":"وَمَا يُكَذِّبُ بِهِۦٓ إِلَّا كُلُّ مُعْتَدٍ أَثِيمٍ","translationUz":"Uni haddan oshuvchi va o`ta gunohkorlardan boshqalar yolg`onga chiqarmaslar.","transcription":null,"tafsirUz":null,"pageNumber":588,"juz":30,"createdAt":"2026-09-17T18:46:10.179Z","updatedAt":"2026-09-17T18:46:10.179Z"},{"id":5861,"surahId":83,"numberInSurah":13,"textArabic":"إِذَا تُتْلَىٰ عَلَيْهِ ءَايَـٰتُنَا قَالَ أَسَـٰطِيرُ ٱلْأَوَّلِينَ","translationUz":"Qachon unga oyatlarimiz tilovat qilinsa, «avvalgilarning afsonalari», der.","transcription":null,"tafsirUz":null,"pageNumber":588,"juz":30,"createdAt":"2026-09-17T18:46:10.183Z","updatedAt":"2026-09-17T18:46:10.183Z"},{"id":5862,"surahId":83,"numberInSurah":14,"textArabic":"كَلَّا ۖ بَلْ ۜ رَانَ عَلَىٰ قُلُوبِهِم مَّا كَانُوا۟ يَكْسِبُونَ","translationUz":"Yo`q! Ularning qilgan kasblari qalblariga mog`or bo`lib o`rnashib qolgandir.","transcription":null,"tafsirUz":null,"pageNumber":588,"juz":30,"createdAt":"2026-09-17T18:46:10.187Z","updatedAt":"2026-09-17T18:46:10.187Z"},{"id":5863,"surahId":83,"numberInSurah":15,"textArabic":"كَلَّآ إِنَّهُمْ عَن رَّبِّهِمْ يَوْمَئِذٍ لَّمَحْجُوبُونَ","translationUz":"Yo`q!!! Albatta, ular o`sha kunda o`z Robbilarini ko`rishdan to`silurlar.","transcription":null,"tafsirUz":null,"pageNumber":588,"juz":30,"createdAt":"2026-09-17T18:46:10.193Z","updatedAt":"2026-09-17T18:46:10.193Z"},{"id":5864,"surahId":83,"numberInSurah":16,"textArabic":"ثُمَّ إِنَّهُمْ لَصَالُوا۟ ٱلْجَحِيمِ","translationUz":"So`ngra, albatta, ular jahiymga kiruvchilardir.","transcription":null,"tafsirUz":null,"pageNumber":588,"juz":30,"createdAt":"2026-09-17T18:46:10.199Z","updatedAt":"2026-09-17T18:46:10.199Z"},{"id":5865,"surahId":83,"numberInSurah":17,"textArabic":"ثُمَّ يُقَالُ هَـٰذَا ٱلَّذِى كُنتُم بِهِۦ تُكَذِّبُونَ","translationUz":"So`ngra, mana bu, sizlar yolg`onga chiqarib yurgan narsa, deyilur.","transcription":null,"tafsirUz":null,"pageNumber":588,"juz":30,"createdAt":"2026-09-17T18:46:10.204Z","updatedAt":"2026-09-17T18:46:10.204Z"},{"id":5866,"surahId":83,"numberInSurah":18,"textArabic":"كَلَّآ إِنَّ كِتَـٰبَ ٱلْأَبْرَارِ لَفِى عِلِّيِّينَ","translationUz":"Yo`q!!! Albatta, abrorlarning kitobi «Illiyyiyn»dadur.","transcription":null,"tafsirUz":null,"pageNumber":588,"juz":30,"createdAt":"2026-09-17T18:46:10.208Z","updatedAt":"2026-09-17T18:46:10.208Z"},{"id":5867,"surahId":83,"numberInSurah":19,"textArabic":"وَمَآ أَدْرَىٰكَ مَا عِلِّيُّونَ","translationUz":"«Illiyyiyn» qandoq narsa ekanini senga nima bildirdi?!","transcription":null,"tafsirUz":null,"pageNumber":588,"juz":30,"createdAt":"2026-09-17T18:46:10.213Z","updatedAt":"2026-09-17T18:46:10.213Z"},{"id":5868,"surahId":83,"numberInSurah":20,"textArabic":"كِتَـٰبٌ مَّرْقُومٌ","translationUz":"U yozilgan kitobdur.","transcription":null,"tafsirUz":null,"pageNumber":588,"juz":30,"createdAt":"2026-09-17T18:46:10.218Z","updatedAt":"2026-09-17T18:46:10.218Z"},{"id":5869,"surahId":83,"numberInSurah":21,"textArabic":"يَشْهَدُهُ ٱلْمُقَرَّبُونَ","translationUz":"Unga muqarrab(farishta)lar shohid bo`lurlar.","transcription":null,"tafsirUz":null,"pageNumber":588,"juz":30,"createdAt":"2026-09-17T18:46:10.222Z","updatedAt":"2026-09-17T18:46:10.222Z"},{"id":5870,"surahId":83,"numberInSurah":22,"textArabic":"إِنَّ ٱلْأَبْرَارَ لَفِى نَعِيمٍ","translationUz":"Albatta, abrorlar jannati na'iymdadurlar.","transcription":null,"tafsirUz":null,"pageNumber":588,"juz":30,"createdAt":"2026-09-17T18:46:10.226Z","updatedAt":"2026-09-17T18:46:10.226Z"},{"id":5871,"surahId":83,"numberInSurah":23,"textArabic":"عَلَى ٱلْأَرَآئِكِ يَنظُرُونَ","translationUz":"Pardali baland so`rilar ustida nazar solib tururlar.","transcription":null,"tafsirUz":null,"pageNumber":588,"juz":30,"createdAt":"2026-09-17T18:46:10.229Z","updatedAt":"2026-09-17T18:46:10.229Z"},{"id":5872,"surahId":83,"numberInSurah":24,"textArabic":"تَعْرِفُ فِى وُجُوهِهِمْ نَضْرَةَ ٱلنَّعِيمِ","translationUz":"Ularning chehralaridan jannat ravnaqini bilib olasan.","transcription":null,"tafsirUz":null,"pageNumber":588,"juz":30,"createdAt":"2026-09-17T18:46:10.233Z","updatedAt":"2026-09-17T18:46:10.233Z"},{"id":5873,"surahId":83,"numberInSurah":25,"textArabic":"يُسْقَوْنَ مِن رَّحِيقٍ مَّخْتُومٍ","translationUz":"Ular muhrlangan, nihoyatda pok sharobdan ichurlar.","transcription":null,"tafsirUz":null,"pageNumber":588,"juz":30,"createdAt":"2026-09-17T18:46:10.237Z","updatedAt":"2026-09-17T18:46:10.237Z"},{"id":5874,"surahId":83,"numberInSurah":26,"textArabic":"خِتَـٰمُهُۥ مِسْكٌ ۚ وَفِى ذَٰلِكَ فَلْيَتَنَافَسِ ٱلْمُتَنَـٰفِسُونَ","translationUz":"U(sharob)ning xotimasi miskdandir. Va shu narsa uchun musobaqa qiluvchilar musobaqa qilsinlar.","transcription":null,"tafsirUz":null,"pageNumber":588,"juz":30,"createdAt":"2026-09-17T18:46:10.240Z","updatedAt":"2026-09-17T18:46:10.240Z"},{"id":5875,"surahId":83,"numberInSurah":27,"textArabic":"وَمِزَاجُهُۥ مِن تَسْنِيمٍ","translationUz":"U sharobning aralashmasi «Tasniym»dandir.","transcription":null,"tafsirUz":null,"pageNumber":588,"juz":30,"createdAt":"2026-09-17T18:46:10.244Z","updatedAt":"2026-09-17T18:46:10.244Z"},{"id":5876,"surahId":83,"numberInSurah":28,"textArabic":"عَيْنًا يَشْرَبُ بِهَا ٱلْمُقَرَّبُونَ","translationUz":"U(Tasniym) bir buloqdirki, undan muqarrablar icharlar.","transcription":null,"tafsirUz":null,"pageNumber":588,"juz":30,"createdAt":"2026-09-17T18:46:10.248Z","updatedAt":"2026-09-17T18:46:10.248Z"},{"id":5877,"surahId":83,"numberInSurah":29,"textArabic":"إِنَّ ٱلَّذِينَ أَجْرَمُوا۟ كَانُوا۟ مِنَ ٱلَّذِينَ ءَامَنُوا۟ يَضْحَكُونَ","translationUz":"Albatta, jinoyat qilganlar iymon keltirganlar ustidan kular edilar.","transcription":null,"tafsirUz":null,"pageNumber":588,"juz":30,"createdAt":"2026-09-17T18:46:10.251Z","updatedAt":"2026-09-17T18:46:10.251Z"},{"id":5878,"surahId":83,"numberInSurah":30,"textArabic":"وَإِذَا مَرُّوا۟ بِهِمْ يَتَغَامَزُونَ","translationUz":"Agar mo`minlar ularning yonidan o`tsalar, masxaralab ishora qilar edilar.","transcription":null,"tafsirUz":null,"pageNumber":588,"juz":30,"createdAt":"2026-09-17T18:46:10.255Z","updatedAt":"2026-09-17T18:46:10.255Z"},{"id":5879,"surahId":83,"numberInSurah":31,"textArabic":"وَإِذَا ٱنقَلَبُوٓا۟ إِلَىٰٓ أَهْلِهِمُ ٱنقَلَبُوا۟ فَكِهِينَ","translationUz":"Agar (kofirlar) o`z ahllari huzuriga qaytib borsalar, huzurlanib qaytib borar edilar.","transcription":null,"tafsirUz":null,"pageNumber":588,"juz":30,"createdAt":"2026-09-17T18:46:10.259Z","updatedAt":"2026-09-17T18:46:10.259Z"},{"id":5880,"surahId":83,"numberInSurah":32,"textArabic":"وَإِذَا رَأَوْهُمْ قَالُوٓا۟ إِنَّ هَـٰٓؤُلَآءِ لَضَآلُّونَ","translationUz":"Va agar u(mo`min)larni ko`rsalar, «Albatta, anavilar adashganlar», der edilar.","transcription":null,"tafsirUz":null,"pageNumber":588,"juz":30,"createdAt":"2026-09-17T18:46:10.263Z","updatedAt":"2026-09-17T18:46:10.263Z"},{"id":5881,"surahId":83,"numberInSurah":33,"textArabic":"وَمَآ أُرْسِلُوا۟ عَلَيْهِمْ حَـٰفِظِينَ","translationUz":"Holbuki, ular mo`minlar ustidan kuzatuvchi qilib yuborilganlari yo`q-ku!","transcription":null,"tafsirUz":null,"pageNumber":588,"juz":30,"createdAt":"2026-09-17T18:46:10.267Z","updatedAt":"2026-09-17T18:46:10.267Z"},{"id":5882,"surahId":83,"numberInSurah":34,"textArabic":"فَٱلْيَوْمَ ٱلَّذِينَ ءَامَنُوا۟ مِنَ ٱلْكُفَّارِ يَضْحَكُونَ","translationUz":"Endi, bu Kunda iymon keltirganlar kofirlar ustidan kularlar.","transcription":null,"tafsirUz":null,"pageNumber":588,"juz":30,"createdAt":"2026-09-17T18:46:10.271Z","updatedAt":"2026-09-17T18:46:10.271Z"},{"id":5883,"surahId":83,"numberInSurah":35,"textArabic":"عَلَى ٱلْأَرَآئِكِ يَنظُرُونَ","translationUz":"Pardali, baland so`rilar ustida nazar solib turarlar.","transcription":null,"tafsirUz":null,"pageNumber":589,"juz":30,"createdAt":"2026-09-17T18:46:10.275Z","updatedAt":"2026-09-17T18:46:10.275Z"},{"id":5884,"surahId":83,"numberInSurah":36,"textArabic":"هَلْ ثُوِّبَ ٱلْكُفَّارُ مَا كَانُوا۟ يَفْعَلُونَ","translationUz":"Kofirlar bu dunyoda qilgan ishlarining «savobini» olarmikanlar?!","transcription":null,"tafsirUz":null,"pageNumber":589,"juz":30,"createdAt":"2026-09-17T18:46:10.279Z","updatedAt":"2026-09-17T18:46:10.279Z"}],"createdAt":"2026-09-17T18:45:07.805Z","updatedAt":"2026-09-18T00:07:52.656Z"}