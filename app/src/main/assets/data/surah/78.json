{"id":78,"number":78,"nameArabic":"النبإ","nameUz":"Nabaʼ","meaningUz":"Xabar","revelationPlace":"makka","totalAyahs":40,"startPage":582,"ayahs":[{"id":5673,"surahId":78,"numberInSurah":1,"textArabic":" عَمَّ يَتَسَآءَلُونَ","translationUz":"Nima haqida so`rashadi?","transcription":null,"tafsirUz":null,"pageNumber":582,"juz":30,"createdAt":"2026-09-17T18:46:07.639Z","updatedAt":"2026-09-17T18:46:07.639Z"},{"id":5674,"surahId":78,"numberInSurah":2,"textArabic":"عَنِ ٱلنَّبَإِ ٱلْعَظِيمِ","translationUz":"Ulkan, muhim xabar haqida.","transcription":null,"tafsirUz":null,"pageNumber":582,"juz":30,"createdAt":"2026-09-17T18:46:07.644Z","updatedAt":"2026-09-17T18:46:07.644Z"},{"id":5675,"surahId":78,"numberInSurah":3,"textArabic":"ٱلَّذِى هُمْ فِيهِ مُخْتَلِفُونَ","translationUz":"Shunday xabarki, ular uning haqida ixtilofdadirlar.","transcription":null,"tafsirUz":null,"pageNumber":582,"juz":30,"createdAt":"2026-09-17T18:46:07.649Z","updatedAt":"2026-09-17T18:46:07.649Z"},{"id":5676,"surahId":78,"numberInSurah":4,"textArabic":"كَلَّا سَيَعْلَمُونَ","translationUz":"Yo`q! Ular tezda bilurlar.","transcription":null,"tafsirUz":null,"pageNumber":582,"juz":30,"createdAt":"2026-09-17T18:46:07.653Z","updatedAt":"2026-09-17T18:46:07.653Z"},{"id":5677,"surahId":78,"numberInSurah":5,"textArabic":"ثُمَّ كَلَّا سَيَعْلَمُونَ","translationUz":"Yana yo`q! Ular tezda bilurlar!","transcription":null,"tafsirUz":null,"pageNumber":582,"juz":30,"createdAt":"2026-09-17T18:46:07.657Z","updatedAt":"2026-09-17T18:46:07.657Z"},{"id":5678,"surahId":78,"numberInSurah":6,"textArabic":"أَلَمْ نَجْعَلِ ٱلْأَرْضَ مِهَـٰدًا","translationUz":"Yerni beshikdek moslab qo`ymadikmi?","transcription":null,"tafsirUz":null,"pageNumber":582,"juz":30,"createdAt":"2026-09-17T18:46:07.661Z","updatedAt":"2026-09-17T18:46:07.661Z"},{"id":5679,"surahId":78,"numberInSurah":7,"textArabic":"وَٱلْجِبَالَ أَوْتَادًا","translationUz":"Va tog`larni qoziq (qilib qo`ymadikmi?).","transcription":null,"tafsirUz":null,"pageNumber":582,"juz":30,"createdAt":"2026-09-17T18:46:07.665Z","updatedAt":"2026-09-17T18:46:07.665Z"},{"id":5680,"surahId":78,"numberInSurah":8,"textArabic":"وَخَلَقْنَـٰكُمْ أَزْوَٰجًا","translationUz":"Va sizlarni juft qilib yaratdik.","transcription":null,"tafsirUz":null,"pageNumber":582,"juz":30,"createdAt":"2026-09-17T18:46:07.668Z","updatedAt":"2026-09-17T18:46:07.668Z"},{"id":5681,"surahId":78,"numberInSurah":9,"textArabic":"وَجَعَلْنَا نَوْمَكُمْ سُبَاتًا","translationUz":"Va uyqularingizni rohat qilib qo`ydik.","transcription":null,"tafsirUz":null,"pageNumber":582,"juz":30,"createdAt":"2026-09-17T18:46:07.672Z","updatedAt":"2026-09-17T18:46:07.672Z"},{"id":5682,"surahId":78,"numberInSurah":10,"textArabic":"وَجَعَلْنَا ٱلَّيْلَ لِبَاسًا","translationUz":"Va kechasini libos qildik.","transcription":null,"tafsirUz":null,"pageNumber":582,"juz":30,"createdAt":"2026-09-17T18:46:07.676Z","updatedAt":"2026-09-17T18:46:07.676Z"},{"id":5683,"surahId":78,"numberInSurah":11,"textArabic":"وَجَعَلْنَا ٱلنَّهَارَ مَعَاشًا","translationUz":"Va kunduzni maosh (tirikchilik) vaqti qildik.","transcription":null,"tafsirUz":null,"pageNumber":582,"juz":30,"createdAt":"2026-09-17T18:46:07.681Z","updatedAt":"2026-09-17T18:46:07.681Z"},{"id":5684,"surahId":78,"numberInSurah":12,"textArabic":"وَبَنَيْنَا فَوْقَكُمْ سَبْعًا شِدَادًا","translationUz":"Tepangizga yetti mustahkam(osmon)ni bino qildik.","transcription":null,"tafsirUz":null,"pageNumber":582,"juz":30,"createdAt":"2026-09-17T18:46:07.685Z","updatedAt":"2026-09-17T18:46:07.685Z"},{"id":5685,"surahId":78,"numberInSurah":13,"textArabic":"وَجَعَلْنَا سِرَاجًا وَهَّاجًا","translationUz":"Va shu'la taratuvchi chiroq ham qildik.","transcription":null,"tafsirUz":null,"pageNumber":582,"juz":30,"createdAt":"2026-09-17T18:46:07.689Z","updatedAt":"2026-09-17T18:46:07.689Z"},{"id":5686,"surahId":78,"numberInSurah":14,"textArabic":"وَأَنزَلْنَا مِنَ ٱلْمُعْصِرَٰتِ مَآءً ثَجَّاجًا","translationUz":"Va siqilgan(bulut)lardan oquvchi suvlar tushirdik.","transcription":null,"tafsirUz":null,"pageNumber":582,"juz":30,"createdAt":"2026-09-17T18:46:07.693Z","updatedAt":"2026-09-17T18:46:07.693Z"},{"id":5687,"surahId":78,"numberInSurah":15,"textArabic":"لِّنُخْرِجَ بِهِۦ حَبًّا وَنَبَاتًا","translationUz":"U(suv) bilan don va nabotot chiqarishimiz uchun.","transcription":null,"tafsirUz":null,"pageNumber":582,"juz":30,"createdAt":"2026-09-17T18:46:07.696Z","updatedAt":"2026-09-17T18:46:07.696Z"},{"id":5688,"surahId":78,"numberInSurah":16,"textArabic":"وَجَنَّـٰتٍ أَلْفَافًا","translationUz":"Va daraxtlari bir-biriga kirishgan bo`stonlar.","transcription":null,"tafsirUz":null,"pageNumber":582,"juz":30,"createdAt":"2026-09-17T18:46:07.700Z","updatedAt":"2026-09-17T18:46:07.700Z"},{"id":5689,"surahId":78,"numberInSurah":17,"textArabic":"إِنَّ يَوْمَ ٱلْفَصْلِ كَانَ مِيقَـٰتًا","translationUz":"Albatta, ajrim kuni vaqti belgilangan edi.","transcription":null,"tafsirUz":null,"pageNumber":582,"juz":30,"createdAt":"2026-09-17T18:46:07.704Z","updatedAt":"2026-09-17T18:46:07.704Z"},{"id":5690,"surahId":78,"numberInSurah":18,"textArabic":"يَوْمَ يُنفَخُ فِى ٱلصُّورِ فَتَأْتُونَ أَفْوَاجًا","translationUz":"U kunda surga puflanur va sizlar to`p-to`p bo`lib kelursiz.","transcription":null,"tafsirUz":null,"pageNumber":582,"juz":30,"createdAt":"2026-09-17T18:46:07.708Z","updatedAt":"2026-09-17T18:46:07.708Z"},{"id":5691,"surahId":78,"numberInSurah":19,"textArabic":"وَفُتِحَتِ ٱلسَّمَآءُ فَكَانَتْ أَبْوَٰبًا","translationUz":"Osmon yorilib eshiklar ochilur.","transcription":null,"tafsirUz":null,"pageNumber":582,"juz":30,"createdAt":"2026-09-17T18:46:07.712Z","updatedAt":"2026-09-17T18:46:07.712Z"},{"id":5692,"surahId":78,"numberInSurah":20,"textArabic":"وَسُيِّرَتِ ٱلْجِبَالُ فَكَانَتْ سَرَابًا","translationUz":"Tog`lar o`rnidan ko`chirilib, sarobga aylanur.","transcription":null,"tafsirUz":null,"pageNumber":582,"juz":30,"createdAt":"2026-09-17T18:46:07.716Z","updatedAt":"2026-09-17T18:46:07.716Z"},{"id":5693,"surahId":78,"numberInSurah":21,"textArabic":"إِنَّ جَهَنَّمَ كَانَتْ مِرْصَادًا","translationUz":"Albatta, jahannam poylab turuvchidir.","transcription":null,"tafsirUz":null,"pageNumber":582,"juz":30,"createdAt":"2026-09-17T18:46:07.720Z","updatedAt":"2026-09-17T18:46:07.720Z"},{"id":5694,"surahId":78,"numberInSurah":22,"textArabic":"لِّلطَّـٰغِينَ مَـَٔابًا","translationUz":"Tug`yonga ketganlarning qaytar joyidir.","transcription":null,"tafsirUz":null,"pageNumber":582,"juz":30,"createdAt":"2026-09-17T18:46:07.724Z","updatedAt":"2026-09-17T18:46:07.724Z"},{"id":5695,"surahId":78,"numberInSurah":23,"textArabic":"لَّـٰبِثِينَ فِيهَآ أَحْقَابًا","translationUz":"Ular (unda) zamonlar bo`yi qolarlar.","transcription":null,"tafsirUz":null,"pageNumber":582,"juz":30,"createdAt":"2026-09-17T18:46:07.729Z","updatedAt":"2026-09-17T18:46:07.729Z"},{"id":5696,"surahId":78,"numberInSurah":24,"textArabic":"لَّا يَذُوقُونَ فِيهَا بَرْدًا وَلَا شَرَابًا","translationUz":"Ular (unda) sovuqni ham, sharobni ham tatiy olmaslar.","transcription":null,"tafsirUz":null,"pageNumber":582,"juz":30,"createdAt":"2026-09-17T18:46:07.733Z","updatedAt":"2026-09-17T18:46:07.733Z"},{"id":5697,"surahId":78,"numberInSurah":25,"textArabic":"إِلَّا حَمِيمًا وَغَسَّاقًا","translationUz":"Magar qaynoq suv va yiringni (tatirlar).","transcription":null,"tafsirUz":null,"pageNumber":582,"juz":30,"createdAt":"2026-09-17T18:46:07.736Z","updatedAt":"2026-09-17T18:46:07.736Z"},{"id":5698,"surahId":78,"numberInSurah":26,"textArabic":"جَزَآءً وِفَاقًا","translationUz":"Muvofiq jazo o`laroq.","transcription":null,"tafsirUz":null,"pageNumber":582,"juz":30,"createdAt":"2026-09-17T18:46:07.740Z","updatedAt":"2026-09-17T18:46:07.740Z"},{"id":5699,"surahId":78,"numberInSurah":27,"textArabic":"إِنَّهُمْ كَانُوا۟ لَا يَرْجُونَ حِسَابًا","translationUz":"Chunki, ular hisob-kitob bo`lishiga ishonmasdilar.","transcription":null,"tafsirUz":null,"pageNumber":582,"juz":30,"createdAt":"2026-09-17T18:46:07.745Z","updatedAt":"2026-09-17T18:46:07.745Z"},{"id":5700,"surahId":78,"numberInSurah":28,"textArabic":"وَكَذَّبُوا۟ بِـَٔايَـٰتِنَا كِذَّابًا","translationUz":"Va Bizning oyatlarimizni yolg`on deyishgan edi, yolg`on!","transcription":null,"tafsirUz":null,"pageNumber":582,"juz":30,"createdAt":"2026-09-17T18:46:07.748Z","updatedAt":"2026-09-17T18:46:07.748Z"},{"id":5701,"surahId":78,"numberInSurah":29,"textArabic":"وَكُلَّ شَىْءٍ أَحْصَيْنَـٰهُ كِتَـٰبًا","translationUz":"Biz har bir narsani kitobga jamlab qo`yganmiz.","transcription":null,"tafsirUz":null,"pageNumber":582,"juz":30,"createdAt":"2026-09-17T18:46:07.752Z","updatedAt":"2026-09-17T18:46:07.752Z"},{"id":5702,"surahId":78,"numberInSurah":30,"textArabic":"فَذُوقُوا۟ فَلَن نَّزِيدَكُمْ إِلَّا عَذَابًا","translationUz":"Bas, tatib ko`ringlar, sizlarga azobdan boshqa hech narsani ziyoda qilmasmiz.","transcription":null,"tafsirUz":null,"pageNumber":582,"juz":30,"createdAt":"2026-09-17T18:46:07.757Z","updatedAt":"2026-09-17T18:46:07.757Z"},{"id":5703,"surahId":78,"numberInSurah":31,"textArabic":"إِنَّ لِلْمُتَّقِينَ مَفَازًا","translationUz":"Albatta, taqvodorlarga yutuq bordir.","transcription":null,"tafsirUz":null,"pageNumber":583,"juz":30,"createdAt":"2026-09-17T18:46:07.761Z","updatedAt":"2026-09-17T18:46:07.761Z"},{"id":5704,"surahId":78,"numberInSurah":32,"textArabic":"حَدَآئِقَ وَأَعْنَـٰبًا","translationUz":"Bog`-rog`lar, uzumzorlar bordir.","transcription":null,"tafsirUz":null,"pageNumber":583,"juz":30,"createdAt":"2026-09-17T18:46:07.765Z","updatedAt":"2026-09-17T18:46:07.765Z"},{"id":5705,"surahId":78,"numberInSurah":33,"textArabic":"وَكَوَاعِبَ أَتْرَابًا","translationUz":"Va yangi bo`yi yetgan bir xil yoshdagi qizlar bordir.","transcription":null,"tafsirUz":null,"pageNumber":583,"juz":30,"createdAt":"2026-09-17T18:46:07.769Z","updatedAt":"2026-09-17T18:46:07.769Z"},{"id":5706,"surahId":78,"numberInSurah":34,"textArabic":"وَكَأْسًا دِهَاقًا","translationUz":"Va to`ldirilgan qadahlar bordir.","transcription":null,"tafsirUz":null,"pageNumber":583,"juz":30,"createdAt":"2026-09-17T18:46:07.772Z","updatedAt":"2026-09-17T18:46:07.772Z"},{"id":5707,"surahId":78,"numberInSurah":35,"textArabic":"لَّا يَسْمَعُونَ فِيهَا لَغْوًا وَلَا كِذَّٰبًا","translationUz":"U yerda bekorchi va yolg`on gaplarni eshitmaslar.","transcription":null,"tafsirUz":null,"pageNumber":583,"juz":30,"createdAt":"2026-09-17T18:46:07.776Z","updatedAt":"2026-09-17T18:46:07.776Z"},{"id":5708,"surahId":78,"numberInSurah":36,"textArabic":"جَزَآءً مِّن رَّبِّكَ عَطَآءً حِسَابًا","translationUz":"Robbingdan mukofot, sovg`a hisobidandir.","transcription":null,"tafsirUz":null,"pageNumber":583,"juz":30,"createdAt":"2026-09-17T18:46:07.780Z","updatedAt":"2026-09-17T18:46:07.780Z"},{"id":5709,"surahId":78,"numberInSurah":37,"textArabic":"رَّبِّ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ وَمَا بَيْنَهُمَا ٱلرَّحْمَـٰنِ ۖ لَا يَمْلِكُونَ مِنْهُ خِطَابًا","translationUz":"U, osmonlar, yer va ularning orasidagi barcha narsalarning Robbi, Rohmandir. Uning huzurida hech kim xitob qilishga qodir bo`lmas.","transcription":null,"tafsirUz":null,"pageNumber":583,"juz":30,"createdAt":"2026-09-17T18:46:07.784Z","updatedAt":"2026-09-17T18:46:07.784Z"},{"id":5710,"surahId":78,"numberInSurah":38,"textArabic":"يَوْمَ يَقُومُ ٱلرُّوحُ وَٱلْمَلَـٰٓئِكَةُ صَفًّا ۖ لَّا يَتَكَلَّمُونَ إِلَّا مَنْ أَذِنَ لَهُ ٱلرَّحْمَـٰنُ وَقَالَ صَوَابًا","translationUz":"O`sha kunda Ruh va farishtalar saf bo`lib turar. Rohman izn berganlar va to`g`ri so`zlaganlardan o`zgalar hech gapira olmaslar.","transcription":null,"tafsirUz":null,"pageNumber":583,"juz":30,"createdAt":"2026-09-17T18:46:07.788Z","updatedAt":"2026-09-17T18:46:07.788Z"},{"id":5711,"surahId":78,"numberInSurah":39,"textArabic":"ذَٰلِكَ ٱلْيَوْمُ ٱلْحَقُّ ۖ فَمَن شَآءَ ٱتَّخَذَ إِلَىٰ رَبِّهِۦ مَـَٔابًا","translationUz":"U haq kundir. Kim xohlasa, o`z Robbiga qaytar yo`l oladir.","transcription":null,"tafsirUz":null,"pageNumber":583,"juz":30,"createdAt":"2026-09-17T18:46:07.793Z","updatedAt":"2026-09-17T18:46:07.793Z"},{"id":5712,"surahId":78,"numberInSurah":40,"textArabic":"إِنَّآ أَنذَرْنَـٰكُمْ عَذَابًا قَرِيبًا يَوْمَ يَنظُرُ ٱلْمَرْءُ مَا قَدَّمَتْ يَدَاهُ وَيَقُولُ ٱلْكَافِرُ يَـٰلَيْتَنِى كُنتُ تُرَٰبًۢا","translationUz":"Albatta, Biz sizlarni yaqin kelajakdagi azobdan qo`rqitdik. U kunda, har kishi qo`li taqdim qilgan narsaga nazar soladir. Va kofir. «Koshki tuproq bo`lib ketsam», deydir.","transcription":null,"tafsirUz":null,"pageNumber":583,"juz":30,"createdAt":"2026-09-17T18:46:07.797Z","updatedAt":"2026-09-17T18:46:07.797Z"}],"createdAt":"2026-09-17T18:45:07.783Z","updatedAt":"2026-09-18T00:07:52.639Z"}