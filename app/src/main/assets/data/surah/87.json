{"id":87,"number":87,"nameArabic":"الأعلى","nameUz":"Aʼlo","meaningUz":"Eng oliy","revelationPlace":"makka","totalAyahs":19,"startPage":591,"ayahs":[{"id":5949,"surahId":87,"numberInSurah":1,"textArabic":" سَبِّحِ ٱسْمَ رَبِّكَ ٱلْأَعْلَى","translationUz":"Oliy qadar bo`lgan Robbing ismini poklab yod et.","transcription":null,"tafsirUz":null,"pageNumber":591,"juz":30,"createdAt":"2026-09-17T18:46:11.402Z","updatedAt":"2026-09-17T18:46:11.402Z"},{"id":5950,"surahId":87,"numberInSurah":2,"textArabic":"ٱلَّذِى خَلَقَ فَسَوَّىٰ","translationUz":"U yaratgan va mutanosib qilgan Zotdir.","transcription":null,"tafsirUz":null,"pageNumber":591,"juz":30,"createdAt":"2026-09-17T18:46:11.409Z","updatedAt":"2026-09-17T18:46:11.409Z"},{"id":5951,"surahId":87,"numberInSurah":3,"textArabic":"وَٱلَّذِى قَدَّرَ فَهَدَىٰ","translationUz":"U, o`lchov bilan qilgan va hidoyatga boshlagan Zotdir.","transcription":null,"tafsirUz":null,"pageNumber":591,"juz":30,"createdAt":"2026-09-17T18:46:11.414Z","updatedAt":"2026-09-17T18:46:11.414Z"},{"id":5952,"surahId":87,"numberInSurah":4,"textArabic":"وَٱلَّذِىٓ أَخْرَجَ ٱلْمَرْعَىٰ","translationUz":"U, o`t-o`lanni chiqargan Zotdir.","transcription":null,"tafsirUz":null,"pageNumber":591,"juz":30,"createdAt":"2026-09-17T18:46:11.418Z","updatedAt":"2026-09-17T18:46:11.418Z"},{"id":5953,"surahId":87,"numberInSurah":5,"textArabic":"فَجَعَلَهُۥ غُثَآءً أَحْوَىٰ","translationUz":"Bas, uni qoraygan xashak qilgan Zotdir.","transcription":null,"tafsirUz":null,"pageNumber":591,"juz":30,"createdAt":"2026-09-17T18:46:11.423Z","updatedAt":"2026-09-17T18:46:11.423Z"},{"id":5954,"surahId":87,"numberInSurah":6,"textArabic":"سَنُقْرِئُكَ فَلَا تَنسَىٰٓ","translationUz":"Biz senga (Qur'onni) qiroat qildiramiz, bas, sen uni esdan chiqarmassan.","transcription":null,"tafsirUz":null,"pageNumber":591,"juz":30,"createdAt":"2026-09-17T18:46:11.427Z","updatedAt":"2026-09-17T18:46:11.427Z"},{"id":5955,"surahId":87,"numberInSurah":7,"textArabic":"إِلَّا مَا شَآءَ ٱللَّهُ ۚ إِنَّهُۥ يَعْلَمُ ٱلْجَهْرَ وَمَا يَخْفَىٰ","translationUz":"Illo, Alloh xohlaganini. Albatta, U oshkorni ham, maxfiy narsalarni ham biladir.","transcription":null,"tafsirUz":null,"pageNumber":591,"juz":30,"createdAt":"2026-09-17T18:46:11.431Z","updatedAt":"2026-09-17T18:46:11.431Z"},{"id":5956,"surahId":87,"numberInSurah":8,"textArabic":"وَنُيَسِّرُكَ لِلْيُسْرَىٰ","translationUz":"Va seni oson yo`lga muyassar qilamiz.","transcription":null,"tafsirUz":null,"pageNumber":591,"juz":30,"createdAt":"2026-09-17T18:46:11.435Z","updatedAt":"2026-09-17T18:46:11.435Z"},{"id":5957,"surahId":87,"numberInSurah":9,"textArabic":"فَذَكِّرْ إِن نَّفَعَتِ ٱلذِّكْرَىٰ","translationUz":"Bas, agar eslatish manfaat bersa, eslatgin.","transcription":null,"tafsirUz":null,"pageNumber":591,"juz":30,"createdAt":"2026-09-17T18:46:11.439Z","updatedAt":"2026-09-17T18:46:11.439Z"},{"id":5958,"surahId":87,"numberInSurah":10,"textArabic":"سَيَذَّكَّرُ مَن يَخْشَىٰ","translationUz":"Albatta, U zotdan qo`rqqan esga oladir.","transcription":null,"tafsirUz":null,"pageNumber":591,"juz":30,"createdAt":"2026-09-17T18:46:11.443Z","updatedAt":"2026-09-17T18:46:11.443Z"},{"id":5959,"surahId":87,"numberInSurah":11,"textArabic":"وَيَتَجَنَّبُهَا ٱلْأَشْقَى","translationUz":"Va badbaxtgina undan chetda bo`ladir.","transcription":null,"tafsirUz":null,"pageNumber":591,"juz":30,"createdAt":"2026-09-17T18:46:11.447Z","updatedAt":"2026-09-17T18:46:11.447Z"},{"id":5960,"surahId":87,"numberInSurah":12,"textArabic":"ٱلَّذِى يَصْلَى ٱلنَّارَ ٱلْكُبْرَىٰ","translationUz":"U katta olovga kiradir.","transcription":null,"tafsirUz":null,"pageNumber":591,"juz":30,"createdAt":"2026-09-17T18:46:11.452Z","updatedAt":"2026-09-17T18:46:11.452Z"},{"id":5961,"surahId":87,"numberInSurah":13,"textArabic":"ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحْيَىٰ","translationUz":"So`ngra, uning ichida o`lmay ham, tirilmay ham qoladir.","transcription":null,"tafsirUz":null,"pageNumber":591,"juz":30,"createdAt":"2026-09-17T18:46:11.456Z","updatedAt":"2026-09-17T18:46:11.456Z"},{"id":5962,"surahId":87,"numberInSurah":14,"textArabic":"قَدْ أَفْلَحَ مَن تَزَكَّىٰ","translationUz":"Haqiqatan, kim pok bo`lsa, yutuq topadir.","transcription":null,"tafsirUz":null,"pageNumber":591,"juz":30,"createdAt":"2026-09-17T18:46:11.460Z","updatedAt":"2026-09-17T18:46:11.460Z"},{"id":5963,"surahId":87,"numberInSurah":15,"textArabic":"وَذَكَرَ ٱسْمَ رَبِّهِۦ فَصَلَّىٰ","translationUz":"Va Robbi ismini zikr qilsa va namoz o`qisa hamdir.","transcription":null,"tafsirUz":null,"pageNumber":591,"juz":30,"createdAt":"2026-09-17T18:46:11.464Z","updatedAt":"2026-09-17T18:46:11.464Z"},{"id":5964,"surahId":87,"numberInSurah":16,"textArabic":"بَلْ تُؤْثِرُونَ ٱلْحَيَوٰةَ ٱلدُّنْيَا","translationUz":"Balki, sizlar bu dunyo hayotini ustun qo`yasizlar.","transcription":null,"tafsirUz":null,"pageNumber":592,"juz":30,"createdAt":"2026-09-17T18:46:11.468Z","updatedAt":"2026-09-17T18:46:11.468Z"},{"id":5965,"surahId":87,"numberInSurah":17,"textArabic":"وَٱلْـَٔاخِرَةُ خَيْرٌ وَأَبْقَىٰٓ","translationUz":"Holbuki, oxirat yaxshiroq va boqiyroqdir.","transcription":null,"tafsirUz":null,"pageNumber":592,"juz":30,"createdAt":"2026-09-17T18:46:11.472Z","updatedAt":"2026-09-17T18:46:11.472Z"},{"id":5966,"surahId":87,"numberInSurah":18,"textArabic":"إِنَّ هَـٰذَا لَفِى ٱلصُّحُفِ ٱلْأُولَىٰ","translationUz":"Albatta, bu avvalgi sahifalarda bordir.","transcription":null,"tafsirUz":null,"pageNumber":592,"juz":30,"createdAt":"2026-09-17T18:46:11.476Z","updatedAt":"2026-09-17T18:46:11.476Z"},{"id":5967,"surahId":87,"numberInSurah":19,"textArabic":"صُحُفِ إِبْرَٰهِيمَ وَمُوسَىٰ","translationUz":"Ibrohim va Muso sahifalaridadir.","transcription":null,"tafsirUz":null,"pageNumber":592,"juz":30,"createdAt":"2026-09-17T18:46:11.479Z","updatedAt":"2026-09-17T18:46:11.479Z"}],"createdAt":"2026-09-17T18:45:07.823Z","updatedAt":"2026-09-18T00:07:52.676Z"}