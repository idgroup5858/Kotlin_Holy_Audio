{"id":75,"number":75,"nameArabic":"القيامة","nameUz":"Qiyoma","meaningUz":"Qiyomat","revelationPlace":"makka","totalAyahs":40,"startPage":577,"ayahs":[{"id":5552,"surahId":75,"numberInSurah":1,"textArabic":" لَآ أُقْسِمُ بِيَوْمِ ٱلْقِيَـٰمَةِ","translationUz":"Qiyomat kuni bilan qasam.","transcription":null,"tafsirUz":null,"pageNumber":577,"juz":29,"createdAt":"2026-09-17T18:46:06.504Z","updatedAt":"2026-09-17T18:46:06.504Z"},{"id":5553,"surahId":75,"numberInSurah":2,"textArabic":"وَلَآ أُقْسِمُ بِٱلنَّفْسِ ٱللَّوَّامَةِ","translationUz":"Va malomatchi nafs bilan qasam.","transcription":null,"tafsirUz":null,"pageNumber":577,"juz":29,"createdAt":"2026-09-17T18:46:06.510Z","updatedAt":"2026-09-17T18:46:06.510Z"},{"id":5554,"surahId":75,"numberInSurah":3,"textArabic":"أَيَحْسَبُ ٱلْإِنسَـٰنُ أَلَّن نَّجْمَعَ عِظَامَهُۥ","translationUz":"(Kofir) Inson Bizni uning suyaklarini jamlab olmas, deb o`ylarmi?","transcription":null,"tafsirUz":null,"pageNumber":577,"juz":29,"createdAt":"2026-09-17T18:46:06.515Z","updatedAt":"2026-09-17T18:46:06.515Z"},{"id":5555,"surahId":75,"numberInSurah":4,"textArabic":"بَلَىٰ قَـٰدِرِينَ عَلَىٰٓ أَن نُّسَوِّىَ بَنَانَهُۥ","translationUz":"Albatta, Biz uning barmoq uchlarini ham asl holiga keltirishga qodirmiz.","transcription":null,"tafsirUz":null,"pageNumber":577,"juz":29,"createdAt":"2026-09-17T18:46:06.520Z","updatedAt":"2026-09-17T18:46:06.520Z"},{"id":5556,"surahId":75,"numberInSurah":5,"textArabic":"بَلْ يُرِيدُ ٱلْإِنسَـٰنُ لِيَفْجُرَ أَمَامَهُۥ","translationUz":"Balki, inson kelajakda fisqu fujur qilishni xohlaydir.","transcription":null,"tafsirUz":null,"pageNumber":577,"juz":29,"createdAt":"2026-09-17T18:46:06.525Z","updatedAt":"2026-09-17T18:46:06.525Z"},{"id":5557,"surahId":75,"numberInSurah":6,"textArabic":"يَسْـَٔلُ أَيَّانَ يَوْمُ ٱلْقِيَـٰمَةِ","translationUz":"Qiyomat kuni qachon? — deb so`raydir.","transcription":null,"tafsirUz":null,"pageNumber":577,"juz":29,"createdAt":"2026-09-17T18:46:06.529Z","updatedAt":"2026-09-17T18:46:06.529Z"},{"id":5558,"surahId":75,"numberInSurah":7,"textArabic":"فَإِذَا بَرِقَ ٱلْبَصَرُ","translationUz":"Qachonki ko`z lol qolib qo`rqinchga to`lsa.","transcription":null,"tafsirUz":null,"pageNumber":577,"juz":29,"createdAt":"2026-09-17T18:46:06.533Z","updatedAt":"2026-09-17T18:46:06.533Z"},{"id":5559,"surahId":75,"numberInSurah":8,"textArabic":"وَخَسَفَ ٱلْقَمَرُ","translationUz":"Va oy tutilsa.","transcription":null,"tafsirUz":null,"pageNumber":577,"juz":29,"createdAt":"2026-09-17T18:46:06.537Z","updatedAt":"2026-09-17T18:46:06.537Z"},{"id":5560,"surahId":75,"numberInSurah":9,"textArabic":"وَجُمِعَ ٱلشَّمْسُ وَٱلْقَمَرُ","translationUz":"Va quyosh bilan oy jamlansa.","transcription":null,"tafsirUz":null,"pageNumber":577,"juz":29,"createdAt":"2026-09-17T18:46:06.541Z","updatedAt":"2026-09-17T18:46:06.541Z"},{"id":5561,"surahId":75,"numberInSurah":10,"textArabic":"يَقُولُ ٱلْإِنسَـٰنُ يَوْمَئِذٍ أَيْنَ ٱلْمَفَرُّ","translationUz":"O`shal kunda inson: «Qochar joy qayerda?» deb qoladir.","transcription":null,"tafsirUz":null,"pageNumber":577,"juz":29,"createdAt":"2026-09-17T18:46:06.545Z","updatedAt":"2026-09-17T18:46:06.545Z"},{"id":5562,"surahId":75,"numberInSurah":11,"textArabic":"كَلَّا لَا وَزَرَ","translationUz":"Yo`q! Qochar joy yo`qdir!","transcription":null,"tafsirUz":null,"pageNumber":577,"juz":29,"createdAt":"2026-09-17T18:46:06.550Z","updatedAt":"2026-09-17T18:46:06.550Z"},{"id":5563,"surahId":75,"numberInSurah":12,"textArabic":"إِلَىٰ رَبِّكَ يَوْمَئِذٍ ٱلْمُسْتَقَرُّ","translationUz":"U kunda joylashuv faqat Robbing huzurida bo`ladir.","transcription":null,"tafsirUz":null,"pageNumber":577,"juz":29,"createdAt":"2026-09-17T18:46:06.554Z","updatedAt":"2026-09-17T18:46:06.554Z"},{"id":5564,"surahId":75,"numberInSurah":13,"textArabic":"يُنَبَّؤُا۟ ٱلْإِنسَـٰنُ يَوْمَئِذٍۭ بِمَا قَدَّمَ وَأَخَّرَ","translationUz":"U kunda insonga avvalu oxir qilgan ishlarining xabari beriladir.","transcription":null,"tafsirUz":null,"pageNumber":577,"juz":29,"createdAt":"2026-09-17T18:46:06.558Z","updatedAt":"2026-09-17T18:46:06.558Z"},{"id":5565,"surahId":75,"numberInSurah":14,"textArabic":"بَلِ ٱلْإِنسَـٰنُ عَلَىٰ نَفْسِهِۦ بَصِيرَةٌ","translationUz":"Ha, inson o`z nafsiga qarshi o`zi shohiddir.","transcription":null,"tafsirUz":null,"pageNumber":577,"juz":29,"createdAt":"2026-09-17T18:46:06.562Z","updatedAt":"2026-09-17T18:46:06.562Z"},{"id":5566,"surahId":75,"numberInSurah":15,"textArabic":"وَلَوْ أَلْقَىٰ مَعَاذِيرَهُۥ","translationUz":"Va agar uzrlarini to`kib solsa ham.","transcription":null,"tafsirUz":null,"pageNumber":577,"juz":29,"createdAt":"2026-09-17T18:46:06.566Z","updatedAt":"2026-09-17T18:46:06.566Z"},{"id":5567,"surahId":75,"numberInSurah":16,"textArabic":"لَا تُحَرِّكْ بِهِۦ لِسَانَكَ لِتَعْجَلَ بِهِۦٓ","translationUz":"Sen shoshilib u bilan tilingni qimirlatma.","transcription":null,"tafsirUz":null,"pageNumber":577,"juz":29,"createdAt":"2026-09-17T18:46:06.571Z","updatedAt":"2026-09-17T18:46:06.571Z"},{"id":5568,"surahId":75,"numberInSurah":17,"textArabic":"إِنَّ عَلَيْنَا جَمْعَهُۥ وَقُرْءَانَهُۥ","translationUz":"Albatta, u(Qur'on)ni jamlash va o`qib berish Bizning zimmamizda.","transcription":null,"tafsirUz":null,"pageNumber":577,"juz":29,"createdAt":"2026-09-17T18:46:06.575Z","updatedAt":"2026-09-17T18:46:06.575Z"},{"id":5569,"surahId":75,"numberInSurah":18,"textArabic":"فَإِذَا قَرَأْنَـٰهُ فَٱتَّبِعْ قُرْءَانَهُۥ","translationUz":"Bas, Biz uni o`qisak, qiroatiga zehn solib tur.","transcription":null,"tafsirUz":null,"pageNumber":577,"juz":29,"createdAt":"2026-09-17T18:46:06.578Z","updatedAt":"2026-09-17T18:46:06.578Z"},{"id":5570,"surahId":75,"numberInSurah":19,"textArabic":"ثُمَّ إِنَّ عَلَيْنَا بَيَانَهُۥ","translationUz":"So`ngra u(Qur'on)ni bayon qilib berish ham Bizning zimmamizda.","transcription":null,"tafsirUz":null,"pageNumber":577,"juz":29,"createdAt":"2026-09-17T18:46:06.583Z","updatedAt":"2026-09-17T18:46:06.583Z"},{"id":5571,"surahId":75,"numberInSurah":20,"textArabic":"كَلَّا بَلْ تُحِبُّونَ ٱلْعَاجِلَةَ","translationUz":"Yo`q! Balki sizlar shoshar dunyoni yaxshi ko`rasizlar.","transcription":null,"tafsirUz":null,"pageNumber":578,"juz":29,"createdAt":"2026-09-17T18:46:06.587Z","updatedAt":"2026-09-17T18:46:06.587Z"},{"id":5572,"surahId":75,"numberInSurah":21,"textArabic":"وَتَذَرُونَ ٱلْـَٔاخِرَةَ","translationUz":"Va oxiratni tark etasizlar.","transcription":null,"tafsirUz":null,"pageNumber":578,"juz":29,"createdAt":"2026-09-17T18:46:06.591Z","updatedAt":"2026-09-17T18:46:06.591Z"},{"id":5573,"surahId":75,"numberInSurah":22,"textArabic":"وُجُوهٌ يَوْمَئِذٍ نَّاضِرَةٌ","translationUz":"U kunda chiroyli yuzlar bor.","transcription":null,"tafsirUz":null,"pageNumber":578,"juz":29,"createdAt":"2026-09-17T18:46:06.595Z","updatedAt":"2026-09-17T18:46:06.595Z"},{"id":5574,"surahId":75,"numberInSurah":23,"textArabic":"إِلَىٰ رَبِّهَا نَاظِرَةٌ","translationUz":"O`z Robbisiga nazar soluvchilar.","transcription":null,"tafsirUz":null,"pageNumber":578,"juz":29,"createdAt":"2026-09-17T18:46:06.599Z","updatedAt":"2026-09-17T18:46:06.599Z"},{"id":5575,"surahId":75,"numberInSurah":24,"textArabic":"وَوُجُوهٌ يَوْمَئِذٍۭ بَاسِرَةٌ","translationUz":"Va u kunda tirishib-burishgan yuzlar ham bor.","transcription":null,"tafsirUz":null,"pageNumber":578,"juz":29,"createdAt":"2026-09-17T18:46:06.603Z","updatedAt":"2026-09-17T18:46:06.603Z"},{"id":5576,"surahId":75,"numberInSurah":25,"textArabic":"تَظُنُّ أَن يُفْعَلَ بِهَا فَاقِرَةٌ","translationUz":"O`zlariga umurtqasini sindiradigan ish bo`lishiga ishonarlar.","transcription":null,"tafsirUz":null,"pageNumber":578,"juz":29,"createdAt":"2026-09-17T18:46:06.607Z","updatedAt":"2026-09-17T18:46:06.607Z"},{"id":5577,"surahId":75,"numberInSurah":26,"textArabic":"كَلَّآ إِذَا بَلَغَتِ ٱلتَّرَاقِىَ","translationUz":"Yo`q! Vaqtiki, (jon) halqumga kelsa.","transcription":null,"tafsirUz":null,"pageNumber":578,"juz":29,"createdAt":"2026-09-17T18:46:06.611Z","updatedAt":"2026-09-17T18:46:06.611Z"},{"id":5578,"surahId":75,"numberInSurah":27,"textArabic":"وَقِيلَ مَنْ ۜ رَاقٍ","translationUz":"Va «Kim buni qutqarar?» deyilsa.","transcription":null,"tafsirUz":null,"pageNumber":578,"juz":29,"createdAt":"2026-09-17T18:46:06.615Z","updatedAt":"2026-09-17T18:46:06.615Z"},{"id":5579,"surahId":75,"numberInSurah":28,"textArabic":"وَظَنَّ أَنَّهُ ٱلْفِرَاقُ","translationUz":"Va, albatta, bu firoq ekanligiga ishonsa.","transcription":null,"tafsirUz":null,"pageNumber":578,"juz":29,"createdAt":"2026-09-17T18:46:06.619Z","updatedAt":"2026-09-17T18:46:06.619Z"},{"id":5580,"surahId":75,"numberInSurah":29,"textArabic":"وَٱلْتَفَّتِ ٱلسَّاقُ بِٱلسَّاقِ","translationUz":"Va boldirlar bir-biriga almashsa.","transcription":null,"tafsirUz":null,"pageNumber":578,"juz":29,"createdAt":"2026-09-17T18:46:06.623Z","updatedAt":"2026-09-17T18:46:06.623Z"},{"id":5581,"surahId":75,"numberInSurah":30,"textArabic":"إِلَىٰ رَبِّكَ يَوْمَئِذٍ ٱلْمَسَاقُ","translationUz":"U kunda haydab borish joyi Robbing huzuridadir.","transcription":null,"tafsirUz":null,"pageNumber":578,"juz":29,"createdAt":"2026-09-17T18:46:06.627Z","updatedAt":"2026-09-17T18:46:06.627Z"},{"id":5582,"surahId":75,"numberInSurah":31,"textArabic":"فَلَا صَدَّقَ وَلَا صَلَّىٰ","translationUz":"Bas, u tasdiqlamadi va namoz o`qimadi.","transcription":null,"tafsirUz":null,"pageNumber":578,"juz":29,"createdAt":"2026-09-17T18:46:06.631Z","updatedAt":"2026-09-17T18:46:06.631Z"},{"id":5583,"surahId":75,"numberInSurah":32,"textArabic":"وَلَـٰكِن كَذَّبَ وَتَوَلَّىٰ","translationUz":"Va lekin yolg`onga chiqardi va yuz o`girdi.","transcription":null,"tafsirUz":null,"pageNumber":578,"juz":29,"createdAt":"2026-09-17T18:46:06.634Z","updatedAt":"2026-09-17T18:46:06.634Z"},{"id":5584,"surahId":75,"numberInSurah":33,"textArabic":"ثُمَّ ذَهَبَ إِلَىٰٓ أَهْلِهِۦ يَتَمَطَّىٰٓ","translationUz":"So`ng o`z ahliga kerilib bordi.","transcription":null,"tafsirUz":null,"pageNumber":578,"juz":29,"createdAt":"2026-09-17T18:46:06.639Z","updatedAt":"2026-09-17T18:46:06.639Z"},{"id":5585,"surahId":75,"numberInSurah":34,"textArabic":"أَوْلَىٰ لَكَ فَأَوْلَىٰ","translationUz":"Holingga voy bo`lsin sening, voy bo`lsin!","transcription":null,"tafsirUz":null,"pageNumber":578,"juz":29,"createdAt":"2026-09-17T18:46:06.643Z","updatedAt":"2026-09-17T18:46:06.643Z"},{"id":5586,"surahId":75,"numberInSurah":35,"textArabic":"ثُمَّ أَوْلَىٰ لَكَ فَأَوْلَىٰٓ","translationUz":"Yana holingga voy bo`lsin sening, voy bo`lsin!","transcription":null,"tafsirUz":null,"pageNumber":578,"juz":29,"createdAt":"2026-09-17T18:46:06.647Z","updatedAt":"2026-09-17T18:46:06.647Z"},{"id":5587,"surahId":75,"numberInSurah":36,"textArabic":"أَيَحْسَبُ ٱلْإِنسَـٰنُ أَن يُتْرَكَ سُدًى","translationUz":"Inson behuda tark qilinishlikning hisobini qilurmi?","transcription":null,"tafsirUz":null,"pageNumber":578,"juz":29,"createdAt":"2026-09-17T18:46:06.651Z","updatedAt":"2026-09-17T18:46:06.651Z"},{"id":5588,"surahId":75,"numberInSurah":37,"textArabic":"أَلَمْ يَكُ نُطْفَةً مِّن مَّنِىٍّ يُمْنَىٰ","translationUz":"U maniydan oqqan nutfa bo`lmaganmidi?","transcription":null,"tafsirUz":null,"pageNumber":578,"juz":29,"createdAt":"2026-09-17T18:46:06.656Z","updatedAt":"2026-09-17T18:46:06.656Z"},{"id":5589,"surahId":75,"numberInSurah":38,"textArabic":"ثُمَّ كَانَ عَلَقَةً فَخَلَقَ فَسَوَّىٰ","translationUz":"So`ng alaqa bo`ldi. Bas, bekami-ko`st etib yaratdi.","transcription":null,"tafsirUz":null,"pageNumber":578,"juz":29,"createdAt":"2026-09-17T18:46:06.660Z","updatedAt":"2026-09-17T18:46:06.660Z"},{"id":5590,"surahId":75,"numberInSurah":39,"textArabic":"فَجَعَلَ مِنْهُ ٱلزَّوْجَيْنِ ٱلذَّكَرَ وَٱلْأُنثَىٰٓ","translationUz":"Bas, undan juftni — erkak va ayolni yaratdi.","transcription":null,"tafsirUz":null,"pageNumber":578,"juz":29,"createdAt":"2026-09-17T18:46:06.665Z","updatedAt":"2026-09-17T18:46:06.665Z"},{"id":5591,"surahId":75,"numberInSurah":40,"textArabic":"أَلَيْسَ ذَٰلِكَ بِقَـٰدِرٍ عَلَىٰٓ أَن يُحْـِۧىَ ٱلْمَوْتَىٰ","translationUz":"Shunday Zot o`liklarni tiriltirishga qodir emasmi?!","transcription":null,"tafsirUz":null,"pageNumber":578,"juz":29,"createdAt":"2026-09-17T18:46:06.669Z","updatedAt":"2026-09-17T18:46:06.669Z"}],"createdAt":"2026-09-17T18:45:07.769Z","updatedAt":"2026-09-18T00:07:52.629Z"}