{"id":53,"number":53,"nameArabic":"النجم","nameUz":"Najm","meaningUz":"Yulduz","revelationPlace":"makka","totalAyahs":62,"startPage":526,"ayahs":[{"id":4785,"surahId":53,"numberInSurah":1,"textArabic":" وَٱلنَّجْمِ إِذَا هَوَىٰ","translationUz":"Botayotgan yulduz bilan qasam.","transcription":null,"tafsirUz":null,"pageNumber":526,"juz":27,"createdAt":"2026-09-17T18:45:57.307Z","updatedAt":"2026-09-17T18:45:57.307Z"},{"id":4786,"surahId":53,"numberInSurah":2,"textArabic":"مَا ضَلَّ صَاحِبُكُمْ وَمَا غَوَىٰ","translationUz":"Sizning Birodaringiz adashgani ham yo`q, yo`ldan ozgani ham yo`q.","transcription":null,"tafsirUz":null,"pageNumber":526,"juz":27,"createdAt":"2026-09-17T18:45:57.313Z","updatedAt":"2026-09-17T18:45:57.313Z"},{"id":4787,"surahId":53,"numberInSurah":3,"textArabic":"وَمَا يَنطِقُ عَنِ ٱلْهَوَىٰٓ","translationUz":"U havodan nutq qilmas.","transcription":null,"tafsirUz":null,"pageNumber":526,"juz":27,"createdAt":"2026-09-17T18:45:57.318Z","updatedAt":"2026-09-17T18:45:57.318Z"},{"id":4788,"surahId":53,"numberInSurah":4,"textArabic":"إِنْ هُوَ إِلَّا وَحْىٌ يُوحَىٰ","translationUz":"U (Qur'on) vahiydan o`zga narsa emas.","transcription":null,"tafsirUz":null,"pageNumber":526,"juz":27,"createdAt":"2026-09-17T18:45:57.323Z","updatedAt":"2026-09-17T18:45:57.323Z"},{"id":4789,"surahId":53,"numberInSurah":5,"textArabic":"عَلَّمَهُۥ شَدِيدُ ٱلْقُوَىٰ","translationUz":"U(Muhammad)ga shiddatli quvvat egasi ta'lim berdi.","transcription":null,"tafsirUz":null,"pageNumber":526,"juz":27,"createdAt":"2026-09-17T18:45:57.327Z","updatedAt":"2026-09-17T18:45:57.327Z"},{"id":4790,"surahId":53,"numberInSurah":6,"textArabic":"ذُو مِرَّةٍ فَٱسْتَوَىٰ","translationUz":"Mirrat egasi ko`tarildi.","transcription":null,"tafsirUz":null,"pageNumber":526,"juz":27,"createdAt":"2026-09-17T18:45:57.332Z","updatedAt":"2026-09-17T18:45:57.332Z"},{"id":4791,"surahId":53,"numberInSurah":7,"textArabic":"وَهُوَ بِٱلْأُفُقِ ٱلْأَعْلَىٰ","translationUz":"Va u oliy ufqda edi.","transcription":null,"tafsirUz":null,"pageNumber":526,"juz":27,"createdAt":"2026-09-17T18:45:57.336Z","updatedAt":"2026-09-17T18:45:57.336Z"},{"id":4792,"surahId":53,"numberInSurah":8,"textArabic":"ثُمَّ دَنَا فَتَدَلَّىٰ","translationUz":"So`ngra yaqinlashdi va juda ham yaqin bo`ldi.","transcription":null,"tafsirUz":null,"pageNumber":526,"juz":27,"createdAt":"2026-09-17T18:45:57.339Z","updatedAt":"2026-09-17T18:45:57.339Z"},{"id":4793,"surahId":53,"numberInSurah":9,"textArabic":"فَكَانَ قَابَ قَوْسَيْنِ أَوْ أَدْنَىٰ","translationUz":"Bas, ikki kamon miqdoriday joyda bo`ldi. Balki undan ham yaqinroq keldi.","transcription":null,"tafsirUz":null,"pageNumber":526,"juz":27,"createdAt":"2026-09-17T18:45:57.344Z","updatedAt":"2026-09-17T18:45:57.344Z"},{"id":4794,"surahId":53,"numberInSurah":10,"textArabic":"فَأَوْحَىٰٓ إِلَىٰ عَبْدِهِۦ مَآ أَوْحَىٰ","translationUz":"Va U zot bandasiga nimani vahiy qilgan bo`lsa, yetkazdi.","transcription":null,"tafsirUz":null,"pageNumber":526,"juz":27,"createdAt":"2026-09-17T18:45:57.348Z","updatedAt":"2026-09-17T18:45:57.348Z"},{"id":4795,"surahId":53,"numberInSurah":11,"textArabic":"مَا كَذَبَ ٱلْفُؤَادُ مَا رَأَىٰٓ","translationUz":"Qalb (ko`z) ko`rganini yolg`onga chiqarmadi.","transcription":null,"tafsirUz":null,"pageNumber":526,"juz":27,"createdAt":"2026-09-17T18:45:57.352Z","updatedAt":"2026-09-17T18:45:57.352Z"},{"id":4796,"surahId":53,"numberInSurah":12,"textArabic":"أَفَتُمَـٰرُونَهُۥ عَلَىٰ مَا يَرَىٰ","translationUz":"U bilan o`zi ko`rgan narsa ustida tortishasizlarmi?!","transcription":null,"tafsirUz":null,"pageNumber":526,"juz":27,"createdAt":"2026-09-17T18:45:57.356Z","updatedAt":"2026-09-17T18:45:57.356Z"},{"id":4797,"surahId":53,"numberInSurah":13,"textArabic":"وَلَقَدْ رَءَاهُ نَزْلَةً أُخْرَىٰ","translationUz":"Va, darhaqiqat, uni boshqa safar ko`rdi.","transcription":null,"tafsirUz":null,"pageNumber":526,"juz":27,"createdAt":"2026-09-17T18:45:57.360Z","updatedAt":"2026-09-17T18:45:57.360Z"},{"id":4798,"surahId":53,"numberInSurah":14,"textArabic":"عِندَ سِدْرَةِ ٱلْمُنتَهَىٰ","translationUz":"Sidratul muntaha(tugash daraxti) oldida.","transcription":null,"tafsirUz":null,"pageNumber":526,"juz":27,"createdAt":"2026-09-17T18:45:57.364Z","updatedAt":"2026-09-17T18:45:57.364Z"},{"id":4799,"surahId":53,"numberInSurah":15,"textArabic":"عِندَهَا جَنَّةُ ٱلْمَأْوَىٰٓ","translationUz":"Uning huzurida ma'vo jannati bor.","transcription":null,"tafsirUz":null,"pageNumber":526,"juz":27,"createdAt":"2026-09-17T18:45:57.367Z","updatedAt":"2026-09-17T18:45:57.367Z"},{"id":4800,"surahId":53,"numberInSurah":16,"textArabic":"إِذْ يَغْشَى ٱلسِّدْرَةَ مَا يَغْشَىٰ","translationUz":"O`shanda, u(daraxt)ni o`raydigan narsa o`rab turibdi.","transcription":null,"tafsirUz":null,"pageNumber":526,"juz":27,"createdAt":"2026-09-17T18:45:57.371Z","updatedAt":"2026-09-17T18:45:57.371Z"},{"id":4801,"surahId":53,"numberInSurah":17,"textArabic":"مَا زَاغَ ٱلْبَصَرُ وَمَا طَغَىٰ","translationUz":"Nigoh burilmadi ham, haddidan oshmadi ham.","transcription":null,"tafsirUz":null,"pageNumber":526,"juz":27,"createdAt":"2026-09-17T18:45:57.375Z","updatedAt":"2026-09-17T18:45:57.375Z"},{"id":4802,"surahId":53,"numberInSurah":18,"textArabic":"لَقَدْ رَأَىٰ مِنْ ءَايَـٰتِ رَبِّهِ ٱلْكُبْرَىٰٓ","translationUz":"Darhaqiqat, o`z Robbisining ulkan belgilaridan ko`rdi.","transcription":null,"tafsirUz":null,"pageNumber":526,"juz":27,"createdAt":"2026-09-17T18:45:57.379Z","updatedAt":"2026-09-17T18:45:57.379Z"},{"id":4803,"surahId":53,"numberInSurah":19,"textArabic":"أَفَرَءَيْتُمُ ٱللَّـٰتَ وَٱلْعُزَّىٰ","translationUz":"Lot va Uzzoni o`ylab ko`rdingizmi?","transcription":null,"tafsirUz":null,"pageNumber":526,"juz":27,"createdAt":"2026-09-17T18:45:57.383Z","updatedAt":"2026-09-17T18:45:57.383Z"},{"id":4804,"surahId":53,"numberInSurah":20,"textArabic":"وَمَنَوٰةَ ٱلثَّالِثَةَ ٱلْأُخْرَىٰٓ","translationUz":"Va boshqasi, uchinchisi — Manotni ham (o`ylab ko`rdingizmi)?","transcription":null,"tafsirUz":null,"pageNumber":526,"juz":27,"createdAt":"2026-09-17T18:45:57.388Z","updatedAt":"2026-09-17T18:45:57.388Z"},{"id":4805,"surahId":53,"numberInSurah":21,"textArabic":"أَلَكُمُ ٱلذَّكَرُ وَلَهُ ٱلْأُنثَىٰ","translationUz":"Sizlarga erkak-u, U zotga ayolmi?","transcription":null,"tafsirUz":null,"pageNumber":526,"juz":27,"createdAt":"2026-09-17T18:45:57.392Z","updatedAt":"2026-09-17T18:45:57.392Z"},{"id":4806,"surahId":53,"numberInSurah":22,"textArabic":"تِلْكَ إِذًا قِسْمَةٌ ضِيزَىٰٓ","translationUz":"Undoq bo`lsa, bu noto`g`ri taqsim-ku!","transcription":null,"tafsirUz":null,"pageNumber":526,"juz":27,"createdAt":"2026-09-17T18:45:57.395Z","updatedAt":"2026-09-17T18:45:57.395Z"},{"id":4807,"surahId":53,"numberInSurah":23,"textArabic":"إِنْ هِىَ إِلَّآ أَسْمَآءٌ سَمَّيْتُمُوهَآ أَنتُمْ وَءَابَآؤُكُم مَّآ أَنزَلَ ٱللَّهُ بِهَا مِن سُلْطَـٰنٍ ۚ إِن يَتَّبِعُونَ إِلَّا ٱلظَّنَّ وَمَا تَهْوَى ٱلْأَنفُسُ ۖ وَلَقَدْ جَآءَهُم مِّن رَّبِّهِمُ ٱلْهُدَىٰٓ","translationUz":"U(but)lar siz va ota-bobolaringiz qo`ygan nomlardan o`zga hech narsa emas. Alloh bunga hech hujjat tushirgan emas. U(mushrik)lar, Robbilaridan hidoyat kelganiga qaramay, gumon va havoyi nafs xohishiga ergasharlar, xolos.","transcription":null,"tafsirUz":null,"pageNumber":526,"juz":27,"createdAt":"2026-09-17T18:45:57.400Z","updatedAt":"2026-09-17T18:45:57.400Z"},{"id":4808,"surahId":53,"numberInSurah":24,"textArabic":"أَمْ لِلْإِنسَـٰنِ مَا تَمَنَّىٰ","translationUz":"Yoki har inson nimani xohlasa, shu bo`laveradimi?","transcription":null,"tafsirUz":null,"pageNumber":526,"juz":27,"createdAt":"2026-09-17T18:45:57.404Z","updatedAt":"2026-09-17T18:45:57.404Z"},{"id":4809,"surahId":53,"numberInSurah":25,"textArabic":"فَلِلَّهِ ٱلْـَٔاخِرَةُ وَٱلْأُولَىٰ","translationUz":"Zero, oxirat ham, dunyo ham Allohnikidir.","transcription":null,"tafsirUz":null,"pageNumber":526,"juz":27,"createdAt":"2026-09-17T18:45:57.407Z","updatedAt":"2026-09-17T18:45:57.407Z"},{"id":4810,"surahId":53,"numberInSurah":26,"textArabic":"۞ وَكَم مِّن مَّلَكٍ فِى ٱلسَّمَـٰوَٰتِ لَا تُغْنِى شَفَـٰعَتُهُمْ شَيْـًٔا إِلَّا مِنۢ بَعْدِ أَن يَأْذَنَ ٱللَّهُ لِمَن يَشَآءُ وَيَرْضَىٰٓ","translationUz":"Osmonlarda qanchadan-qancha farishtalar mavjud, ularning shafoati hech foyda bermas. Magar, Alloh O`zi xohlagan va rozi bo`lganlarga izn bersa.","transcription":null,"tafsirUz":null,"pageNumber":526,"juz":27,"createdAt":"2026-09-17T18:45:57.410Z","updatedAt":"2026-09-17T18:45:57.410Z"},{"id":4811,"surahId":53,"numberInSurah":27,"textArabic":"إِنَّ ٱلَّذِينَ لَا يُؤْمِنُونَ بِٱلْـَٔاخِرَةِ لَيُسَمُّونَ ٱلْمَلَـٰٓئِكَةَ تَسْمِيَةَ ٱلْأُنثَىٰ","translationUz":"Albatta, oxiratga iymon keltirmaganlar farishtalarni ayol nomi bilan nomlarlar.","transcription":null,"tafsirUz":null,"pageNumber":527,"juz":27,"createdAt":"2026-09-17T18:45:57.414Z","updatedAt":"2026-09-17T18:45:57.414Z"},{"id":4812,"surahId":53,"numberInSurah":28,"textArabic":"وَمَا لَهُم بِهِۦ مِنْ عِلْمٍ ۖ إِن يَتَّبِعُونَ إِلَّا ٱلظَّنَّ ۖ وَإِنَّ ٱلظَّنَّ لَا يُغْنِى مِنَ ٱلْحَقِّ شَيْـًٔا","translationUz":"Ularda bu haqda hech qanday ilm yo`q. Gumondan boshqa narsaga ergashmaslar. Albatta, gumon haqiqat o`rniga o`tmas.","transcription":null,"tafsirUz":null,"pageNumber":527,"juz":27,"createdAt":"2026-09-17T18:45:57.417Z","updatedAt":"2026-09-17T18:45:57.417Z"},{"id":4813,"surahId":53,"numberInSurah":29,"textArabic":"فَأَعْرِضْ عَن مَّن تَوَلَّىٰ عَن ذِكْرِنَا وَلَمْ يُرِدْ إِلَّا ٱلْحَيَوٰةَ ٱلدُّنْيَا","translationUz":"Bizning zikrimizga orqa o`girgan, hayoti dunyodan boshqani xohlamaydiganlardan yuz o`gir.","transcription":null,"tafsirUz":null,"pageNumber":527,"juz":27,"createdAt":"2026-09-17T18:45:57.421Z","updatedAt":"2026-09-17T18:45:57.421Z"},{"id":4814,"surahId":53,"numberInSurah":30,"textArabic":"ذَٰلِكَ مَبْلَغُهُم مِّنَ ٱلْعِلْمِ ۚ إِنَّ رَبَّكَ هُوَ أَعْلَمُ بِمَن ضَلَّ عَن سَبِيلِهِۦ وَهُوَ أَعْلَمُ بِمَنِ ٱهْتَدَىٰ","translationUz":"Ularning erishgan ilmlari mana shu. Albatta, Robbing Uning yo`lidan adashganlarni bilguvchidir va U hidoyatdagilarni ham bilguvchidir.","transcription":null,"tafsirUz":null,"pageNumber":527,"juz":27,"createdAt":"2026-09-17T18:45:57.426Z","updatedAt":"2026-09-17T18:45:57.426Z"},{"id":4815,"surahId":53,"numberInSurah":31,"textArabic":"وَلِلَّهِ مَا فِى ٱلسَّمَـٰوَٰتِ وَمَا فِى ٱلْأَرْضِ لِيَجْزِىَ ٱلَّذِينَ أَسَـٰٓـُٔوا۟ بِمَا عَمِلُوا۟ وَيَجْزِىَ ٱلَّذِينَ أَحْسَنُوا۟ بِٱلْحُسْنَى","translationUz":"Osmonlardagiyu yerdagi barcha narsalar Allohnikidir. U yomonlik qilganlarni amaliga yarasha jazolar va yaxshilik qilganlarni go`zal (mukofot) ila mukofotlar.","transcription":null,"tafsirUz":null,"pageNumber":527,"juz":27,"createdAt":"2026-09-17T18:45:57.430Z","updatedAt":"2026-09-17T18:45:57.430Z"},{"id":4816,"surahId":53,"numberInSurah":32,"textArabic":"ٱلَّذِينَ يَجْتَنِبُونَ كَبَـٰٓئِرَ ٱلْإِثْمِ وَٱلْفَوَٰحِشَ إِلَّا ٱللَّمَمَ ۚ إِنَّ رَبَّكَ وَٰسِعُ ٱلْمَغْفِرَةِ ۚ هُوَ أَعْلَمُ بِكُمْ إِذْ أَنشَأَكُم مِّنَ ٱلْأَرْضِ وَإِذْ أَنتُمْ أَجِنَّةٌ فِى بُطُونِ أُمَّهَـٰتِكُمْ ۖ فَلَا تُزَكُّوٓا۟ أَنفُسَكُمْ ۖ هُوَ أَعْلَمُ بِمَنِ ٱتَّقَىٰٓ","translationUz":"Ular kichik gunohlardan boshqa katta gunohlar va fahsh ishlardan chetda bo`ladiganlardir. Albatta, Robbing mag`firati keng Zotdir. U sizlarni tuproqdan paydo qilganda ham, onalaringiz qorinlarida homilalik chog`ingizni ham yaxshi biluvchidir. Shundoq ekan, o`zingizni oqlamang, U kim taqvodorligini yaxshi biladir.","transcription":null,"tafsirUz":null,"pageNumber":527,"juz":27,"createdAt":"2026-09-17T18:45:57.434Z","updatedAt":"2026-09-17T18:45:57.434Z"},{"id":4817,"surahId":53,"numberInSurah":33,"textArabic":"أَفَرَءَيْتَ ٱلَّذِى تَوَلَّىٰ","translationUz":"Yuz o`girib ketganni ko`rdingmi?!","transcription":null,"tafsirUz":null,"pageNumber":527,"juz":27,"createdAt":"2026-09-17T18:45:57.437Z","updatedAt":"2026-09-17T18:45:57.437Z"},{"id":4818,"surahId":53,"numberInSurah":34,"textArabic":"وَأَعْطَىٰ قَلِيلًا وَأَكْدَىٰٓ","translationUz":"U ozgina berdi va to`xtadi.","transcription":null,"tafsirUz":null,"pageNumber":527,"juz":27,"createdAt":"2026-09-17T18:45:57.441Z","updatedAt":"2026-09-17T18:45:57.441Z"},{"id":4819,"surahId":53,"numberInSurah":35,"textArabic":"أَعِندَهُۥ عِلْمُ ٱلْغَيْبِ فَهُوَ يَرَىٰٓ","translationUz":"Uning huzurida g`ayb ilmi bor-u, u ko`rib turibdimi?","transcription":null,"tafsirUz":null,"pageNumber":527,"juz":27,"createdAt":"2026-09-17T18:45:57.445Z","updatedAt":"2026-09-17T18:45:57.445Z"},{"id":4820,"surahId":53,"numberInSurah":36,"textArabic":"أَمْ لَمْ يُنَبَّأْ بِمَا فِى صُحُفِ مُوسَىٰ","translationUz":"Yoki Musoning sahifalaridagi narsalar xabari unga berilmadimi?","transcription":null,"tafsirUz":null,"pageNumber":527,"juz":27,"createdAt":"2026-09-17T18:45:57.449Z","updatedAt":"2026-09-17T18:45:57.449Z"},{"id":4821,"surahId":53,"numberInSurah":37,"textArabic":"وَإِبْرَٰهِيمَ ٱلَّذِى وَفَّىٰٓ","translationUz":"Va vafo qilgan Ibrohimning?","transcription":null,"tafsirUz":null,"pageNumber":527,"juz":27,"createdAt":"2026-09-17T18:45:57.453Z","updatedAt":"2026-09-17T18:45:57.453Z"},{"id":4822,"surahId":53,"numberInSurah":38,"textArabic":"أَلَّا تَزِرُ وَازِرَةٌ وِزْرَ أُخْرَىٰ","translationUz":"Albatta, hech bir gunohkor boshqaning gunohini ko`tarmas.","transcription":null,"tafsirUz":null,"pageNumber":527,"juz":27,"createdAt":"2026-09-17T18:45:57.457Z","updatedAt":"2026-09-17T18:45:57.457Z"},{"id":4823,"surahId":53,"numberInSurah":39,"textArabic":"وَأَن لَّيْسَ لِلْإِنسَـٰنِ إِلَّا مَا سَعَىٰ","translationUz":"Har bir insonga o`z qilganidan boshqa narsa yo`q.","transcription":null,"tafsirUz":null,"pageNumber":527,"juz":27,"createdAt":"2026-09-17T18:45:57.461Z","updatedAt":"2026-09-17T18:45:57.461Z"},{"id":4824,"surahId":53,"numberInSurah":40,"textArabic":"وَأَنَّ سَعْيَهُۥ سَوْفَ يُرَىٰ","translationUz":"Va, albatta, uning qilmishi tezda ko`rinur.","transcription":null,"tafsirUz":null,"pageNumber":527,"juz":27,"createdAt":"2026-09-17T18:45:57.465Z","updatedAt":"2026-09-17T18:45:57.465Z"},{"id":4825,"surahId":53,"numberInSurah":41,"textArabic":"ثُمَّ يُجْزَىٰهُ ٱلْجَزَآءَ ٱلْأَوْفَىٰ","translationUz":"So`ngra jazo yoki mukofoti to`liq berilur.","transcription":null,"tafsirUz":null,"pageNumber":527,"juz":27,"createdAt":"2026-09-17T18:45:57.469Z","updatedAt":"2026-09-17T18:45:57.469Z"},{"id":4826,"surahId":53,"numberInSurah":42,"textArabic":"وَأَنَّ إِلَىٰ رَبِّكَ ٱلْمُنتَهَىٰ","translationUz":"Va, albatta, intiho Robbing huzuridadir.","transcription":null,"tafsirUz":null,"pageNumber":527,"juz":27,"createdAt":"2026-09-17T18:45:57.473Z","updatedAt":"2026-09-17T18:45:57.473Z"},{"id":4827,"surahId":53,"numberInSurah":43,"textArabic":"وَأَنَّهُۥ هُوَ أَضْحَكَ وَأَبْكَىٰ","translationUz":"Va, albatta, kuldirgan ham O`zi, yig`latgan ham O`zidir.","transcription":null,"tafsirUz":null,"pageNumber":527,"juz":27,"createdAt":"2026-09-17T18:45:57.477Z","updatedAt":"2026-09-17T18:45:57.477Z"},{"id":4828,"surahId":53,"numberInSurah":44,"textArabic":"وَأَنَّهُۥ هُوَ أَمَاتَ وَأَحْيَا","translationUz":"Albatta, o`ldirgan ham O`zi, tiriltirgan ham O`zi.","transcription":null,"tafsirUz":null,"pageNumber":527,"juz":27,"createdAt":"2026-09-17T18:45:57.481Z","updatedAt":"2026-09-17T18:45:57.481Z"},{"id":4829,"surahId":53,"numberInSurah":45,"textArabic":"وَأَنَّهُۥ خَلَقَ ٱلزَّوْجَيْنِ ٱلذَّكَرَ وَٱلْأُنثَىٰ","translationUz":"Albatta, ikki juftni — erkak va ayolni yaratgan ham O`zi.","transcription":null,"tafsirUz":null,"pageNumber":528,"juz":27,"createdAt":"2026-09-17T18:45:57.486Z","updatedAt":"2026-09-17T18:45:57.486Z"},{"id":4830,"surahId":53,"numberInSurah":46,"textArabic":"مِن نُّطْفَةٍ إِذَا تُمْنَىٰ","translationUz":"Otilib chiqqan nutfadan.","transcription":null,"tafsirUz":null,"pageNumber":528,"juz":27,"createdAt":"2026-09-17T18:45:57.490Z","updatedAt":"2026-09-17T18:45:57.490Z"},{"id":4831,"surahId":53,"numberInSurah":47,"textArabic":"وَأَنَّ عَلَيْهِ ٱلنَّشْأَةَ ٱلْأُخْرَىٰ","translationUz":"Va, albatta, keyingi paydo qilish zimmasidagi zot ham O`zi.","transcription":null,"tafsirUz":null,"pageNumber":528,"juz":27,"createdAt":"2026-09-17T18:45:57.493Z","updatedAt":"2026-09-17T18:45:57.493Z"},{"id":4832,"surahId":53,"numberInSurah":48,"textArabic":"وَأَنَّهُۥ هُوَ أَغْنَىٰ وَأَقْنَىٰ","translationUz":"Va, albatta, behojat qilgan ham O`zi, badavlat qilgan ham O`zi.","transcription":null,"tafsirUz":null,"pageNumber":528,"juz":27,"createdAt":"2026-09-17T18:45:57.497Z","updatedAt":"2026-09-17T18:45:57.497Z"},{"id":4833,"surahId":53,"numberInSurah":49,"textArabic":"وَأَنَّهُۥ هُوَ رَبُّ ٱلشِّعْرَىٰ","translationUz":"Va, albatta She'roning robbisi ham Uning O`zi.","transcription":null,"tafsirUz":null,"pageNumber":528,"juz":27,"createdAt":"2026-09-17T18:45:57.502Z","updatedAt":"2026-09-17T18:45:57.502Z"},{"id":4834,"surahId":53,"numberInSurah":50,"textArabic":"وَأَنَّهُۥٓ أَهْلَكَ عَادًا ٱلْأُولَىٰ","translationUz":"Va, albatta, birinchi Odni halok qilgan ham O`zi.","transcription":null,"tafsirUz":null,"pageNumber":528,"juz":27,"createdAt":"2026-09-17T18:45:57.506Z","updatedAt":"2026-09-17T18:45:57.506Z"},{"id":4835,"surahId":53,"numberInSurah":51,"textArabic":"وَثَمُودَا۟ فَمَآ أَبْقَىٰ","translationUz":"Va Samudni boqiy qoldirmagan ham O`zi.","transcription":null,"tafsirUz":null,"pageNumber":528,"juz":27,"createdAt":"2026-09-17T18:45:57.509Z","updatedAt":"2026-09-17T18:45:57.509Z"},{"id":4836,"surahId":53,"numberInSurah":52,"textArabic":"وَقَوْمَ نُوحٍ مِّن قَبْلُ ۖ إِنَّهُمْ كَانُوا۟ هُمْ أَظْلَمَ وَأَطْغَىٰ","translationUz":"Va bundan oldin Nuh qavmini (halok qilgan ham O`zi). Chunki, ular o`ta zolim va o`ta tug`yonga ketgan edilar.","transcription":null,"tafsirUz":null,"pageNumber":528,"juz":27,"createdAt":"2026-09-17T18:45:57.513Z","updatedAt":"2026-09-17T18:45:57.513Z"},{"id":4837,"surahId":53,"numberInSurah":53,"textArabic":"وَٱلْمُؤْتَفِكَةَ أَهْوَىٰ","translationUz":"Va to`ntarilganni qulatgan (ham O`zi).","transcription":null,"tafsirUz":null,"pageNumber":528,"juz":27,"createdAt":"2026-09-17T18:45:57.517Z","updatedAt":"2026-09-17T18:45:57.517Z"},{"id":4838,"surahId":53,"numberInSurah":54,"textArabic":"فَغَشَّىٰهَا مَا غَشَّىٰ","translationUz":"Bas, uni o`ragan narsa o`rab oldi.","transcription":null,"tafsirUz":null,"pageNumber":528,"juz":27,"createdAt":"2026-09-17T18:45:57.521Z","updatedAt":"2026-09-17T18:45:57.521Z"},{"id":4839,"surahId":53,"numberInSurah":55,"textArabic":"فَبِأَىِّ ءَالَآءِ رَبِّكَ تَتَمَارَىٰ","translationUz":"Shunday ekan, Robbingning qaysi ne'matlariga shak keltirasan?","transcription":null,"tafsirUz":null,"pageNumber":528,"juz":27,"createdAt":"2026-09-17T18:45:57.525Z","updatedAt":"2026-09-17T18:45:57.525Z"},{"id":4840,"surahId":53,"numberInSurah":56,"textArabic":"هَـٰذَا نَذِيرٌ مِّنَ ٱلنُّذُرِ ٱلْأُولَىٰٓ","translationUz":"Bu, avvalgi ogohlantiruvchilar kabi bir ogohlantiruvchidir.","transcription":null,"tafsirUz":null,"pageNumber":528,"juz":27,"createdAt":"2026-09-17T18:45:57.528Z","updatedAt":"2026-09-17T18:45:57.528Z"},{"id":4841,"surahId":53,"numberInSurah":57,"textArabic":"أَزِفَتِ ٱلْـَٔازِفَةُ","translationUz":"Yaqinlashuvchi yaqinlashdi.","transcription":null,"tafsirUz":null,"pageNumber":528,"juz":27,"createdAt":"2026-09-17T18:45:57.532Z","updatedAt":"2026-09-17T18:45:57.532Z"},{"id":4842,"surahId":53,"numberInSurah":58,"textArabic":"لَيْسَ لَهَا مِن دُونِ ٱللَّهِ كَاشِفَةٌ","translationUz":"Uni Allohdan boshqa kashf qiluvchi yo`q.","transcription":null,"tafsirUz":null,"pageNumber":528,"juz":27,"createdAt":"2026-09-17T18:45:57.536Z","updatedAt":"2026-09-17T18:45:57.536Z"},{"id":4843,"surahId":53,"numberInSurah":59,"textArabic":"أَفَمِنْ هَـٰذَا ٱلْحَدِيثِ تَعْجَبُونَ","translationUz":"Bu so`zdan sizlar ajablanasizlarmi?","transcription":null,"tafsirUz":null,"pageNumber":528,"juz":27,"createdAt":"2026-09-17T18:45:57.540Z","updatedAt":"2026-09-17T18:45:57.540Z"},{"id":4844,"surahId":53,"numberInSurah":60,"textArabic":"وَتَضْحَكُونَ وَلَا تَبْكُونَ","translationUz":"Va kulasizlar-u, yig`lamaysizlarmi?","transcription":null,"tafsirUz":null,"pageNumber":528,"juz":27,"createdAt":"2026-09-17T18:45:57.544Z","updatedAt":"2026-09-17T18:45:57.544Z"},{"id":4845,"surahId":53,"numberInSurah":61,"textArabic":"وَأَنتُمْ سَـٰمِدُونَ","translationUz":"Va holbuki, sizlar beparvosizlar.","transcription":null,"tafsirUz":null,"pageNumber":528,"juz":27,"createdAt":"2026-09-17T18:45:57.548Z","updatedAt":"2026-09-17T18:45:57.548Z"},{"id":4846,"surahId":53,"numberInSurah":62,"textArabic":"فَٱسْجُدُوا۟ لِلَّهِ وَٱعْبُدُوا۟ ۩","translationUz":"Bas, Allohga sajda qilinglar va ibodat qilinglar.","transcription":null,"tafsirUz":null,"pageNumber":528,"juz":27,"createdAt":"2026-09-17T18:45:57.552Z","updatedAt":"2026-09-17T18:45:57.552Z"}],"createdAt":"2026-09-17T18:45:07.664Z","updatedAt":"2026-09-18T00:07:52.549Z"}