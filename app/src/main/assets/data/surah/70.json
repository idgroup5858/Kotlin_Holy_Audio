{"id":70,"number":70,"nameArabic":"المعارج","nameUz":"Maorij","meaningUz":"Koʻtarilish darajalari","revelationPlace":"makka","totalAyahs":44,"startPage":568,"ayahs":[{"id":5376,"surahId":70,"numberInSurah":1,"textArabic":" سَأَلَ سَآئِلٌۢ بِعَذَابٍ وَاقِعٍ","translationUz":"So`rovchi voqe' bo`luvchi azob haqida so`radi.","transcription":null,"tafsirUz":null,"pageNumber":568,"juz":29,"createdAt":"2026-09-17T18:46:04.484Z","updatedAt":"2026-09-17T18:46:04.484Z"},{"id":5377,"surahId":70,"numberInSurah":2,"textArabic":"لِّلْكَـٰفِرِينَ لَيْسَ لَهُۥ دَافِعٌ","translationUz":"Kofirlarga. Uni daf' qiluvchi yo`qdir.","transcription":null,"tafsirUz":null,"pageNumber":568,"juz":29,"createdAt":"2026-09-17T18:46:04.489Z","updatedAt":"2026-09-17T18:46:04.489Z"},{"id":5378,"surahId":70,"numberInSurah":3,"textArabic":"مِّنَ ٱللَّهِ ذِى ٱلْمَعَارِجِ","translationUz":"U Allohdan — ma'orijlar egasidandir.","transcription":null,"tafsirUz":null,"pageNumber":568,"juz":29,"createdAt":"2026-09-17T18:46:04.494Z","updatedAt":"2026-09-17T18:46:04.494Z"},{"id":5379,"surahId":70,"numberInSurah":4,"textArabic":"تَعْرُجُ ٱلْمَلَـٰٓئِكَةُ وَٱلرُّوحُ إِلَيْهِ فِى يَوْمٍ كَانَ مِقْدَارُهُۥ خَمْسِينَ أَلْفَ سَنَةٍ","translationUz":"Farishtalar va Ruh Uning huzuriga miqdori ellik ming yil bo`lgan kunda ko`tarilur.","transcription":null,"tafsirUz":null,"pageNumber":568,"juz":29,"createdAt":"2026-09-17T18:46:04.497Z","updatedAt":"2026-09-17T18:46:04.497Z"},{"id":5380,"surahId":70,"numberInSurah":5,"textArabic":"فَٱصْبِرْ صَبْرًا جَمِيلًا","translationUz":"Bas, chiroyli sabr qil.","transcription":null,"tafsirUz":null,"pageNumber":568,"juz":29,"createdAt":"2026-09-17T18:46:04.501Z","updatedAt":"2026-09-17T18:46:04.501Z"},{"id":5381,"surahId":70,"numberInSurah":6,"textArabic":"إِنَّهُمْ يَرَوْنَهُۥ بَعِيدًا","translationUz":"Albatta, ular u(qiyomat)ni uzoq deb biladir.","transcription":null,"tafsirUz":null,"pageNumber":568,"juz":29,"createdAt":"2026-09-17T18:46:04.505Z","updatedAt":"2026-09-17T18:46:04.505Z"},{"id":5382,"surahId":70,"numberInSurah":7,"textArabic":"وَنَرَىٰهُ قَرِيبًا","translationUz":"Va Biz uni juda yaqin deb bilurmiz.","transcription":null,"tafsirUz":null,"pageNumber":568,"juz":29,"createdAt":"2026-09-17T18:46:04.509Z","updatedAt":"2026-09-17T18:46:04.509Z"},{"id":5383,"surahId":70,"numberInSurah":8,"textArabic":"يَوْمَ تَكُونُ ٱلسَّمَآءُ كَٱلْمُهْلِ","translationUz":"U kunda osmon xuddi qora moy qoldiqlariga o`xshab qoladir.","transcription":null,"tafsirUz":null,"pageNumber":568,"juz":29,"createdAt":"2026-09-17T18:46:04.513Z","updatedAt":"2026-09-17T18:46:04.513Z"},{"id":5384,"surahId":70,"numberInSurah":9,"textArabic":"وَتَكُونُ ٱلْجِبَالُ كَٱلْعِهْنِ","translationUz":"Va tog`lar xuddi titilgan junga o`xshab qoladir.","transcription":null,"tafsirUz":null,"pageNumber":568,"juz":29,"createdAt":"2026-09-17T18:46:04.517Z","updatedAt":"2026-09-17T18:46:04.517Z"},{"id":5385,"surahId":70,"numberInSurah":10,"textArabic":"وَلَا يَسْـَٔلُ حَمِيمٌ حَمِيمًا","translationUz":"Va yaqin do`st o`z do`stidan so`ramaydir.","transcription":null,"tafsirUz":null,"pageNumber":568,"juz":29,"createdAt":"2026-09-17T18:46:04.521Z","updatedAt":"2026-09-17T18:46:04.521Z"},{"id":5386,"surahId":70,"numberInSurah":11,"textArabic":"يُبَصَّرُونَهُمْ ۚ يَوَدُّ ٱلْمُجْرِمُ لَوْ يَفْتَدِى مِنْ عَذَابِ يَوْمِئِذٍۭ بِبَنِيهِ","translationUz":"Ularni ko`rib turadirlar. Gunohkor o`sha kun azobidan qutulish uchun o`z bolalarini ham.","transcription":null,"tafsirUz":null,"pageNumber":569,"juz":29,"createdAt":"2026-09-17T18:46:04.526Z","updatedAt":"2026-09-17T18:46:04.526Z"},{"id":5387,"surahId":70,"numberInSurah":12,"textArabic":"وَصَـٰحِبَتِهِۦ وَأَخِيهِ","translationUz":"Va xotinini va aka-ukasini ham.","transcription":null,"tafsirUz":null,"pageNumber":569,"juz":29,"createdAt":"2026-09-17T18:46:04.530Z","updatedAt":"2026-09-17T18:46:04.530Z"},{"id":5388,"surahId":70,"numberInSurah":13,"textArabic":"وَفَصِيلَتِهِ ٱلَّتِى تُـْٔوِيهِ","translationUz":"Va uni o`ziga olgan qabilasini ham.","transcription":null,"tafsirUz":null,"pageNumber":569,"juz":29,"createdAt":"2026-09-17T18:46:04.534Z","updatedAt":"2026-09-17T18:46:04.534Z"},{"id":5389,"surahId":70,"numberInSurah":14,"textArabic":"وَمَن فِى ٱلْأَرْضِ جَمِيعًا ثُمَّ يُنجِيهِ","translationUz":"Va yer yuzidagi jamiyki kimsalarni ham fido qilishni xohlaydir. So`ngra o`zi najot topsa.","transcription":null,"tafsirUz":null,"pageNumber":569,"juz":29,"createdAt":"2026-09-17T18:46:04.538Z","updatedAt":"2026-09-17T18:46:04.538Z"},{"id":5390,"surahId":70,"numberInSurah":15,"textArabic":"كَلَّآ ۖ إِنَّهَا لَظَىٰ","translationUz":"Yo`q! Albatta, u(jahannam) kuchli alangadur.","transcription":null,"tafsirUz":null,"pageNumber":569,"juz":29,"createdAt":"2026-09-17T18:46:04.542Z","updatedAt":"2026-09-17T18:46:04.542Z"},{"id":5391,"surahId":70,"numberInSurah":16,"textArabic":"نَزَّاعَةً لِّلشَّوَىٰ","translationUz":"Boshning terisini sidirib oluvchidur.","transcription":null,"tafsirUz":null,"pageNumber":569,"juz":29,"createdAt":"2026-09-17T18:46:04.546Z","updatedAt":"2026-09-17T18:46:04.546Z"},{"id":5392,"surahId":70,"numberInSurah":17,"textArabic":"تَدْعُوا۟ مَنْ أَدْبَرَ وَتَوَلَّىٰ","translationUz":"U chaqiradir. Orqaga ketgan va yuz o`girganni.","transcription":null,"tafsirUz":null,"pageNumber":569,"juz":29,"createdAt":"2026-09-17T18:46:04.550Z","updatedAt":"2026-09-17T18:46:04.550Z"},{"id":5393,"surahId":70,"numberInSurah":18,"textArabic":"وَجَمَعَ فَأَوْعَىٰٓ","translationUz":"Va (molni) yig`ib, berkitganni.","transcription":null,"tafsirUz":null,"pageNumber":569,"juz":29,"createdAt":"2026-09-17T18:46:04.554Z","updatedAt":"2026-09-17T18:46:04.554Z"},{"id":5394,"surahId":70,"numberInSurah":19,"textArabic":"۞ إِنَّ ٱلْإِنسَـٰنَ خُلِقَ هَلُوعًا","translationUz":"Albatta, inson «halu'» qilib yaratilgandir.","transcription":null,"tafsirUz":null,"pageNumber":569,"juz":29,"createdAt":"2026-09-17T18:46:04.558Z","updatedAt":"2026-09-17T18:46:04.558Z"},{"id":5395,"surahId":70,"numberInSurah":20,"textArabic":"إِذَا مَسَّهُ ٱلشَّرُّ جَزُوعًا","translationUz":"Agar unga yomonlik yetsa, chidamsizdir.","transcription":null,"tafsirUz":null,"pageNumber":569,"juz":29,"createdAt":"2026-09-17T18:46:04.562Z","updatedAt":"2026-09-17T18:46:04.562Z"},{"id":5396,"surahId":70,"numberInSurah":21,"textArabic":"وَإِذَا مَسَّهُ ٱلْخَيْرُ مَنُوعًا","translationUz":"Va agar yaxshilik yetsa, ko`p man qiluvchidir.","transcription":null,"tafsirUz":null,"pageNumber":569,"juz":29,"createdAt":"2026-09-17T18:46:04.566Z","updatedAt":"2026-09-17T18:46:04.566Z"},{"id":5397,"surahId":70,"numberInSurah":22,"textArabic":"إِلَّا ٱلْمُصَلِّينَ","translationUz":"Illo, namoz o`quvchilargina mustasnodir.","transcription":null,"tafsirUz":null,"pageNumber":569,"juz":29,"createdAt":"2026-09-17T18:46:04.570Z","updatedAt":"2026-09-17T18:46:04.570Z"},{"id":5398,"surahId":70,"numberInSurah":23,"textArabic":"ٱلَّذِينَ هُمْ عَلَىٰ صَلَاتِهِمْ دَآئِمُونَ","translationUz":"Ular namozlarida doim bo`ladiganlardir.","transcription":null,"tafsirUz":null,"pageNumber":569,"juz":29,"createdAt":"2026-09-17T18:46:04.574Z","updatedAt":"2026-09-17T18:46:04.574Z"},{"id":5399,"surahId":70,"numberInSurah":24,"textArabic":"وَٱلَّذِينَ فِىٓ أَمْوَٰلِهِمْ حَقٌّ مَّعْلُومٌ","translationUz":"Ularning molu mulklarida ma'lum haqq bordur.","transcription":null,"tafsirUz":null,"pageNumber":569,"juz":29,"createdAt":"2026-09-17T18:46:04.578Z","updatedAt":"2026-09-17T18:46:04.578Z"},{"id":5400,"surahId":70,"numberInSurah":25,"textArabic":"لِّلسَّآئِلِ وَٱلْمَحْرُومِ","translationUz":"So`rovchi va bechoralar uchundir.","transcription":null,"tafsirUz":null,"pageNumber":569,"juz":29,"createdAt":"2026-09-17T18:46:04.582Z","updatedAt":"2026-09-17T18:46:04.582Z"},{"id":5401,"surahId":70,"numberInSurah":26,"textArabic":"وَٱلَّذِينَ يُصَدِّقُونَ بِيَوْمِ ٱلدِّينِ","translationUz":"Va ular qiyomat kunini tasdiqlaydiganlardir.","transcription":null,"tafsirUz":null,"pageNumber":569,"juz":29,"createdAt":"2026-09-17T18:46:04.586Z","updatedAt":"2026-09-17T18:46:04.586Z"},{"id":5402,"surahId":70,"numberInSurah":27,"textArabic":"وَٱلَّذِينَ هُم مِّنْ عَذَابِ رَبِّهِم مُّشْفِقُونَ","translationUz":"Va ular o`z Robbilari azobidan qo`rqadiganlardir.","transcription":null,"tafsirUz":null,"pageNumber":569,"juz":29,"createdAt":"2026-09-17T18:46:04.590Z","updatedAt":"2026-09-17T18:46:04.590Z"},{"id":5403,"surahId":70,"numberInSurah":28,"textArabic":"إِنَّ عَذَابَ رَبِّهِمْ غَيْرُ مَأْمُونٍ","translationUz":"Albatta, Robbilarining azobidan omonlik yo`qdir.","transcription":null,"tafsirUz":null,"pageNumber":569,"juz":29,"createdAt":"2026-09-17T18:46:04.594Z","updatedAt":"2026-09-17T18:46:04.594Z"},{"id":5404,"surahId":70,"numberInSurah":29,"textArabic":"وَٱلَّذِينَ هُمْ لِفُرُوجِهِمْ حَـٰفِظُونَ","translationUz":"Va ular o`z farjlarini saqlaydiganlardir.","transcription":null,"tafsirUz":null,"pageNumber":569,"juz":29,"createdAt":"2026-09-17T18:46:04.598Z","updatedAt":"2026-09-17T18:46:04.598Z"},{"id":5405,"surahId":70,"numberInSurah":30,"textArabic":"إِلَّا عَلَىٰٓ أَزْوَٰجِهِمْ أَوْ مَا مَلَكَتْ أَيْمَـٰنُهُمْ فَإِنَّهُمْ غَيْرُ مَلُومِينَ","translationUz":"Illo, o`z xotinlari yoki mulki bo`lganlardan (saqlamasalar), albatta ular malomat qilinmasdir.","transcription":null,"tafsirUz":null,"pageNumber":569,"juz":29,"createdAt":"2026-09-17T18:46:04.602Z","updatedAt":"2026-09-17T18:46:04.602Z"},{"id":5406,"surahId":70,"numberInSurah":31,"textArabic":"فَمَنِ ٱبْتَغَىٰ وَرَآءَ ذَٰلِكَ فَأُو۟لَـٰٓئِكَ هُمُ ٱلْعَادُونَ","translationUz":"Kimki o`shandan o`zgani istasa, bas, ular chegaradan chiqqanlardir.","transcription":null,"tafsirUz":null,"pageNumber":569,"juz":29,"createdAt":"2026-09-17T18:46:04.606Z","updatedAt":"2026-09-17T18:46:04.606Z"},{"id":5407,"surahId":70,"numberInSurah":32,"textArabic":"وَٱلَّذِينَ هُمْ لِأَمَـٰنَـٰتِهِمْ وَعَهْدِهِمْ رَٰعُونَ","translationUz":"Ular omonatlariga va ahdlariga rioya qiladiganlardir.","transcription":null,"tafsirUz":null,"pageNumber":569,"juz":29,"createdAt":"2026-09-17T18:46:04.612Z","updatedAt":"2026-09-17T18:46:04.612Z"},{"id":5408,"surahId":70,"numberInSurah":33,"textArabic":"وَٱلَّذِينَ هُم بِشَهَـٰدَٰتِهِمْ قَآئِمُونَ","translationUz":"Va ular guvohliklarini to`g`ri beradiganlardir.","transcription":null,"tafsirUz":null,"pageNumber":569,"juz":29,"createdAt":"2026-09-17T18:46:04.617Z","updatedAt":"2026-09-17T18:46:04.617Z"},{"id":5409,"surahId":70,"numberInSurah":34,"textArabic":"وَٱلَّذِينَ هُمْ عَلَىٰ صَلَاتِهِمْ يُحَافِظُونَ","translationUz":"Ular namozlarini muhofaza qiladiganlardir.","transcription":null,"tafsirUz":null,"pageNumber":569,"juz":29,"createdAt":"2026-09-17T18:46:04.621Z","updatedAt":"2026-09-17T18:46:04.621Z"},{"id":5410,"surahId":70,"numberInSurah":35,"textArabic":"أُو۟لَـٰٓئِكَ فِى جَنَّـٰتٍ مُّكْرَمُونَ","translationUz":"O`shalar jannatlarda hurmatlanadiganlardir.","transcription":null,"tafsirUz":null,"pageNumber":569,"juz":29,"createdAt":"2026-09-17T18:46:04.626Z","updatedAt":"2026-09-17T18:46:04.626Z"},{"id":5411,"surahId":70,"numberInSurah":36,"textArabic":"فَمَالِ ٱلَّذِينَ كَفَرُوا۟ قِبَلَكَ مُهْطِعِينَ","translationUz":"Kufr keltirganlarga ne bo`ldiki, sen tomon bo`yin cho`zib shoshilmoqdalar?","transcription":null,"tafsirUz":null,"pageNumber":569,"juz":29,"createdAt":"2026-09-17T18:46:04.630Z","updatedAt":"2026-09-17T18:46:04.630Z"},{"id":5412,"surahId":70,"numberInSurah":37,"textArabic":"عَنِ ٱلْيَمِينِ وَعَنِ ٱلشِّمَالِ عِزِينَ","translationUz":"O`ng tarafdan va chap tarafdan to`p-to`p bo`lmoqdalar?","transcription":null,"tafsirUz":null,"pageNumber":569,"juz":29,"createdAt":"2026-09-17T18:46:04.635Z","updatedAt":"2026-09-17T18:46:04.635Z"},{"id":5413,"surahId":70,"numberInSurah":38,"textArabic":"أَيَطْمَعُ كُلُّ ٱمْرِئٍ مِّنْهُمْ أَن يُدْخَلَ جَنَّةَ نَعِيمٍ","translationUz":"Ulardan har bir kishi na'iym jannatga kiritilishni tama' qilurmi?","transcription":null,"tafsirUz":null,"pageNumber":569,"juz":29,"createdAt":"2026-09-17T18:46:04.639Z","updatedAt":"2026-09-17T18:46:04.639Z"},{"id":5414,"surahId":70,"numberInSurah":39,"textArabic":"كَلَّآ ۖ إِنَّا خَلَقْنَـٰهُم مِّمَّا يَعْلَمُونَ","translationUz":"Yo`q! Albatta, Biz ularni o`zlari bilgan narsadan yaratganmiz.","transcription":null,"tafsirUz":null,"pageNumber":569,"juz":29,"createdAt":"2026-09-17T18:46:04.643Z","updatedAt":"2026-09-17T18:46:04.643Z"},{"id":5415,"surahId":70,"numberInSurah":40,"textArabic":"فَلَآ أُقْسِمُ بِرَبِّ ٱلْمَشَـٰرِقِ وَٱلْمَغَـٰرِبِ إِنَّا لَقَـٰدِرُونَ","translationUz":"Mashriqlar va mag`riblar Robbisi bilan qasam ichamanki, albatta, Biz qodirmiz.","transcription":null,"tafsirUz":null,"pageNumber":570,"juz":29,"createdAt":"2026-09-17T18:46:04.647Z","updatedAt":"2026-09-17T18:46:04.647Z"},{"id":5416,"surahId":70,"numberInSurah":41,"textArabic":"عَلَىٰٓ أَن نُّبَدِّلَ خَيْرًا مِّنْهُمْ وَمَا نَحْنُ بِمَسْبُوقِينَ","translationUz":"O`rinlariga ulardan yaxshiroqlarini almashtirishga va Biz bu ishni qilishdan ojizmasmiz.","transcription":null,"tafsirUz":null,"pageNumber":570,"juz":29,"createdAt":"2026-09-17T18:46:04.651Z","updatedAt":"2026-09-17T18:46:04.651Z"},{"id":5417,"surahId":70,"numberInSurah":42,"textArabic":"فَذَرْهُمْ يَخُوضُوا۟ وَيَلْعَبُوا۟ حَتَّىٰ يُلَـٰقُوا۟ يَوْمَهُمُ ٱلَّذِى يُوعَدُونَ","translationUz":"Ularni tek qo`y. To va'da qilingan kunga yo`liqqunlaricha (xohlaganlariga) sho`ng`iyversinlar va o`ynayversinlar.","transcription":null,"tafsirUz":null,"pageNumber":570,"juz":29,"createdAt":"2026-09-17T18:46:04.655Z","updatedAt":"2026-09-17T18:46:04.655Z"},{"id":5418,"surahId":70,"numberInSurah":43,"textArabic":"يَوْمَ يَخْرُجُونَ مِنَ ٱلْأَجْدَاثِ سِرَاعًا كَأَنَّهُمْ إِلَىٰ نُصُبٍ يُوفِضُونَ","translationUz":"U kunda xuddi sanamlar(ibodati)ga shoshganlaridek, qabrlaridan shoshib chiqurlar.","transcription":null,"tafsirUz":null,"pageNumber":570,"juz":29,"createdAt":"2026-09-17T18:46:04.658Z","updatedAt":"2026-09-17T18:46:04.658Z"},{"id":5419,"surahId":70,"numberInSurah":44,"textArabic":"خَـٰشِعَةً أَبْصَـٰرُهُمْ تَرْهَقُهُمْ ذِلَّةٌ ۚ ذَٰلِكَ ٱلْيَوْمُ ٱلَّذِى كَانُوا۟ يُوعَدُونَ","translationUz":"Ko`zlari qo`rqinchga to`lgan, o`zlarini xorlik qoplagan holda tururlar. Bu o`sha, ularga va'da qilingan kundur.","transcription":null,"tafsirUz":null,"pageNumber":570,"juz":29,"createdAt":"2026-09-17T18:46:04.662Z","updatedAt":"2026-09-17T18:46:04.662Z"}],"createdAt":"2026-09-17T18:45:07.745Z","updatedAt":"2026-09-18T00:07:52.612Z"}