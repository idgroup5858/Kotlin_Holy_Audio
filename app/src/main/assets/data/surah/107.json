{"id":107,"number":107,"nameArabic":"الماعون","nameUz":"Moun","meaningUz":"Koʻmak","revelationPlace":"makka","totalAyahs":7,"startPage":602,"ayahs":[{"id":6198,"surahId":107,"numberInSurah":1,"textArabic":" أَرَءَيْتَ ٱلَّذِى يُكَذِّبُ بِٱلدِّينِ","translationUz":"Oxirat(jazosi)ni yolg`onga chiqaruvchini ko`rdingmi?","transcription":null,"tafsirUz":null,"pageNumber":602,"juz":30,"createdAt":"2026-09-17T18:46:17.075Z","updatedAt":"2026-09-17T18:46:17.075Z"},{"id":6199,"surahId":107,"numberInSurah":2,"textArabic":"فَذَٰلِكَ ٱلَّذِى يَدُعُّ ٱلْيَتِيمَ","translationUz":"U, yetimni qo`pollik bilan haydaydir.","transcription":null,"tafsirUz":null,"pageNumber":602,"juz":30,"createdAt":"2026-09-17T18:46:17.081Z","updatedAt":"2026-09-17T18:46:17.081Z"},{"id":6200,"surahId":107,"numberInSurah":3,"textArabic":"وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ","translationUz":"Va miskinlarga taom berishga qiziqtirmaydir.","transcription":null,"tafsirUz":null,"pageNumber":602,"juz":30,"createdAt":"2026-09-17T18:46:17.086Z","updatedAt":"2026-09-17T18:46:17.086Z"},{"id":6201,"surahId":107,"numberInSurah":4,"textArabic":"فَوَيْلٌ لِّلْمُصَلِّينَ","translationUz":"Bir «namozxonlar»ga vayl bo`lsinki.","transcription":null,"tafsirUz":null,"pageNumber":602,"juz":30,"createdAt":"2026-09-17T18:46:17.091Z","updatedAt":"2026-09-17T18:46:17.091Z"},{"id":6202,"surahId":107,"numberInSurah":5,"textArabic":"ٱلَّذِينَ هُمْ عَن صَلَاتِهِمْ سَاهُونَ","translationUz":"Ular namozlarini unutuvchilardir.","transcription":null,"tafsirUz":null,"pageNumber":602,"juz":30,"createdAt":"2026-09-17T18:46:17.096Z","updatedAt":"2026-09-17T18:46:17.096Z"},{"id":6203,"surahId":107,"numberInSurah":6,"textArabic":"ٱلَّذِينَ هُمْ يُرَآءُونَ","translationUz":"Undoq kishilar riyo qiladiganlardir.","transcription":null,"tafsirUz":null,"pageNumber":602,"juz":30,"createdAt":"2026-09-17T18:46:17.101Z","updatedAt":"2026-09-17T18:46:17.101Z"},{"id":6204,"surahId":107,"numberInSurah":7,"textArabic":"وَيَمْنَعُونَ ٱلْمَاعُونَ","tra