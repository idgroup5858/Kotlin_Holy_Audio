{"id":69,"number":69,"nameArabic":"الحاقة","nameUz":"Haqqa","meaningUz":"Muqarrar voqea","revelationPlace":"makka","totalAyahs":52,"startPage":566,"ayahs":[{"id":5324,"surahId":69,"numberInSurah":1,"textArabic":" ٱلْحَآقَّةُ","translationUz":"Al-Haaqqoh.","transcription":null,"tafsirUz":null,"pageNumber":566,"juz":29,"createdAt":"2026-09-17T18:46:04.050Z","updatedAt":"2026-09-17T18:46:04.050Z"},{"id":5325,"surahId":69,"numberInSurah":2,"textArabic":"مَا ٱلْحَآقَّةُ","translationUz":"Al-Haaqqoh nima o`zi?!","transcription":null,"tafsirUz":null,"pageNumber":566,"juz":29,"createdAt":"2026-09-17T18:46:04.056Z","updatedAt":"2026-09-17T18:46:04.056Z"},{"id":5326,"surahId":69,"numberInSurah":3,"textArabic":"وَمَآ أَدْرَىٰكَ مَا ٱلْحَآقَّةُ","translationUz":"Al-Haaqqoh nimaligini senga nima bildirdi?!","transcription":null,"tafsirUz":null,"pageNumber":566,"juz":29,"createdAt":"2026-09-17T18:46:04.060Z","updatedAt":"2026-09-17T18:46:04.060Z"},{"id":5327,"surahId":69,"numberInSurah":4,"textArabic":"كَذَّبَتْ ثَمُودُ وَعَادٌۢ بِٱلْقَارِعَةِ","translationUz":"Samud va Od qori'ani yolg`onga chiqarishdi.","transcription":null,"tafsirUz":null,"pageNumber":566,"juz":29,"createdAt":"2026-09-17T18:46:04.064Z","updatedAt":"2026-09-17T18:46:04.064Z"},{"id":5328,"surahId":69,"numberInSurah":5,"textArabic":"فَأَمَّا ثَمُودُ فَأُهْلِكُوا۟ بِٱلطَّاغِيَةِ","translationUz":"Bas, ammo Samud haddan oshuvchi bilan halok qilindi.","transcription":null,"tafsirUz":null,"pageNumber":566,"juz":29,"createdAt":"2026-09-17T18:46:04.069Z","updatedAt":"2026-09-17T18:46:04.069Z"},{"id":5329,"surahId":69,"numberInSurah":6,"textArabic":"وَأَمَّا عَادٌ فَأُهْلِكُوا۟ بِرِيحٍ صَرْصَرٍ عَاتِيَةٍ","translationUz":"Va ammo Od qattiq (sovuq) shamol bilan halok qilindilar.","transcription":null,"tafsirUz":null,"pageNumber":566,"juz":29,"createdAt":"2026-09-17T18:46:04.072Z","updatedAt":"2026-09-17T18:46:04.072Z"},{"id":5330,"surahId":69,"numberInSurah":7,"textArabic":"سَخَّرَهَا عَلَيْهِمْ سَبْعَ لَيَالٍ وَثَمَـٰنِيَةَ أَيَّامٍ حُسُومًا فَتَرَى ٱلْقَوْمَ فِيهَا صَرْعَىٰ كَأَنَّهُمْ أَعْجَازُ نَخْلٍ خَاوِيَةٍ","translationUz":"U zot ularning ustidan bu shamolni yetti kechayu sakkiz kunduz «beminnat xizmat» qildirib qo`ydi. Bas, qavmning u yerda halok bo`lib, ag`darilib yotganini ko`rasan. Ular xuddi xurmoning chirigan tomirlariga o`xsharlar.","transcription":null,"tafsirUz":null,"pageNumber":566,"juz":29,"createdAt":"2026-09-17T18:46:04.076Z","updatedAt":"2026-09-17T18:46:04.076Z"},{"id":5331,"surahId":69,"numberInSurah":8,"textArabic":"فَهَلْ تَرَىٰ لَهُم مِّنۢ بَاقِيَةٍ","translationUz":"Bas, sen ulardan birortasining boqiy qolganini ko`rasanmi?","transcription":null,"tafsirUz":null,"pageNumber":566,"juz":29,"createdAt":"2026-09-17T18:46:04.081Z","updatedAt":"2026-09-17T18:46:04.081Z"},{"id":5332,"surahId":69,"numberInSurah":9,"textArabic":"وَجَآءَ فِرْعَوْنُ وَمَن قَبْلَهُۥ وَٱلْمُؤْتَفِكَـٰتُ بِٱلْخَاطِئَةِ","translationUz":"Fir'avn, undan avvalgilar va to`ntarilganliklar xato qildilar.","transcription":null,"tafsirUz":null,"pageNumber":567,"juz":29,"createdAt":"2026-09-17T18:46:04.084Z","updatedAt":"2026-09-17T18:46:04.084Z"},{"id":5333,"surahId":69,"numberInSurah":10,"textArabic":"فَعَصَوْا۟ رَسُولَ رَبِّهِمْ فَأَخَذَهُمْ أَخْذَةً رَّابِيَةً","translationUz":"Bas, ular Robbilarining Rasuliga osiy bo`ldilar. Darhaqiqat, U zot ularni qattiq tutishlik bilan tutdi.","transcription":null,"tafsirUz":null,"pageNumber":567,"juz":29,"createdAt":"2026-09-17T18:46:04.088Z","updatedAt":"2026-09-17T18:46:04.088Z"},{"id":5334,"surahId":69,"numberInSurah":11,"textArabic":"إِنَّا لَمَّا طَغَا ٱلْمَآءُ حَمَلْنَـٰكُمْ فِى ٱلْجَارِيَةِ","translationUz":"Albatta, Biz suv tug`yonga kelgan paytda sizlarni kemada ko`targanmiz.","transcription":null,"tafsirUz":null,"pageNumber":567,"juz":29,"createdAt":"2026-09-17T18:46:04.091Z","updatedAt":"2026-09-17T18:46:04.091Z"},{"id":5335,"surahId":69,"numberInSurah":12,"textArabic":"لِنَجْعَلَهَا لَكُمْ تَذْكِرَةً وَتَعِيَهَآ أُذُنٌ وَٰعِيَةٌ","translationUz":"Uni sizlarga eslatma qilish uchun va anglovchi quloqlar anglab olishi uchun.","transcription":null,"tafsirUz":null,"pageNumber":567,"juz":29,"createdAt":"2026-09-17T18:46:04.095Z","updatedAt":"2026-09-17T18:46:04.095Z"},{"id":5336,"surahId":69,"numberInSurah":13,"textArabic":"فَإِذَا نُفِخَ فِى ٱلصُّورِ نَفْخَةٌ وَٰحِدَةٌ","translationUz":"Agar dudga birgina puflash-la puflansa...","transcription":null,"tafsirUz":null,"pageNumber":567,"juz":29,"createdAt":"2026-09-17T18:46:04.100Z","updatedAt":"2026-09-17T18:46:04.100Z"},{"id":5337,"surahId":69,"numberInSurah":14,"textArabic":"وَحُمِلَتِ ٱلْأَرْضُ وَٱلْجِبَالُ فَدُكَّتَا دَكَّةً وَٰحِدَةً","translationUz":"Va yeru tog`lar ko`tarilib, bir martagina silkitilsa...","transcription":null,"tafsirUz":null,"pageNumber":567,"juz":29,"createdAt":"2026-09-17T18:46:04.104Z","updatedAt":"2026-09-17T18:46:04.104Z"},{"id":5338,"surahId":69,"numberInSurah":15,"textArabic":"فَيَوْمَئِذٍ وَقَعَتِ ٱلْوَاقِعَةُ","translationUz":"Bas, o`sha kunda, Voqi'a voqe' bo`libdir.","transcription":null,"tafsirUz":null,"pageNumber":567,"juz":29,"createdAt":"2026-09-17T18:46:04.107Z","updatedAt":"2026-09-17T18:46:04.107Z"},{"id":5339,"surahId":69,"numberInSurah":16,"textArabic":"وَٱنشَقَّتِ ٱلسَّمَآءُ فَهِىَ يَوْمَئِذٍ وَاهِيَةٌ","translationUz":"Va osmon parchalansa, bas, o`sha kunda, u (osmon) beholdir.","transcription":null,"tafsirUz":null,"pageNumber":567,"juz":29,"createdAt":"2026-09-17T18:46:04.111Z","updatedAt":"2026-09-17T18:46:04.111Z"},{"id":5340,"surahId":69,"numberInSurah":17,"textArabic":"وَٱلْمَلَكُ عَلَىٰٓ أَرْجَآئِهَا ۚ وَيَحْمِلُ عَرْشَ رَبِّكَ فَوْقَهُمْ يَوْمَئِذٍ ثَمَـٰنِيَةٌ","translationUz":"Va farishtalar uning atrofida va o`sha kunda Robbingning arshini sakkiztasi ko`tarib turadir.","transcription":null,"tafsirUz":null,"pageNumber":567,"juz":29,"createdAt":"2026-09-17T18:46:04.115Z","updatedAt":"2026-09-17T18:46:04.115Z"},{"id":5341,"surahId":69,"numberInSurah":18,"textArabic":"يَوْمَئِذٍ تُعْرَضُونَ لَا تَخْفَىٰ مِنكُمْ خَافِيَةٌ","translationUz":"Bas, o`sha kunda ko`rikdan o`tasizlar, birorta narsangiz maxfiy qolmaydir.","transcription":null,"tafsirUz":null,"pageNumber":567,"juz":29,"createdAt":"2026-09-17T18:46:04.119Z","updatedAt":"2026-09-17T18:46:04.119Z"},{"id":5342,"surahId":69,"numberInSurah":19,"textArabic":"فَأَمَّا مَنْ أُوتِىَ كِتَـٰبَهُۥ بِيَمِينِهِۦ فَيَقُولُ هَآؤُمُ ٱقْرَءُوا۟ كِتَـٰبِيَهْ","translationUz":"Bas, kimning kitobi o`ng tarafdan berilsa, u: «Mana, mening kitobimni o`qib ko`ringlar!","transcription":null,"tafsirUz":null,"pageNumber":567,"juz":29,"createdAt":"2026-09-17T18:46:04.122Z","updatedAt":"2026-09-17T18:46:04.122Z"},{"id":5343,"surahId":69,"numberInSurah":20,"textArabic":"إِنِّى ظَنَنتُ أَنِّى مُلَـٰقٍ حِسَابِيَهْ","translationUz":"Albatta, men hisob-kitobimga yo`liqishimga ishonardim», deydir.","transcription":null,"tafsirUz":null,"pageNumber":567,"juz":29,"createdAt":"2026-09-17T18:46:04.126Z","updatedAt":"2026-09-17T18:46:04.126Z"},{"id":5344,"surahId":69,"numberInSurah":21,"textArabic":"فَهُوَ فِى عِيشَةٍ رَّاضِيَةٍ","translationUz":"Bas, u rozilik hayotidadir.","transcription":null,"tafsirUz":null,"pageNumber":567,"juz":29,"createdAt":"2026-09-17T18:46:04.130Z","updatedAt":"2026-09-17T18:46:04.130Z"},{"id":5345,"surahId":69,"numberInSurah":22,"textArabic":"فِى جَنَّةٍ عَالِيَةٍ","translationUz":"Oliy jannatdadir.","transcription":null,"tafsirUz":null,"pageNumber":567,"juz":29,"createdAt":"2026-09-17T18:46:04.134Z","updatedAt":"2026-09-17T18:46:04.134Z"},{"id":5346,"surahId":69,"numberInSurah":23,"textArabic":"قُطُوفُهَا دَانِيَةٌ","translationUz":"Uning mevalari yaqindir.","transcription":null,"tafsirUz":null,"pageNumber":567,"juz":29,"createdAt":"2026-09-17T18:46:04.138Z","updatedAt":"2026-09-17T18:46:04.138Z"},{"id":5347,"surahId":69,"numberInSurah":24,"textArabic":"كُلُوا۟ وَٱشْرَبُوا۟ هَنِيٓـًٔۢا بِمَآ أَسْلَفْتُمْ فِى ٱلْأَيَّامِ ٱلْخَالِيَةِ","translationUz":"O`tgan kunlarda qilgan narsalaringiz tufayli yenglar va ichinglar, osh bo`lsin.","transcription":null,"tafsirUz":null,"pageNumber":567,"juz":29,"createdAt":"2026-09-17T18:46:04.142Z","updatedAt":"2026-09-17T18:46:04.142Z"},{"id":5348,"surahId":69,"numberInSurah":25,"textArabic":"وَأَمَّا مَنْ أُوتِىَ كِتَـٰبَهُۥ بِشِمَالِهِۦ فَيَقُولُ يَـٰلَيْتَنِى لَمْ أُوتَ كِتَـٰبِيَهْ","translationUz":"Va ammo kimning kitobi chap tarafdan berilsa, u: «Voy sho`rim, koshki menga kitobim berilmasa edi.","transcription":null,"tafsirUz":null,"pageNumber":567,"juz":29,"createdAt":"2026-09-17T18:46:04.146Z","updatedAt":"2026-09-17T18:46:04.146Z"},{"id":5349,"surahId":69,"numberInSurah":26,"textArabic":"وَلَمْ أَدْرِ مَا حِسَابِيَهْ","translationUz":"Va hisob-kitob qandoqligini bilmasam edim.","transcription":null,"tafsirUz":null,"pageNumber":567,"juz":29,"createdAt":"2026-09-17T18:46:04.150Z","updatedAt":"2026-09-17T18:46:04.150Z"},{"id":5350,"surahId":69,"numberInSurah":27,"textArabic":"يَـٰلَيْتَهَا كَانَتِ ٱلْقَاضِيَةَ","translationUz":"Qani endi, (bu dunyodagi o`lim) oxirgisi bo`lsa edi.","transcription":null,"tafsirUz":null,"pageNumber":567,"juz":29,"createdAt":"2026-09-17T18:46:04.154Z","updatedAt":"2026-09-17T18:46:04.154Z"},{"id":5351,"surahId":69,"numberInSurah":28,"textArabic":"مَآ أَغْنَىٰ عَنِّى مَالِيَهْ ۜ","translationUz":"Molu mulkim meni saqlab qola olmadi.","transcription":null,"tafsirUz":null,"pageNumber":567,"juz":29,"createdAt":"2026-09-17T18:46:04.159Z","updatedAt":"2026-09-17T18:46:04.159Z"},{"id":5352,"surahId":69,"numberInSurah":29,"textArabic":"هَلَكَ عَنِّى سُلْطَـٰنِيَهْ","translationUz":"Mening sultonim ham halok bo`ldi», deydir.","transcription":null,"tafsirUz":null,"pageNumber":567,"juz":29,"createdAt":"2026-09-17T18:46:04.163Z","updatedAt":"2026-09-17T18:46:04.163Z"},{"id":5353,"surahId":69,"numberInSurah":30,"textArabic":"خُذُوهُ فَغُلُّوهُ","translationUz":"Tutinglar uni va kishanlanglar uni!!!","transcription":null,"tafsirUz":null,"pageNumber":567,"juz":29,"createdAt":"2026-09-17T18:46:04.166Z","updatedAt":"2026-09-17T18:46:04.166Z"},{"id":5354,"surahId":69,"numberInSurah":31,"textArabic":"ثُمَّ ٱلْجَحِيمَ صَلُّوهُ","translationUz":"So`ngra jahannamga solinglar uni!!!","transcription":null,"tafsirUz":null,"pageNumber":567,"juz":29,"createdAt":"2026-09-17T18:46:04.170Z","updatedAt":"2026-09-17T18:46:04.170Z"},{"id":5355,"surahId":69,"numberInSurah":32,"textArabic":"ثُمَّ فِى سِلْسِلَةٍ ذَرْعُهَا سَبْعُونَ ذِرَاعًا فَٱسْلُكُوهُ","translationUz":"So`ngra yetmish qulochli zanjirga kiriting uni!!!","transcription":null,"tafsirUz":null,"pageNumber":567,"juz":29,"createdAt":"2026-09-17T18:46:04.173Z","updatedAt":"2026-09-17T18:46:04.173Z"},{"id":5356,"surahId":69,"numberInSurah":33,"textArabic":"إِنَّهُۥ كَانَ لَا يُؤْمِنُ بِٱللَّهِ ٱلْعَظِيمِ","translationUz":"Chunki, u ulug` Allohga iymon keltirmagan edi.","transcription":null,"tafsirUz":null,"pageNumber":567,"juz":29,"createdAt":"2026-09-17T18:46:04.177Z","updatedAt":"2026-09-17T18:46:04.177Z"},{"id":5357,"surahId":69,"numberInSurah":34,"textArabic":"وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ","translationUz":"Va miskinlarga taom berishga qiziqtirmagan edi.","transcription":null,"tafsirUz":null,"pageNumber":567,"juz":29,"createdAt":"2026-09-17T18:46:04.181Z","updatedAt":"2026-09-17T18:46:04.181Z"},{"id":5358,"surahId":69,"numberInSurah":35,"textArabic":"فَلَيْسَ لَهُ ٱلْيَوْمَ هَـٰهُنَا حَمِيمٌ","translationUz":"Bas, bugungi kunda unga bu yerda biron chin do`st yo`q.","transcription":null,"tafsirUz":null,"pageNumber":568,"juz":29,"createdAt":"2026-09-17T18:46:04.185Z","updatedAt":"2026-09-17T18:46:04.185Z"},{"id":5359,"surahId":69,"numberInSurah":36,"textArabic":"وَلَا طَعَامٌ إِلَّا مِنْ غِسْلِينٍ","translationUz":"Va g`isliyndan o`zga taom ham yo`q.","transcription":null,"tafsirUz":null,"pageNumber":568,"juz":29,"createdAt":"2026-09-17T18:46:04.189Z","updatedAt":"2026-09-17T18:46:04.189Z"},{"id":5360,"surahId":69,"numberInSurah":37,"textArabic":"لَّا يَأْكُلُهُۥٓ إِلَّا ٱلْخَـٰطِـُٔونَ","translationUz":"Uni xatokorlardan boshqa hech kim yemas.","transcription":null,"tafsirUz":null,"pageNumber":568,"juz":29,"createdAt":"2026-09-17T18:46:04.193Z","updatedAt":"2026-09-17T18:46:04.193Z"},{"id":5361,"surahId":69,"numberInSurah":38,"textArabic":"فَلَآ أُقْسِمُ بِمَا تُبْصِرُونَ","translationUz":"Sizlar ko`rib turgan narsalar bilan qasam ichurman.","transcription":null,"tafsirUz":null,"pageNumber":568,"juz":29,"createdAt":"2026-09-17T18:46:04.197Z","updatedAt":"2026-09-17T18:46:04.197Z"},{"id":5362,"surahId":69,"numberInSurah":39,"textArabic":"وَمَا لَا تُبْصِرُونَ","translationUz":"Va sizlar ko`rmaydigan narsalar bilan ham.","transcription":null,"tafsirUz":null,"pageNumber":568,"juz":29,"createdAt":"2026-09-17T18:46:04.201Z","updatedAt":"2026-09-17T18:46:04.201Z"},{"id":5363,"surahId":69,"numberInSurah":40,"textArabic":"إِنَّهُۥ لَقَوْلُ رَسُولٍ كَرِيمٍ","translationUz":"Albatta u (Qur'on) karamli Rasulning so`zidir.","transcription":null,"tafsirUz":null,"pageNumber":568,"juz":29,"createdAt":"2026-09-17T18:46:04.205Z","updatedAt":"2026-09-17T18:46:04.205Z"},{"id":5364,"surahId":69,"numberInSurah":41,"textArabic":"وَمَا هُوَ بِقَوْلِ شَاعِرٍ ۚ قَلِيلًا مَّا تُؤْمِنُونَ","translationUz":"Va u shoirning so`zi emas. Sizlar juda oz ishonasizlar.","transcription":null,"tafsirUz":null,"pageNumber":568,"juz":29,"createdAt":"2026-09-17T18:46:04.209Z","updatedAt":"2026-09-17T18:46:04.209Z"},{"id":5365,"surahId":69,"numberInSurah":42,"textArabic":"وَلَا بِقَوْلِ كَاهِنٍ ۚ قَلِيلًا مَّا تَذَكَّرُونَ","translationUz":"Va u folbinning so`zi ham emas. Sizlar juda oz eslaysizlar.","transcription":null,"tafsirUz":null,"pageNumber":568,"juz":29,"createdAt":"2026-09-17T18:46:04.214Z","updatedAt":"2026-09-17T18:46:04.214Z"},{"id":5366,"surahId":69,"numberInSurah":43,"textArabic":"تَنزِيلٌ مِّن رَّبِّ ٱلْعَـٰلَمِينَ","translationUz":"U olamlar Robbisidan tushirilgandir.","transcription":null,"tafsirUz":null,"pageNumber":568,"juz":29,"createdAt":"2026-09-17T18:46:04.217Z","updatedAt":"2026-09-17T18:46:04.217Z"},{"id":5367,"surahId":69,"numberInSurah":44,"textArabic":"وَلَوْ تَقَوَّلَ عَلَيْنَا بَعْضَ ٱلْأَقَاوِيلِ","translationUz":"Va agar u Bizning (nomimizdan) ba'zan yolg`on so`zlarni to`qisa.","transcription":null,"tafsirUz":null,"pageNumber":568,"juz":29,"createdAt":"2026-09-17T18:46:04.221Z","updatedAt":"2026-09-17T18:46:04.221Z"},{"id":5368,"surahId":69,"numberInSurah":45,"textArabic":"لَأَخَذْنَا مِنْهُ بِٱلْيَمِينِ","translationUz":"Albatta, Biz uni qudrat bilan tutamiz.","transcription":null,"tafsirUz":null,"pageNumber":568,"juz":29,"createdAt":"2026-09-17T18:46:04.225Z","updatedAt":"2026-09-17T18:46:04.225Z"},{"id":5369,"surahId":69,"numberInSurah":46,"textArabic":"ثُمَّ لَقَطَعْنَا مِنْهُ ٱلْوَتِينَ","translationUz":"So`ngra, albatta, uning shoh tomirini kesamiz.","transcription":null,"tafsirUz":null,"pageNumber":568,"juz":29,"createdAt":"2026-09-17T18:46:04.229Z","updatedAt":"2026-09-17T18:46:04.229Z"},{"id":5370,"surahId":69,"numberInSurah":47,"textArabic":"فَمَا مِنكُم مِّنْ أَحَدٍ عَنْهُ حَـٰجِزِينَ","translationUz":"Bas, sizlardan hech kim uni to`sib qola olmas.","transcription":null,"tafsirUz":null,"pageNumber":568,"juz":29,"createdAt":"2026-09-17T18:46:04.233Z","updatedAt":"2026-09-17T18:46:04.233Z"},{"id":5371,"surahId":69,"numberInSurah":48,"textArabic":"وَإِنَّهُۥ لَتَذْكِرَةٌ لِّلْمُتَّقِينَ","translationUz":"Va albatta, u (Qur'on) taqvodorlar uchun eslatmadir.","transcription":null,"tafsirUz":null,"pageNumber":568,"juz":29,"createdAt":"2026-09-17T18:46:04.237Z","updatedAt":"2026-09-17T18:46:04.237Z"},{"id":5372,"surahId":69,"numberInSurah":49,"textArabic":"وَإِنَّا لَنَعْلَمُ أَنَّ مِنكُم مُّكَذِّبِينَ","translationUz":"Va albatta, Biz sizlarning ichingizda yolg`onga chiqaruvchilar borligini bilib turamiz.","transcription":null,"tafsirUz":null,"pageNumber":568,"juz":29,"createdAt":"2026-09-17T18:46:04.242Z","updatedAt":"2026-09-17T18:46:04.242Z"},{"id":5373,"surahId":69,"numberInSurah":50,"textArabic":"وَإِنَّهُۥ لَحَسْرَةٌ عَلَى ٱلْكَـٰفِرِينَ","translationUz":"Va albatta, u (Qur'on) kofirlar uchun hasratdir.","transcription":null,"tafsirUz":null,"pageNumber":568,"juz":29,"createdAt":"2026-09-17T18:46:04.247Z","updatedAt":"2026-09-17T18:46:04.247Z"},{"id":5374,"surahId":69,"numberInSurah":51,"textArabic":"وَإِنَّهُۥ لَحَقُّ ٱلْيَقِينِ","translationUz":"Va albatta, u (Qur'on) shubhasiz haqiqatdir.","transcription":null,"tafsirUz":null,"pageNumber":568,"juz":29,"createdAt":"2026-09-17T18:46:04.251Z","updatedAt":"2026-09-17T18:46:04.251Z"},{"id":5375,"surahId":69,"numberInSurah":52,"textArabic":"فَسَبِّحْ بِٱسْمِ رَبِّكَ ٱلْعَظِيمِ","translationUz":"Bas, ulug` Robbingning ismini poklab yod et.","transcription":null,"tafsirUz":null,"pageNumber":568,"juz":29,"createdAt":"2026-09-17T18:46:04.256Z","updatedAt":"2026-09-17T18:46:04.256Z"}],"createdAt":"2026-09-17T18:45:07.740Z","updatedAt":"2026-09-18T00:07:52.609Z"}