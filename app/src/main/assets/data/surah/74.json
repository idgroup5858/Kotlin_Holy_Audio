","updatedAt":"2026-09-17T18:46:06.100Z"},{"id":5510,"surahId":74,"numberInSurah":15,"textArabic":"ثُمَّ يَطْمَعُ أَنْ أَزِيدَ","translationUz":"So`ngra, yana ziyoda qilishimni tama' qilur.","transcription":null,"tafsirUz":null,"pageNumber":575,"juz":29,"createdAt":"2026-09-17T18:46:06.105Z","updatedAt":"2026-09-17T18:46:06.105Z"},{"id":5511,"surahId":74,"numberInSurah":16,"textArabic":"كَلَّآ ۖ إِنَّهُۥ كَانَ لِـَٔايَـٰتِنَا عَنِيدًا","translationUz":"Yo`q! Chunki, u Bizning oyatlarimizga sarkash edi.","transcription":null,"tafsirUz":null,"pageNumber":575,"juz":29,"createdAt":"2026-09-17T18:46:06.109Z","updatedAt":"2026-09-17T18:46:06.109Z"},{"id":5512,"surahId":74,"numberInSurah":17,"textArabic":"سَأُرْهِقُهُۥ صَعُودًا","translationUz":"Tezda uni mashaqqatli chiqish-la horitaman.","transcription":null,"tafsirUz":null,"pageNumber":575,"juz":29,"createdAt":"2026-09-17T18:46:06.114Z","updatedAt":"2026-09-17T18:46:06.114Z"},{"id":5513,"surahId":74,"numberInSurah":18,"textArabic":"إِنَّهُۥ فَكَّرَ وَقَدَّرَ","translationUz":"Albatta, u tafakkur qildi va chamalab ko`rdi.","transcription":null,"tafsirUz":null,"pageNumber":576,"juz":29,"createdAt":"2026-09-17T18:46:06.117Z","updatedAt":"2026-09-17T18:46:06.117Z"},{"id":5514,"surahId":74,"numberInSurah":19,"textArabic":"فَقُتِلَ كَيْفَ قَدَّرَ","translationUz":"La'nat bo`lsin unga, qandoq ham chamaladi!","transcription":null,"tafsirUz":null,"pageNumber":576,"juz":29,"createdAt":"2026-09-17T18:46:06.121Z","updatedAt":"2026-09-17T18:46:06.121Z"},{"id":5515,"surahId":74,"numberInSurah":20,"textArabic":"ثُمَّ قُتِلَ كَيْفَ قَدَّرَ","translationUz":"So`ngra yana la'nat bo`lsin unga, qandoq ham chamaladi.","transcription":null,"tafsirUz":null,"pageNumber":576,"juz":29,"createdAt":"2026-09-17T18:46:06.126Z","updatedAt":"2026-09-17T18:46:06.126Z"},{"id":5516,"surahId":74,"numberInSurah":21,"textArabic":"ثُمَّ نَظَرَ","translationUz":"So`ngra nazar soldi.","transcription":null,"tafsirUz":null,"pageNumber":576,"juz":29,"createdAt":"2026-09-17T18:46:06.129Z","updatedAt":"2026-09-17T18:46:06.129Z"},{"id":5517,"surahId":74,"numberInSurah":22,"textArabic":"ثُمَّ عَبَسَ وَبَسَرَ","translationUz":"So`ngra yuzini burishtirdi va qavog`ini soldi.","transcription":null,"tafsirUz":null,"pageNumber":576,"juz":29,"createdAt":"2026-09-17T18:46:06.133Z","updatedAt":"2026-09-17T18:46:06.133Z"},{"id":5518,"surahId":74,"numberInSurah":23,"textArabic":"ثُمَّ أَدْبَرَ وَٱسْتَكْبَرَ","translationUz":"So`ngra yuz o`girdi va takabburlik qildi.","transcription":null,"tafsirUz":null,"pageNumber":576,"juz":29,"createdAt":"2026-09-17T18:46:06.138Z","updatedAt":"2026-09-17T18:46:06.138Z"},{"id":5519,"surahId":74,"numberInSurah":24,"textArabic":"فَقَالَ إِنْ هَـٰذَآ إِلَّا سِحْرٌ يُؤْثَرُ","translationUz":"Bas, «Bu asar qolgan sehrdan o`zga hech narsa emas.","transcription":null,"tafsirUz":null,"pageNumber":576,"juz":29,"createdAt":"2026-09-17T18:46:06.142Z","updatedAt":"2026-09-17T18:46:06.142Z"},{"id":5520,"surahId":74,"numberInSurah":25,"textArabic":"إِنْ هَـٰذَآ إِلَّا قَوْلُ ٱلْبَشَرِ","translationUz":"Bu bashar so`zidan o`zga hech narsa emas», dedi.","transcription":null,"tafsirUz":null,"pageNumber":576,"juz":29,"createdAt":"2026-09-17T18:46:06.146Z","updatedAt":"2026-09-17T18:46:06.146Z"},{"id":5521,"surahId":74,"numberInSurah":26,"textArabic":"سَأُصْلِيهِ سَقَرَ","translationUz":"Tezda uni saqar(do`zaxi)ga kiriturman.","transcription":null,"tafsirUz":null,"pageNumber":576,"juz":29,"createdAt":"2026-09-17T18:46:06.150Z","updatedAt":"2026-09-17T18:46:06.150Z"},{"id":5522,"surahId":74,"numberInSurah":27,"textArabic":"وَمَآ أَدْرَىٰكَ مَا سَقَرُ","translationUz":"Va saqar nimaligini senga nima bildirdi?","transcription":null,"tafsirUz":null,"pageNumber":576,"juz":29,"createdAt":"2026-09-17T18:46:06.154Z","updatedAt":"2026-09-17T18:46:06.154Z"},{"id":5523,"surahId":74,"numberInSurah":28,"textArabic":"لَا تُبْقِى وَلَا تَذَرُ","translationUz":"U boqiy qoldirmas va tark ham qilmas.","transcription":null,"tafsirUz":null,"pageNumber":576,"juz":29,"createdAt":"2026-09-17T18:46:06.157Z","updatedAt":"2026-09-17T18:46:06.157Z"},{"id":5524,"surahId":74,"numberInSurah":29,"textArabic":"لَوَّاحَةٌ لِّلْبَشَرِ","translationUz":"U terini ko`p kuydiruvchidir.","transcription":null,"tafsirUz":null,"pageNumber":576,"juz":29,"createdAt":"2026-09-17T18:46:06.161Z","updatedAt":"2026-09-17T18:46:06.161Z"},{"id":5525,"surahId":74,"numberInSurah":30,"textArabic":"عَلَيْهَا تِسْعَةَ عَشَرَ","translationUz":"U(saqar)ning ustida o`n to`qqizta (farishta) bor.","transcription":null,"tafsirUz":null,"pageNumber":576,"juz":29,"createdAt":"2026-09-17T18:46:06.165Z","updatedAt":"2026-09-17T18:46:06.165Z"},{"id":5526,"surahId":74,"numberInSurah":31,"textArabic":"وَمَا جَعَلْنَآ أَصْحَـٰبَ ٱلنَّارِ إِلَّا مَلَـٰٓئِكَةً ۙ وَمَا جَعَلْنَا عِدَّتَهُمْ إِلَّا فِتْنَةً لِّلَّذِينَ كَفَرُوا۟ لِيَسْتَيْقِنَ ٱلَّذِينَ أُوتُوا۟ ٱلْكِتَـٰبَ وَيَزْدَادَ ٱلَّذِينَ ءَامَنُوٓا۟ إِيمَـٰنًا ۙ وَلَا يَرْتَابَ ٱلَّذِينَ أُوتُوا۟ ٱلْكِتَـٰبَ وَٱلْمُؤْمِنُونَ ۙ وَلِيَقُولَ ٱلَّذِينَ فِى قُلُوبِهِم مَّرَضٌ وَٱلْكَـٰفِرُونَ مَاذَآ أَرَادَ ٱللَّهُ بِهَـٰذَا مَثَلًا ۚ كَذَٰلِكَ يُضِلُّ ٱللَّهُ مَن يَشَآءُ وَيَهْدِى مَن يَشَآءُ ۚ وَمَا يَعْلَمُ جُنُودَ رَبِّكَ إِلَّا هُوَ ۚ وَمَا هِىَ إِلَّا ذِكْرَىٰ لِلْبَشَرِ","translationUz":"Do`zax sohiblarini farishtalardan qilganimiz va ularning adadi ham faqat kofirlarni sinash uchun. Kitob berilganlar ishonch hosil qilishlari uchun. Va iymonlilarning iymoni ziyoda bo`lishi uchun. Kitob berilganlar va mo`minlar shak-shubha qilmasliklari uchun va qalblarida kasali borlar (munofiqlar) va kofirlar, Alloh bu bilan nima misolni iroda qilmoqchi, deyishlari uchun. Shundoq qilib, Alloh xohlagan kimsani adashtirur va xohlagan kimsani hidoyatga solur. Robbingning askarlarini O`zidan boshqa hech kim bilmas. Va u (do`zax) bashar uchun eslatmadan o`zga hech narsa emas.","transcription":null,"tafsirUz":null,"pageNumber":576,"juz":29,"createdAt":"2026-09-17T18:46:06.169Z","updatedAt":"2026-09-17T18:46:06.169Z"},{"id":5527,"surahId":74,"numberInSurah":32,"textArabic":"كَلَّا وَٱلْقَمَرِ","translationUz":"Yo`q! Oy bilan qasam.","transcription":null,"tafsirUz":null,"pageNumber":576,"juz":29,"createdAt":"2026-09-17T18:46:06.173Z","updatedAt":"2026-09-17T18:46:06.173Z"},{"id":5528,"surahId":74,"numberInSurah":33,"textArabic":"وَٱلَّيْلِ إِذْ أَدْبَرَ","translationUz":"Va chekinayotgan tun bilan qasam.","transcription":null,"tafsirUz":null,"pageNumber":576,"juz":29,"createdAt":"2026-09-17T18:46:06.177Z","updatedAt":"2026-09-17T18:46:06.177Z"},{"id":5529,"surahId":74,"numberInSurah":34,"textArabic":"وَٱلصُّبْحِ إِذَآ أَسْفَرَ","translationUz":"Va yorishayotgan tong bilan qasam.","transcription":null,"tafsirUz":null,"pageNumber":576,"juz":29,"createdAt":"2026-09-17T18:46:06.181Z","updatedAt":"2026-09-17T18:46:06.181Z"},{"id":5530,"surahId":74,"numberInSurah":35,"textArabic":"إِنَّهَا لَإِحْدَى ٱلْكُبَرِ","translationUz":"Albatta, u(do`zax) ulkan(azob)larning biridir.","transcription":null,"tafsirUz":null,"pageNumber":576,"juz":29,"createdAt":"2026-09-17T18:46:06.185Z","updatedAt":"2026-09-17T18:46:06.185Z"},{"id":5531,"surahId":74,"numberInSurah":36,"textArabic":"نَذِيرًا لِّلْبَشَرِ","translationUz":"U bashariyat uchun ogohlantiruvchidir.","transcription":null,"tafsirUz":null,"pageNumber":576,"juz":29,"createdAt":"2026-09-17T18:46:06.189Z","updatedAt":"2026-09-17T18:46:06.189Z"},{"id":5532,"surahId":74,"numberInSurah":37,"textArabic":"لِمَن شَآءَ مِنكُمْ أَن يَتَقَدَّمَ أَوْ يَتَأَخَّرَ","translationUz":"Sizlardan peshqadam bo`lishni yoki ortda qolishni xohlayotgan kimsalar uchundir.","transcription":null,"tafsirUz":null,"pageNumber":576,"juz":29,"createdAt":"2026-09-17T18:46:06.193Z","updatedAt":"2026-09-17T18:46:06.193Z"},{"id":5533,"surahId":74,"numberInSurah":38,"textArabic":"كُلُّ نَفْسٍۭ بِمَا كَسَبَتْ رَهِينَةٌ","translationUz":"Har bir shaxs o`z kasbining garovidir.","transcription":null,"tafsirUz":null,"pageNumber":576,"juz":29,"createdAt":"2026-09-17T18:46:06.198Z","updatedAt":"2026-09-17T18:46:06.198Z"},{"id":5534,"surahId":74,"numberInSurah":39,"textArabic":"إِلَّآ أَصْحَـٰبَ ٱلْيَمِينِ","translationUz":"(Bundan) o`ng taraf sohiblari mustasnodir.","transcription":null,"tafsirUz":null,"pageNumber":576,"juz":29,"createdAt":"2026-09-17T18:46:06.202Z","updatedAt":"2026-09-17T18:46:06.202Z"},{"id":5535,"surahId":74,"numberInSurah":40,"textArabic":"فِى جَنَّـٰتٍ يَتَسَآءَلُونَ","translationUz":"Ular jannatlarda, so`raydirlar.","transcription":null,"tafsirUz":null,"pageNumber":576,"juz":29,"createdAt":"2026-09-17T18:46:06.206Z","updatedAt":"2026-09-17T18:46:06.206Z"},{"id":5536,"surahId":74,"numberInSurah":41,"textArabic":"عَنِ ٱلْمُجْرِمِينَ","translationUz":"Gunohkorlardan.","transcription":null,"tafsirUz":null,"pageNumber":576,"juz":29,"createdAt":"2026-09-17T18:46:06.210Z","updatedAt":"2026-09-17T18:46:06.210Z"},{"id":5537,"surahId":74,"numberInSurah":42,"textArabic":"مَا سَلَكَكُمْ فِى سَقَرَ","translationUz":"«Sizlarni do`zaxga nima kiritdi?» (deb)","transcription":null,"tafsirUz":null,"pageNumber":576,"juz":29,"createdAt":"2026-09-17T18:46:06.214Z","updatedAt":"2026-09-17T18:46:06.214Z"},{"id":5538,"surahId":74,"numberInSurah":43,"textArabic":"قَالُوا۟ لَمْ نَكُ مِنَ ٱلْمُصَلِّينَ","translationUz":"Alar: «Namoz o`qiydiganlardan bo`lmagan edik.","transcription":null,"tafsirUz":null,"pageNumber":576,"juz":29,"createdAt":"2026-09-17T18:46:06.218Z","updatedAt":"2026-09-17T18:46:06.218Z"},{"id":5539,"surahId":74,"numberInSurah":44,"textArabic":"وَلَمْ نَكُ نُطْعِمُ ٱلْمِسْكِينَ","translationUz":"Va miskinlarga taom bermagan edik.","transcription":null,"tafsirUz":null,"pageNumber":576,"juz":29,"createdAt":"2026-09-17T18:46:06.223Z","updatedAt":"2026-09-17T18:46:06.223Z"},{"id":5540,"surahId":74,"numberInSurah":45,"textArabic":"وَكُنَّا نَخُوضُ مَعَ ٱلْخَآئِضِينَ","translationUz":"Va botilga sho`ng`uvchilar bilan birga sho`ng`ir edik.","transcription":null,"tafsirUz":null,"pageNumber":576,"juz":29,"createdAt":"2026-09-17T18:46:06.226Z","updatedAt":"2026-09-17T18:46:06.226Z"},{"id":5541,"surahId":74,"numberInSurah":46,"textArabic":"وَكُنَّا نُكَذِّبُ بِيَوْمِ ٱلدِّينِ","translationUz":"Va qiyomat kunini yolg`onga chiqarar edik.","transcription":null,"tafsirUz":null,"pageNumber":576,"juz":29,"createdAt":"2026-09-17T18:46:06.230Z","updatedAt":"2026-09-17T18:46:06.230Z"},{"id":5542,"surahId":74,"numberInSurah":47,"textArabic":"حَتَّىٰٓ أَتَىٰنَا ٱلْيَقِينُ","translationUz":"Toki bizga o`lim kelgunicha», derlar.","transcription":null,"tafsirUz":null,"pageNumber":576,"juz":29,"createdAt":"2026-09-17T18:46:06.235Z","updatedAt":"2026-09-17T18:46:06.235Z"},{"id":5543,"surahId":74,"numberInSurah":48,"textArabic":"فَمَا تَنفَعُهُمْ شَفَـٰعَةُ ٱلشَّـٰفِعِينَ","translationUz":"Bas, ularga shafoatchilarning shafoati manfaat bermaydir.","transcription":null,"tafsirUz":null,"pageNumber":577,"juz":29,"createdAt":"2026-09-17T18:46:06.239Z","updatedAt":"2026-09-17T18:46:06.239Z"},{"id":5544,"surahId":74,"numberInSurah":49,"textArabic":"فَمَا لَهُمْ عَنِ ٱلتَّذْكِرَةِ مُعْرِضِينَ","translationUz":"Ularga nima bo`ldiki, eslatmadan yuz o`girarlar.","transcription":null,"tafsirUz":null,"pageNumber":577,"juz":29,"createdAt":"2026-09-17T18:46:06.242Z","updatedAt":"2026-09-17T18:46:06.242Z"},{"id":5545,"surahId":74,"numberInSurah":50,"textArabic":"كَأَنَّهُمْ حُمُرٌ مُّسْتَنفِرَةٌ","translationUz":"Xuddi qattiq qo`rqqan eshaklar.","transcription":null,"tafsirUz":null,"pageNumber":577,"juz":29,"createdAt":"2026-09-17T18:46:06.245Z","updatedAt":"2026-09-17T18:46:06.245Z"},{"id":5546,"surahId":74,"numberInSurah":51,"textArabic":"فَرَّتْ مِن قَسْوَرَةٍۭ","translationUz":"Arslondan qochgani kabi.","transcription":null,"tafsirUz":null,"pageNumber":577,"juz":29,"createdAt":"2026-09-17T18:46:06.249Z","updatedAt":"2026-09-17T18:46:06.249Z"},{"id":5547,"surahId":74,"numberInSurah":52,"textArabic":"بَلْ يُرِيدُ كُلُّ ٱمْرِئٍ مِّنْهُمْ أَن يُؤْتَىٰ صُحُفًا مُّنَشَّرَةً","translationUz":"Balki ulardan har biri o`ziga nashr qilingan sahifalar berilishini iroda qilar.","transcription":null,"tafsirUz":null,"pageNumber":577,"juz":29,"createdAt":"2026-09-17T18:46:06.254Z","updatedAt":"2026-09-17T18:46:06.254Z"},{"id":5548,"surahId":74,"numberInSurah":53,"textArabic":"كَلَّا ۖ بَل لَّا يَخَافُونَ ٱلْـَٔاخِرَةَ","translationUz":"Yo`q! Balki ular oxiratdan qo`rqmaslar.","transcription":null,"tafsirUz":null,"pageNumber":577,"juz":29,"createdAt":"2026-09-17T18:46:06.257Z","updatedAt":"2026-09-17T18:46:06.257Z"},{"id":5549,"surahId":74,"numberInSurah":54,"textArabic":"كَلَّآ إِنَّهُۥ تَذْكِرَةٌ","translationUz":"Yo`q! Albatta, u(Qur'on) eslatmadur.","transcription":null,"tafsirUz":null,"pageNumber":577,"juz":29,"createdAt":"2026-09-17T18:46:06.262Z","updatedAt":"2026-09-17T18:46:06.262Z"},{"id":5550,"surahId":74,"numberInSurah":55,"textArabic":"فَمَن شَآءَ ذَكَرَهُۥ","translationUz":"Bas, kim xohlasa, uni eslaydir.","transcription":null,"tafsirUz":null,"pageNumber":577,"juz":29,"createdAt":"2026-09-17T18:46:06.266Z","updatedAt":"2026-09-17T18:46:06.266Z"},{"id":5551,"surahId":74,"numberInSurah":56,"textArabic":"وَمَا يَذْكُرُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ ۚ هُوَ أَهْلُ ٱلتَّقْوَىٰ وَأَهْلُ ٱلْمَغْفِرَةِ","translationUz":"Va faqat Alloh xohlasagina, eslarlar. U zot taqvo ahlidir va mag`firat ahlidir.","transcription":null,"tafsirUz":null,"pageNumber":577,"juz":29,"createdAt":"2026-09-17T18:46:06.270Z","updatedAt":"2026-09-17T18:46:06.270Z"}],"createdAt":"2026-09-17T18:45:07.764Z","updatedAt":"2026-09-18T00:07:52.626Z"}