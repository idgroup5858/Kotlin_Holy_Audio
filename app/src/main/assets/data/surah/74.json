{"id":74,"number":74,"nameArabic":"المدثر","nameUz":"Muddassir","meaningUz":"Kiyinib olgan","revelationPlace":"makka","totalAyahs":56,"startPage":575,"ayahs":[{"id":5496,"surahId":74,"numberInSurah":1,"textArabic":" يَـٰٓأَيُّهَا ٱلْمُدَّثِّرُ","translationUz":"Ey, burkanib yotgan!","transcription":null,"tafsirUz":null,"pageNumber":575,"juz":29,"createdAt":"2026-09-17T18:46:06.047Z","updatedAt":"2026-09-17T18:46:06.047Z"},{"id":5497,"surahId":74,"numberInSurah":2,"textArabic":"قُمْ فَأَنذِرْ","translationUz":"Tur va ogohlantir!","transcription":null,"tafsirUz":null,"pageNumber":575,"juz":29,"createdAt":"2026-09-17T18:46:06.053Z","updatedAt":"2026-09-17T18:46:06.053Z"},{"id":5498,"surahId":74,"numberInSurah":3,"textArabic":"وَرَبَّكَ فَكَبِّرْ","translationUz":"Va Robbingni ulug`la!","transcription":null,"tafsirUz":null,"pageNumber":575,"juz":29,"createdAt":"2026-09-17T18:46:06.057Z","updatedAt":"2026-09-17T18:46:06.057Z"},{"id":5499,"surahId":74,"numberInSurah":4,"textArabic":"وَثِيَابَكَ فَطَهِّرْ","translationUz":"Va kiyimingni pokla!","transcription":null,"tafsirUz":null,"pageNumber":575,"juz":29,"createdAt":"2026-09-17T18:46:06.061Z","updatedAt":"2026-09-17T18:46:06.061Z"},{"id":5500,"surahId":74,"numberInSurah":5,"textArabic":"وَٱلرُّجْزَ فَٱهْجُرْ","translationUz":"Va azob(sababchisi)dan chetlan!","transcription":null,"tafsirUz":null,"pageNumber":575,"juz":29,"createdAt":"2026-09-17T18:46:06.065Z","updatedAt":"2026-09-17T18:46:06.065Z"},{"id":5501,"surahId":74,"numberInSurah":6,"textArabic":"وَلَا تَمْنُن تَسْتَكْثِرُ","translationUz":"Va ko`p (ish) qilgan bo`lsang ham, minnat qilma.","transcription":null,"tafsirUz":null,"pageNumber":575,"juz":29,"createdAt":"2026-09-17T18:46:06.069Z","updatedAt":"2026-09-17T18:46:06.069Z"},{"id":5502,"surahId":74,"numberInSurah":7,"textArabic":"وَلِرَبِّكَ فَٱصْبِرْ","translationUz":"Va Robbing uchun sabr qil.","transcription":null,"tafsirUz":null,"pageNumber":575,"juz":29,"createdAt":"2026-09-17T18:46:06.073Z","updatedAt":"2