{"id":86,"number":86,"nameArabic":"الطارق","nameUz":"Toriq","meaningUz":"Tunda keluvchi yulduz","revelationPlace":"makka","totalAyahs":17,"startPage":591,"ayahs":[{"id":5932,"surahId":86,"numberInSurah":1,"textArabic":" وَٱلسَّمَآءِ وَٱلطَّارِقِ","translationUz":"Osmon bilan qasam va toriq bilan qasam.","transcription":null,"tafsirUz":null,"pageNumber":591,"juz":30,"createdAt":"2026-09-17T18:46:11.148Z","updatedAt":"2026-09-17T18:46:11.148Z"},{"id":5933,"surahId":86,"numberInSurah":2,"textArabic":"وَمَآ أَدْرَىٰكَ مَا ٱلطَّارِقُ","translationUz":"Toriq nimaligini senga ne bildirdi?","transcription":null,"tafsirUz":null,"pageNumber":591,"juz":30,"createdAt":"2026-09-17T18:46:11.154Z","updatedAt":"2026-09-17T18:46:11.154Z"},{"id":5934,"surahId":86,"numberInSurah":3,"textArabic":"ٱلنَّجْمُ ٱلثَّاقِبُ","translationUz":"U, nur sochib turuvchi yulduzdir.","transcription":null,"tafsirUz":null,"pageNumber":591,"juz":30,"createdAt":"2026-09-17T18:46:11.158Z","updatedAt":"2026-09-17T18:46:11.158Z"},{"id":5935,"surahId":86,"numberInSurah":4,"textArabic":"إِن كُلُّ نَفْسٍ لَّمَّا عَلَيْهَا حَافِظٌ","translationUz":"Hech bir jon yo`qki, uning hifz qilib turuvchisi bo`lmasa.","transcription":null,"tafsirUz":null,"pageNumber":591,"juz":30,"createdAt":"2026-09-17T18:46:11.162Z","updatedAt":"2026-09-17T18:46:11.162Z"},{"id":5936,"surahId":86,"numberInSurah":5,"textArabic":"فَلْيَنظُرِ ٱلْإِنسَـٰنُ مِمَّ خُلِقَ","translationUz":"Inson nimadan yaralganiga nazar solsin.","transcription":null,"tafsirUz":null,"pageNumber":591,"juz":30,"createdAt":"2026-09-17T18:46:11.167Z","updatedAt":"2026-09-17T18:46:11.167Z"},{"id":5937,"surahId":86,"numberInSurah":6,"textArabic":"خُلِقَ مِن مَّآءٍ دَافِقٍ","translationUz":"U otilib chiquvchi suvdan yaralgandir.","transcription":null,"tafsirUz":null,"pageNumber":591,"juz":30,"createdAt":"2026-09-17T18:46:11.171Z","updatedAt":"2026-09-17T18:46:11.171Z"},{"id":5938,"surahId":86,"numberInSurah":7,"textArabic":"يَخْرُجُ مِنۢ بَيْنِ ٱلصُّلْبِ وَٱلتَّرَآئِبِ","translationUz":"U (suv) sulb (orqa umurtqa) va taroib (ko`krak suyagi) orasidan chiqadir.","transcription":null,"tafsirUz":null,"pageNumber":591,"juz":30,"createdAt":"2026-09-17T18:46:11.175Z","updatedAt":"2026-09-17T18:46:11.175Z"},{"id":5939,"surahId":86,"numberInSurah":8,"textArabic":"إِنَّهُۥ عَلَىٰ رَجْعِهِۦ لَقَادِرٌ","translationUz":"Albatta, U zot uni qayta tiriltirishga qodirdir.","transcription":null,"tafsirUz":null,"pageNumber":591,"juz":30,"createdAt":"2026-09-17T18:46:11.179Z","updatedAt":"2026-09-17T18:46:11.179Z"},{"id":5940,"surahId":86,"numberInSurah":9,"textArabic":"يَوْمَ تُبْلَى ٱلسَّرَآئِرُ","translationUz":"Sirlar fosh bo`ladigan kundadir.","transcription":null,"tafsirUz":null,"pageNumber":591,"juz":30,"createdAt":"2026-09-17T18:46:11.183Z","updatedAt":"2026-09-17T18:46:11.183Z"},{"id":5941,"surahId":86,"numberInSurah":10,"textArabic":"فَمَا لَهُۥ مِن قُوَّةٍ وَلَا نَاصِرٍ","translationUz":"Bas (o`shanda) u(inson)da quvvat ham, nusrat beruvchi ham bo`lmaydir.","transcription":null,"tafsirUz":null,"pageNumber":591,"juz":30,"createdAt":"2026-09-17T18:46:11.188Z","updatedAt":"2026-09-17T18:46:11.188Z"},{"id":5942,"surahId":86,"numberInSurah":11,"textArabic":"وَٱلسَّمَآءِ ذَاتِ ٱلرَّجْعِ","translationUz":"Qaytuvchi sohibi bo`lgan osmon bilan qasam.","transcription":null,"tafsirUz":null,"pageNumber":591,"juz":30,"createdAt":"2026-09-17T18:46:11.191Z","updatedAt":"2026-09-17T18:46:11.191Z"},{"id":5943,"surahId":86,"numberInSurah":12,"textArabic":"وَٱلْأَرْضِ ذَاتِ ٱلصَّدْعِ","translationUz":"Yorib chiquvchi egasi bo`lgan yer bilan qasam.","transcription":null,"tafsirUz":null,"pageNumber":591,"juz":30,"createdAt":"2026-09-17T18:46:11.196Z","updatedAt":"2026-09-17T18:46:11.196Z"},{"id":5944,"surahId":86,"numberInSurah":13,"textArabic":"إِنَّهُۥ لَقَوْلٌ فَصْلٌ","translationUz":"Albatta, u (Qur'on) ajratuvchi so`zdir.","transcription":null,"tafsirUz":null,"pageNumber":591,"juz":30,"createdAt":"2026-09-17T18:46:11.200Z","updatedAt":"2026-09-17T18:46:11.200Z"},{"id":5945,"surahId":86,"numberInSurah":14,"textArabic":"وَمَا هُوَ بِٱلْهَزْلِ","translationUz":"Va u hazil emasdir.","transcription":null,"tafsirUz":null,"pageNumber":591,"juz":30,"createdAt":"2026-09-17T18:46:11.204Z","updatedAt":"2026-09-17T18:46:11.204Z"},{"id":5946,"surahId":86,"numberInSurah":15,"textArabic":"إِنَّهُمْ يَكِيدُونَ كَيْدًا","translationUz":"Albatta, ular hiyla qiladir.","transcription":null,"tafsirUz":null,"pageNumber":591,"juz":30,"createdAt":"2026-09-17T18:46:11.207Z","updatedAt":"2026-09-17T18:46:11.207Z"},{"id":5947,"surahId":86,"numberInSurah":16,"textArabic":"وَأَكِيدُ كَيْدًا","translationUz":"Va Men ham «hiyla» qilurman.","transcription":null,"tafsirUz":null,"pageNumber":591,"juz":30,"createdAt":"2026-09-17T18:46:11.211Z","updatedAt":"2026-09-17T18:46:11.211Z"},{"id":5948,"surahId":86,"numberInSurah":17,"textArabic":"فَمَهِّلِ ٱلْكَـٰفِرِينَ أَمْهِلْهُمْ رُوَيْدًۢا","translationUz":"Bas, kofirlarga muhlat ber. Ha, ularga ozgina muhlat ber.","transcription":null,"tafsirUz":null,"pageNumber":591,"juz":30,"createdAt":"2026-09-17T18:46:11.216Z","updatedAt":"2026-09-17T18:46:11.216Z"}],"createdAt":"2026-09-17T18:45:07.818Z","updatedAt":"2026-09-18T00:07:52.668Z"}