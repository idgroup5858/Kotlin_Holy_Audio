{"id":81,"number":81,"nameArabic":"التكوير","nameUz":"Takvir","meaningUz":"Oʻralish","revelationPlace":"makka","totalAyahs":29,"startPage":586,"ayahs":[{"id":5801,"surahId":81,"numberInSurah":1,"textArabic":" إِذَا ٱلشَّمْسُ كُوِّرَتْ","translationUz":"Vaqtiki, quyoshni buklab, o`ralsa.","transcription":null,"tafsirUz":null,"pageNumber":586,"juz":30,"createdAt":"2026-09-17T18:46:08.855Z","updatedAt":"2026-09-17T18:46:08.855Z"},{"id":5802,"surahId":81,"numberInSurah":2,"textArabic":"وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتْ","translationUz":"Va vaqtiki yulduzlar uzilib tushib, sochilib ketsa.","transcription":null,"tafsirUz":null,"pageNumber":586,"juz":30,"createdAt":"2026-09-17T18:46:08.860Z","updatedAt":"2026-09-17T18:46:08.860Z"},{"id":5803,"surahId":81,"numberInSurah":3,"textArabic":"وَإِذَا ٱلْجِبَالُ سُيِّرَتْ","translationUz":"Va vaqtiki, tog`lar joyidan ko`chirilsa.","transcription":null,"tafsirUz":null,"pageNumber":586,"juz":30,"createdAt":"2026-09-17T18:46:08.865Z","updatedAt":"2026-09-17T18:46:08.865Z"},{"id":5804,"surahId":81,"numberInSurah":4,"textArabic":"وَإِذَا ٱلْعِشَارُ عُطِّلَتْ","translationUz":"Va vaqtiki, homilasiga o`n oy to`lgan tuyalar qarovsiz qolsa.","transcription":null,"tafsirUz":null,"pageNumber":586,"juz":30,"createdAt":"2026-09-17T18:46:08.869Z","updatedAt":"2026-09-17T18:46:08.869Z"},{"id":5805,"surahId":81,"numberInSurah":5,"textArabic":"وَإِذَا ٱلْوُحُوشُ حُشِرَتْ","translationUz":"Va vaqtiki, vahshiy hayvonlar bir joyga to`plansa.","transcription":null,"tafsirUz":null,"pageNumber":586,"juz":30,"createdAt":"2026-09-17T18:46:08.873Z","updatedAt":"2026-09-17T18:46:08.873Z"},{"id":5806,"surahId":81,"numberInSurah":6,"textArabic":"وَإِذَا ٱلْبِحَارُ سُجِّرَتْ","translationUz":"Va vaqtiki, dengizlar alanga olib yonsa.","transcription":null,"tafsirUz":null,"pageNumber":586,"juz":30,"createdAt":"2026-09-17T18:46:08.878Z","updatedAt":"2026-09-17T18:46:08.878Z"},{"id":5807,"surahId":81,"numberInSurah":7,"textArabic":"وَإِذَا ٱلنُّفُوسُ زُوِّجَتْ","translationUz":"Va vaqtiki, nafslar juftlashtirilsa.","transcription":null,"tafsirUz":null,"pageNumber":586,"juz":30,"createdAt":"2026-09-17T18:46:08.887Z","updatedAt":"2026-09-17T18:46:08.887Z"},{"id":5808,"surahId":81,"numberInSurah":8,"textArabic":"وَإِذَا ٱلْمَوْءُۥدَةُ سُئِلَتْ","translationUz":"Va vaqtiki, tiriklay ko`milgan qizdan so`ralsa.","transcription":null,"tafsirUz":null,"pageNumber":586,"juz":30,"createdAt":"2026-09-17T18:46:08.892Z","updatedAt":"2026-09-17T18:46:08.892Z"},{"id":5809,"surahId":81,"numberInSurah":9,"textArabic":"بِأَىِّ ذَنۢبٍ قُتِلَتْ","translationUz":"U nima gunoh uchun o`ldirilgan?","transcription":null,"tafsirUz":null,"pageNumber":586,"juz":30,"createdAt":"2026-09-17T18:46:08.896Z","updatedAt":"2026-09-17T18:46:08.896Z"},{"id":5810,"surahId":81,"numberInSurah":10,"textArabic":"وَإِذَا ٱلصُّحُفُ نُشِرَتْ","translationUz":"Va vaqtiki, sahifalar nashr qilinsa.","transcription":null,"tafsirUz":null,"pageNumber":586,"juz":30,"createdAt":"2026-09-17T18:46:08.899Z","updatedAt":"2026-09-17T18:46:08.899Z"},{"id":5811,"surahId":81,"numberInSurah":11,"textArabic":"وَإِذَا ٱلسَّمَآءُ كُشِطَتْ","translationUz":"Va vaqtiki, osmon qo`porilsa.","transcription":null,"tafsirUz":null,"pageNumber":586,"juz":30,"createdAt":"2026-09-17T18:46:08.903Z","updatedAt":"2026-09-17T18:46:08.903Z"},{"id":5812,"surahId":81,"numberInSurah":12,"textArabic":"وَإِذَا ٱلْجَحِيمُ سُعِّرَتْ","translationUz":"Va vaqtiki, jahannam qizdirilsa.","transcription":null,"tafsirUz":null,"pageNumber":586,"juz":30,"createdAt":"2026-09-17T18:46:08.908Z","updatedAt":"2026-09-17T18:46:08.908Z"},{"id":5813,"surahId":81,"numberInSurah":13,"textArabic":"وَإِذَا ٱلْجَنَّةُ أُزْلِفَتْ","translationUz":"Va vaqtiki, jannat yaqinlashtirilsa.","transcription":null,"tafsirUz":null,"pageNumber":586,"juz":30,"createdAt":"2026-09-17T18:46:08.913Z","updatedAt":"2026-09-17T18:46:08.913Z"},{"id":5814,"surahId":81,"numberInSurah":14,"textArabic":"عَلِمَتْ نَفْسٌ مَّآ أَحْضَرَتْ","translationUz":"Har bir jon nima hozirlaganini biladir.","transcription":null,"tafsirUz":null,"pageNumber":586,"juz":30,"createdAt":"2026-09-17T18:46:08.918Z","updatedAt":"2026-09-17T18:46:08.918Z"},{"id":5815,"surahId":81,"numberInSurah":15,"textArabic":"فَلَآ أُقْسِمُ بِٱلْخُنَّسِ","translationUz":"(Kunduzi) maxfiy bo`luvchi(yulduz)lar bilan qasam.","transcription":null,"tafsirUz":null,"pageNumber":586,"juz":30,"createdAt":"2026-09-17T18:46:08.924Z","updatedAt":"2026-09-17T18:46:08.924Z"},{"id":5816,"surahId":81,"numberInSurah":16,"textArabic":"ٱلْجَوَارِ ٱلْكُنَّسِ","translationUz":"(Kechalari) yuruvchi, berkinuvchi(yulduz)lar bilan qasam.","transcription":null,"tafsirUz":null,"pageNumber":586,"juz":30,"createdAt":"2026-09-17T18:46:08.928Z","updatedAt":"2026-09-17T18:46:08.928Z"},{"id":5817,"surahId":81,"numberInSurah":17,"textArabic":"وَٱلَّيْلِ إِذَا عَسْعَسَ","translationUz":"Qorong`uligi ila kirib kelgan kecha bilan qasam.","transcription":null,"tafsirUz":null,"pageNumber":586,"juz":30,"createdAt":"2026-09-17T18:46:08.932Z","updatedAt":"2026-09-17T18:46:08.932Z"},{"id":5818,"surahId":81,"numberInSurah":18,"textArabic":"وَٱلصُّبْحِ إِذَا تَنَفَّسَ","translationUz":"Nafas olib kirib kelgan tong bilan qasam.","transcription":null,"tafsirUz":null,"pageNumber":586,"juz":30,"createdAt":"2026-09-17T18:46:08.935Z","updatedAt":"2026-09-17T18:46:08.935Z"},{"id":5819,"surahId":81,"numberInSurah":19,"textArabic":"إِنَّهُۥ لَقَوْلُ رَسُولٍ كَرِيمٍ","translationUz":"Albatta u(Qur'on) karamli elchining so`zidir.","transcription":null,"tafsirUz":null,"pageNumber":586,"juz":30,"createdAt":"2026-09-17T18:46:08.939Z","updatedAt":"2026-09-17T18:46:08.939Z"},{"id":5820,"surahId":81,"numberInSurah":20,"textArabic":"ذِى قُوَّةٍ عِندَ ذِى ٱلْعَرْشِ مَكِينٍ","translationUz":"U quvvatli, arsh Egasi huzurida martabasi oliydir.","transcription":null,"tafsirUz":null,"pageNumber":586,"juz":30,"createdAt":"2026-09-17T18:46:08.943Z","updatedAt":"2026-09-17T18:46:08.943Z"},{"id":5821,"surahId":81,"numberInSurah":21,"textArabic":"مُّطَاعٍ ثَمَّ أَمِينٍ","translationUz":"Itoat qilingan, omonatlidir.","transcription":null,"tafsirUz":null,"pageNumber":586,"juz":30,"createdAt":"2026-09-17T18:46:08.946Z","updatedAt":"2026-09-17T18:46:08.946Z"},{"id":5822,"surahId":81,"numberInSurah":22,"textArabic":"وَمَا صَاحِبُكُم بِمَجْنُونٍ","translationUz":"Sizning sohibingiz majnun emasdir.","transcription":null,"tafsirUz":null,"pageNumber":586,"juz":30,"createdAt":"2026-09-17T18:46:08.949Z","updatedAt":"2026-09-17T18:46:08.949Z"},{"id":5823,"surahId":81,"numberInSurah":23,"textArabic":"وَلَقَدْ رَءَاهُ بِٱلْأُفُقِ ٱلْمُبِينِ","translationUz":"Batahqiq, ul ani ochiq-oydin ufqda ko`rdi.","transcription":null,"tafsirUz":null,"pageNumber":586,"juz":30,"createdAt":"2026-09-17T18:46:08.952Z","updatedAt":"2026-09-17T18:46:08.952Z"},{"id":5824,"surahId":81,"numberInSurah":24,"textArabic":"وَمَا هُوَ عَلَى ٱلْغَيْبِ بِضَنِينٍ","translationUz":"Va u g`aybga baxil emasdir.","transcription":null,"tafsirUz":null,"pageNumber":586,"juz":30,"createdAt":"2026-09-17T18:46:08.956Z","updatedAt":"2026-09-17T18:46:08.956Z"},{"id":5825,"surahId":81,"numberInSurah":25,"textArabic":"وَمَا هُوَ بِقَوْلِ شَيْطَـٰنٍ رَّجِيمٍ","translationUz":"Va u(Qur'on) toshbo`ron qilingan shaytonning so`zi emasdir.","transcription":null,"tafsirUz":null,"pageNumber":586,"juz":30,"createdAt":"2026-09-17T18:46:08.960Z","updatedAt":"2026-09-17T18:46:08.960Z"},{"id":5826,"surahId":81,"numberInSurah":26,"textArabic":"فَأَيْنَ تَذْهَبُونَ","translationUz":"Bas, qayoqqa ketmoqdasiz?!","transcription":null,"tafsirUz":null,"pageNumber":586,"juz":30,"createdAt":"2026-09-17T18:46:08.964Z","updatedAt":"2026-09-17T18:46:08.964Z"},{"id":5827,"surahId":81,"numberInSurah":27,"textArabic":"إِنْ هُوَ إِلَّا ذِكْرٌ لِّلْعَـٰلَمِينَ","translationUz":"U (Qur'on) olamlarga eslatmadan boshqa narsa emasdir.","transcription":null,"tafsirUz":null,"pageNumber":586,"juz":30,"createdAt":"2026-09-17T18:46:08.967Z","updatedAt":"2026-09-17T18:46:08.967Z"},{"id":5828,"surahId":81,"numberInSurah":28,"textArabic":"لِمَن شَآءَ مِنكُمْ أَن يَسْتَقِيمَ","translationUz":"Sizlardan istiqomat(to`g`ri yo`l)da bo`lishni xohlovchilar uchundir.","transcription":null,"tafsirUz":null,"pageNumber":586,"juz":30,"createdAt":"2026-09-17T18:46:08.971Z","updatedAt":"2026-09-17T18:46:08.971Z"},{"id":5829,"surahId":81,"numberInSurah":29,"textArabic":"وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ رَبُّ ٱلْعَـٰلَمِينَ","translationUz":"Olamlarning Robbi Alloh xohlamasa, sizlar xohlay olmassizlar.","transcription":null,"tafsirUz":null,"pageNumber":586,"juz":30,"createdAt":"2026-09-17T18:46:08.976Z","updatedAt":"2026-09-17T18:46:08.976Z"}],"createdAt":"2026-09-17T18:45:07.796Z","updatedAt":"2026-09-18T00:07:52.649Z"}