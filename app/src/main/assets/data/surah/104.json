{"id":104,"number":104,"nameArabic":"الهمزة","nameUz":"Humaza","meaningUz":"Gʻiybatchi","revelationPlace":"makka","totalAyahs":9,"startPage":601,"ayahs":[{"id":6180,"surahId":104,"numberInSurah":1,"textArabic":" وَيْلٌ لِّكُلِّ هُمَزَةٍ لُّمَزَةٍ","translationUz":"Har bir obro` to`kuvchi va ayblovchiga «vayl» bo`lsin.","transcription":null,"tafsirUz":null,"pageNumber":601,"juz":30,"createdAt":"2026-09-17T18:46:16.383Z","updatedAt":"2026-09-17T18:46:16.383Z"},{"id":6181,"surahId":104,"numberInSurah":2,"textArabic":"ٱلَّذِى جَمَعَ مَالًا وَعَدَّدَهُۥ","translationUz":"U mol jamladi va uni sanab turur.","transcription":null,"tafsirUz":null,"pageNumber":601,"juz":30,"createdAt":"2026-09-17T18:46:16.392Z","updatedAt":"2026-09-17T18:46:16.392Z"},{"id":6182,"surahId":104,"numberInSurah":3,"textArabic":"يَحْسَبُ أَنَّ مَالَهُۥٓ أَخْلَدَهُۥ","translationUz":"U, albatta, moli uni abadiy qoldirur deb hisob qilur.","transcription":null,"tafsirUz":null,"pageNumber":601,"juz":30,"createdAt":"2026-09-17T18:46:16.399Z","updatedAt":"2026-09-17T18:46:16.399Z"},{"id":6183,"surahId":104,"numberInSurah":4,"textArabic":"كَلَّا ۖ لَيُنۢبَذَنَّ فِى ٱلْحُطَمَةِ","translationUz":"Yo`q! Albatta, u «hutoma»ga xor-zor etib tashlanur.","transcription":null,"tafsirUz":null,"pageNumber":601,"juz":30,"createdAt":"2026-09-17T18:46:16.405Z","updatedAt":"2026-09-17T18:46:16.405Z"},{"id":6184,"surahId":104,"numberInSurah":5,"textArabic":"وَمَآ أَدْرَىٰكَ مَا ٱلْحُطَمَةُ","translationUz":"«Hutoma» qandoq narsa ekanini senga nima bildirur?","transcription":null,"tafsirUz":null,"pageNumber":601,"juz":30,"createdAt":"2026-09-17T18:46:16.410Z","updatedAt":"2026-09-17T18:46:16.410Z"},{"id":6185,"surahId":104,"numberInSurah":6,"textArabic":"نَارُ ٱللَّهِ ٱلْمُوقَدَةُ","translationUz":"U, Allohning shiddatli, o`chmas olovidir.","transcription":null,"tafsirUz":null,"pageNumber":601,"juz":30,"createdAt":"2026-09-17T18:46:16.414Z","updatedAt":"2026-09-17T18:46:16.414Z"},{"id":6186,"surahId":104,"numberInSurah":7,"textArabic":"ٱلَّتِى تَطَّلِعُ عَلَى ٱلْأَفْـِٔدَةِ","translationUz":"Qalblargacha yetib boradigandur.","transcription":null,"tafsirUz":null,"pageNumber":601,"juz":30,"createdAt":"2026-09-17T18:46:16.417Z","updatedAt":"2026-09-17T18:46:16.417Z"},{"id":6187,"surahId":104,"numberInSurah":8,"textArabic":"إِنَّهَا عَلَيْهِم مُّؤْصَدَةٌ","translationUz":"Albatta, u ularning ustidan qoplangandir.","transcription":null,"tafsirUz":null,"pageNumber":601,"juz":30,"createdAt":"2026-09-17T18:46:16.421Z","updatedAt":"2026-09-17T18:46:16.421Z"},{"id":6188,"surahId":104,"numberInSurah":9,"textArabic":"فِى عَمَدٍ مُّمَدَّدَةٍۭ","translationUz":"Uzun-uzun ustunlarga bog`langandir.","transcription":null,"tafsirUz":null,"pageNumber":601,"juz":30,"createdAt":"2026-09-17T18:46:16.425Z","updatedAt":"2026-09-17T18:46:16.425Z"}],"createdAt":"2026-09-17T18:45:07.901Z","updatedAt":"2026-09-18T00:07:52.736Z"}