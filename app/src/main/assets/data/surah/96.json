{"id":96,"number":96,"nameArabic":"العلق","nameUz":"Alaq","meaningUz":"Laxta qon","revelationPlace":"makka","totalAyahs":19,"startPage":597,"ayahs":[{"id":6107,"surahId":96,"numberInSurah":1,"textArabic":" ٱقْرَأْ بِٱسْمِ رَبِّكَ ٱلَّذِى خَلَقَ","translationUz":"Yaratgan Robbing nomi bilan o`qi.","transcription":null,"tafsirUz":null,"pageNumber":597,"juz":30,"createdAt":"2026-09-17T18:46:14.577Z","updatedAt":"2026-09-17T18:46:14.577Z"},{"id":6108,"surahId":96,"numberInSurah":2,"textArabic":"خَلَقَ ٱلْإِنسَـٰنَ مِنْ عَلَقٍ","translationUz":"U insonni alaqdan yaratdi.","transcription":null,"tafsirUz":null,"pageNumber":597,"juz":30,"createdAt":"2026-09-17T18:46:14.584Z","updatedAt":"2026-09-17T18:46:14.584Z"},{"id":6109,"surahId":96,"numberInSurah":3,"textArabic":"ٱقْرَأْ وَرَبُّكَ ٱلْأَكْرَمُ","translationUz":"O`qi! Robbing Karamlilarning karamlisidir.","transcription":null,"tafsirUz":null,"pageNumber":597,"juz":30,"createdAt":"2026-09-17T18:46:14.588Z","updatedAt":"2026-09-17T18:46:14.588Z"},{"id":6110,"surahId":96,"numberInSurah":4,"textArabic":"ٱلَّذِى عَلَّمَ بِٱلْقَلَمِ","translationUz":"U, qalam bilan ilm o`rgatgandir.","transcription":null,"tafsirUz":null,"pageNumber":597,"juz":30,"createdAt":"2026-09-17T18:46:14.593Z","updatedAt":"2026-09-17T18:46:14.593Z"},{"id":6111,"surahId":96,"numberInSurah":5,"textArabic":"عَلَّمَ ٱلْإِنسَـٰنَ مَا لَمْ يَعْلَمْ","translationUz":"U, insonga bilmagan narsasini o`rgatdi.","transcription":null,"tafsirUz":null,"pageNumber":597,"juz":30,"createdAt":"2026-09-17T18:46:14.597Z","updatedAt":"2026-09-17T18:46:14.597Z"},{"id":6112,"surahId":96,"numberInSurah":6,"textArabic":"كَلَّآ إِنَّ ٱلْإِنسَـٰنَ لَيَطْغَىٰٓ","translationUz":"Yo`q! Inson, albatta, tug`yonga ketur.","transcription":null,"tafsirUz":null,"pageNumber":597,"juz":30,"createdAt":"2026-09-17T18:46:14.602Z","updatedAt":"2026-09-17T18:46:14.602Z"},{"id":6113,"surahId":96,"numberInSurah":7,"textArabic":"أَن رَّءَاهُ ٱسْتَغْنَىٰٓ","translationUz":"Gar o`zini boy ko`rsa.","transcription":null,"tafsirUz":null,"pageNumber":597,"juz":30,"createdAt":"2026-09-17T18:46:14.607Z","updatedAt":"2026-09-17T18:46:14.607Z"},{"id":6114,"surahId":96,"numberInSurah":8,"textArabic":"إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجْعَىٰٓ","translationUz":"Albatta, qaytib borish Robbinggadir.","transcription":null,"tafsirUz":null,"pageNumber":597,"juz":30,"createdAt":"2026-09-17T18:46:14.611Z","updatedAt":"2026-09-17T18:46:14.611Z"},{"id":6115,"surahId":96,"numberInSurah":9,"textArabic":"أَرَءَيْتَ ٱلَّذِى يَنْهَىٰ","translationUz":"Qaytarganni ko`rdingmi?!","transcription":null,"tafsirUz":null,"pageNumber":597,"juz":30,"createdAt":"2026-09-17T18:46:14.615Z","updatedAt":"2026-09-17T18:46:14.615Z"},{"id":6116,"surahId":96,"numberInSurah":10,"textArabic":"عَبْدًا إِذَا صَلَّىٰٓ","translationUz":"Bandani namoz o`qiyotganida?!","transcription":null,"tafsirUz":null,"pageNumber":597,"juz":30,"createdAt":"2026-09-17T18:46:14.619Z","updatedAt":"2026-09-17T18:46:14.619Z"},{"id":6117,"surahId":96,"numberInSurah":11,"textArabic":"أَرَءَيْتَ إِن كَانَ عَلَى ٱلْهُدَىٰٓ","translationUz":"Ayting-chi, agar o`sha hidoyatda bo`lsa.","transcription":null,"tafsirUz":null,"pageNumber":597,"juz":30,"createdAt":"2026-09-17T18:46:14.623Z","updatedAt":"2026-09-17T18:46:14.623Z"},{"id":6118,"surahId":96,"numberInSurah":12,"textArabic":"أَوْ أَمَرَ بِٱلتَّقْوَىٰٓ","translationUz":"Yoki taqvoga chaqirsa.","transcription":null,"tafsirUz":null,"pageNumber":597,"juz":30,"createdAt":"2026-09-17T18:46:14.627Z","updatedAt":"2026-09-17T18:46:14.627Z"},{"id":6119,"surahId":96,"numberInSurah":13,"textArabic":"أَرَءَيْتَ إِن كَذَّبَ وَتَوَلَّىٰٓ","translationUz":"Ayting-chi, agar u yolg`onga chiqarsa va yuz o`girsa.","transcription":null,"tafsirUz":null,"pageNumber":597,"juz":30,"createdAt":"2026-09-17T18:46:14.631Z","updatedAt":"2026-09-17T18:46:14.631Z"},{"id":6120,"surahId":96,"numberInSurah":14,"textArabic":"أَلَمْ يَعْلَم بِأَنَّ ٱللَّهَ يَرَىٰ","translationUz":"Alloh uni ko`rib turishini bilmasmi?","transcription":null,"tafsirUz":null,"pageNumber":597,"juz":30,"createdAt":"2026-09-17T18:46:14.634Z","updatedAt":"2026-09-17T18:46:14.634Z"},{"id":6121,"surahId":96,"numberInSurah":15,"textArabic":"كَلَّا لَئِن لَّمْ يَنتَهِ لَنَسْفَعًۢا بِٱلنَّاصِيَةِ","translationUz":"Yo`q! Agar qaytmasa, peshonasidan shiddat-la tutamiz!","transcription":null,"tafsirUz":null,"pageNumber":597,"juz":30,"createdAt":"2026-09-17T18:46:14.639Z","updatedAt":"2026-09-17T18:46:14.639Z"},{"id":6122,"surahId":96,"numberInSurah":16,"textArabic":"نَاصِيَةٍ كَـٰذِبَةٍ خَاطِئَةٍ","translationUz":"Yolg`onchi, xatokor peshonasidan!","transcription":null,"tafsirUz":null,"pageNumber":597,"juz":30,"createdAt":"2026-09-17T18:46:14.643Z","updatedAt":"2026-09-17T18:46:14.643Z"},{"id":6123,"surahId":96,"numberInSurah":17,"textArabic":"فَلْيَدْعُ نَادِيَهُۥ","translationUz":"Bas, u o`z to`pini chaqirsin.","transcription":null,"tafsirUz":null,"pageNumber":597,"juz":30,"createdAt":"2026-09-17T18:46:14.646Z","updatedAt":"2026-09-17T18:46:14.646Z"},{"id":6124,"surahId":96,"numberInSurah":18,"textArabic":"سَنَدْعُ ٱلزَّبَانِيَةَ","translationUz":"Biz ham zaboniyalarni chaqirurmiz.","transcription":null,"tafsirUz":null,"pageNumber":597,"juz":30,"createdAt":"2026-09-17T18:46:14.651Z","updatedAt":"2026-09-17T18:46:14.651Z"},{"id":6125,"surahId":96,"numberInSurah":19,"textArabic":"كَلَّا لَا تُطِعْهُ وَٱسْجُدْ وَٱقْتَرِب ۩","translationUz":"Yo`q! Sen unga itoat qilma! Sajda qil va qurbat hosil qil.","transcription":null,"tafsirUz":null,"pageNumber":597,"juz":30,"createdAt":"2026-09-17T18:46:14.655Z","updatedAt":"2026-09-17T18:46:14.655Z"}],"createdAt":"2026-09-17T18:45:07.864Z","updatedAt":"2026-09-18T00:07:52.708Z"}