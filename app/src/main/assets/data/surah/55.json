Surah":27,"textArabic":"وَيَبْقَىٰ وَجْهُ رَبِّكَ ذُو ٱلْجَلَـٰلِ وَٱلْإِكْرَامِ","translationUz":"Ulug`lik va ikrom egasi Robbingning O`zigina boqiydir.","transcription":null,"tafsirUz":null,"pageNumber":532,"juz":27,"createdAt":"2026-09-17T18:45:58.661Z","updatedAt":"2026-09-17T18:45:58.661Z"},{"id":4929,"surahId":55,"numberInSurah":28,"textArabic":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","translationUz":"Bas, Robbingizning qaysi ne'matlarini yolg`on deya olursiz?!","transcription":null,"tafsirUz":null,"pageNumber":532,"juz":27,"createdAt":"2026-09-17T18:45:58.665Z","updatedAt":"2026-09-17T18:45:58.665Z"},{"id":4930,"surahId":55,"numberInSurah":29,"textArabic":"يَسْـَٔلُهُۥ مَن فِى ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ ۚ كُلَّ يَوْمٍ هُوَ فِى شَأْنٍ","translationUz":"Undan yeru osmondagi jonzotlar so`rarlar. U har kuni ishdadir.","transcription":null,"tafsirUz":null,"pageNumber":532,"juz":27,"createdAt":"2026-09-17T18:45:58.669Z","updatedAt":"2026-09-17T18:45:58.669Z"},{"id":4931,"surahId":55,"numberInSurah":30,"textArabic":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","translationUz":"Bas, Robbingizning qaysi ne'matlarini yolg`on deya olursiz?!","transcription":null,"tafsirUz":null,"pageNumber":532,"juz":27,"createdAt":"2026-09-17T18:45:58.673Z","updatedAt":"2026-09-17T18:45:58.673Z"},{"id":4932,"surahId":55,"numberInSurah":31,"textArabic":"سَنَفْرُغُ لَكُمْ أَيُّهَ ٱلثَّقَلَانِ","translationUz":"Albatta, sizlar uchun vaqt topamiz, ey, insu jinlar!","transcription":null,"tafsirUz":null,"pageNumber":532,"juz":27,"createdAt":"2026-09-17T18:45:58.677Z","updatedAt":"2026-09-17T18:45:58.677Z"},{"id":4933,"surahId":55,"numberInSurah":32,"textArabic":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","translationUz":"Bas, Robbingizning qaysi ne'matlarini yolg`on deya olursiz?!","transcription":null,"tafsirUz":null,"pageNumber":532,"juz":27,"createdAt":"2026-09-17T18:45:58.681Z","updatedAt":"2026-09-17T18:45:58.681Z"},{"id":4934,"surahId":55,"numberInSurah":33,"textArabic":"يَـٰمَع