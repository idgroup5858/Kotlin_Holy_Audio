{"id":92,"number":92,"nameArabic":"الليل","nameUz":"Layl","meaningUz":"Tun","revelationPlace":"makka","totalAyahs":21,"startPage":595,"ayahs":[{"id":6059,"surahId":92,"numberInSurah":1,"textArabic":" وَٱلَّيْلِ إِذَا يَغْشَىٰ","translationUz":"Tunning qoplab kelayotgan payti bilan qasam.","transcription":null,"tafsirUz":null,"pageNumber":595,"juz":30,"createdAt":"2026-09-17T18:46:13.007Z","updatedAt":"2026-09-17T18:46:13.007Z"},{"id":6060,"surahId":92,"numberInSurah":2,"textArabic":"وَٱلنَّهَارِ إِذَا تَجَلَّىٰ","translationUz":"Nahorning tajalli payti bilan qasam.","transcription":null,"tafsirUz":null,"pageNumber":595,"juz":30,"createdAt":"2026-09-17T18:46:13.012Z","updatedAt":"2026-09-17T18:46:13.012Z"},{"id":6061,"surahId":92,"numberInSurah":3,"textArabic":"وَمَا خَلَقَ ٱلذَّكَرَ وَٱلْأُنثَىٰٓ","translationUz":"Erkak va urg`ochining yaratilishi bilan qasam.","transcription":null,"tafsirUz":null,"pageNumber":595,"juz":30,"createdAt":"2026-09-17T18:46:13.017Z","updatedAt":"2026-09-17T18:46:13.017Z"},{"id":6062,"surahId":92,"numberInSurah":4,"textArabic":"إِنَّ سَعْيَكُمْ لَشَتَّىٰ","translationUz":"Albatta, sizlarning ishlaringiz turlichadur.","transcription":null,"tafsirUz":null,"pageNumber":595,"juz":30,"createdAt":"2026-09-17T18:46:13.020Z","updatedAt":"2026-09-17T18:46:13.020Z"},{"id":6063,"surahId":92,"numberInSurah":5,"textArabic":"فَأَمَّا مَنْ أَعْطَىٰ وَٱتَّقَىٰ","translationUz":"Ammo kimki (ato) bersa va taqvo qilsa...","transcription":null,"tafsirUz":null,"pageNumber":595,"juz":30,"createdAt":"2026-09-17T18:46:13.024Z","updatedAt":"2026-09-17T18:46:13.024Z"},{"id":6064,"surahId":92,"numberInSurah":6,"textArabic":"وَصَدَّقَ بِٱلْحُسْنَىٰ","translationUz":"Va go`zalni tasdiq qilsa...","transcription":null,"tafsirUz":null,"pageNumber":595,"juz":30,"createdAt":"2026-09-17T18:46:13.029Z","updatedAt":"2026-09-17T18:46:13.029Z"},{"id":6065,"surahId":92,"numberInSurah":7,"textArabic":"فَسَنُيَسِّرُهُۥ لِلْيُسْرَىٰ","translationUz":"Bas, Biz uni osonga muyassar qilamiz.","transcription":null,"tafsirUz":null,"pageNumber":595,"juz":30,"createdAt":"2026-09-17T18:46:13.033Z","updatedAt":"2026-09-17T18:46:13.033Z"},{"id":6066,"surahId":92,"numberInSurah":8,"textArabic":"وَأَمَّا مَنۢ بَخِلَ وَٱسْتَغْنَىٰ","translationUz":"Va ammo, kimki baxillik va istig`no qilsa...","transcription":null,"tafsirUz":null,"pageNumber":595,"juz":30,"createdAt":"2026-09-17T18:46:13.037Z","updatedAt":"2026-09-17T18:46:13.037Z"},{"id":6067,"surahId":92,"numberInSurah":9,"textArabic":"وَكَذَّبَ بِٱلْحُسْنَىٰ","translationUz":"Va go`zalni yolg`onga chiqarsa...","transcription":null,"tafsirUz":null,"pageNumber":595,"juz":30,"createdAt":"2026-09-17T18:46:13.041Z","updatedAt":"2026-09-17T18:46:13.041Z"},{"id":6068,"surahId":92,"numberInSurah":10,"textArabic":"فَسَنُيَسِّرُهُۥ لِلْعُسْرَىٰ","translationUz":"Bas, Biz uni qiyinga muyassar qilamiz.","transcription":null,"tafsirUz":null,"pageNumber":595,"juz":30,"createdAt":"2026-09-17T18:46:13.045Z","updatedAt":"2026-09-17T18:46:13.045Z"},{"id":6069,"surahId":92,"numberInSurah":11,"textArabic":"وَمَا يُغْنِى عَنْهُ مَالُهُۥٓ إِذَا تَرَدَّىٰٓ","translationUz":"U qulagan vaqtda unga mol-mulki foyda bermas.","transcription":null,"tafsirUz":null,"pageNumber":595,"juz":30,"createdAt":"2026-09-17T18:46:13.048Z","updatedAt":"2026-09-17T18:46:13.048Z"},{"id":6070,"surahId":92,"numberInSurah":12,"textArabic":"إِنَّ عَلَيْنَا لَلْهُدَىٰ","translationUz":"Albatta, hidoyatga boshlash Bizning zimmamizdadir.","transcription":null,"tafsirUz":null,"pageNumber":595,"juz":30,"createdAt":"2026-09-17T18:46:13.052Z","updatedAt":"2026-09-17T18:46:13.052Z"},{"id":6071,"surahId":92,"numberInSurah":13,"textArabic":"وَإِنَّ لَنَا لَلْـَٔاخِرَةَ وَٱلْأُولَىٰ","translationUz":"Albatta, ham oxirat va ham bu dunyo Biznikidir.","transcription":null,"tafsirUz":null,"pageNumber":595,"juz":30,"createdAt":"2026-09-17T18:46:13.057Z","updatedAt":"2026-09-17T18:46:13.057Z"},{"id":6072,"surahId":92,"numberInSurah":14,"textArabic":"فَأَنذَرْتُكُمْ نَارًا تَلَظَّىٰ","translationUz":"Bas, Men sizlarni lovullagan o`tdan ogohlantirdim.","transcription":null,"tafsirUz":null,"pageNumber":595,"juz":30,"createdAt":"2026-09-17T18:46:13.061Z","updatedAt":"2026-09-17T18:46:13.061Z"},{"id":6073,"surahId":92,"numberInSurah":15,"textArabic":"لَا يَصْلَىٰهَآ إِلَّا ٱلْأَشْقَى","translationUz":"Unga badbaxtdan boshqa kirmas.","transcription":null,"tafsirUz":null,"pageNumber":596,"juz":30,"createdAt":"2026-09-17T18:46:13.066Z","updatedAt":"2026-09-17T18:46:13.066Z"},{"id":6074,"surahId":92,"numberInSurah":16,"textArabic":"ٱلَّذِى كَذَّبَ وَتَوَلَّىٰ","translationUz":"O`sha yolg`onga chiqargan va yuz o`girgan edi.","transcription":null,"tafsirUz":null,"pageNumber":596,"juz":30,"createdAt":"2026-09-17T18:46:13.070Z","updatedAt":"2026-09-17T18:46:13.070Z"},{"id":6075,"surahId":92,"numberInSurah":17,"textArabic":"وَسَيُجَنَّبُهَا ٱلْأَتْقَى","translationUz":"Va albatta, undan taqvodor banda chetda qoladir.","transcription":null,"tafsirUz":null,"pageNumber":596,"juz":30,"createdAt":"2026-09-17T18:46:13.074Z","updatedAt":"2026-09-17T18:46:13.074Z"},{"id":6076,"surahId":92,"numberInSurah":18,"textArabic":"ٱلَّذِى يُؤْتِى مَالَهُۥ يَتَزَكَّىٰ","translationUz":"U, boyligini sarflaydir va o`zini poklaydir.","transcription":null,"tafsirUz":null,"pageNumber":596,"juz":30,"createdAt":"2026-09-17T18:46:13.077Z","updatedAt":"2026-09-17T18:46:13.077Z"},{"id":6077,"surahId":92,"numberInSurah":19,"textArabic":"وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعْمَةٍ تُجْزَىٰٓ","translationUz":"Biror kishining unda qaytarilishi lozim yaxshiligi yo`q edi.","transcription":null,"tafsirUz":null,"pageNumber":596,"juz":30,"createdAt":"2026-09-17T18:46:13.082Z","updatedAt":"2026-09-17T18:46:13.082Z"},{"id":6078,"surahId":92,"numberInSurah":20,"textArabic":"إِلَّا ٱبْتِغَآءَ وَجْهِ رَبِّهِ ٱلْأَعْلَىٰ","translationUz":"Faqat, o`zining oliy maqom Robbining roziligini so`rab qiladir.","transcription":null,"tafsirUz":null,"pageNumber":596,"juz":30,"createdAt":"2026-09-17T18:46:13.086Z","updatedAt":"2026-09-17T18:46:13.086Z"},{"id":6079,"surahId":92,"numberInSurah":21,"textArabic":"وَلَسَوْفَ يَرْضَىٰ","translationUz":"Va albatta, tezda rozi bo`ladir.","transcription":null,"tafsirUz":null,"pageNumber":596,"juz":30,"createdAt":"2026-09-17T18:46:13.090Z","updatedAt":"2026-09-17T18:46:13.090Z"}],"createdAt":"2026-09-17T18:45:07.847Z","updatedAt":"2026-09-18T00:07:52.695Z"}