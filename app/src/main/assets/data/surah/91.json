{"id":91,"number":91,"nameArabic":"الشمس","nameUz":"Shams","meaningUz":"Quyosh","revelationPlace":"makka","totalAyahs":15,"startPage":595,"ayahs":[{"id":6044,"surahId":91,"numberInSurah":1,"textArabic":" وَٱلشَّمْسِ وَضُحَىٰهَا","translationUz":"Quyosh bilan va uning ziyosi bilan qasam.","transcription":null,"tafsirUz":null,"pageNumber":595,"juz":30,"createdAt":"2026-09-17T18:46:12.738Z","updatedAt":"2026-09-17T18:46:12.738Z"},{"id":6045,"surahId":91,"numberInSurah":2,"textArabic":"وَٱلْقَمَرِ إِذَا تَلَىٰهَا","translationUz":"Uning ortidan kelgan oy bilan qasam.","transcription":null,"tafsirUz":null,"pageNumber":595,"juz":30,"createdAt":"2026-09-17T18:46:12.745Z","updatedAt":"2026-09-17T18:46:12.745Z"},{"id":6046,"surahId":91,"numberInSurah":3,"textArabic":"وَٱلنَّهَارِ إِذَا جَلَّىٰهَا","translationUz":"Va u(quyosh)ni ravshan ko`rsatgan nahor bilan qasam.","transcription":null,"tafsirUz":null,"pageNumber":595,"juz":30,"createdAt":"2026-09-17T18:46:12.751Z","updatedAt":"2026-09-17T18:46:12.751Z"},{"id":6047,"surahId":91,"numberInSurah":4,"textArabic":"وَٱلَّيْلِ إِذَا يَغْشَىٰهَا","translationUz":"Va u(quyosh)ni qoplagan tun bilan qasam.","transcription":null,"tafsirUz":null,"pageNumber":595,"juz":30,"createdAt":"2026-09-17T18:46:12.755Z","updatedAt":"2026-09-17T18:46:12.755Z"},{"id":6048,"surahId":91,"numberInSurah":5,"textArabic":"وَٱلسَّمَآءِ وَمَا بَنَىٰهَا","translationUz":"Va osmon bilan va uning bino qilinishi bilan qasam.","transcription":null,"tafsirUz":null,"pageNumber":595,"juz":30,"createdAt":"2026-09-17T18:46:12.760Z","updatedAt":"2026-09-17T18:46:12.760Z"},{"id":6049,"surahId":91,"numberInSurah":6,"textArabic":"وَٱلْأَرْضِ وَمَا طَحَىٰهَا","translationUz":"Va yer bilan va uning to`shalishi bilan qasam.","transcription":null,"tafsirUz":null,"pageNumber":595,"juz":30,"createdAt":"2026-09-17T18:46:12.764Z","updatedAt":"2026-09-17T18:46:12.764Z"},{"id":6050,"surahId":91,"numberInSurah":7,"textArabic":"وَنَفْسٍ وَمَا سَوَّىٰهَا","translationUz":"Va nafs bilan va uning mukammal qilinishi bilan qasam.","transcription":null,"tafsirUz":null,"pageNumber":595,"juz":30,"createdAt":"2026-09-17T18:46:12.768Z","updatedAt":"2026-09-17T18:46:12.768Z"},{"id":6051,"surahId":91,"numberInSurah":8,"textArabic":"فَأَلْهَمَهَا فُجُورَهَا وَتَقْوَىٰهَا","translationUz":"Bas, unga fujurini va taqvosini bildirdi.","transcription":null,"tafsirUz":null,"pageNumber":595,"juz":30,"createdAt":"2026-09-17T18:46:12.772Z","updatedAt":"2026-09-17T18:46:12.772Z"},{"id":6052,"surahId":91,"numberInSurah":9,"textArabic":"قَدْ أَفْلَحَ مَن زَكَّىٰهَا","translationUz":"Batahqiq, kim u(nafs)ni poklasa, yutuqqa erishdi.","transcription":null,"tafsirUz":null,"pageNumber":595,"juz":30,"createdAt":"2026-09-17T18:46:12.776Z","updatedAt":"2026-09-17T18:46:12.776Z"},{"id":6053,"surahId":91,"numberInSurah":10,"textArabic":"وَقَدْ خَابَ مَن دَسَّىٰهَا","translationUz":"Va batahqiq, kim u(nafs)ni kirlasa, noumid bo`ldi.","transcription":null,"tafsirUz":null,"pageNumber":595,"juz":30,"createdAt":"2026-09-17T18:46:12.780Z","updatedAt":"2026-09-17T18:46:12.780Z"},{"id":6054,"surahId":91,"numberInSurah":11,"textArabic":"كَذَّبَتْ ثَمُودُ بِطَغْوَىٰهَآ","translationUz":"Samud qavmi o`z tug`yoni ila yolg`onga chiqardi.","transcription":null,"tafsirUz":null,"pageNumber":595,"juz":30,"createdAt":"2026-09-17T18:46:12.785Z","updatedAt":"2026-09-17T18:46:12.785Z"},{"id":6055,"surahId":91,"numberInSurah":12,"textArabic":"إِذِ ٱنۢبَعَثَ أَشْقَىٰهَا","translationUz":"Vaqtiki, uning eng badbaxti shoshilib turdi.","transcription":null,"tafsirUz":null,"pageNumber":595,"juz":30,"createdAt":"2026-09-17T18:46:12.789Z","updatedAt":"2026-09-17T18:46:12.789Z"},{"id":6056,"surahId":91,"numberInSurah":13,"textArabic":"فَقَالَ لَهُمْ رَسُولُ ٱللَّهِ نَاقَةَ ٱللَّهِ وَسُقْيَـٰهَا","translationUz":"Bas, ularga Allohning Rasuli: «Allohning tuyasiga va uning suviga tegmanglar», dedi.","transcription":null,"tafsirUz":null,"pageNumber":595,"juz":30,"createdAt":"2026-09-17T18:46:12.792Z","updatedAt":"2026-09-17T18:46:12.792Z"},{"id":6057,"surahId":91,"numberInSurah":14,"textArabic":"فَكَذَّبُوهُ فَعَقَرُوهَا فَدَمْدَمَ عَلَيْهِمْ رَبُّهُم بِذَنۢبِهِمْ فَسَوَّىٰهَا","translationUz":"Bas, (uni) yolg`onchiga chiqarishdi va (tuyani) so`yishdi. Bas, Robblari ularni gunohlari sababli yo`q qilib yubordi va bunda barchani barobar qildi.","transcription":null,"tafsirUz":null,"pageNumber":595,"juz":30,"createdAt":"2026-09-17T18:46:12.796Z","updatedAt":"2026-09-17T18:46:12.796Z"},{"id":6058,"surahId":91,"numberInSurah":15,"textArabic":"وَلَا يَخَافُ عُقْبَـٰهَا","translationUz":"Va U zot bu(ish)ning oqibatidan qo`rqmas.","transcription":null,"tafsirUz":null,"pageNumber":595,"juz":30,"createdAt":"2026-09-17T18:46:12.800Z","updatedAt":"2026-09-17T18:46:12.800Z"}],"createdAt":"2026-09-17T18:45:07.842Z","updatedAt":"2026-09-18T00:07:52.691Z"}