{"number":527,"textArabic":null,"translationUz":null,"juz":null,"note":null,"updatedAt":null,"ayahs":[{"id":4811,"surahId":53,"surah":{"id":53,"number":53,"nameArabic":"النجم","nameUz":"Najm","meaningUz":"Yulduz","revelationPlace":"makka","totalAyahs":62,"startPage":526,"createdAt":"2026-09-17T18:45:07.664Z","updatedAt":"2026-09-18T00:07:52.549Z"},"numberInSurah":27,"textArabic":"إِنَّ ٱلَّذِينَ لَا يُؤْمِنُونَ بِٱلْـَٔاخِرَةِ لَيُسَمُّونَ ٱلْمَلَـٰٓئِكَةَ تَسْمِيَةَ ٱلْأُنثَىٰ","translationUz":"Albatta, oxiratga iymon keltirmaganlar farishtalarni ayol nomi bilan nomlarlar.","transcription":null,"tafsirUz":null,"pageNumber":527,"juz":27,"createdAt":"2026-09-17T18:45:57.414Z","updatedAt":"2026-09-17T18:45:57.414Z"},{"id":4812,"surahId":53,"surah":{"id":53,"number":53,"nameArabic":"النجم","nameUz":"Najm","meaningUz":"Yulduz","revelationPlace":"makka","totalAyahs":62,"startPage":526,"createdAt":"2026-09-17T18:45:07.664Z","updatedAt":"2026-09-18T00:07:52.549Z"},"numberInSurah":28,"textArabic":"وَمَا لَهُم بِهِۦ مِنْ عِلْمٍ ۖ إِن يَتَّبِعُونَ إِلَّا ٱلظَّنَّ ۖ وَإِنَّ ٱلظَّنَّ لَا يُغْنِى مِنَ ٱلْحَقِّ شَيْـًٔا","translationUz":"Ularda bu haqda hech qanday ilm yo`q. Gumondan boshqa narsaga ergashmaslar. Albatta, gumon haqiqat o`rniga o`tmas.","transcription":null,"tafsirUz":null,"pageNumber":527,"juz":27,"createdAt":"2026-09-17T18:45:57.417Z","updatedAt":"2026-09-17T18:45:57.417Z"},{"id":4813,"surahId":53,"surah":{"id":53,"number":53,"nameArabic":"النجم","nameUz":"Najm","meaningUz":"Yulduz","revelationPlace":"makka","totalAyahs":62,"startPage":526,"createdAt":"2026-09-17T18:45:07.664Z","updatedAt":"2026-09-18T00:07:52.549Z"},"numberInSurah":29,"textArabic":"فَأَعْرِضْ عَن مَّن تَوَلَّىٰ عَن ذِكْرِنَا وَلَمْ يُرِدْ إِلَّا ٱلْحَيَوٰةَ ٱلدُّنْيَا","translationUz":"Bizning zikrimizga orqa o`girgan, hayoti dunyodan boshqani xohlamaydiganlardan yuz o`gir.","transcription":null,"tafsirUz":null,"pageNumber":527,"juz":27,"createdAt":"2026-09-17T18:45:57.421Z","updatedAt":"2026-09-17T18:45:57.421Z"},{"id":4814,"surahId":53,"surah":{"id":53,"number":53,"nameArabic":"النجم","nameUz":"Najm","meaningUz":"Yulduz","revelationPlace":"makka","totalAyahs":62,"startPage":526,"createdAt":"2026-09-17T18:45:07.664Z","updatedAt":"2026-09-18T00:07:52.549Z"},"numberInSurah":30,"textArabic":"ذَٰلِكَ مَبْلَغُهُم مِّنَ ٱلْعِلْمِ ۚ إِنَّ رَبَّكَ هُوَ أَعْلَمُ بِمَن ضَلَّ عَن سَبِيلِهِۦ وَهُوَ أَعْلَمُ بِمَنِ ٱهْتَدَىٰ","translationUz":"Ularning erishgan ilmlari mana shu. Albatta, Robbing Uning yo`lidan adashganlarni bilguvchidir va U hidoyatdagilarni ham bilguvchidir.","transcription":null,"tafsirUz":null,"pageNumber":527,"juz":27,"createdAt":"2026-09-17T18:45:57.426Z","updatedAt":"2026-09-17T18:45:57.426Z"},{"id":4815,"surahId":53,"surah":{"id":53,"number":53,"nameArabic":"النجم","nameUz":"Najm","meaningUz":"Yulduz","revelationPlace":"makka","totalAyahs":62,"startPage":526,"createdAt":"2026-09-17T18:45:07.664Z","updatedAt":"2026-09-18T00:07:52.549Z"},"numberInSurah":31,"textArabic":"وَلِلَّهِ مَا فِى ٱلسَّمَـٰوَٰتِ وَمَا فِى ٱلْأَرْضِ لِيَجْزِىَ ٱلَّذِينَ أَسَـٰٓـُٔوا۟ بِمَا عَمِلُوا۟ وَيَجْزِىَ ٱلَّذِينَ أَحْسَنُوا۟ بِٱلْحُسْنَى","translationUz":"Osmonlardagiyu yerdagi barcha narsalar Allohnikidir. U yomonlik qilganlarni amaliga yarasha jazolar va yaxshilik qilganlarni go`zal (mukofot) ila mukofotlar.","transcription":null,"tafsirUz":null,"pageNumber":527,"juz":27,"createdAt":"2026-09-17T18:45:57.430Z","updatedAt":"2026-09-17T18:45:57.430Z"},{"id":4816,"surahId":53,"surah":{"id":53,"number":53,"nameArabic":"النجم","nameUz":"Najm","meaningUz":"Yulduz","revelationPlace":"makka","totalAyahs":62,"startPage":526,"createdAt":"2026-09-17T18:45:07.664Z","updatedAt":"2026-09-18T00:07:52.549Z"},"numberInSurah":32,"textArabic":"ٱلَّذِينَ يَجْتَنِبُونَ كَبَـٰٓئِرَ ٱلْإِثْمِ وَٱلْفَوَٰحِشَ إِلَّا ٱللَّمَمَ ۚ إِنَّ رَبَّكَ وَٰسِعُ ٱلْمَغْفِرَةِ ۚ هُوَ أَعْلَمُ بِكُمْ إِذْ أَنشَأَكُم مِّنَ ٱلْأَرْضِ وَإِذْ أَنتُمْ أَجِنَّةٌ فِى بُطُونِ أُمَّهَـٰتِكُمْ ۖ فَلَا تُزَكُّوٓا۟ أَنفُسَكُمْ ۖ هُوَ أَعْلَمُ بِمَنِ ٱتَّقَىٰٓ","translationUz":"Ular kichik gunohlardan boshqa katta gunohlar va fahsh ishlardan chetda bo`ladiganlardir. Albatta, Robbing mag`firati keng Zotdir. U sizlarni tuproqdan paydo qilganda ham, onalaringiz qorinlarida homilalik chog`ingizni ham yaxshi biluvchidir. Shundoq ekan, o`zingizni oqlamang, U kim taqvodorligini yaxshi biladir.","transcription":null,"tafsirUz":null,"pageNumber":527,"juz":27,"createdAt":"2026-09-17T18:45:57.434Z","updatedAt":"2026-09-17T18:45:57.434Z"},{"id":4817,"surahId":53,"surah":{"id":53,"number":53,"nameArabic":"النجم","nameUz":"Najm","meaningUz":"Yulduz","revelationPlace":"makka","totalAyahs":62,"startPage":526,"createdAt":"2026-09-17T18:45:07.664Z","updatedAt":"2026-09-18T00:07:52.549Z"},"numberInSurah":33,"textArabic":"أَفَرَءَيْتَ ٱلَّذِى تَوَلَّىٰ","translationUz":"Yuz o`girib ketganni ko`rdingmi?!","transcription":null,"tafsirUz":null,"pageNumber":527,"juz":27,"createdAt":"2026-09-17T18:45:57.437Z","updatedAt":"2026-09-17T18:45:57.437Z"},{"id":4818,"surahId":53,"surah":{"id":53,"number":53,"nameArabic":"النجم","nameUz":"Najm","meaningUz":"Yulduz","revelationPlace":"makka","totalAyahs":62,"startPage":526,"createdAt":"2026-09-17T18:45:07.664Z","updatedAt":"2026-09-18T00:07:52.549Z"},"numberInSurah":34,"textArabic":"وَأَعْطَىٰ قَلِيلًا وَأَكْدَىٰٓ","translationUz":"U ozgina berdi va to`xtadi.","transcription":null,"tafsirUz":null,"pageNumber":527,"juz":27,"createdAt":"2026-09-17T18:45:57.441Z","updatedAt":"2026-09-17T18:45:57.441Z"},{"id":4819,"surahId":53,"surah":{"id":53,"number":53,"nameArabic":"النجم","nameUz":"Najm","meaningUz":"Yulduz","revelationPlace":"makka","totalAyahs":62,"startPage":526,"createdAt":"2026-09-17T18:45:07.664Z","updatedAt":"2026-09-18T00:07:52.549Z"},"numberInSurah":35,"textArabic":"أَعِندَهُۥ عِلْمُ ٱلْغَيْبِ فَهُوَ يَرَىٰٓ","translationUz":"Uning huzurida g`ayb ilmi bor-u, u ko`rib turibdimi?","transcription":null,"tafsirUz":null,"pageNumber":527,"juz":27,"createdAt":"2026-09-17T18:45:57.445Z","updatedAt":"2026-09-17T18:45:57.445Z"},{"id":4820,"surahId":53,"surah":{"id":53,"number":53,"nameArabic":"النجم","nameUz":"Najm","meaningUz":"Yulduz","revelationPlace":"makka","totalAyahs":62,"startPage":526,"createdAt":"2026-09-17T18:45:07.664Z","updatedAt":"2026-09-18T00:07:52.549Z"},"numberInSurah":36,"textArabic":"أَمْ لَمْ يُنَبَّأْ بِمَا فِى صُحُفِ مُوسَىٰ","translationUz":"Yoki Musoning sahifalaridagi narsalar xabari unga berilmadimi?","transcription":null,"tafsirUz":null,"pageNumber":527,"juz":27,"createdAt":"2026-09-17T18:45:57.449Z","updatedAt":"2026-09-17T18:45:57.449Z"},{"id":4821,"surahId":53,"surah":{"id":53,"number":53,"nameArabic":"النجم","nameUz":"Najm","meaningUz":"Yulduz","revelationPlace":"makka","totalAyahs":62,"startPage":526,"createdAt":"2026-09-17T18:45:07.664Z","updatedAt":"2026-09-18T00:07:52.549Z"},"numberInSurah":37,"textArabic":"وَإِبْرَٰهِيمَ ٱلَّذِى وَفَّىٰٓ","translationUz":"Va vafo qilgan Ibrohimning?","transcription":null,"tafsirUz":null,"pageNumber":527,"juz":27,"createdAt":"2026-09-17T18:45:57.453Z","updatedAt":"2026-09-17T18:45:57.453Z"},{"id":4822,"surahId":53,"surah":{"id":53,"number":53,"nameArabic":"النجم","nameUz":"Najm","meaningUz":"Yulduz","revelationPlace":"makka","totalAyahs":62,"startPage":526,"createdAt":"2026-09-17T18:45:07.664Z","updatedAt":"2026-09-18T00:07:52.549Z"},"numberInSurah":38,"textArabic":"أَلَّا تَزِرُ وَازِرَةٌ وِزْرَ أُخْرَىٰ","translationUz":"Albatta, hech bir gunohkor boshqaning gunohini ko`tarmas.","transcription":null,"tafsirUz":null,"pageNumber":527,"juz":27,"createdAt":"2026-09-17T18:45:57.457Z","updatedAt":"2026-09-17T18:45:57.457Z"},{"id":4823,"surahId":53,"surah":{"id":53,"number":53,"nameArabic":"النجم","nameUz":"Najm","meaningUz":"Yulduz","revelationPlace":"makka","totalAyahs":62,"startPage":526,"createdAt":"2026-09-17T18:45:07.664Z","updatedAt":"2026-09-18T00:07:52.549Z"},"numberInSurah":39,"textArabic":"وَأَن لَّيْسَ لِلْإِنسَـٰنِ إِلَّا مَا سَعَىٰ","translationUz":"Har bir insonga o`z qilganidan boshqa narsa yo`q.","transcription":null,"tafsirUz":null,"pageNumber":527,"juz":27,"createdAt":"2026-09-17T18:45:57.461Z","updatedAt":"2026-09-17T18:45:57.461Z"},{"id":4824,"surahId":53,"surah":{"id":53,"number":53,"nameArabic":"النجم","nameUz":"Najm","meaningUz":"Yulduz","revelationPlace":"makka","totalAyahs":62,"startPage":526,"createdAt":"2026-09-17T18:45:07.664Z","updatedAt":"2026-09-18T00:07:52.549Z"},"numberInSurah":40,"textArabic":"وَأَنَّ سَعْيَهُۥ سَوْفَ يُرَىٰ","translationUz":"Va, albatta, uning qilmishi tezda ko`rinur.","transcription":null,"tafsirUz":null,"pageNumber":527,"juz":27,"createdAt":"2026-09-17T18:45:57.465Z","updatedAt":"2026-09-17T18:45:57.465Z"},{"id":4825,"surahId":53,"surah":{"id":53,"number":53,"nameArabic":"النجم","nameUz":"Najm","meaningUz":"Yulduz","revelationPlace":"makka","totalAyahs":62,"startPage":526,"createdAt":"2026-09-17T18:45:07.664Z","updatedAt":"2026-09-18T00:07:52.549Z"},"numberInSurah":41,"textArabic":"ثُمَّ يُجْزَىٰهُ ٱلْجَزَآءَ ٱلْأَوْفَىٰ","translationUz":"So`ngra jazo yoki mukofoti to`liq berilur.","transcription":null,"tafsirUz":null,"pageNumber":527,"juz":27,"createdAt":"2026-09-17T18:45:57.469Z","updatedAt":"2026-09-17T18:45:57.469Z"},{"id":4826,"surahId":53,"surah":{"id":53,"number":53,"nameArabic":"النجم","nameUz":"Najm","meaningUz":"Yulduz","revelationPlace":"makka","totalAyahs":62,"startPage":526,"createdAt":"2026-09-17T18:45:07.664Z","updatedAt":"2026-09-18T00:07:52.549Z"},"numberInSurah":42,"textArabic":"وَأَنَّ إِلَىٰ رَبِّكَ ٱلْمُنتَهَىٰ","translationUz":"Va, albatta, intiho Robbing huzuridadir.","transcription":null,"tafsirUz":null,"pageNumber":527,"juz":27,"createdAt":"2026-09-17T18:45:57.473Z","updatedAt":"2026-09-17T18:45:57.473Z"},{"id":4827,"surahId":53,"surah":{"id":53,"number":53,"nameArabic":"النجم","nameUz":"Najm","meaningUz":"Yulduz","revelationPlace":"makka","totalAyahs":62,"startPage":526,"createdAt":"2026-09-17T18:45:07.664Z","updatedAt":"2026-09-18T00:07:52.549Z"},"numberInSurah":43,"textArabic":"وَأَنَّهُۥ هُوَ أَضْحَكَ وَأَبْكَىٰ","translationUz":"Va, albatta, kuldirgan ham O`zi, yig`latgan ham O`zidir.","transcription":null,"tafsirUz":null,"pageNumber":527,"juz":27,"createdAt":"2026-09-17T18:45:57.477Z","updatedAt":"2026-09-17T18:45:57.477Z"},{"id":4828,"surahId":53,"surah":{"id":53,"number":53,"nameArabic":"النجم","nameUz":"Najm","meaningUz":"Yulduz","revelationPlace":"makka","totalAyahs":62,"startPage":526,"createdAt":"2026-09-17T18:45:07.664Z","updatedAt":"2026-09-18T00:07:52.549Z"},"numberInSurah":44,"textArabic":"وَأَنَّهُۥ هُوَ أَمَاتَ وَأَحْيَا","translationUz":"Albatta, o`ldirgan ham O`zi, tiriltirgan ham O`zi.","transcription":null,"tafsirUz":null,"pageNumber":527,"juz":27,"createdAt":"2026-09-17T18:45:57.481Z","updatedAt":"2026-09-17T18:45:57.481Z"}]}