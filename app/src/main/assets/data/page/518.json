{"number":518,"textArabic":null,"translationUz":null,"juz":null,"note":null,"updatedAt":null,"ayahs":[{"id":4631,"surahId":50,"surah":{"id":50,"number":50,"nameArabic":"ق","nameUz":"Qof","meaningUz":"Qof","revelationPlace":"makka","totalAyahs":45,"startPage":518,"createdAt":"2026-09-17T18:45:07.648Z","updatedAt":"2026-09-18T00:07:52.536Z"},"numberInSurah":1,"textArabic":" قٓ ۚ وَٱلْقُرْءَانِ ٱلْمَجِيدِ","translationUz":"Qoof. Ulug` Qur'on ila qasam.","transcription":null,"tafsirUz":null,"pageNumber":518,"juz":26,"createdAt":"2026-09-17T18:45:55.615Z","updatedAt":"2026-09-17T18:45:55.615Z"},{"id":4632,"surahId":50,"surah":{"id":50,"number":50,"nameArabic":"ق","nameUz":"Qof","meaningUz":"Qof","revelationPlace":"makka","totalAyahs":45,"startPage":518,"createdAt":"2026-09-17T18:45:07.648Z","updatedAt":"2026-09-18T00:07:52.536Z"},"numberInSurah":2,"textArabic":"بَلْ عَجِبُوٓا۟ أَن جَآءَهُم مُّنذِرٌ مِّنْهُمْ فَقَالَ ٱلْكَـٰفِرُونَ هَـٰذَا شَىْءٌ عَجِيبٌ","translationUz":"Balki, ularga o`zlaridan ogohlantiruvchi kelganidan ajablandilar va kofirlar: «Bu ajib narsa-ku?» – dedilar.","transcription":null,"tafsirUz":null,"pageNumber":518,"juz":26,"createdAt":"2026-09-17T18:45:55.620Z","updatedAt":"2026-09-17T18:45:55.620Z"},{"id":4633,"surahId":50,"surah":{"id":50,"number":50,"nameArabic":"ق","nameUz":"Qof","meaningUz":"Qof","revelationPlace":"makka","totalAyahs":45,"startPage":518,"createdAt":"2026-09-17T18:45:07.648Z","updatedAt":"2026-09-18T00:07:52.536Z"},"numberInSurah":3,"textArabic":"أَءِذَا مِتْنَا وَكُنَّا تُرَابًا ۖ ذَٰلِكَ رَجْعٌۢ بَعِيدٌ","translationUz":"O`lib, tuproq bo`lganimizdan keyin ham-a? Bu qaytish (aqldan) uzoq.","transcription":null,"tafsirUz":null,"pageNumber":518,"juz":26,"createdAt":"2026-09-17T18:45:55.624Z","updatedAt":"2026-09-17T18:45:55.624Z"},{"id":4634,"surahId":50,"surah":{"id":50,"number":50,"nameArabic":"ق","nameUz":"Qof","meaningUz":"Qof","revelationPlace":"makka","totalAyahs":45,"startPage":518,"createdAt":"2026-09-17T18:45:07.648Z","updatedAt":"2026-09-18T00:07:52.536Z"},"numberInSurah":4,"textArabic":"قَدْ عَلِمْنَا مَا تَنقُصُ ٱلْأَرْضُ مِنْهُمْ ۖ وَعِندَنَا كِتَـٰبٌ حَفِيظٌۢ","translationUz":"Haqiqatan, Biz ularni yer kamaytirayotganini bildik va Bizning huzurimizda saqlovchi kitob bor.","transcription":null,"tafsirUz":null,"pageNumber":518,"juz":26,"createdAt":"2026-09-17T18:45:55.628Z","updatedAt":"2026-09-17T18:45:55.628Z"},{"id":4635,"surahId":50,"surah":{"id":50,"number":50,"nameArabic":"ق","nameUz":"Qof","meaningUz":"Qof","revelationPlace":"makka","totalAyahs":45,"startPage":518,"createdAt":"2026-09-17T18:45:07.648Z","updatedAt":"2026-09-18T00:07:52.536Z"},"numberInSurah":5,"textArabic":"بَلْ كَذَّبُوا۟ بِٱلْحَقِّ لَمَّا جَآءَهُمْ فَهُمْ فِىٓ أَمْرٍ مَّرِيجٍ","translationUz":"Aniqki, ularga haq kelganda, uni yolg`onga chiqardilar. Bas, ular iztirobli ishdadirlar.","transcription":null,"tafsirUz":null,"pageNumber":518,"juz":26,"createdAt":"2026-09-17T18:45:55.632Z","updatedAt":"2026-09-17T18:45:55.632Z"},{"id":4636,"surahId":50,"surah":{"id":50,"number":50,"nameArabic":"ق","nameUz":"Qof","meaningUz":"Qof","revelationPlace":"makka","totalAyahs":45,"startPage":518,"createdAt":"2026-09-17T18:45:07.648Z","updatedAt":"2026-09-18T00:07:52.536Z"},"numberInSurah":6,"textArabic":"أَفَلَمْ يَنظُرُوٓا۟ إِلَى ٱلسَّمَآءِ فَوْقَهُمْ كَيْفَ بَنَيْنَـٰهَا وَزَيَّنَّـٰهَا وَمَا لَهَا مِن فُرُوجٍ","translationUz":"Ustilaridagi osmonga nazar solmaydilarmi? Uni qanday bino qilibmiz va ziynatlabmiz? Va (holbuki), uning teshiklari ham yo`q?!","transcription":null,"tafsirUz":null,"pageNumber":518,"juz":26,"createdAt":"2026-09-17T18:45:55.636Z","updatedAt":"2026-09-17T18:45:55.636Z"},{"id":4637,"surahId":50,"surah":{"id":50,"number":50,"nameArabic":"ق","nameUz":"Qof","meaningUz":"Qof","revelationPlace":"makka","totalAyahs":45,"startPage":518,"createdAt":"2026-09-17T18:45:07.648Z","updatedAt":"2026-09-18T00:07:52.536Z"},"numberInSurah":7,"textArabic":"وَٱلْأَرْضَ مَدَدْنَـٰهَا وَأَلْقَيْنَا فِيهَا رَوَٰسِىَ وَأَنۢبَتْنَا فِيهَا مِن كُلِّ زَوْجٍۭ بَهِيجٍ","translationUz":"Va yerni cho`zib qo`ydik, unga tog`larni tashladik va unda turli go`zal juftlarni o`stirdik.","transcription":null,"tafsirUz":null,"pageNumber":518,"juz":26,"createdAt":"2026-09-17T18:45:55.640Z","updatedAt":"2026-09-17T18:45:55.640Z"},{"id":4638,"surahId":50,"surah":{"id":50,"number":50,"nameArabic":"ق","nameUz":"Qof","meaningUz":"Qof","revelationPlace":"makka","totalAyahs":45,"startPage":518,"createdAt":"2026-09-17T18:45:07.648Z","updatedAt":"2026-09-18T00:07:52.536Z"},"numberInSurah":8,"textArabic":"تَبْصِرَةً وَذِكْرَىٰ لِكُلِّ عَبْدٍ مُّنِيبٍ","translationUz":"(Robbisiga) qaytuvchi har bir bandaga ko`rgazma va eslatma qilib...","transcription":null,"tafsirUz":null,"pageNumber":518,"juz":26,"createdAt":"2026-09-17T18:45:55.643Z","updatedAt":"2026-09-17T18:45:55.643Z"},{"id":4639,"surahId":50,"surah":{"id":50,"number":50,"nameArabic":"ق","nameUz":"Qof","meaningUz":"Qof","revelationPlace":"makka","totalAyahs":45,"startPage":518,"createdAt":"2026-09-17T18:45:07.648Z","updatedAt":"2026-09-18T00:07:52.536Z"},"numberInSurah":9,"textArabic":"وَنَزَّلْنَا مِنَ ٱلسَّمَآءِ مَآءً مُّبَـٰرَكًا فَأَنۢبَتْنَا بِهِۦ جَنَّـٰتٍ وَحَبَّ ٱلْحَصِيدِ","translationUz":"Va osmondan baraka suvini tushirdik hamda u bilan bog`-rog`larni va don hosilini o`stirdik.","transcription":null,"tafsirUz":null,"pageNumber":518,"juz":26,"createdAt":"2026-09-17T18:45:55.647Z","updatedAt":"2026-09-17T18:45:55.647Z"},{"id":4640,"surahId":50,"surah":{"id":50,"number":50,"nameArabic":"ق","nameUz":"Qof","meaningUz":"Qof","revelationPlace":"makka","totalAyahs":45,"startPage":518,"createdAt":"2026-09-17T18:45:07.648Z","updatedAt":"2026-09-18T00:07:52.536Z"},"numberInSurah":10,"textArabic":"وَٱلنَّخْلَ بَاسِقَـٰتٍ لَّهَا طَلْعٌ نَّضِيدٌ","translationUz":"Va zich mevali shingillari bor xurmolarni ham.","transcription":null,"tafsirUz":null,"pageNumber":518,"juz":26,"createdAt":"2026-09-17T18:45:55.651Z","updatedAt":"2026-09-17T18:45:55.651Z"},{"id":4641,"surahId":50,"surah":{"id":50,"number":50,"nameArabic":"ق","nameUz":"Qof","meaningUz":"Qof","revelationPlace":"makka","totalAyahs":45,"startPage":518,"createdAt":"2026-09-17T18:45:07.648Z","updatedAt":"2026-09-18T00:07:52.536Z"},"numberInSurah":11,"textArabic":"رِّزْقًا لِّلْعِبَادِ ۖ وَأَحْيَيْنَا بِهِۦ بَلْدَةً مَّيْتًا ۚ كَذَٰلِكَ ٱلْخُرُوجُ","translationUz":"Bandalarga rizq qilib. Va u (yomg`ir) bilan o`lgan shaharni tiriltirdik. Shunday bo`ladir (qabrdan) chiqish ham.","transcription":null,"tafsirUz":null,"pageNumber":518,"juz":26,"createdAt":"2026-09-17T18:45:55.656Z","updatedAt":"2026-09-17T18:45:55.656Z"},{"id":4642,"surahId":50,"surah":{"id":50,"number":50,"nameArabic":"ق","nameUz":"Qof","meaningUz":"Qof","revelationPlace":"makka","totalAyahs":45,"startPage":518,"createdAt":"2026-09-17T18:45:07.648Z","updatedAt":"2026-09-18T00:07:52.536Z"},"numberInSurah":12,"textArabic":"كَذَّبَتْ قَبْلَهُمْ قَوْمُ نُوحٍ وَأَصْحَـٰبُ ٱلرَّسِّ وَثَمُودُ","translationUz":"Ulardan avval Nuh qavmi, quduq sohiblari va Samud yolg`onga chiqarganlar.","transcription":null,"tafsirUz":null,"pageNumber":518,"juz":26,"createdAt":"2026-09-17T18:45:55.660Z","updatedAt":"2026-09-17T18:45:55.660Z"},{"id":4643,"surahId":50,"surah":{"id":50,"number":50,"nameArabic":"ق","nameUz":"Qof","meaningUz":"Qof","revelationPlace":"makka","totalAyahs":45,"startPage":518,"createdAt":"2026-09-17T18:45:07.648Z","updatedAt":"2026-09-18T00:07:52.536Z"},"numberInSurah":13,"textArabic":"وَعَادٌ وَفِرْعَوْنُ وَإِخْوَٰنُ لُوطٍ","translationUz":"Va Od, Fir'avn, Lut birodarlari.","transcription":null,"tafsirUz":null,"pageNumber":518,"juz":26,"createdAt":"2026-09-17T18:45:55.664Z","updatedAt":"2026-09-17T18:45:55.664Z"},{"id":4644,"surahId":50,"surah":{"id":50,"number":50,"nameArabic":"ق","nameUz":"Qof","meaningUz":"Qof","revelationPlace":"makka","totalAyahs":45,"startPage":518,"createdAt":"2026-09-17T18:45:07.648Z","updatedAt":"2026-09-18T00:07:52.536Z"},"numberInSurah":14,"textArabic":"وَأَصْحَـٰبُ ٱلْأَيْكَةِ وَقَوْمُ تُبَّعٍ ۚ كُلٌّ كَذَّبَ ٱلرُّسُلَ فَحَقَّ وَعِيدِ","translationUz":"Va daraxtzor egalari va Tubba' qavmi — barchalari Payg`ambarlarni yolg`onga chiqarganlar. Bas, (azob) va'dam haq bo`ldi.","transcription":null,"tafsirUz":null,"pageNumber":518,"juz":26,"createdAt":"2026-09-17T18:45:55.668Z","updatedAt":"2026-09-17T18:45:55.668Z"},{"id":4645,"surahId":50,"surah":{"id":50,"number":50,"nameArabic":"ق","nameUz":"Qof","meaningUz":"Qof","revelationPlace":"makka","totalAyahs":45,"startPage":518,"createdAt":"2026-09-17T18:45:07.648Z","updatedAt":"2026-09-18T00:07:52.536Z"},"numberInSurah":15,"textArabic":"أَفَعَيِينَا بِٱلْخَلْقِ ٱلْأَوَّلِ ۚ بَلْ هُمْ فِى لَبْسٍ مِّنْ خَلْقٍ جَدِيدٍ","translationUz":"Avvalgi yaratishga ojiz bo`l-dikmi? Yo`q! Ular yangidan yaratilishga shubhadadirlar.","transcription":null,"tafsirUz":null,"pageNumber":518,"juz":26,"createdAt":"2026-09-17T18:45:55.672Z","updatedAt":"2026-09-17T18:45:55.672Z"}]}