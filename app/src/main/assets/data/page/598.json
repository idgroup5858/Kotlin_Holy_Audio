T18:46:15.042Z"},{"id":6136,"surahId":98,"surah":{"id":98,"number":98,"nameArabic":"البينة","nameUz":"Bayyina","meaningUz":"Aniq hujjat","revelationPlace":"madina","totalAyahs":8,"startPage":598,"createdAt":"2026-09-17T18:45:07.874Z","updatedAt":"2026-09-18T00:07:52.715Z"},"numberInSurah":6,"textArabic":"إِنَّ ٱلَّذِينَ كَفَرُوا۟ مِنْ أَهْلِ ٱلْكِتَـٰبِ وَٱلْمُشْرِكِينَ فِى نَارِ جَهَنَّمَ خَـٰلِدِينَ فِيهَآ ۚ أُو۟لَـٰٓئِكَ هُمْ شَرُّ ٱلْبَرِيَّةِ","translationUz":"Albatta, ahli kitob va mushriklardan bo`lgan kufr keltirganlar jahannam o`tidadurlar, u yerda abadiy qolurlar. Undaylar xaloyiqning eng yomonidirlar.","transcription":null,"tafsirUz":null,"pageNumber":598,"juz":30,"createdAt":"2026-09-17T18:46:15.046Z","updatedAt":"2026-09-17T18:46:15.046Z"},{"id":6137,"surahId":98,"surah":{"id":98,"number":98,"nameArabic":"البينة","nameUz":"Bayyina","meaningUz":"Aniq hujjat","revelationPlace":"madina","totalAyahs":8,"startPage":598,"createdAt":"2026-09-17T18:45:07.874Z","updatedAt":"2026-09-18T00:07:52.715Z"},"numberInSurah":7,"textArabic":"إِنَّ ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ أُو۟لَـٰٓئِكَ هُمْ خَيْرُ ٱلْبَرِيَّةِ","translationUz":"Albatta, iymon keltirganlar va solih amallarni qilganlar, ana o`shalar, xaloyiqning eng yaxshisidir.","transcription":null,"tafsirUz":null,"pageNumber":598,"juz":30,"createdAt":"2026-09-17T18:46:15.050Z","updatedAt":"2026-09-17T18:46:15.050Z"}]}