ِى جَنَّـٰتٍ وَعُيُونٍ","translationUz":"Bog`-rog`larda, buloqlarda?!","transcription":null,"tafsirUz":null,"pageNumber":373,"juz":19,"createdAt":"2026-09-17T18:45:39.800Z","updatedAt":"2026-09-17T18:45:39.800Z"},{"id":3080,"surahId":26,"surah":{"id":26,"number":26,"nameArabic":"الشعراء","nameUz":"Shuaro","meaningUz":"Shoirlar","revelationPlace":"makka","totalAyahs":227,"startPage":367,"createdAt":"2026-09-17T18:45:07.530Z","updatedAt":"2026-09-18T00:07:52.427Z"},"numberInSurah":148,"textArabic":"وَزُرُوعٍ وَنَخْلٍ طَلْعُهَا هَضِيمٌ","translationUz":"Ekinzorlaru mayin xurmozor ichlarida-ya?!","transcription":null,"tafsirUz":null,"pageNumber":373,"juz":19,"createdAt":"2026-09-17T18:45:39.804Z","updatedAt":"2026-09-17T18:45:39.804Z"},{"id":3081,"surahId":26,"surah":{"id":26,"number":26,"nameArabic":"الشعراء","nameUz":"Shuaro","meaningUz":"Shoirlar","revelationPlace":"makka","totalAyahs":227,"startPage":367,"createdAt":"2026-09-17T18:45:07.530Z","updatedAt":"2026-09-18T00:07:52.427Z"},"numberInSurah":149,"textArabic":"وَتَنْحِتُونَ مِنَ ٱلْجِبَالِ بُيُوتًا فَـٰرِهِينَ","translationUz":"Va tog`lardan manmanlik-la uylar yo`naverasizmi?!","transcription":null,"tafsirUz":null,"pageNumber":373,"juz":19,"createdAt":"2026-09-17T18:45:39.808Z","updatedAt":"2026-09-17T18:45:39.808Z"},{"id":3082,"surahId":26,"surah":{"id":26,"number":26,"nameArabic":"الشعراء","nameUz":"Shuaro","meaningUz":"Shoirlar","revelationPlace":"makka","totalAyahs":227,"startPage":367,"createdAt":"2026-09-17T18:45:07.530Z","updatedAt":"2026-09-18T00:07:52.427Z"},"numberInSurah":150,"textArabic":"فَٱتَّقُوا۟ ٱللَّهَ وَأَطِيعُونِ","translationUz":"Bas, Allohdan qo`rqinglar va menga itoat qilinglar.","transcription":null,"tafsirUz":null,"pageNumber":373,"juz":19,"createdAt":"2026-09-17T18:45:39.812Z","updatedAt":"2026-09-17T18:45:39.812Z"},{"id":3083,"surahId":26,"surah":{"id":26,"number":26,"nameArabic":"الشعراء","nameUz":"Shuaro","meaningUz":"Shoirlar","revelationPlace":"makka","totalAyahs":227,"startPage":367,"createdAt":"2026-09-17T18:45:07.530Z","updatedAt":"2026-09-18T00:07:52.427Z"},"numberInSurah":151,"textArabic":"وَلَا تُطِيعُوٓا۟ أَمْرَ ٱلْمُسْرِفِينَ","translationUz":"Va yer yuzida isrofchilarning ishiga itoat qilmanglar.","transcription":null,"tafsirUz":null,"pageNumber":373,"juz":19,"createdAt":"2026-09-17T18:45:39.816Z","updatedAt":"2026-09-17T18:45:39.816Z"},{"id":3084,"surahId":26,"surah":{"id":26,"number":26,"nameArabic":"الشعراء","nameUz":"Shuaro","meaningUz":"Shoirlar","revelationPlace":"makka","totalAyahs":227,"startPage":367,"createdAt":"2026-09-17T18:45:07.530Z","updatedAt":"2026-09-18T00:07:52.427Z"},"numberInSurah":152,"textArabic":"ٱلَّذِينَ يُفْسِدُونَ فِى ٱلْأَرْضِ وَلَا يُصْلِحُونَ","translationUz":"Yer yuzida buzg`unchilik qiladigan, isloh etmaydiganlarning».","transcription":null,"tafsirUz":null,"pageNumber":373,"juz":19,"createdAt":"2026-09-17T18:45:39.821Z","updatedAt":"2026-09-17T18:45:39.821Z"},{"id":3085,"surahId":26,"surah":{"id":26,"number":26,"nameArabic":"الشعراء","nameUz":"Shuaro","meaningUz":"Shoirlar","revelationPlace":"makka","totalAyahs":227,"startPage":367,"createdAt":"2026-09-17T18:45:07.530Z","updatedAt":"2026-09-18T00:07:52.427Z"},"numberInSurah":153,"textArabic":"قَالُوٓا۟ إِنَّمَآ أَنتَ مِنَ ٱلْمُسَحَّرِينَ","translationUz":"Ular: «Sen, albatta, sehrlanganlardandirsan.","transcription":null,"tafsirUz":null,"pageNumber":373,"juz":19,"createdAt":"2026-09-17T18:45:39.825Z","updatedAt":"2026-09-17T18:45:39.825Z"},{"id":3086,"surahId":26,"surah":{"id":26,"number":26,"nameArabic":"الشعراء","nameUz":"Shuaro","meaningUz":"Shoirlar","revelationPlace":"makka","totalAyahs":227,"startPage":367,"createdAt":"2026-09-17T18:45:07.530Z","updatedAt":"2026-09-18T00:07:52.427Z"},"numberInSurah":154,"textArabic":"مَآ أَنتَ إِلَّا بَشَرٌ مِّثْلُنَا فَأْتِ بِـَٔايَةٍ إِن كُنتَ مِنَ ٱلصَّـٰدِقِينَ","translationUz":"Sen bizga o`xshagan bashardan boshqa hech narsa emassan. Agar rostgo`ylardan bo`lsang, mo`'jiza keltir», dedilar.","transcriptio