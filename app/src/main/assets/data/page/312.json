{"number":312,"textArabic":null,"translationUz":null,"juz":null,"note":null,"updatedAt":null,"ayahs":[{"id":2346,"surahId":19,"surah":{"id":19,"number":19,"nameArabic":"مريم","nameUz":"Maryam","meaningUz":"Maryam","revelationPlace":"makka","totalAyahs":98,"startPage":305,"createdAt":"2026-09-17T18:45:07.494Z","updatedAt":"2026-09-18T00:07:52.394Z"},"numberInSurah":96,"textArabic":"إِنَّ ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ سَيَجْعَلُ لَهُمُ ٱلرَّحْمَـٰنُ وُدًّا","translationUz":"Albatta, iymon keltirgan va yaxshi amallarni qilganlarga Rohman muhabbat paydo qilur.","transcription":null,"tafsirUz":null,"pageNumber":312,"juz":16,"createdAt":"2026-09-17T18:45:32.401Z","updatedAt":"2026-09-17T18:45:32.401Z"},{"id":2347,"surahId":19,"surah":{"id":19,"number":19,"nameArabic":"مريم","nameUz":"Maryam","meaningUz":"Maryam","revelationPlace":"makka","totalAyahs":98,"startPage":305,"createdAt":"2026-09-17T18:45:07.494Z","updatedAt":"2026-09-18T00:07:52.394Z"},"numberInSurah":97,"textArabic":"فَإِنَّمَا يَسَّرْنَـٰهُ بِلِسَانِكَ لِتُبَشِّرَ بِهِ ٱلْمُتَّقِينَ وَتُنذِرَ بِهِۦ قَوْمًا لُّدًّا","translationUz":"Bas, albatta, taqvodorlarga xushxabar berishing va u bilan sarkash qavmlarni ogohlantirishing uchun u(Qur'on)ni tilingga oson qildik.","transcription":null,"tafsirUz":null,"pageNumber":312,"juz":16,"createdAt":"2026-09-17T18:45:32.404Z","updatedAt":"2026-09-17T18:45:32.404Z"},{"id":2348,"surahId":19,"surah":{"id":19,"number":19,"nameArabic":"مريم","nameUz":"Maryam","meaningUz":"Maryam","revelationPlace":"makka","totalAyahs":98,"startPage":305,"createdAt":"2026-09-17T18:45:07.494Z","updatedAt":"2026-09-18T00:07:52.394Z"},"numberInSurah":98,"textArabic":"وَكَمْ أَهْلَكْنَا قَبْلَهُم مِّن قَرْنٍ هَلْ تُحِسُّ مِنْهُم مِّنْ أَحَدٍ أَوْ تَسْمَعُ لَهُمْ رِكْزًۢا","translationUz":"Ulardan oldin qanchadan-qancha asr(ahli)ni halok qildik. Ulardan birortasini his etasanmi yoki sharpasini eshitasanmi?!","transcription":null,"tafsirUz":null,"pageNumber":312,"juz":16,"createdAt":"2026-09-17T18:45:32.408Z","updatedAt":"2026-09-17T18:45:32.408Z"},{"id":2349,"surahId":20,"surah":{"id":20,"number":20,"nameArabic":"طه","nameUz":"Toha","meaningUz":"Toha","revelationPlace":"makka","totalAyahs":135,"startPage":312,"createdAt":"2026-09-17T18:45:07.499Z","updatedAt":"2026-09-18T00:07:52.398Z"},"numberInSurah":1,"textArabic":" طه","translationUz":"Toha.","transcription":null,"tafsirUz":null,"pageNumber":312,"juz":16,"createdAt":"2026-09-17T18:45:33.110Z","updatedAt":"2026-09-17T18:45:33.110Z"},{"id":2350,"surahId":20,"surah":{"id":20,"number":20,"nameArabic":"طه","nameUz":"Toha","meaningUz":"Toha","revelationPlace":"makka","totalAyahs":135,"startPage":312,"createdAt":"2026-09-17T18:45:07.499Z","updatedAt":"2026-09-18T00:07:52.398Z"},"numberInSurah":2,"textArabic":"مَآ أَنزَلْنَا عَلَيْكَ ٱلْقُرْءَانَ لِتَشْقَىٰٓ","translationUz":"Senga Qur'onni badbaxt bo`lishing uchun nozil qilganimiz yo`q.","transcription":null,"tafsirUz":null,"pageNumber":312,"juz":16,"createdAt":"2026-09-17T18:45:33.115Z","updatedAt":"2026-09-17T18:45:33.115Z"},{"id":2351,"surahId":20,"surah":{"id":20,"number":20,"nameArabic":"طه","nameUz":"Toha","meaningUz":"Toha","revelationPlace":"makka","totalAyahs":135,"startPage":312,"createdAt":"2026-09-17T18:45:07.499Z","updatedAt":"2026-09-18T00:07:52.398Z"},"numberInSurah":3,"textArabic":"إِلَّا تَذْكِرَةً لِّمَن يَخْشَىٰ","translationUz":"Magar qo`rqqan kimsalarga eslatma bo`lishi uchun.","transcription":null,"tafsirUz":null,"pageNumber":312,"juz":16,"createdAt":"2026-09-17T18:45:33.119Z","updatedAt":"2026-09-17T18:45:33.119Z"},{"id":2352,"surahId":20,"surah":{"id":20,"number":20,"nameArabic":"طه","nameUz":"Toha","meaningUz":"Toha","revelationPlace":"makka","totalAyahs":135,"startPage":312,"createdAt":"2026-09-17T18:45:07.499Z","updatedAt":"2026-09-18T00:07:52.398Z"},"numberInSurah":4,"textArabic":"تَنزِيلًا مِّمَّنْ خَلَقَ ٱلْأَرْضَ وَٱلسَّمَـٰوَٰتِ ٱلْعُلَى","translationUz":"U, yerni va yuksak osmonlarni yaratgan Zotdan nozil bo`lgandir.","transcription":null,"tafsirUz":null,"pageNumber":312,"juz":16,"createdAt":"2026-09-17T18:45:33.123Z","updatedAt":"2026-09-17T18:45:33.123Z"},{"id":2353,"surahId":20,"surah":{"id":20,"number":20,"nameArabic":"طه","nameUz":"Toha","meaningUz":"Toha","revelationPlace":"makka","totalAyahs":135,"startPage":312,"createdAt":"2026-09-17T18:45:07.499Z","updatedAt":"2026-09-18T00:07:52.398Z"},"numberInSurah":5,"textArabic":"ٱلرَّحْمَـٰنُ عَلَى ٱلْعَرْشِ ٱسْتَوَىٰ","translationUz":"U — Rohman (Zoti va ulug`ligiga munosib ravishda) Arshga ko`tarildi.","transcription":null,"tafsirUz":null,"pageNumber":312,"juz":16,"createdAt":"2026-09-17T18:45:33.130Z","updatedAt":"2026-09-17T18:45:33.130Z"},{"id":2354,"surahId":20,"surah":{"id":20,"number":20,"nameArabic":"طه","nameUz":"Toha","meaningUz":"Toha","revelationPlace":"makka","totalAyahs":135,"startPage":312,"createdAt":"2026-09-17T18:45:07.499Z","updatedAt":"2026-09-18T00:07:52.398Z"},"numberInSurah":6,"textArabic":"لَهُۥ مَا فِى ٱلسَّمَـٰوَٰتِ وَمَا فِى ٱلْأَرْضِ وَمَا بَيْنَهُمَا وَمَا تَحْتَ ٱلثَّرَىٰ","translationUz":"Osmonlardagi narsalaru yerdagi narsalar, ularning orasidagi narsalaru yer ostidagi narsalar Unikidir.","transcription":null,"tafsirUz":null,"pageNumber":312,"juz":16,"createdAt":"2026-09-17T18:45:33.135Z","updatedAt":"2026-09-17T18:45:33.135Z"},{"id":2355,"surahId":20,"surah":{"id":20,"number":20,"nameArabic":"طه","nameUz":"Toha","meaningUz":"Toha","revelationPlace":"makka","totalAyahs":135,"startPage":312,"createdAt":"2026-09-17T18:45:07.499Z","updatedAt":"2026-09-18T00:07:52.398Z"},"numberInSurah":7,"textArabic":"وَإِن تَجْهَرْ بِٱلْقَوْلِ فَإِنَّهُۥ يَعْلَمُ ٱلسِّرَّ وَأَخْفَى","translationUz":"Sen agar so`zda ovozingni yuksaltirsang ham. Bas, albatta, U sirni ham, maxfiyni ham bilguvchidir.","transcription":null,"tafsirUz":null,"pageNumber":312,"juz":16,"createdAt":"2026-09-17T18:45:33.142Z","updatedAt":"2026-09-17T18:45:33.142Z"},{"id":2356,"surahId":20,"surah":{"id":20,"number":20,"nameArabic":"طه","nameUz":"Toha","meaningUz":"Toha","revelationPlace":"makka","totalAyahs":135,"startPage":312,"createdAt":"2026-09-17T18:45:07.499Z","updatedAt":"2026-09-18T00:07:52.398Z"},"numberInSurah":8,"textArabic":"ٱللَّهُ لَآ إِلَـٰهَ إِلَّا هُوَ ۖ لَهُ ٱلْأَسْمَآءُ ٱلْحُسْنَىٰ","translationUz":"Alloh — Undan boshqa ibodatga sazovor iloh yo`q Zotdir. Go`zal ismlar Unikidir.","transcription":null,"tafsirUz":null,"pageNumber":312,"juz":16,"createdAt":"2026-09-17T18:45:33.147Z","updatedAt":"2026-09-17T18:45:33.147Z"},{"id":2357,"surahId":20,"surah":{"id":20,"number":20,"nameArabic":"طه","nameUz":"Toha","meaningUz":"Toha","revelationPlace":"makka","totalAyahs":135,"startPage":312,"createdAt":"2026-09-17T18:45:07.499Z","updatedAt":"2026-09-18T00:07:52.398Z"},"numberInSurah":9,"textArabic":"وَهَلْ أَتَىٰكَ حَدِيثُ مُوسَىٰٓ","translationUz":"Senga Musoning xabari keldimi?","transcription":null,"tafsirUz":null,"pageNumber":312,"juz":16,"createdAt":"2026-09-17T18:45:33.152Z","updatedAt":"2026-09-17T18:45:33.152Z"},{"id":2358,"surahId":20,"surah":{"id":20,"number":20,"nameArabic":"طه","nameUz":"Toha","meaningUz":"Toha","revelationPlace":"makka","totalAyahs":135,"startPage":312,"createdAt":"2026-09-17T18:45:07.499Z","updatedAt":"2026-09-18T00:07:52.398Z"},"numberInSurah":10,"textArabic":"إِذْ رَءَا نَارًا فَقَالَ لِأَهْلِهِ ٱمْكُثُوٓا۟ إِنِّىٓ ءَانَسْتُ نَارًا لَّعَلِّىٓ ءَاتِيكُم مِّنْهَا بِقَبَسٍ أَوْ أَجِدُ عَلَى ٱلنَّارِ هُدًى","translationUz":"U, olovni ko`rgan chog`ida o`z ahliga: «Turib turinglar, men olovni ko`rdim, shoyad, sizga undan cho`g` keltirsam yoki olov boshida yo`l ko`rsatuvchini topsam», dedi.","transcription":null,"tafsirUz":null,"pageNumber":312,"juz":16,"createdAt":"2026-09-17T18:45:33.156Z","updatedAt":"2026-09-17T18:45:33.156Z"},{"id":2359,"surahId":20,"surah":{"id":20,"number":20,"nameArabic":"طه","nameUz":"Toha","meaningUz":"Toha","revelationPlace":"makka","totalAyahs":135,"startPage":312,"createdAt":"2026-09-17T18:45:07.499Z","updatedAt":"2026-09-18T00:07:52.398Z"},"numberInSurah":11,"textArabic":"فَلَمَّآ أَتَىٰهَا نُودِىَ يَـٰمُوسَىٰٓ","translationUz":"Bas, u(olov)ga kelganida, nido qilindi: «Ey Muso.","transcription":null,"tafsirUz":null,"pageNumber":312,"juz":16,"createdAt":"2026-09-17T18:45:33.161Z","updatedAt":"2026-09-17T18:45:33.161Z"},{"id":2360,"surahId":20,"surah":{"id":20,"number":20,"nameArabic":"طه","nameUz":"Toha","meaningUz":"Toha","revelationPlace":"makka","totalAyahs":135,"startPage":312,"createdAt":"2026-09-17T18:45:07.499Z","updatedAt":"2026-09-18T00:07:52.398Z"},"numberInSurah":12,"textArabic":"إِنِّىٓ أَنَا۠ رَبُّكَ فَٱخْلَعْ نَعْلَيْكَ ۖ إِنَّكَ بِٱلْوَادِ ٱلْمُقَدَّسِ طُوًى","translationUz":"Albatta, Men O`zim sening Robbingdirman. Kavushlaringni yech. Chunki, sen muqaddas Tuvo vodiysidasan».","transcription":null,"tafsirUz":null,"pageNumber":312,"juz":16,"createdAt":"2026-09-17T18:45:33.165Z","updatedAt":"2026-09-17T18:45:33.165Z"}]}