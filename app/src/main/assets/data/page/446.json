ات","nameUz":"Soffot","meaningUz":"Saf tortganlar","revelationPlace":"makka","totalAyahs":182,"startPage":446,"createdAt":"2026-09-17T18:45:07.584Z","updatedAt":"2026-09-18T00:07:52.478Z"},"numberInSurah":8,"textArabic":"لَّا يَسَّمَّعُونَ إِلَى ٱلْمَلَإِ ٱلْأَعْلَىٰ وَيُقْذَفُونَ مِن كُلِّ جَانِبٍ","translationUz":"Ular yuksak to`pliqqa quloq sola olmaslar va har tomondan (uchqun-la) otilurlar.","transcription":null,"tafsirUz":null,"pageNumber":446,"juz":23,"createdAt":"2026-09-17T18:45:47.958Z","updatedAt":"2026-09-17T18:45:47.958Z"},{"id":3797,"surahId":37,"surah":{"id":37,"number":37,"nameArabic":"الصافات","nameUz":"Soffot","meaningUz":"Saf tortganlar","revelationPlace":"makka","totalAyahs":182,"startPage":446,"createdAt":"2026-09-17T18:45:07.584Z","updatedAt":"2026-09-18T00:07:52.478Z"},"numberInSurah":9,"textArabic":"دُحُورًا ۖ وَلَهُمْ عَذَابٌ وَاصِبٌ","translationUz":"Haydalurlar! Ular uchun uzluksiz azob bordir.","transcription":null,"tafsirUz":null,"pageNumber":446,"juz":23,"createdAt":"2026-09-17T18:45:47.963Z","updatedAt":"2026-09-17T18:45:47.963Z"},{"id":3798,"surahId":37,"surah":{"id":37,"number":37,"nameArabic":"الصافات","nameUz":"Soffot","meaningUz":"Saf tortganlar","revelationPlace":"makka","totalAyahs":182,"startPage":446,"createdAt":"2026-09-17T18:45:07.584Z","updatedAt":"2026-09-18T00:07:52.478Z"},"numberInSurah":10,"textArabic":"إِلَّا مَنْ خَطِفَ ٱلْخَطْفَةَ فَأَتْبَعَهُۥ شِهَابٌ ثَاقِبٌ","translationUz":"Magar birorta so`zni o`g`rilikcha tinglagan shaxs bo`lsa, uni yoquvchi olov ta'qib etar.","transcription":null,"tafsirUz":null,"pageNumber":446,"juz":23,"createdAt":"2026-09-17T18:45:47.966Z","updatedAt":"2026-09-17T18:45:47.966Z"},{"id":3799,"surahId":37,"surah":{"id":37,"number":37,"nameArabic":"الصافات","nameUz":"Soffot","meaningUz":"Saf tortganlar","revelationPlace":"makka","totalAyahs":182,"startPage":446,"createdAt":"2026-09-17T18:45:07.584Z","updatedAt":"2026-09-18T00:07:52.478Z"},"numberInSurah":11,"textArabic":"فَٱسْتَفْتِهِمْ أَهُمْ أَشَدُّ خَلْقًا أَم مَّنْ خَلَقْنَآ ۚ إِنَّا خَلَقْنَـٰهُم مِّن طِينٍ لَّازِبٍۭ","translationUz":"Bas, sen ulardan so`ra: ularni yaratish qiyinroqmikan yoki Biz yaratgan zotlarni?! Albatta, Biz ularni yopishqoq loydan yaratdik.","transcription":null,"tafsirUz":null,"pageNumber":446,"juz":23,"createdAt":"2026-09-17T18:45:47.970Z","updatedAt":"2026-09-17T18:45:47.970Z"},{"id":3800,"surahId":37,"surah":{"id":37,"number":37,"nameArabic":"الصافات","nameUz":"Soffot","meaningUz":"Saf tortganlar","revelationPlace":"makka","totalAyahs":182,"startPage":446,"createdAt":"2026-09-17T18:45:07.584Z","updatedAt":"2026-09-18T00:07:52.478Z"},"numberInSurah":12,"textArabic":"بَلْ عَجِبْتَ وَيَسْخَرُونَ","translationUz":"Balki sen ajablanding, ular esa masxara qilurlar.","transcription":null,"tafsirUz":null,"pageNumber":446,"juz":23,"createdAt":"2026-09-17T18:45:47.974Z","updatedAt":"2026-09-17T18:45:47.974Z"},{"id":3801,"surahId":37,"surah":{"id":37,"number":37,"nameArabic":"الصافات","nameUz":"Soffot","meaningUz":"Saf tortganlar","revelationPlace":"makka","totalAyahs":182,"startPage":446,"createdAt":"2026-09-17T18:45:07.584Z","updatedAt":"2026-09-18T00:07:52.478Z"},"numberInSurah":13,"textArabic":"وَإِذَا ذُكِّرُوا۟ لَا يَذْكُرُونَ","translationUz":"Qachonki eslatilsalar, eslamaslar.","transcription":null,"tafsirUz":null,"pageNumber":446,"juz":23,"createdAt":"2026-09-17T18:45:47.977Z","updatedAt":"2026-09-17T18:45:47.977Z"},{"id":3802,"surahId":37,"surah":{"id":37,"number":37,"nameArabic":"الصافات","nameUz":"Soffot","meaningUz":"Saf tortganlar","revelationPlace":"makka","totalAyahs":182,"startPage":446,"createdAt":"2026-09-17T18:45:07.584Z","updatedAt":"2026-09-18T00:07:52.478Z"},"numberInSurah":14,"textArabic":"وَإِذَا رَأَوْا۟ ءَايَةً يَسْتَسْخِرُونَ","translationUz":"Qachonki biror oyat(belgi)ni ko`rsalar, qattiqroq masxara qilurlar.","transcription":null,"tafsirUz":null,"pageNumber":446,"juz":23,"createdAt":"2026-09-17T18:45:47.981Z","updatedAt":"2026-09-17T18:45:47.981Z"},{"id":3803,"surahId":37,"surah":{"id":37,"number":37,"nameArabic":"الصافات","nameUz":"Soffot","meaningUz":"Saf tortganlar","revelationPlace":"makka","totalAyahs":182,"startPage":446,"createdAt":"2026-09-17T18:45:07.584Z","updatedAt":"2026-09-18T00:07:52.478Z"},"numberInSurah":15,"textArabic":"وَقَالُوٓا۟ إِنْ هَـٰذَآ إِلَّا سِحْرٌ مُّبِينٌ","translationUz":"Ular: «Bu (Qur'on) ochiq-oydin sehrdan boshqa narsa emas.","transcription":null,"tafsirUz":null,"pageNumber":446,"juz":23,"createdAt":"2026-09-17T18:45:47.984Z","updatedAt":"2026-09-17T18:45:47.984Z"},{"id":3804,"surahId":37,"surah":{"id":37,"number":37,"nameArabic":"الصافات","nameUz":"Soffot","meaningUz":"Saf tortganlar","revelationPlace":"makka","totalAyahs":182,"startPage":446,"createdAt":"2026-09-17T18:45:07.584Z","updatedAt":"2026-09-18T00:07:52.478Z"},"numberInSurah":16,"textArabic":"أَءِذَا مِتْنَا وَكُنَّا تُرَابًا وَعِظَـٰمًا أَءِنَّا لَمَبْعُوثُونَ","translationUz":"O`lsak-da, tuproq va suyak bo`lsak-da, albatta, biz qayta tiriltirilurmizmi?!","transcription":null,"tafsirUz":null,"pageNumber":446,"juz":23,"createdAt":"2026-09-17T18:45:47.988Z","updatedAt":"2026-09-17T18:45:47.988Z"},{"id":3805,"surahId":37,"surah":{"id":37,"number":37,"nameArabic":"الصافات","nameUz":"Soffot","meaningUz":"Saf tortganlar","revelationPlace":"makka","totalAyahs":182,"startPage":446,"createdAt":"2026-09-17T18:45:07.584Z","updatedAt":"2026-09-18T00:07:52.478Z"},"numberInSurah":17,"textArabic":"أَوَءَابَآؤُنَا ٱلْأَوَّلُونَ","translationUz":"Avvalgi ota-bobolarimiz ham-a?!» – dedilar.","transcription":null,"tafsirUz":null,"pageNumber":446,"juz":23,"createdAt":"2026-09-17T18:45:47.992Z","updatedAt":"2026-09-17T18:45:47.992Z"},{"id":3806,"surahId":37,"surah":{"id":37,"number":37,"nameArabic":"الصافات","nameUz":"Soffot","meaningUz":"Saf tortganlar","revelationPlace":"makka","totalAyahs":182,"startPage":446,"createdAt":"2026-09-17T18:45:07.584Z","updatedAt":"2026-09-18T00:07:52.478Z"},"numberInSurah":18,"textArabic":"قُلْ نَعَمْ وَأَنتُمْ دَٰخِرُونَ","translationUz":"Sen: «Ha! Xor bo`lgan hollaringizda!» degin.","transcription":null,"tafsirUz":null,"pageNumber":446,"juz":23,"createdAt":"2026-09-17T18:45:47.996Z","updatedAt":"2026-09-17T18:45:47.996Z"},{"id":3807,"surahId":37,"surah":{"id":37,"number":37,"nameArabic":"الصافات","nameUz":"Soffot","meaningUz":"Saf tortganlar","revelationPlace":"makka","totalAyahs":182,"startPage":446,"createdAt":"2026-09-17T18:45:07.584Z","updatedAt":"2026-09-18T00:07:52.478Z"},"numberInSurah":19,"textArabic":"فَإِنَّمَا هِىَ زَجْرَةٌ وَٰحِدَةٌ فَإِذَا هُمْ يَنظُرُونَ","translationUz":"Bas, u faqatgina bir qichqiriqdan iborat, xolos. Bas, birdan ular nazar solib turibdilar-da!","transcription":null,"tafsirUz":null,"pageNumber":446,"juz":23,"createdAt":"2026-09-17T18:45:48.000Z","updatedAt":"2026-09-17T18:45:48.000Z"},{"id":3808,"surahId":37,"surah":{"id":37,"number":37,"nameArabic":"الصافات","nameUz":"Soffot","meaningUz":"Saf tortganlar","revelationPlace":"makka","totalAyahs":182,"startPage":446,"createdAt":"2026-09-17T18:45:07.584Z","updatedAt":"2026-09-18T00:07:52.478Z"},"numberInSurah":20,"textArabic":"وَقَالُوا۟ يَـٰوَيْلَنَا هَـٰذَا يَوْمُ ٱلدِّينِ","translationUz":"Va ular: «Voh, sho`rimiz qurisin! Bu, jazo kuni-ku!» – derlar.","transcription":null,"tafsirUz":null,"pageNumber":446,"juz":23,"createdAt":"2026-09-17T18:45:48.004Z","updatedAt":"2026-09-17T18:45:48.004Z"},{"id":3809,"surahId":37,"surah":{"id":37,"number":37,"nameArabic":"الصافات","nameUz":"Soffot","meaningUz":"Saf tortganlar","revelationPlace":"makka","totalAyahs":182,"startPage":446,"createdAt":"2026-09-17T18:45:07.584Z","updatedAt":"2026-09-18T00:07:52.478Z"},"numberInSurah":21,"textArabic":"هَـٰذَا يَوْمُ ٱلْفَصْلِ ٱلَّذِى كُنتُم بِهِۦ تُكَذِّبُونَ","translationUz":"«Bu, sizlar yolg`onga chiqarib yurgan ajrim kunidir.","transcription":null,"tafsirUz":null,"pageNumber":446,"juz":23,"createdAt":"2026-09-17T18:45:48.009Z","updatedAt":"2026-09-17T18:45:48.009Z"},{"id":3810,"surahId":37,"surah":{"id":37,"number":37,"nameArabic":"الصافات","nameUz":"Soffot","meaningUz":"Saf tortganlar","revelationPlace":"makka","totalAyahs":182,"startPage":446,"createdAt":"2026-09-17T18:45:07.584Z","updatedAt":"2026-09-18T00:07:52.478Z"},"numberInSurah":22,"textArabic":"۞ ٱحْشُرُوا۟ ٱلَّذِينَ ظَلَمُوا۟ وَأَزْوَٰجَهُمْ وَمَا كَانُوا۟ يَعْبُدُونَ","translationUz":"Zulm qilganlarni, ularning juftlarini va ular ibodat qilib yurgan...","transcription":null,"tafsirUz":null,"pageNumber":446,"juz":23,"createdAt":"2026-09-17T18:45:48.013Z","updatedAt":"2026-09-17T18:45:48.013Z"},{"id":3811,"surahId":37,"surah":{"id":37,"number":37,"nameArabic":"الصافات","nameUz":"Soffot","meaningUz":"Saf tortganlar","revelationPlace":"makka","totalAyahs":182,"startPage":446,"createdAt":"2026-09-17T18:45:07.584Z","updatedAt":"2026-09-18T00:07:52.478Z"},"numberInSurah":23,"textArabic":"مِن دُونِ ٱللَّهِ فَٱهْدُوهُمْ إِلَىٰ صِرَٰطِ ٱلْجَحِيمِ","translationUz":"Allohdan o`zga narsalarini to`planglar. Bas, ularni jahiym yo`liga hidoyat qiling» (deyilur).","transcription":null,"tafsirUz":null,"pageNumber":446,"juz":23,"createdAt":"2026-09-17T18:45:48.017Z","updatedAt":"2026-09-17T18:45:48.017Z"},{"id":3812,"surahId":37,"surah":{"id":37,"number":37,"nameArabic":"الصافات","nameUz":"Soffot","meaningUz":"Saf tortganlar","revelationPlace":"makka","totalAyahs":182,"startPage":446,"createdAt":"2026-09-17T18:45:07.584Z","updatedAt":"2026-09-18T00:07:52.478Z"},"numberInSurah":24,"textArabic":"وَقِفُوهُمْ ۖ إِنَّهُم مَّسْـُٔولُونَ","translationUz":"Va ularni to`xtatinglar! Albatta, ular so`ralguvchidirlar.","transcription":null,"tafsirUz":null,"pageNumber":446,"juz":23,"createdAt":"2026-09-17T18:45:48.021Z","updatedAt":"2026-09-17T18:45:48.021Z"}]}