rah":4,"textArabic":"وَٱلَّذِينَ يُؤْمِنُونَ بِمَآ أُنزِلَ إِلَيْكَ وَمَآ أُنزِلَ مِن قَبْلِكَ وَبِٱلْـَٔاخِرَةِ هُمْ يُوقِنُونَ","translationUz":"Va ular senga va sendan oldin nozil qilingan narsaga iymon keltirarlar va oxiratga aniq ishonarlar.","transcription":null,"tafsirUz":null,"pageNumber":2,"juz":1,"createdAt":"2026-09-17T18:45:09.474Z","updatedAt":"2026-09-17T18:45:09.474Z"},{"id":12,"surahId":2,"surah":{"id":2,"number":2,"nameArabic":"البقرة","nameUz":"Baqara","meaningUz":"Sigir","revelationPlace":"madina","totalAyahs":286,"startPage":2,"createdAt":"2026-09-17T18:45:07.405Z","updatedAt":"2026-09-18T00:07:52.297Z"},"numberInSurah":5,"textArabic":"أُو۟لَـٰٓئِكَ عَلَىٰ هُدًى مِّن رَّبِّهِمْ ۖ وَأُو۟لَـٰٓئِكَ هُمُ ٱلْمُفْلِحُونَ","translationUz":"Ana o`shalar Robbilaridan bo`lgan hidoyatdadirlar va ana o`shalar, o`shalargina najot topguvchilardir.","transcription":null,"tafsirUz":null,"pageNumber":2,"juz":1,"createdAt":"2026-09-17T18:45:09.480Z","updatedAt":"2026-09-17T18:45:09.480Z"}]}