21Z","updatedAt":"2026-09-17T18:45:27.521Z"},{"id":1880,"surahId":15,"surah":{"id":15,"number":15,"nameArabic":"الحجر","nameUz":"Hijr","meaningUz":"Hijr vodiysi","revelationPlace":"makka","totalAyahs":99,"startPage":262,"createdAt":"2026-09-17T18:45:07.474Z","updatedAt":"2026-09-18T00:07:52.373Z"},"numberInSurah":78,"textArabic":"وَإِن كَانَ أَصْحَـٰبُ ٱلْأَيْكَةِ لَظَـٰلِمِينَ","translationUz":"Albatta, bir-biriga kirishib ketgan daraxtzor egalari zolimlardan bo`lganlar.","transcription":null,"tafsirUz":null,"pageNumber":266,"juz":14,"createdAt":"2026-09-17T18:45:27.524Z","updatedAt":"2026-09-17T18:45:27.524Z"},{"id":1881,"surahId":15,"surah":{"id":15,"number":15,"nameArabic":"الحجر","nameUz":"Hijr","meaningUz":"Hijr vodiysi","revelationPlace":"makka","totalAyahs":99,"startPage":262,"createdAt":"2026-09-17T18:45:07.474Z","updatedAt":"2026-09-18T00:07:52.373Z"},"numberInSurah":79,"textArabic":"فَٱنتَقَمْنَا مِنْهُمْ وَإِنَّهُمَا لَبِإِمَامٍ مُّبِينٍ","translationUz":"Bas, Biz ulardan intiqom oldik. Albatta, ularning ikkovlari ham ochiq yo`l ustidadir.","transcription":null,"tafsirUz":null,"pageNumber":266,"juz":14,"createdAt":"2026-09-17T18:45:27.528Z","updatedAt":"2026-09-17T18:45:27.528Z"},{"id":1882,"surahId":15,"surah":{"id":15,"number":15,"nameArabic":"الحجر","nameUz":"Hijr","meaningUz":"Hijr vodiysi","revelationPlace":"makka","totalAyahs":99,"startPage":262,"createdAt":"2026-09-17T18:45:07.474Z","updatedAt":"2026-09-18T00:07:52.373Z"},"numberInSurah":80,"textArabic":"وَلَقَدْ كَذَّبَ أَصْحَـٰبُ ٱلْحِجْرِ ٱلْمُرْسَلِينَ","translationUz":"Batahqiq, Hijr egalari Payg`ambarlarni yolg`onchiga chiqardilar.","transcription":null,"tafsirUz":null,"pageNumber":266,"juz":14,"createdAt":"2026-09-17T18:45:27.532Z","updatedAt":"2026-09-17T18:45:27.532Z"},{"id":1883,"surahId":15,"surah":{"id":15,"number":15,"nameArabic":"الحجر","nameUz":"Hijr","meaningUz":"Hijr vodiysi","revelationPlace":"makka","totalAyahs":99,"startPage":262,"createdAt":"2026-09-17T18:45:07.474Z","updatedAt":"2026-09-18T00:07:52.373Z"},"numberInSurah":81,"textArabic":"وَءَاتَيْنَـٰهُمْ ءَايَـٰتِنَا فَكَانُوا۟ عَنْهَا مُعْرِضِينَ","translationUz":"Va ularga oyatlarimizni berdik. Bas, yuz o`giruvchi bo`ldilar.","transcription":null,"tafsirUz":null,"pageNumber":266,"juz":14,"createdAt":"2026-09-17T18:45:27.536Z","updatedAt":"2026-09-17T18:45:27.536Z"},{"id":1884,"surahId":15,"surah":{"id":15,"number":15,"nameArabic":"الحجر","nameUz":"Hijr","meaningUz":"Hijr vodiysi","revelationPlace":"makka","totalAyahs":99,"startPage":262,"createdAt":"2026-09-17T18:45:07.474Z","updatedAt":"2026-09-18T00:07:52.373Z"},"numberInSurah":82,"textArabic":"وَكَانُوا۟ يَنْحِتُونَ مِنَ ٱلْجِبَالِ بُيُوتًا ءَامِنِينَ","translationUz":"Ular tog`dan o`yib uy yasab, omonlikda yurar edilar.","transcription":null,"tafsirUz":null,"pageNumber":266,"juz":14,"createdAt":"2026-09-17T18:45:27.540Z","updatedAt":"2026-09-17T18:45:27.540Z"},{"id":1885,"surahId":15,"surah":{"id":15,"number":15,"nameArabic":"الحجر","nameUz":"Hijr","meaningUz":"Hijr vodiysi","revelationPlace":"makka","totalAyahs":99,"startPage":262,"createdAt":"2026-09-17T18:45:07.474Z","updatedAt":"2026-09-18T00:07:52.373Z"},"numberInSurah":83,"textArabic":"فَأَخَذَتْهُمُ ٱلصَّيْحَةُ مُصْبِحِينَ","translationUz":"Bas, subhidam chog`ida ularni qattiq qichqiriq tutdi.","transcription":null,"tafsirUz":null,"pageNumber":266,"juz":14,"createdAt":"2026-09-17T18:45:27.543Z","updatedAt":"2026-09-17T18:45:27.543Z"},{"id":1886,"surahId":15,"surah":{"id":15,"number":15,"nameArabic":"الحجر","nameUz":"Hijr","meaningUz":"Hijr vodiysi","revelationPlace":"makka","totalAyahs":99,"startPage":262,"createdAt":"2026-09-17T18:45:07.474Z","updatedAt":"2026-09-18T00:07:52.373Z"},"numberInSurah":84,"textArabic":"فَمَآ أَغْنَىٰ عَنْهُم مَّا كَانُوا۟ يَكْسِبُونَ","translationUz":"Qilgan kasblari ularga biron foyda bermadi.","transcription":null,"tafsirUz":null,"pageNumber":266,"juz":14,"createdAt":"2026-09-17T18:45:27.546Z","updatedAt":"2026-09-17T18:45:27.546Z"},{"id":1887,"surahId":15,"surah":{"id":15,"number":15,"nameArabic":"الحجر","nameUz":"Hijr","meaningUz":"Hijr vodiysi","revelationPlace":"makka","totalAyahs":99,"startPage":262,"createdAt":"2026-09-17T18:45:07.474Z","updatedAt":"2026-09-18T00:07:52.373Z"},"numberInSurah":85,"textArabic":"وَمَا خَلَقْنَا ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضَ وَمَا بَيْنَهُمَآ إِلَّا بِٱلْحَقِّ ۗ وَإِنَّ ٱلسَّاعَةَ لَـَٔاتِيَةٌ ۖ فَٱصْفَحِ ٱلصَّفْحَ ٱلْجَمِيلَ","translationUz":"Biz osmonlaru yerni va ulardagi narsalarni haq ila yaratdik. Albatta, qiyomat kelguvchidir. Bas, sen go`zal shaklda yuz o`gir.","transcription":null,"tafsirUz":null,"pageNumber":266,"juz":14,"createdAt":"2026-09-17T18:45:27.550Z","updatedAt":"2026-09-17T18:45:27.550Z"},{"id":1888,"surahId":15,"surah":{"id":15,"number":15,"nameArabic":"الحجر","nameUz":"Hijr","meaningUz":"Hijr vodiysi","revelationPlace":"makka","totalAyahs":99,"startPage":262,"createdAt":"2026-09-17T18:45:07.474Z","updatedAt":"2026-09-18T00:07:52.373Z"},"numberInSurah":86,"textArabic":"إِنَّ رَبَّكَ هُوَ ٱلْخَلَّـٰقُ ٱلْعَلِيمُ","translationUz":"Albatta, Robbing yaratguvchi va bilguvchi Zotdir.","transcription":null,"tafsirUz":null,"pageNumber":266,"juz":14,"createdAt":"2026-09-17T18:45:27.554Z","updatedAt":"2026-09-17T18:45:27.554Z"},{"id":1889,"surahId":15,"surah":{"id":15,"number":15,"nameArabic":"الحجر","nameUz":"Hijr","meaningUz":"Hijr vodiysi","revelationPlace":"makka","totalAyahs":99,"startPage":262,"createdAt":"2026-09-17T18:45:07.474Z","updatedAt":"2026-09-18T00:07:52.373Z"},"numberInSurah":87,"textArabic":"وَلَقَدْ ءَاتَيْنَـٰكَ سَبْعًا مِّنَ ٱلْمَثَانِى وَٱلْقُرْءَانَ ٱلْعَظِيمَ","translationUz":"Va, batahqiq, senga yetti takrorlanuvchini va Ulug` Qur'onni berdik.","transcription":null,"tafsirUz":null,"pageNumber":266,"juz":14,"createdAt":"2026-09-17T18:45:27.558Z","updatedAt":"2026-09-17T18:45:27.558Z"},{"id":1890,"surahId":15,"surah":{"id":15,"number":15,"nameArabic":"الحجر","nameUz":"Hijr","meaningUz":"Hijr vodiysi","revelationPlace":"makka","totalAyahs":99,"startPage":262,"createdAt":"2026-09-17T18:45:07.474Z","updatedAt":"2026-09-18T00:07:52.373Z"},"numberInSurah":88,"textArabic":"لَا تَمُدَّنَّ عَيْنَيْكَ إِلَىٰ مَا مَتَّعْنَا بِهِۦٓ أَزْوَٰجًا مِّنْهُمْ وَلَا تَحْزَنْ عَلَيْهِمْ وَٱخْفِضْ جَنَاحَكَ لِلْمُؤْمِنِينَ","translationUz":"Biz ulardan ba'zi guruhlarni bahramand qilgan narsalarga (havas-la) nazar solma! Ular uchun xafa ham bo`lma! Mo`minlarga qanotingni pastlat!","transcription":null,"tafsirUz":null,"pageNumber":266,"juz":14,"createdAt":"2026-09-17T18:45:27.562Z","updatedAt":"2026-09-17T18:45:27.562Z"},{"id":1891,"surahId":15,"surah":{"id":15,"number":15,"nameArabic":"الحجر","nameUz":"Hijr","meaningUz":"Hijr vodiysi","revelationPlace":"makka","totalAyahs":99,"startPage":262,"createdAt":"2026-09-17T18:45:07.474Z","updatedAt":"2026-09-18T00:07:52.373Z"},"numberInSurah":89,"textArabic":"وَقُلْ إِنِّىٓ أَنَا ٱلنَّذِيرُ ٱلْمُبِينُ","translationUz":"Va: «Albatta, men ochiq-oydin ogohlantirguvchiman», deb ayt.","transcription":null,"tafsirUz":null,"pageNumber":266,"juz":14,"createdAt":"2026-09-17T18:45:27.566Z","updatedAt":"2026-09-17T18:45:27.566Z"},{"id":1892,"surahId":15,"surah":{"id":15,"number":15,"nameArabic":"الحجر","nameUz":"Hijr","meaningUz":"Hijr vodiysi","revelationPlace":"makka","totalAyahs":99,"startPage":262,"createdAt":"2026-09-17T18:45:07.474Z","updatedAt":"2026-09-18T00:07:52.373Z"},"numberInSurah":90,"textArabic":"كَمَآ أَنزَلْنَا عَلَى ٱلْمُقْتَسِمِينَ","translationUz":"Xuddi taqsimlovchilarga tushirganimizga o`xshash.","transcription":null,"tafsirUz":null,"pageNumber":266,"juz":14,"createdAt":"2026-09-17T18:45:27.569Z","updatedAt":"2026-09-17T18:45:27.569Z"}]}