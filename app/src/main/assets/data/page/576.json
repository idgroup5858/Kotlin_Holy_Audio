-shubha qilmasliklari uchun va qalblarida kasali borlar (munofiqlar) va kofirlar, Alloh bu bilan nima misolni iroda qilmoqchi, deyishlari uchun. Shundoq qilib, Alloh xohlagan kimsani adashtirur va xohlagan kimsani hidoyatga solur. Robbingning askarlarini O`zidan boshqa hech kim bilmas. Va u (do`zax) bashar uchun eslatmadan o`zga hech narsa emas.","transcription":null,"tafsirUz":null,"pageNumber":576,"juz":29,"createdAt":"2026-09-17T18:46:06.169Z","updatedAt":"2026-09-17T18:46:06.169Z"},{"id":5527,"surahId":74,"surah":{"id":74,"number":74,"nameArabic":"المدثر","nameUz":"Muddassir","meaningUz":"Kiyinib olgan","revelationPlace":"makka","totalAyahs":56,"startPage":575,"createdAt":"2026-09-17T18:45:07.764Z","updatedAt":"2026-09-18T00:07:52.626Z"},"numberInSurah":32,"textArabic":"كَلَّا وَٱلْقَمَرِ","translationUz":"Yo`q! Oy bilan qasam.","transcription":null,"tafsirUz":null,"pageNumber":576,"juz":29,"createdAt":"2026-09-17T18:46:06.173Z","updatedAt":"2026-09-17T18:46:06.173Z"},{"id":5528,"surahId":74,"surah":{"id":74,"number":74,"nameArabic":"المدثر","nameUz":"Muddassir","meaningUz":"Kiyinib olgan","revelationPlace":"makka","totalAyahs":56,"startPage":575,"createdAt":"2026-09-17T18:45:07.764Z","updatedAt":"2026-09-18T00:07:52.626Z"},"numberInSurah":33,"textArabic":"وَٱلَّيْلِ إِذْ أَدْبَرَ","translationUz":"Va chekinayotgan tun bilan qasam.","transcription":null,"tafsirUz":null,"pageNumber":576,"juz":29,"createdAt":"2026-09-17T18:46:06.177Z","updatedAt":"2026-09-17T18:46:06.177Z"},{"id":5529,"surahId":74,"surah":{"id":74,"number":74,"nameArabic":"المدثر","nameUz":"Muddassir","meaningUz":"Kiyinib olgan","revelationPlace":"makka","totalAyahs":56,"startPage":575,"createdAt":"2026-09-17T18:45:07.764Z","updatedAt":"2026-09-18T00:07:52.626Z"},"numberInSurah":34,"textArabic":"وَٱلصُّبْحِ إِذَآ أَسْفَرَ","translationUz":"Va yorishayotgan tong bilan qasam.","transcription":null,"tafsirUz":null,"pageNumber":576,"juz":29,"createdAt":"2026-09-17T18:46:06.181Z","updatedAt":"2026-09-