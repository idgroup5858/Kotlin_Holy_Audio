 هُمْ لِلزَّكَوٰةِ فَـٰعِلُونَ","translationUz":"Ular zakotni ado qilguvchilardir.","transcription":null,"tafsirUz":null,"pageNumber":342,"juz":18,"createdAt":"2026-09-17T18:45:36.174Z","updatedAt":"2026-09-17T18:45:36.174Z"},{"id":2678,"surahId":23,"surah":{"id":23,"number":23,"nameArabic":"المؤمنون","nameUz":"Moʻminun","meaningUz":"Moʻminlar","revelationPlace":"makka","totalAyahs":118,"startPage":342,"createdAt":"2026-09-17T18:45:07.515Z","updatedAt":"2026-09-18T00:07:52.412Z"},"numberInSurah":5,"textArabic":"وَٱلَّذِينَ هُمْ لِفُرُوجِهِمْ حَـٰفِظُونَ","translationUz":"Ular farjlarini saqlovchilardir.","transcription":null,"tafsirUz":null,"pageNumber":342,"juz":18,"createdAt":"2026-09-17T18:45:36.178Z","updatedAt":"2026-09-17T18:45:36.178Z"},{"id":2679,"surahId":23,"surah":{"id":23,"number":23,"nameArabic":"المؤمنون","nameUz":"Moʻminun","meaningUz":"Moʻminlar","revelationPlace":"makka","totalAyahs":118,"startPage":342,"createdAt":"2026-09-17T18:45:07.515Z","updatedAt":"2026-09-18T00:07:52.412Z"},"numberInSurah":6,"textArabic":"إِلَّا عَلَىٰٓ أَزْوَٰجِهِمْ أَوْ مَا مَلَكَتْ أَيْمَـٰنُهُمْ فَإِنَّهُمْ غَيْرُ مَلُومِينَ","translationUz":"Magar o`z jufti halollari va qo`llarida mulk bo`lganlardan (saqlamasalar), albatta, ular malomat qilinguvchi emaslar.","transcription":null,"tafsirUz":null,"pageNumber":342,"juz":18,"createdAt":"2026-09-17T18:45:36.182Z","updatedAt":"2026-09-17T18:45:36.182Z"},{"id":2680,"surahId":23,"surah":{"id":23,"number":23,"nameArabic":"المؤمنون","nameUz":"Moʻminun","meaningUz":"Moʻminlar","revelationPlace":"makka","totalAyahs":118,"startPage":342,"createdAt":"2026-09-17T18:45:07.515Z","updatedAt":"2026-09-18T00:07:52.412Z"},"numberInSurah":7,"textArabic":"فَمَنِ ٱبْتَغَىٰ وَرَآءَ ذَٰلِكَ فَأُو۟لَـٰٓئِكَ هُمُ ٱلْعَادُونَ","translationUz":"Kim ana shundan boshqani talab qilsa, bas, ana o`shalar tajovuzkorlardir.","transcription":null,"tafsirUz":null,"pageNumber":342,"juz":18,"createdAt":"2026-09-17T18:45:36.186Z","updatedAt":"2026-09-17T18:45:36.186Z"},{"id":2681,"surahId":23,"surah":{"id":23,"number":23,"nameArabic":"المؤمنون","nameUz":"Moʻminun","meaningUz":"Moʻminlar","revelationPlace":"makka","totalAyahs":118,"startPage":342,"createdAt":"2026-09-17T18:45:07.515Z","updatedAt":"2026-09-18T00:07:52.412Z"},"numberInSurah":8,"textArabic":"وَٱلَّذِينَ هُمْ لِأَمَـٰنَـٰتِهِمْ وَعَهْدِهِمْ رَٰعُونَ","translationUz":"Ular omonatlariga va ahdlariga rioya qilguvchilardir.","transcription":null,"tafsirUz":null,"pageNumber":342,"juz":18,"createdAt":"2026-09-17T18:45:36.190Z","updatedAt":"2026-09-17T18:45:36.190Z"},{"id":2682,"surahId":23,"surah":{"id":23,"number":23,"nameArabic":"المؤمنون","nameUz":"Moʻminun","meaningUz":"Moʻminlar","revelationPlace":"makka","totalAyahs":118,"startPage":342,"createdAt":"2026-09-17T18:45:07.515Z","updatedAt":"2026-09-18T00:07:52.412Z"},"numberInSurah":9,"textArabic":"وَٱلَّذِينَ هُمْ عَلَىٰ صَلَوَٰتِهِمْ يُحَافِظُونَ","translationUz":"Ular namozlarini muhofaza qilguvchilardir.","transcription":null,"tafsirUz":null,"pageNumber":342,"juz":18,"createdAt":"2026-09-17T18:45:36.195Z","updatedAt":"2026-09-17T18:45:36.195Z"},{"id":2683,"surahId":23,"surah":{"id":23,"number":23,"nameArabic":"المؤمنون","nameUz":"Moʻminun","meaningUz":"Moʻminlar","revelationPlace":"makka","totalAyahs":118,"startPage":342,"createdAt":"2026-09-17T18:45:07.515Z","updatedAt":"2026-09-18T00:07:52.412Z"},"numberInSurah":10,"textArabic":"أُو۟لَـٰٓئِكَ هُمُ ٱلْوَٰرِثُونَ","translationUz":"Ana o`shalar voris bo`lguvchilardir.","transcription":null,"tafsirUz":null,"pageNumber":342,"juz":18,"createdAt":"2026-09-17T18:45:36.199Z","updatedAt":"2026-09-17T18:45:36.199Z"},{"id":2684,"surahId":23,"surah":{"id":23,"number":23,"nameArabic":"المؤمنون","nameUz":"Moʻminun","meaningUz":"Moʻminlar","revelationPlace":"makka","totalAyahs":118,"startPage":342,"createdAt":"2026-09-17T18:45:07.515Z","updatedAt":"2026-09-18T00:07:52.412Z"},"numberInSurah":11,"textArabic":"ٱلَّذِينَ يَرِثُونَ ٱلْفِرْدَوْسَ هُمْ فِيهَا خَـٰلِدُونَ","translationUz":"Ular Firdavs (jannati)ni meros olurlar, ular unda abadiy qolguvchilardir.","transcription":null,"tafsirUz":null,"pageNumber":342,"juz":18,"createdAt":"2026-09-17T18:45:36.203Z","updatedAt":"2026-09-17T18:45:36.203Z"},{"id":2685,"surahId":23,"surah":{"id":23,"number":23,"nameArabic":"المؤمنون","nameUz":"Moʻminun","meaningUz":"Moʻminlar","revelationPlace":"makka","totalAyahs":118,"startPage":342,"createdAt":"2026-09-17T18:45:07.515Z","updatedAt":"2026-09-18T00:07:52.412Z"},"numberInSurah":12,"textArabic":"وَلَقَدْ خَلَقْنَا ٱلْإِنسَـٰنَ مِن سُلَـٰلَةٍ مِّن طِينٍ","translationUz":"Qasamki, batahqiq, insonni loy sulolasidan yaratdik.","transcription":null,"tafsirUz":null,"pageNumber":342,"juz":18,"createdAt":"2026-09-17T18:45:36.207Z","updatedAt":"2026-09-17T18:45:36.207Z"},{"id":2686,"surahId":23,"surah":{"id":23,"number":23,"nameArabic":"المؤمنون","nameUz":"Moʻminun","meaningUz":"Moʻminlar","revelationPlace":"makka","totalAyahs":118,"startPage":342,"createdAt":"2026-09-17T18:45:07.515Z","updatedAt":"2026-09-18T00:07:52.412Z"},"numberInSurah":13,"textArabic":"ثُمَّ جَعَلْنَـٰهُ نُطْفَةً فِى قَرَارٍ مَّكِينٍ","translationUz":"So`ngra uni mustahkam qarorgohda nutfa qildik.","transcription":null,"tafsirUz":null,"pageNumber":342,"juz":18,"createdAt":"2026-09-17T18:45:36.212Z","updatedAt":"2026-09-17T18:45:36.212Z"},{"id":2687,"surahId":23,"surah":{"id":23,"number":23,"nameArabic":"المؤمنون","nameUz":"Moʻminun","meaningUz":"Moʻminlar","revelationPlace":"makka","totalAyahs":118,"startPage":342,"createdAt":"2026-09-17T18:45:07.515Z","updatedAt":"2026-09-18T00:07:52.412Z"},"numberInSurah":14,"textArabic":"ثُمَّ خَلَقْنَا ٱلنُّطْفَةَ عَلَقَةً فَخَلَقْنَا ٱلْعَلَقَةَ مُضْغَةً فَخَلَقْنَا ٱلْمُضْغَةَ عِظَـٰمًا فَكَسَوْنَا ٱلْعِظَـٰمَ لَحْمًا ثُمَّ أَنشَأْنَـٰهُ خَلْقًا ءَاخَرَ ۚ فَتَبَارَكَ ٱللَّهُ أَحْسَنُ ٱلْخَـٰلِقِينَ","translationUz":"So`ngra nutfadan alaqa yaratdik, alaqadan chaynalgan go`sht yaratdik, chaynalgan parcha go`shtdan suyak yaratdik, bas, suyakka go`sht qopladik, so`ngra uni boshqa bir jonzot etib paydo qildik. Bas, yaratguvchilarning eng yaxshisi Alloh barakotli va buyukdir.","transcription":null,"tafsirUz":null,"pageNumber":342,"juz":18,"createdAt":"2026-09-17T18:45:36.216Z","updatedAt":"2026-09-17T18:45:36.216Z"},{"id":2688,"surahId":23,"surah":{"id":23,"number":23,"nameArabic":"المؤمنون","nameUz":"Moʻminun","meaningUz":"Moʻminlar","revelationPlace":"makka","totalAyahs":118,"startPage":342,"createdAt":"2026-09-17T18:45:07.515Z","updatedAt":"2026-09-18T00:07:52.412Z"},"numberInSurah":15,"textArabic":"ثُمَّ إِنَّكُم بَعْدَ ذَٰلِكَ لَمَيِّتُونَ","translationUz":"So`ngra, albatta, sizlar bundan keyin o`lguvchilardirsiz.","transcription":null,"tafsirUz":null,"pageNumber":342,"juz":18,"createdAt":"2026-09-17T18:45:36.219Z","updatedAt":"2026-09-17T18:45:36.219Z"},{"id":2689,"surahId":23,"surah":{"id":23,"number":23,"nameArabic":"المؤمنون","nameUz":"Moʻminun","meaningUz":"Moʻminlar","revelationPlace":"makka","totalAyahs":118,"startPage":342,"createdAt":"2026-09-17T18:45:07.515Z","updatedAt":"2026-09-18T00:07:52.412Z"},"numberInSurah":16,"textArabic":"ثُمَّ إِنَّكُمْ يَوْمَ ٱلْقِيَـٰمَةِ تُبْعَثُونَ","translationUz":"So`ngra, albatta, sizlar qiyomat kuni qayta tiriltirilursiz.","transcription":null,"tafsirUz":null,"pageNumber":342,"juz":18,"createdAt":"2026-09-17T18:45:36.223Z","updatedAt":"2026-09-17T18:45:36.223Z"},{"id":2690,"surahId":23,"surah":{"id":23,"number":23,"nameArabic":"المؤمنون","nameUz":"Moʻminun","meaningUz":"Moʻminlar","revelationPlace":"makka","totalAyahs":118,"startPage":342,"createdAt":"2026-09-17T18:45:07.515Z","updatedAt":"2026-09-18T00:07:52.412Z"},"numberInSurah":17,"textArabic":"وَلَقَدْ خَلَقْنَا فَوْقَكُمْ سَبْعَ طَرَآئِقَ وَمَا كُنَّا عَنِ ٱلْخَلْقِ غَـٰفِلِينَ","translationUz":"Batahqiq, Biz ustingizda yetti yo`lni yaratdik. Biz maxluqotdan g`ofil bo`lgan emasmiz.","transcription":null,"tafsirUz":null,"pageNumber":342,"juz":18,"createdAt":"2026-09-17T18:45:36.228Z","updatedAt":"2026-09-17T18:45:36.228Z"}]}