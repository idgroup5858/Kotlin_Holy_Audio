{"number":444,"textArabic":null,"translationUz":null,"juz":null,"note":null,"updatedAt":null,"ayahs":[{"id":3760,"surahId":36,"surah":{"id":36,"number":36,"nameArabic":"يس","nameUz":"Yosin","meaningUz":"Yosin","revelationPlace":"makka","totalAyahs":83,"startPage":440,"createdAt":"2026-09-17T18:45:07.579Z","updatedAt":"2026-09-18T00:07:52.474Z"},"numberInSurah":55,"textArabic":"إِنَّ أَصْحَـٰبَ ٱلْجَنَّةِ ٱلْيَوْمَ فِى شُغُلٍ فَـٰكِهُونَ","translationUz":"Albatta, jannat egalari u kunda rohatlanish ila mashg`ullar.","transcription":null,"tafsirUz":null,"pageNumber":444,"juz":23,"createdAt":"2026-09-17T18:45:46.994Z","updatedAt":"2026-09-17T18:45:46.994Z"},{"id":3761,"surahId":36,"surah":{"id":36,"number":36,"nameArabic":"يس","nameUz":"Yosin","meaningUz":"Yosin","revelationPlace":"makka","totalAyahs":83,"startPage":440,"createdAt":"2026-09-17T18:45:07.579Z","updatedAt":"2026-09-18T00:07:52.474Z"},"numberInSurah":56,"textArabic":"هُمْ وَأَزْوَٰجُهُمْ فِى ظِلَـٰلٍ عَلَى ٱلْأَرَآئِكِ مُتَّكِـُٔونَ","translationUz":"Ular va ularning juftlari soyalarda so`rilarda yonboshlab yoturlar.","transcription":null,"tafsirUz":null,"pageNumber":444,"juz":23,"createdAt":"2026-09-17T18:45:46.997Z","updatedAt":"2026-09-17T18:45:46.997Z"},{"id":3762,"surahId":36,"surah":{"id":36,"number":36,"nameArabic":"يس","nameUz":"Yosin","meaningUz":"Yosin","revelationPlace":"makka","totalAyahs":83,"startPage":440,"createdAt":"2026-09-17T18:45:07.579Z","updatedAt":"2026-09-18T00:07:52.474Z"},"numberInSurah":57,"textArabic":"لَهُمْ فِيهَا فَـٰكِهَةٌ وَلَهُم مَّا يَدَّعُونَ","translationUz":"Ular uchun u yerda mevalar bordir. Ular uchun u yerda istagan narsalari bordir.","transcription":null,"tafsirUz":null,"pageNumber":444,"juz":23,"createdAt":"2026-09-17T18:45:47.001Z","updatedAt":"2026-09-17T18:45:47.001Z"},{"id":3763,"surahId":36,"surah":{"id":36,"number":36,"nameArabic":"يس","nameUz":"Yosin","meaningUz":"Yosin","revelationPlace":"makka","totalAyahs":83,"startPage":440,"createdAt":"2026-09-17T18:45:07.579Z","updatedAt":"2026-09-18T00:07:52.474Z"},"numberInSurah":58,"textArabic":"سَلَـٰمٌ قَوْلًا مِّن رَّبٍّ رَّحِيمٍ","translationUz":"Rohiym bo`lgan zot Robbdan «Salom» so`zi bordir.","transcription":null,"tafsirUz":null,"pageNumber":444,"juz":23,"createdAt":"2026-09-17T18:45:47.005Z","updatedAt":"2026-09-17T18:45:47.005Z"},{"id":3764,"surahId":36,"surah":{"id":36,"number":36,"nameArabic":"يس","nameUz":"Yosin","meaningUz":"Yosin","revelationPlace":"makka","totalAyahs":83,"startPage":440,"createdAt":"2026-09-17T18:45:07.579Z","updatedAt":"2026-09-18T00:07:52.474Z"},"numberInSurah":59,"textArabic":"وَٱمْتَـٰزُوا۟ ٱلْيَوْمَ أَيُّهَا ٱلْمُجْرِمُونَ","translationUz":"Ey, jinoyatchilar! Bugungi kunda siz ajralingiz!","transcription":null,"tafsirUz":null,"pageNumber":444,"juz":23,"createdAt":"2026-09-17T18:45:47.009Z","updatedAt":"2026-09-17T18:45:47.009Z"},{"id":3765,"surahId":36,"surah":{"id":36,"number":36,"nameArabic":"يس","nameUz":"Yosin","meaningUz":"Yosin","revelationPlace":"makka","totalAyahs":83,"startPage":440,"createdAt":"2026-09-17T18:45:07.579Z","updatedAt":"2026-09-18T00:07:52.474Z"},"numberInSurah":60,"textArabic":"۞ أَلَمْ أَعْهَدْ إِلَيْكُمْ يَـٰبَنِىٓ ءَادَمَ أَن لَّا تَعْبُدُوا۟ ٱلشَّيْطَـٰنَ ۖ إِنَّهُۥ لَكُمْ عَدُوٌّ مُّبِينٌ","translationUz":"Men sizlarga: «Ey, Odam bolalari, shaytonga ibodat qilmang, albatta, u sizga ochiq-oydin dushmandir.","transcription":null,"tafsirUz":null,"pageNumber":444,"juz":23,"createdAt":"2026-09-17T18:45:47.013Z","updatedAt":"2026-09-17T18:45:47.013Z"},{"id":3766,"surahId":36,"surah":{"id":36,"number":36,"nameArabic":"يس","nameUz":"Yosin","meaningUz":"Yosin","revelationPlace":"makka","totalAyahs":83,"startPage":440,"createdAt":"2026-09-17T18:45:07.579Z","updatedAt":"2026-09-18T00:07:52.474Z"},"numberInSurah":61,"textArabic":"وَأَنِ ٱعْبُدُونِى ۚ هَـٰذَا صِرَٰطٌ مُّسْتَقِيمٌ","translationUz":"Va Menga ibodat qiling, mana shu to`g`ri yo`ldir», deb amr qilmagan edimmi?!","transcription":null,"tafsirUz":null,"pageNumber":444,"juz":23,"createdAt":"2026-09-17T18:45:47.017Z","updatedAt":"2026-09-17T18:45:47.017Z"},{"id":3767,"surahId":36,"surah":{"id":36,"number":36,"nameArabic":"يس","nameUz":"Yosin","meaningUz":"Yosin","revelationPlace":"makka","totalAyahs":83,"startPage":440,"createdAt":"2026-09-17T18:45:07.579Z","updatedAt":"2026-09-18T00:07:52.474Z"},"numberInSurah":62,"textArabic":"وَلَقَدْ أَضَلَّ مِنكُمْ جِبِلًّا كَثِيرًا ۖ أَفَلَمْ تَكُونُوا۟ تَعْقِلُونَ","translationUz":"Batahqiq, u sizlardan ko`pchilik avlodni adashtirdi. Aql yurituvchi bo`lmagan edingizmi?!","transcription":null,"tafsirUz":null,"pageNumber":444,"juz":23,"createdAt":"2026-09-17T18:45:47.021Z","updatedAt":"2026-09-17T18:45:47.021Z"},{"id":3768,"surahId":36,"surah":{"id":36,"number":36,"nameArabic":"يس","nameUz":"Yosin","meaningUz":"Yosin","revelationPlace":"makka","totalAyahs":83,"startPage":440,"createdAt":"2026-09-17T18:45:07.579Z","updatedAt":"2026-09-18T00:07:52.474Z"},"numberInSurah":63,"textArabic":"هَـٰذِهِۦ جَهَنَّمُ ٱلَّتِى كُنتُمْ تُوعَدُونَ","translationUz":"Mana bu sizga va'da qilingan jahannamdir!","transcription":null,"tafsirUz":null,"pageNumber":444,"juz":23,"createdAt":"2026-09-17T18:45:47.025Z","updatedAt":"2026-09-17T18:45:47.025Z"},{"id":3769,"surahId":36,"surah":{"id":36,"number":36,"nameArabic":"يس","nameUz":"Yosin","meaningUz":"Yosin","revelationPlace":"makka","totalAyahs":83,"startPage":440,"createdAt":"2026-09-17T18:45:07.579Z","updatedAt":"2026-09-18T00:07:52.474Z"},"numberInSurah":64,"textArabic":"ٱصْلَوْهَا ٱلْيَوْمَ بِمَا كُنتُمْ تَكْفُرُونَ","translationUz":"Kufr keltirib o`tganingiz tufayli bugungi kunda unga kiring!","transcription":null,"tafsirUz":null,"pageNumber":444,"juz":23,"createdAt":"2026-09-17T18:45:47.030Z","updatedAt":"2026-09-17T18:45:47.030Z"},{"id":3770,"surahId":36,"surah":{"id":36,"number":36,"nameArabic":"يس","nameUz":"Yosin","meaningUz":"Yosin","revelationPlace":"makka","totalAyahs":83,"startPage":440,"createdAt":"2026-09-17T18:45:07.579Z","updatedAt":"2026-09-18T00:07:52.474Z"},"numberInSurah":65,"textArabic":"ٱلْيَوْمَ نَخْتِمُ عَلَىٰٓ أَفْوَٰهِهِمْ وَتُكَلِّمُنَآ أَيْدِيهِمْ وَتَشْهَدُ أَرْجُلُهُم بِمَا كَانُوا۟ يَكْسِبُونَ","translationUz":"Bugungi kunda ularning og`izlariga muhr uramiz. Nima kasb qilganlarini Bizga qo`llari so`zlar va oyoqlari guvohlik berur.","transcription":null,"tafsirUz":null,"pageNumber":444,"juz":23,"createdAt":"2026-09-17T18:45:47.034Z","updatedAt":"2026-09-17T18:45:47.034Z"},{"id":3771,"surahId":36,"surah":{"id":36,"number":36,"nameArabic":"يس","nameUz":"Yosin","meaningUz":"Yosin","revelationPlace":"makka","totalAyahs":83,"startPage":440,"createdAt":"2026-09-17T18:45:07.579Z","updatedAt":"2026-09-18T00:07:52.474Z"},"numberInSurah":66,"textArabic":"وَلَوْ نَشَآءُ لَطَمَسْنَا عَلَىٰٓ أَعْيُنِهِمْ فَٱسْتَبَقُوا۟ ٱلصِّرَٰطَ فَأَنَّىٰ يُبْصِرُونَ","translationUz":"Agar xohlasak, ko`zlarini tep-tekis qilib qo`yurmiz. Bas, ular yo`lga shoshilurlar. Ammo, qanday ham ko`rsinlar.","transcription":null,"tafsirUz":null,"pageNumber":444,"juz":23,"createdAt":"2026-09-17T18:45:47.038Z","updatedAt":"2026-09-17T18:45:47.038Z"},{"id":3772,"surahId":36,"surah":{"id":36,"number":36,"nameArabic":"يس","nameUz":"Yosin","meaningUz":"Yosin","revelationPlace":"makka","totalAyahs":83,"startPage":440,"createdAt":"2026-09-17T18:45:07.579Z","updatedAt":"2026-09-18T00:07:52.474Z"},"numberInSurah":67,"textArabic":"وَلَوْ نَشَآءُ لَمَسَخْنَـٰهُمْ عَلَىٰ مَكَانَتِهِمْ فَمَا ٱسْتَطَـٰعُوا۟ مُضِيًّا وَلَا يَرْجِعُونَ","translationUz":"Agar xohlasak, ularni joylarida qotirib qo`yurmiz. Bas, oldinga yurishga ham qodir bo`lmaslar, ortga ham qayta olmaslar.","transcription":null,"tafsirUz":null,"pageNumber":444,"juz":23,"createdAt":"2026-09-17T18:45:47.043Z","updatedAt":"2026-09-17T18:45:47.043Z"},{"id":3773,"surahId":36,"surah":{"id":36,"number":36,"nameArabic":"يس","nameUz":"Yosin","meaningUz":"Yosin","revelationPlace":"makka","totalAyahs":83,"startPage":440,"createdAt":"2026-09-17T18:45:07.579Z","updatedAt":"2026-09-18T00:07:52.474Z"},"numberInSurah":68,"textArabic":"وَمَن نُّعَمِّرْهُ نُنَكِّسْهُ فِى ٱلْخَلْقِ ۖ أَفَلَا يَعْقِلُونَ","translationUz":"Kimning umrini uzoq qilsak, uni xilqatida nochor qilib qo`yamiz. Axir, aql ishlatib ko`rmaydilarmi?!","transcription":null,"tafsirUz":null,"pageNumber":444,"juz":23,"createdAt":"2026-09-17T18:45:47.046Z","updatedAt":"2026-09-17T18:45:47.046Z"},{"id":3774,"surahId":36,"surah":{"id":36,"number":36,"nameArabic":"يس","nameUz":"Yosin","meaningUz":"Yosin","revelationPlace":"makka","totalAyahs":83,"startPage":440,"createdAt":"2026-09-17T18:45:07.579Z","updatedAt":"2026-09-18T00:07:52.474Z"},"numberInSurah":69,"textArabic":"وَمَا عَلَّمْنَـٰهُ ٱلشِّعْرَ وَمَا يَنۢبَغِى لَهُۥٓ ۚ إِنْ هُوَ إِلَّا ذِكْرٌ وَقُرْءَانٌ مُّبِينٌ","translationUz":"Biz unga she'rni ta'lim berganimiz yo`q. Bu uning uchun to`g`ri ham kelmas. U — zikr va ochiq-oydin Qur'ondan o`zga narsa emas.","transcription":null,"tafsirUz":null,"pageNumber":444,"juz":23,"createdAt":"2026-09-17T18:45:47.050Z","updatedAt":"2026-09-17T18:45:47.050Z"},{"id":3775,"surahId":36,"surah":{"id":36,"number":36,"nameArabic":"يس","nameUz":"Yosin","meaningUz":"Yosin","revelationPlace":"makka","totalAyahs":83,"startPage":440,"createdAt":"2026-09-17T18:45:07.579Z","updatedAt":"2026-09-18T00:07:52.474Z"},"numberInSurah":70,"textArabic":"لِّيُنذِرَ مَن كَانَ حَيًّا وَيَحِقَّ ٱلْقَوْلُ عَلَى ٱلْكَـٰفِرِينَ","translationUz":"Tirik bo`lgan shaxslarni ogohlantirish va kofirlarga (azob) so`zini haq qilish uchundir.","transcription":null,"tafsirUz":null,"pageNumber":444,"juz":23,"createdAt":"2026-09-17T18:45:47.054Z","updatedAt":"2026-09-17T18:45:47.054Z"}]}