{"number":497,"textArabic":null,"translationUz":null,"juz":null,"note":null,"updatedAt":null,"ayahs":[{"id":4433,"surahId":44,"surah":{"id":44,"number":44,"nameArabic":"الدخان","nameUz":"Duxon","meaningUz":"Tutun","revelationPlace":"makka","totalAyahs":59,"startPage":496,"createdAt":"2026-09-17T18:45:07.618Z","updatedAt":"2026-09-18T00:07:52.509Z"},"numberInSurah":19,"textArabic":"وَأَن لَّا تَعْلُوا۟ عَلَى ٱللَّهِ ۖ إِنِّىٓ ءَاتِيكُم بِسُلْطَـٰنٍ مُّبِينٍ","translationUz":"Va Allohga mutakabbirlik qilmang. Albatta, men sizga ochiq-oydin hujjat keltirurman.","transcription":null,"tafsirUz":null,"pageNumber":497,"juz":25,"createdAt":"2026-09-17T18:45:53.514Z","updatedAt":"2026-09-17T18:45:53.514Z"},{"id":4434,"surahId":44,"surah":{"id":44,"number":44,"nameArabic":"الدخان","nameUz":"Duxon","meaningUz":"Tutun","revelationPlace":"makka","totalAyahs":59,"startPage":496,"createdAt":"2026-09-17T18:45:07.618Z","updatedAt":"2026-09-18T00:07:52.509Z"},"numberInSurah":20,"textArabic":"وَإِنِّى عُذْتُ بِرَبِّى وَرَبِّكُمْ أَن تَرْجُمُونِ","translationUz":"Va, albatta, men o`zimning Robbim va sizning Robbingizdan meni toshbo`ron qilishingizdan panoh so`radim.","transcription":null,"tafsirUz":null,"pageNumber":497,"juz":25,"createdAt":"2026-09-17T18:45:53.519Z","updatedAt":"2026-09-17T18:45:53.519Z"},{"id":4435,"surahId":44,"surah":{"id":44,"number":44,"nameArabic":"الدخان","nameUz":"Duxon","meaningUz":"Tutun","revelationPlace":"makka","totalAyahs":59,"startPage":496,"createdAt":"2026-09-17T18:45:07.618Z","updatedAt":"2026-09-18T00:07:52.509Z"},"numberInSurah":21,"textArabic":"وَإِن لَّمْ تُؤْمِنُوا۟ لِى فَٱعْتَزِلُونِ","translationUz":"Va agar menga iymon keltirmasangiz, mendan chetlaning».","transcription":null,"tafsirUz":null,"pageNumber":497,"juz":25,"createdAt":"2026-09-17T18:45:53.523Z","updatedAt":"2026-09-17T18:45:53.523Z"},{"id":4436,"surahId":44,"surah":{"id":44,"number":44,"nameArabic":"الدخان","nameUz":"Duxon","meaningUz":"Tutun","revelationPlace":"makka","totalAyahs":59,"startPage":496,"createdAt":"2026-09-17T18:45:07.618Z","updatedAt":"2026-09-18T00:07:52.509Z"},"numberInSurah":22,"textArabic":"فَدَعَا رَبَّهُۥٓ أَنَّ هَـٰٓؤُلَآءِ قَوْمٌ مُّجْرِمُونَ","translationUz":"U Robbiga: «Albatta, anavilar jinoyatchi qavmdir», deb duo qildi.","transcription":null,"tafsirUz":null,"pageNumber":497,"juz":25,"createdAt":"2026-09-17T18:45:53.527Z","updatedAt":"2026-09-17T18:45:53.527Z"},{"id":4437,"surahId":44,"surah":{"id":44,"number":44,"nameArabic":"الدخان","nameUz":"Duxon","meaningUz":"Tutun","revelationPlace":"makka","totalAyahs":59,"startPage":496,"createdAt":"2026-09-17T18:45:07.618Z","updatedAt":"2026-09-18T00:07:52.509Z"},"numberInSurah":23,"textArabic":"فَأَسْرِ بِعِبَادِى لَيْلًا إِنَّكُم مُّتَّبَعُونَ","translationUz":"Bas, bandalarim ila kechasi yurib ket. Albatta, siz izingizdan quvilursiz.","transcription":null,"tafsirUz":null,"pageNumber":497,"juz":25,"createdAt":"2026-09-17T18:45:53.531Z","updatedAt":"2026-09-17T18:45:53.531Z"},{"id":4438,"surahId":44,"surah":{"id":44,"number":44,"nameArabic":"الدخان","nameUz":"Duxon","meaningUz":"Tutun","revelationPlace":"makka","totalAyahs":59,"startPage":496,"createdAt":"2026-09-17T18:45:07.618Z","updatedAt":"2026-09-18T00:07:52.509Z"},"numberInSurah":24,"textArabic":"وَٱتْرُكِ ٱلْبَحْرَ رَهْوًا ۖ إِنَّهُمْ جُندٌ مُّغْرَقُونَ","translationUz":"Va dengizni sokin holida qo`y, albatta, ular g`arq qilinadigan qo`shindir.","transcription":null,"tafsirUz":null,"pageNumber":497,"juz":25,"createdAt":"2026-09-17T18:45:53.535Z","updatedAt":"2026-09-17T18:45:53.535Z"},{"id":4439,"surahId":44,"surah":{"id":44,"number":44,"nameArabic":"الدخان","nameUz":"Duxon","meaningUz":"Tutun","revelationPlace":"makka","totalAyahs":59,"startPage":496,"createdAt":"2026-09-17T18:45:07.618Z","updatedAt":"2026-09-18T00:07:52.509Z"},"numberInSurah":25,"textArabic":"كَمْ تَرَكُوا۟ مِن جَنَّـٰتٍ وَعُيُونٍ","translationUz":"Ular ortlaridan qanchadan-qancha bog`u rog`larni va buloqlarni,","transcription":null,"tafsirUz":null,"pageNumber":497,"juz":25,"createdAt":"2026-09-17T18:45:53.539Z","updatedAt":"2026-09-17T18:45:53.539Z"},{"id":4440,"surahId":44,"surah":{"id":44,"number":44,"nameArabic":"الدخان","nameUz":"Duxon","meaningUz":"Tutun","revelationPlace":"makka","totalAyahs":59,"startPage":496,"createdAt":"2026-09-17T18:45:07.618Z","updatedAt":"2026-09-18T00:07:52.509Z"},"numberInSurah":26,"textArabic":"وَزُرُوعٍ وَمَقَامٍ كَرِيمٍ","translationUz":"Ekinzorlarni va yaxshi joylarni.","transcription":null,"tafsirUz":null,"pageNumber":497,"juz":25,"createdAt":"2026-09-17T18:45:53.543Z","updatedAt":"2026-09-17T18:45:53.543Z"},{"id":4441,"surahId":44,"surah":{"id":44,"number":44,"nameArabic":"الدخان","nameUz":"Duxon","meaningUz":"Tutun","revelationPlace":"makka","totalAyahs":59,"startPage":496,"createdAt":"2026-09-17T18:45:07.618Z","updatedAt":"2026-09-18T00:07:52.509Z"},"numberInSurah":27,"textArabic":"وَنَعْمَةٍ كَانُوا۟ فِيهَا فَـٰكِهِينَ","translationUz":"Va o`zlari ichida maza qilayotgan nozu ne'matlarni qoldirdilar.","transcription":null,"tafsirUz":null,"pageNumber":497,"juz":25,"createdAt":"2026-09-17T18:45:53.547Z","updatedAt":"2026-09-17T18:45:53.547Z"},{"id":4442,"surahId":44,"surah":{"id":44,"number":44,"nameArabic":"الدخان","nameUz":"Duxon","meaningUz":"Tutun","revelationPlace":"makka","totalAyahs":59,"startPage":496,"createdAt":"2026-09-17T18:45:07.618Z","updatedAt":"2026-09-18T00:07:52.509Z"},"numberInSurah":28,"textArabic":"كَذَٰلِكَ ۖ وَأَوْرَثْنَـٰهَا قَوْمًا ءَاخَرِينَ","translationUz":"Mana shunday! Biz u(narsa)larni boshqa qavmlarga meros qilib berdik.","transcription":null,"tafsirUz":null,"pageNumber":497,"juz":25,"createdAt":"2026-09-17T18:45:53.551Z","updatedAt":"2026-09-17T18:45:53.551Z"},{"id":4443,"surahId":44,"surah":{"id":44,"number":44,"nameArabic":"الدخان","nameUz":"Duxon","meaningUz":"Tutun","revelationPlace":"makka","totalAyahs":59,"startPage":496,"createdAt":"2026-09-17T18:45:07.618Z","updatedAt":"2026-09-18T00:07:52.509Z"},"numberInSurah":29,"textArabic":"فَمَا بَكَتْ عَلَيْهِمُ ٱلسَّمَآءُ وَٱلْأَرْضُ وَمَا كَانُوا۟ مُنظَرِينَ","translationUz":"Bas, ularga osmon ham, yer ham yig`lamadi va ular muhlat berilganlardan ham bo`lmadilar.","transcription":null,"tafsirUz":null,"pageNumber":497,"juz":25,"createdAt":"2026-09-17T18:45:53.556Z","updatedAt":"2026-09-17T18:45:53.556Z"},{"id":4444,"surahId":44,"surah":{"id":44,"number":44,"nameArabic":"الدخان","nameUz":"Duxon","meaningUz":"Tutun","revelationPlace":"makka","totalAyahs":59,"startPage":496,"createdAt":"2026-09-17T18:45:07.618Z","updatedAt":"2026-09-18T00:07:52.509Z"},"numberInSurah":30,"textArabic":"وَلَقَدْ نَجَّيْنَا بَنِىٓ إِسْرَٰٓءِيلَ مِنَ ٱلْعَذَابِ ٱلْمُهِينِ","translationUz":"Batahqiq, Bani Isroilga xorlovchi azobdan...","transcription":null,"tafsirUz":null,"pageNumber":497,"juz":25,"createdAt":"2026-09-17T18:45:53.560Z","updatedAt":"2026-09-17T18:45:53.560Z"},{"id":4445,"surahId":44,"surah":{"id":44,"number":44,"nameArabic":"الدخان","nameUz":"Duxon","meaningUz":"Tutun","revelationPlace":"makka","totalAyahs":59,"startPage":496,"createdAt":"2026-09-17T18:45:07.618Z","updatedAt":"2026-09-18T00:07:52.509Z"},"numberInSurah":31,"textArabic":"مِن فِرْعَوْنَ ۚ إِنَّهُۥ كَانَ عَالِيًا مِّنَ ٱلْمُسْرِفِينَ","translationUz":"Fir'avndan najot berdik. Albatta, u mutakabbir va haddidan oshganlardan edi.","transcription":null,"tafsirUz":null,"pageNumber":497,"juz":25,"createdAt":"2026-09-17T18:45:53.565Z","updatedAt":"2026-09-17T18:45:53.565Z"},{"id":4446,"surahId":44,"surah":{"id":44,"number":44,"nameArabic":"الدخان","nameUz":"Duxon","meaningUz":"Tutun","revelationPlace":"makka","totalAyahs":59,"startPage":496,"createdAt":"2026-09-17T18:45:07.618Z","updatedAt":"2026-09-18T00:07:52.509Z"},"numberInSurah":32,"textArabic":"وَلَقَدِ ٱخْتَرْنَـٰهُمْ عَلَىٰ عِلْمٍ عَلَى ٱلْعَـٰلَمِينَ","translationUz":"Batahqiq, Biz ularni bilib turib, olamlar ichidan tanlab oldik.","transcription":null,"tafsirUz":null,"pageNumber":497,"juz":25,"createdAt":"2026-09-17T18:45:53.568Z","updatedAt":"2026-09-17T18:45:53.568Z"},{"id":4447,"surahId":44,"surah":{"id":44,"number":44,"nameArabic":"الدخان","nameUz":"Duxon","meaningUz":"Tutun","revelationPlace":"makka","totalAyahs":59,"startPage":496,"createdAt":"2026-09-17T18:45:07.618Z","updatedAt":"2026-09-18T00:07:52.509Z"},"numberInSurah":33,"textArabic":"وَءَاتَيْنَـٰهُم مِّنَ ٱلْـَٔايَـٰتِ مَا فِيهِ بَلَـٰٓؤٌا۟ مُّبِينٌ","translationUz":"Va ularga oyat(mo`'jiza)lardan ichida ochiq-oydin sinov bor narsalarni berdik.","transcription":null,"tafsirUz":null,"pageNumber":497,"juz":25,"createdAt":"2026-09-17T18:45:53.572Z","updatedAt":"2026-09-17T18:45:53.572Z"},{"id":4448,"surahId":44,"surah":{"id":44,"number":44,"nameArabic":"الدخان","nameUz":"Duxon","meaningUz":"Tutun","revelationPlace":"makka","totalAyahs":59,"startPage":496,"createdAt":"2026-09-17T18:45:07.618Z","updatedAt":"2026-09-18T00:07:52.509Z"},"numberInSurah":34,"textArabic":"إِنَّ هَـٰٓؤُلَآءِ لَيَقُولُونَ","translationUz":"Albatta, anavilar derlar:","transcription":null,"tafsirUz":null,"pageNumber":497,"juz":25,"createdAt":"2026-09-17T18:45:53.576Z","updatedAt":"2026-09-17T18:45:53.576Z"},{"id":4449,"surahId":44,"surah":{"id":44,"number":44,"nameArabic":"الدخان","nameUz":"Duxon","meaningUz":"Tutun","revelationPlace":"makka","totalAyahs":59,"startPage":496,"createdAt":"2026-09-17T18:45:07.618Z","updatedAt":"2026-09-18T00:07:52.509Z"},"numberInSurah":35,"textArabic":"إِنْ هِىَ إِلَّا مَوْتَتُنَا ٱلْأُولَىٰ وَمَا نَحْنُ بِمُنشَرِينَ","translationUz":"«Birinchi o`limimizdan boshqa hech qanday o`lim yo`q va biz qayta tiriltiriluvchi emasmiz.","transcription":null,"tafsirUz":null,"pageNumber":497,"juz":25,"createdAt":"2026-09-17T18:45:53.581Z","updatedAt":"2026-09-17T18:45:53.581Z"},{"id":4450,"surahId":44,"surah":{"id":44,"number":44,"nameArabic":"الدخان","nameUz":"Duxon","meaningUz":"Tutun","revelationPlace":"makka","totalAyahs":59,"startPage":496,"createdAt":"2026-09-17T18:45:07.618Z","updatedAt":"2026-09-18T00:07:52.509Z"},"numberInSurah":36,"textArabic":"فَأْتُوا۟ بِـَٔابَآئِنَآ إِن كُنتُمْ صَـٰدِقِينَ","translationUz":"Agar rostgo`y bo`lsangiz, ota-bobolarimizni keltiringlar».","transcription":null,"tafsirUz":null,"pageNumber":497,"juz":25,"createdAt":"2026-09-17T18:45:53.585Z","updatedAt":"2026-09-17T18:45:53.585Z"},{"id":4451,"surahId":44,"surah":{"id":44,"number":44,"nameArabic":"الدخان","nameUz":"Duxon","meaningUz":"Tutun","revelationPlace":"makka","totalAyahs":59,"startPage":496,"createdAt":"2026-09-17T18:45:07.618Z","updatedAt":"2026-09-18T00:07:52.509Z"},"numberInSurah":37,"textArabic":"أَهُمْ خَيْرٌ أَمْ قَوْمُ تُبَّعٍ وَٱلَّذِينَ مِن قَبْلِهِمْ ۚ أَهْلَكْنَـٰهُمْ ۖ إِنَّهُمْ كَانُوا۟ مُجْرِمِينَ","translationUz":"Ular yaxshiroqmi yoki Tubba' qavmiyu ulardan oldin o`tganlarmi?! Biz ularni halok qildik. Albatta, ular jinoyatchi bo`lgan edilar.","transcription":null,"tafsirUz":null,"pageNumber":497,"juz":25,"createdAt":"2026-09-17T18:45:53.589Z","updatedAt":"2026-09-17T18:45:53.589Z"},{"id":4452,"surahId":44,"surah":{"id":44,"number":44,"nameArabic":"الدخان","nameUz":"Duxon","meaningUz":"Tutun","revelationPlace":"makka","totalAyahs":59,"startPage":496,"createdAt":"2026-09-17T18:45:07.618Z","updatedAt":"2026-09-18T00:07:52.509Z"},"numberInSurah":38,"textArabic":"وَمَا خَلَقْنَا ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضَ وَمَا بَيْنَهُمَا لَـٰعِبِينَ","translationUz":"Osmonlaru yerni va ularning orasidagi narsalarni o`ynab yaratganimiz yo`q!","transcription":null,"tafsirUz":null,"pageNumber":497,"juz":25,"createdAt":"2026-09-17T18:45:53.594Z","updatedAt":"2026-09-17T18:45:53.594Z"},{"id":4453,"surahId":44,"surah":{"id":44,"number":44,"nameArabic":"الدخان","nameUz":"Duxon","meaningUz":"Tutun","revelationPlace":"makka","totalAyahs":59,"startPage":496,"createdAt":"2026-09-17T18:45:07.618Z","updatedAt":"2026-09-18T00:07:52.509Z"},"numberInSurah":39,"textArabic":"مَا خَلَقْنَـٰهُمَآ إِلَّا بِٱلْحَقِّ وَلَـٰكِنَّ أَكْثَرَهُمْ لَا يَعْلَمُونَ","translationUz":"Biz ularni faqat haq ila yaratdik, lekin ko`plari bilmaslar.","transcription":null,"tafsirUz":null,"pageNumber":497,"juz":25,"createdAt":"2026-09-17T18:45:53.598Z","updatedAt":"2026-09-17T18:45:53.598Z"}]}