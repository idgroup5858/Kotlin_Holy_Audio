{"number":520,"textArabic":null,"translationUz":null,"juz":null,"note":null,"updatedAt":null,"ayahs":[{"id":4666,"surahId":50,"surah":{"id":50,"number":50,"nameArabic":"ق","nameUz":"Qof","meaningUz":"Qof","revelationPlace":"makka","totalAyahs":45,"startPage":518,"createdAt":"2026-09-17T18:45:07.648Z","updatedAt":"2026-09-18T00:07:52.536Z"},"numberInSurah":36,"textArabic":"وَكَمْ أَهْلَكْنَا قَبْلَهُم مِّن قَرْنٍ هُمْ أَشَدُّ مِنْهُم بَطْشًا فَنَقَّبُوا۟ فِى ٱلْبِلَـٰدِ هَلْ مِن مَّحِيصٍ","translationUz":"Ulardan avval, ulardan ko`ra kuchliroq asr(avlod)lardan qanchasini halok qildik. «Qochadigan joy bormi?» deb yurtma-yurt kezib chiqdilar.","transcription":null,"tafsirUz":null,"pageNumber":520,"juz":26,"createdAt":"2026-09-17T18:45:55.754Z","updatedAt":"2026-09-17T18:45:55.754Z"},{"id":4667,"surahId":50,"surah":{"id":50,"number":50,"nameArabic":"ق","nameUz":"Qof","meaningUz":"Qof","revelationPlace":"makka","totalAyahs":45,"startPage":518,"createdAt":"2026-09-17T18:45:07.648Z","updatedAt":"2026-09-18T00:07:52.536Z"},"numberInSurah":37,"textArabic":"إِنَّ فِى ذَٰلِكَ لَذِكْرَىٰ لِمَن كَانَ لَهُۥ قَلْبٌ أَوْ أَلْقَى ٱلسَّمْعَ وَهُوَ شَهِيدٌ","translationUz":"Albatta, bunda qalbi borlarga va zehn bilan quloq osganlarga eslatma bordir.","transcription":null,"tafsirUz":null,"pageNumber":520,"juz":26,"createdAt":"2026-09-17T18:45:55.759Z","updatedAt":"2026-09-17T18:45:55.759Z"},{"id":4668,"surahId":50,"surah":{"id":50,"number":50,"nameArabic":"ق","nameUz":"Qof","meaningUz":"Qof","revelationPlace":"makka","totalAyahs":45,"startPage":518,"createdAt":"2026-09-17T18:45:07.648Z","updatedAt":"2026-09-18T00:07:52.536Z"},"numberInSurah":38,"textArabic":"وَلَقَدْ خَلَقْنَا ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضَ وَمَا بَيْنَهُمَا فِى سِتَّةِ أَيَّامٍ وَمَا مَسَّنَا مِن لُّغُوبٍ","translationUz":"Albatta, osmonlaru yerni va ularning orasidagi narsalarni olti kunda yaratdik. Va Bizni charchoq tutmadi.","transcription":null,"tafsirUz":null,"pageNumber":520,"juz":26,"createdAt":"2026-09-17T18:45:55.762Z","updatedAt":"2026-09-17T18:45:55.762Z"},{"id":4669,"surahId":50,"surah":{"id":50,"number":50,"nameArabic":"ق","nameUz":"Qof","meaningUz":"Qof","revelationPlace":"makka","totalAyahs":45,"startPage":518,"createdAt":"2026-09-17T18:45:07.648Z","updatedAt":"2026-09-18T00:07:52.536Z"},"numberInSurah":39,"textArabic":"فَٱصْبِرْ عَلَىٰ مَا يَقُولُونَ وَسَبِّحْ بِحَمْدِ رَبِّكَ قَبْلَ طُلُوعِ ٱلشَّمْسِ وَقَبْلَ ٱلْغُرُوبِ","translationUz":"Ularning aytayotganlariga sabr qil va Robbingga quyosh chiqishi va botishidan avval hamdu tasbih ayt.","transcription":null,"tafsirUz":null,"pageNumber":520,"juz":26,"createdAt":"2026-09-17T18:45:55.766Z","updatedAt":"2026-09-17T18:45:55.766Z"},{"id":4670,"surahId":50,"surah":{"id":50,"number":50,"nameArabic":"ق","nameUz":"Qof","meaningUz":"Qof","revelationPlace":"makka","totalAyahs":45,"startPage":518,"createdAt":"2026-09-17T18:45:07.648Z","updatedAt":"2026-09-18T00:07:52.536Z"},"numberInSurah":40,"textArabic":"وَمِنَ ٱلَّيْلِ فَسَبِّحْهُ وَأَدْبَـٰرَ ٱلسُّجُودِ","translationUz":"Kechasida ham Unga tasbih ayt. Va sajdadan keyin ham.","transcription":null,"tafsirUz":null,"pageNumber":520,"juz":26,"createdAt":"2026-09-17T18:45:55.770Z","updatedAt":"2026-09-17T18:45:55.770Z"},{"id":4671,"surahId":50,"surah":{"id":50,"number":50,"nameArabic":"ق","nameUz":"Qof","meaningUz":"Qof","revelationPlace":"makka","totalAyahs":45,"startPage":518,"createdAt":"2026-09-17T18:45:07.648Z","updatedAt":"2026-09-18T00:07:52.536Z"},"numberInSurah":41,"textArabic":"وَٱسْتَمِعْ يَوْمَ يُنَادِ ٱلْمُنَادِ مِن مَّكَانٍ قَرِيبٍ","translationUz":"Nido qiluvchi yaqin joydan nido qilgan kunda quloq os.","transcription":null,"tafsirUz":null,"pageNumber":520,"juz":26,"createdAt":"2026-09-17T18:45:55.774Z","updatedAt":"2026-09-17T18:45:55.774Z"},{"id":4672,"surahId":50,"surah":{"id":50,"number":50,"nameArabic":"ق","nameUz":"Qof","meaningUz":"Qof","revelationPlace":"makka","totalAyahs":45,"startPage":518,"createdAt":"2026-09-17T18:45:07.648Z","updatedAt":"2026-09-18T0