45:48.151Z"},{"id":3847,"surahId":37,"surah":{"id":37,"number":37,"nameArabic":"الصافات","nameUz":"Soffot","meaningUz":"Saf tortganlar","revelationPlace":"makka","totalAyahs":182,"startPage":446,"createdAt":"2026-09-17T18:45:07.584Z","updatedAt":"2026-09-18T00:07:52.478Z"},"numberInSurah":59,"textArabic":"إِلَّا مَوْتَتَنَا ٱلْأُولَىٰ وَمَا نَحْنُ بِمُعَذَّبِينَ","translationUz":"Faqat birinchi o`limimizdan boshqa?! Biz azoblanguvchi emas ekanmizmi?!","transcription":null,"tafsirUz":null,"pageNumber":448,"juz":23,"createdAt":"2026-09-17T18:45:48.155Z","updatedAt":"2026-09-17T18:45:48.155Z"},{"id":3848,"surahId":37,"surah":{"id":37,"number":37,"nameArabic":"الصافات","nameUz":"Soffot","meaningUz":"Saf tortganlar","revelationPlace":"makka","totalAyahs":182,"startPage":446,"createdAt":"2026-09-17T18:45:07.584Z","updatedAt":"2026-09-18T00:07:52.478Z"},"numberInSurah":60,"textArabic":"إِنَّ هَـٰذَا لَهُوَ ٱلْفَوْزُ ٱلْعَظِيمُ","translationUz":"Albatta, bu ayni ulug` yutuqdir.","transcription":null,"tafsirUz":null,"pageNumber":448,"juz":23,"createdAt":"2026-09-17T18:45:48.159Z","updatedAt":"2026-09-17T18:45:48.159Z"},{"id":3849,"surahId":37,"surah":{"id":37,"number":37,"nameArabic":"الصافات","nameUz":"Soffot","meaningUz":"Saf tortganlar","revelationPlace":"makka","totalAyahs":182,"startPage":446,"createdAt":"2026-09-17T18:45:07.584Z","updatedAt":"2026-09-18T00:07:52.478Z"},"numberInSurah":61,"textArabic":"لِمِثْلِ هَـٰذَا فَلْيَعْمَلِ ٱلْعَـٰمِلُونَ","translationUz":"Bas, amal qilguvchilar mana shunga o`xshash narsa uchun amal etsinlar».","transcription":null,"tafsirUz":null,"pageNumber":448,"juz":23,"createdAt":"2026-09-17T18:45:48.163Z","updatedAt":"2026-09-17T18:45:48.163Z"},{"id":3850,"surahId":37,"surah":{"id":37,"number":37,"nameArabic":"الصافات","nameUz":"Soffot","meaningUz":"Saf tortganlar","revelationPlace":"makka","totalAyahs":182,"startPage":446,"createdAt":"2026-09-17T18:45:07.584Z","updatedAt":"2026-09-18T00:07:52.478Z"},"numberInSurah":62,"textArabic":"أَذَٰل