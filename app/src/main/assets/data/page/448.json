ic":"الصافات","nameUz":"Soffot","meaningUz":"Saf tortganlar","revelationPlace":"makka","totalAyahs":182,"startPage":446,"createdAt":"2026-09-17T18:45:07.584Z","updatedAt":"2026-09-18T00:07:52.478Z"},"numberInSurah":66,"textArabic":"فَإِنَّهُمْ لَـَٔاكِلُونَ مِنْهَا فَمَالِـُٔونَ مِنْهَا ٱلْبُطُونَ","translationUz":"Bas, albatta, ular undan yeguvchilardir. Undan qorinlarni to`ldirguvchilardir.","transcription":null,"tafsirUz":null,"pageNumber":448,"juz":23,"createdAt":"2026-09-17T18:45:48.183Z","updatedAt":"2026-09-17T18:45:48.183Z"},{"id":3855,"surahId":37,"surah":{"id":37,"number":37,"nameArabic":"الصافات","nameUz":"Soffot","meaningUz":"Saf tortganlar","revelationPlace":"makka","totalAyahs":182,"startPage":446,"createdAt":"2026-09-17T18:45:07.584Z","updatedAt":"2026-09-18T00:07:52.478Z"},"numberInSurah":67,"textArabic":"ثُمَّ إِنَّ لَهُمْ عَلَيْهَا لَشَوْبًا مِّنْ حَمِيمٍ","translationUz":"So`ngra, buning ustiga, ular uchun o`ta qaynoq suvdan aralashtirma ham bor.","transcription":null,"tafsirUz":null,"pageNumber":448,"juz":23,"createdAt":"2026-09-17T18:45:48.187Z","updatedAt":"2026-09-17T18:45:48.187Z"},{"id":3856,"surahId":37,"surah":{"id":37,"number":37,"nameArabic":"الصافات","nameUz":"Soffot","meaningUz":"Saf tortganlar","revelationPlace":"makka","totalAyahs":182,"startPage":446,"createdAt":"2026-09-17T18:45:07.584Z","updatedAt":"2026-09-18T00:07:52.478Z"},"numberInSurah":68,"textArabic":"ثُمَّ إِنَّ مَرْجِعَهُمْ لَإِلَى ٱلْجَحِيمِ","translationUz":"So`ngra, albatta, ularning qaytar joyi jahannamga bo`lur.","transcription":null,"tafsirUz":null,"pageNumber":448,"juz":23,"createdAt":"2026-09-17T18:45:48.191Z","updatedAt":"2026-09-17T18:45:48.191Z"},{"id":3857,"surahId":37,"surah":{"id":37,"number":37,"nameArabic":"الصافات","nameUz":"Soffot","meaningUz":"Saf tortganlar","revelationPlace":"makka","totalAyahs":182,"startPage":446,"createdAt":"2026-09-17T18:45:07.584Z","updatedAt":"2026-09-18T00:07:52.478Z"},"numberInSurah":69,"textArabic":"إِنَّهُمْ أَلْفَوْا۟ ءَابَ