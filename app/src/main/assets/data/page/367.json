{"number":367,"textArabic":null,"translationUz":null,"juz":null,"note":null,"updatedAt":null,"ayahs":[{"id":2933,"surahId":26,"surah":{"id":26,"number":26,"nameArabic":"الشعراء","nameUz":"Shuaro","meaningUz":"Shoirlar","revelationPlace":"makka","totalAyahs":227,"startPage":367,"createdAt":"2026-09-17T18:45:07.530Z","updatedAt":"2026-09-18T00:07:52.427Z"},"numberInSurah":1,"textArabic":" طسٓمٓ","translationUz":"To. Siyn. Miym.","transcription":null,"tafsirUz":null,"pageNumber":367,"juz":19,"createdAt":"2026-09-17T18:45:39.174Z","updatedAt":"2026-09-17T18:45:39.174Z"},{"id":2934,"surahId":26,"surah":{"id":26,"number":26,"nameArabic":"الشعراء","nameUz":"Shuaro","meaningUz":"Shoirlar","revelationPlace":"makka","totalAyahs":227,"startPage":367,"createdAt":"2026-09-17T18:45:07.530Z","updatedAt":"2026-09-18T00:07:52.427Z"},"numberInSurah":2,"textArabic":"تِلْكَ ءَايَـٰتُ ٱلْكِتَـٰبِ ٱلْمُبِينِ","translationUz":"Bular ochiq kitobning oyatlaridir.","transcription":null,"tafsirUz":null,"pageNumber":367,"juz":19,"createdAt":"2026-09-17T18:45:39.180Z","updatedAt":"2026-09-17T18:45:39.180Z"},{"id":2935,"surahId":26,"surah":{"id":26,"number":26,"nameArabic":"الشعراء","nameUz":"Shuaro","meaningUz":"Shoirlar","revelationPlace":"makka","totalAyahs":227,"startPage":367,"createdAt":"2026-09-17T18:45:07.530Z","updatedAt":"2026-09-18T00:07:52.427Z"},"numberInSurah":3,"textArabic":"لَعَلَّكَ بَـٰخِعٌ نَّفْسَكَ أَلَّا يَكُونُوا۟ مُؤْمِنِينَ","translationUz":"Ehtimol, (ular) mo`min bo`lmaganlari uchun sen o`zingni halok qilmoqchidirsan?!","transcription":null,"tafsirUz":null,"pageNumber":367,"juz":19,"createdAt":"2026-09-17T18:45:39.184Z","updatedAt":"2026-09-17T18:45:39.184Z"},{"id":2936,"surahId":26,"surah":{"id":26,"number":26,"nameArabic":"الشعراء","nameUz":"Shuaro","meaningUz":"Shoirlar","revelationPlace":"makka","totalAyahs":227,"startPage":367,"createdAt":"2026-09-17T18:45:07.530Z","updatedAt":"2026-09-18T00:07:52.427Z"},"numberInSurah":4,"textArabic":"إِن نَّشَأْ نُنَزِّلْ عَلَيْهِم مِّنَ ٱلسَّمَآءِ ءَايَةً فَظَلَّتْ أَعْنَـٰقُهُمْ لَهَا خَـٰضِعِينَ","translationUz":"Agar xohlasak, ularga osmondan oyat-mo`'jiza nozil qilamiz. Bas, ularning bo`yinlari unga egilib qoladir.","transcription":null,"tafsirUz":null,"pageNumber":367,"juz":19,"createdAt":"2026-09-17T18:45:39.189Z","updatedAt":"2026-09-17T18:45:39.189Z"},{"id":2937,"surahId":26,"surah":{"id":26,"number":26,"nameArabic":"الشعراء","nameUz":"Shuaro","meaningUz":"Shoirlar","revelationPlace":"makka","totalAyahs":227,"startPage":367,"createdAt":"2026-09-17T18:45:07.530Z","updatedAt":"2026-09-18T00:07:52.427Z"},"numberInSurah":5,"textArabic":"وَمَا يَأْتِيهِم مِّن ذِكْرٍ مِّنَ ٱلرَّحْمَـٰنِ مُحْدَثٍ إِلَّا كَانُوا۟ عَنْهُ مُعْرِضِينَ","translationUz":"Ularga Rohmandan yangi eslatma kelibdiki, albatta, undan yuz o`girguvchi bo`lganlar.","transcription":null,"tafsirUz":null,"pageNumber":367,"juz":19,"createdAt":"2026-09-17T18:45:39.193Z","updatedAt":"2026-09-17T18:45:39.193Z"},{"id":2938,"surahId":26,"surah":{"id":26,"number":26,"nameArabic":"الشعراء","nameUz":"Shuaro","meaningUz":"Shoirlar","revelationPlace":"makka","totalAyahs":227,"startPage":367,"createdAt":"2026-09-17T18:45:07.530Z","updatedAt":"2026-09-18T00:07:52.427Z"},"numberInSurah":6,"textArabic":"فَقَدْ كَذَّبُوا۟ فَسَيَأْتِيهِمْ أَنۢبَـٰٓؤُا۟ مَا كَانُوا۟ بِهِۦ يَسْتَهْزِءُونَ","translationUz":"Bas, batahqiq, yolg`onga chiqardilar. Yaqinda ularga o`zlari istehzo qilgan narsaning xabari kelajakdir.","transcription":null,"tafsirUz":null,"pageNumber":367,"juz":19,"createdAt":"2026-09-17T18:45:39.198Z","updatedAt":"2026-09-17T18:45:39.198Z"},{"id":2939,"surahId":26,"surah":{"id":26,"number":26,"nameArabic":"الشعراء","nameUz":"Shuaro","meaningUz":"Shoirlar","revelationPlace":"makka","totalAyahs":227,"startPage":367,"createdAt":"2026-09-17T18:45:07.530Z","updatedAt":"2026-09-18T00:07:52.427Z"},"numberInSurah":7,"textArabic":"أَوَلَمْ يَرَوْا۟ إِلَى ٱلْأَرْضِ كَمْ أَنۢبَتْنَا فِيهَا مِن كُلِّ زَوْجٍ كَرِيمٍ","translationUz":"Ular yerga qaramaydilarmi?! Biz unda karamli juftlardan qanchalarini undirib qo`yibmiz.","transcription":null,"tafsirUz":null,"pageNumber":367,"juz":19,"createdAt":"2026-09-17T18:45:39.202Z","updatedAt":"2026-09-17T18:45:39.202Z"},{"id":2940,"surahId":26,"surah":{"id":26,"number":26,"nameArabic":"الشعراء","nameUz":"Shuaro","meaningUz":"Shoirlar","revelationPlace":"makka","totalAyahs":227,"startPage":367,"createdAt":"2026-09-17T18:45:07.530Z","updatedAt":"2026-09-18T00:07:52.427Z"},"numberInSurah":8,"textArabic":"إِنَّ فِى ذَٰلِكَ لَـَٔايَةً ۖ وَمَا كَانَ أَكْثَرُهُم مُّؤْمِنِينَ","translationUz":"Albatta, bunda oyat-belgi bor. Lekin ko`plari mo`min bo`lmaslar.","transcription":null,"tafsirUz":null,"pageNumber":367,"juz":19,"createdAt":"2026-09-17T18:45:39.206Z","updatedAt":"2026-09-17T18:45:39.206Z"},{"id":2941,"surahId":26,"surah":{"id":26,"number":26,"nameArabic":"الشعراء","nameUz":"Shuaro","meaningUz":"Shoirlar","revelationPlace":"makka","totalAyahs":227,"startPage":367,"createdAt":"2026-09-17T18:45:07.530Z","updatedAt":"2026-09-18T00:07:52.427Z"},"numberInSurah":9,"textArabic":"وَإِنَّ رَبَّكَ لَهُوَ ٱلْعَزِيزُ ٱلرَّحِيمُ","translationUz":"Albatta, Robbing O`zi aziyzu mehribondir.","transcription":null,"tafsirUz":null,"pageNumber":367,"juz":19,"createdAt":"2026-09-17T18:45:39.211Z","updatedAt":"2026-09-17T18:45:39.211Z"},{"id":2942,"surahId":26,"surah":{"id":26,"number":26,"nameArabic":"الشعراء","nameUz":"Shuaro","meaningUz":"Shoirlar","revelationPlace":"makka","totalAyahs":227,"startPage":367,"createdAt":"2026-09-17T18:45:07.530Z","updatedAt":"2026-09-18T00:07:52.427Z"},"numberInSurah":10,"textArabic":"وَإِذْ نَادَىٰ رَبُّكَ مُوسَىٰٓ أَنِ ٱئْتِ ٱلْقَوْمَ ٱلظَّـٰلِمِينَ","translationUz":"Robbing Musoga: «U zolim qavmga borgin.","transcription":null,"tafsirUz":null,"pageNumber":367,"juz":19,"createdAt":"2026-09-17T18:45:39.215Z","updatedAt":"2026-09-17T18:45:39.215Z"},{"id":2943,"surahId":26,"surah":{"id":26,"number":26,"nameArabic":"الشعراء","nameUz":"Shuaro","meaningUz":"Shoirlar","revelationPlace":"makka","totalAyahs":227,"startPage":367,"createdAt":"2026-09-17T18:45:07.530Z","updatedAt":"2026-09-18T00:07:52.427Z"},"numberInSurah":11,"textArabic":"قَوْمَ فِرْعَوْنَ ۚ أَلَا يَتَّقُونَ","translationUz":"Fir'avn qavmiga. (Bizdan) qo`rqmaydilarmi?!» deb nido qilganini esla.","transcription":null,"tafsirUz":null,"pageNumber":367,"juz":19,"createdAt":"2026-09-17T18:45:39.220Z","updatedAt":"2026-09-17T18:45:39.220Z"},{"id":2944,"surahId":26,"surah":{"id":26,"number":26,"nameArabic":"الشعراء","nameUz":"Shuaro","meaningUz":"Shoirlar","revelationPlace":"makka","totalAyahs":227,"startPage":367,"createdAt":"2026-09-17T18:45:07.530Z","updatedAt":"2026-09-18T00:07:52.427Z"},"numberInSurah":12,"textArabic":"قَالَ رَبِّ إِنِّىٓ أَخَافُ أَن يُكَذِّبُونِ","translationUz":"U: «Ey Robbim, ular meni yolg`onchi qilishlaridan qo`rqarman.","transcription":null,"tafsirUz":null,"pageNumber":367,"juz":19,"createdAt":"2026-09-17T18:45:39.225Z","updatedAt":"2026-09-17T18:45:39.225Z"},{"id":2945,"surahId":26,"surah":{"id":26,"number":26,"nameArabic":"الشعراء","nameUz":"Shuaro","meaningUz":"Shoirlar","revelationPlace":"makka","totalAyahs":227,"startPage":367,"createdAt":"2026-09-17T18:45:07.530Z","updatedAt":"2026-09-18T00:07:52.427Z"},"numberInSurah":13,"textArabic":"وَيَضِيقُ صَدْرِى وَلَا يَنطَلِقُ لِسَانِى فَأَرْسِلْ إِلَىٰ هَـٰرُونَ","translationUz":"Va dilim siqilishidan hamda tilim burro bo`lmay qolishidan. Bas, Horunni elchi qil.","transcription":null,"tafsirUz":null,"pageNumber":367,"juz":19,"createdAt":"2026-09-17T18:45:39.228Z","updatedAt":"2026-09-17T18:45:39.228Z"},{"id":2946,"surahId":26,"surah":{"id":26,"number":26,"nameArabic":"الشعراء","nameUz":"Shuaro","meaningUz":"Shoirlar","revelationPlace":"makka","totalAyahs":227,"startPage":367,"createdAt":"2026-09-17T18:45:07.530Z","updatedAt":"2026-09-18T00:07:52.427Z"},"numberInSurah":14,"textArabic":"وَلَهُمْ عَلَىَّ ذَنۢبٌ فَأَخَافُ أَن يَقْتُلُونِ","translationUz":"Mening zimmamda ular nazdida gunoh bor. Bas, meni o`ldirishlaridan xavfdaman», dedi.","transcription":null,"tafsirUz":null,"pageNumber":367,"juz":19,"createdAt":"2026-09-17T18:45:39.232Z","updatedAt":"2026-09-17T18:45:39.232Z"},{"id":2947,"surahId":26,"surah":{"id":26,"number":26,"nameArabic":"الشعراء","nameUz":"Shuaro","meaningUz":"Shoirlar","revelationPlace":"makka","totalAyahs":227,"startPage":367,"createdAt":"2026-09-17T18:45:07.530Z","updatedAt":"2026-09-18T00:07:52.427Z"},"numberInSurah":15,"textArabic":"قَالَ كَلَّا ۖ فَٱذْهَبَا بِـَٔايَـٰتِنَآ ۖ إِنَّا مَعَكُم مُّسْتَمِعُونَ","translationUz":"U zot: «Yo`q! Bas, ikkingiz Bizning oyat-mo`'jizalarimiz ila boringlar. Albatta, Biz ikkingiz bilan eshitguvchimiz.","transcription":null,"tafsirUz":null,"pageNumber":367,"juz":19,"createdAt":"2026-09-17T18:45:39.236Z","updatedAt":"2026-09-17T18:45:39.236Z"},{"id":2948,"surahId":26,"surah":{"id":26,"number":26,"nameArabic":"الشعراء","nameUz":"Shuaro","meaningUz":"Shoirlar","revelationPlace":"makka","totalAyahs":227,"startPage":367,"createdAt":"2026-09-17T18:45:07.530Z","updatedAt":"2026-09-18T00:07:52.427Z"},"numberInSurah":16,"textArabic":"فَأْتِيَا فِرْعَوْنَ فَقُولَآ إِنَّا رَسُولُ رَبِّ ٱلْعَـٰلَمِينَ","translationUz":"Bas, Fir'avnga boringlar va unga: «Biz Robbul olamiynning Payg`ambarlarimiz.","transcription":null,"tafsirUz":null,"pageNumber":367,"juz":19,"createdAt":"2026-09-17T18:45:39.240Z","updatedAt":"2026-09-17T18:45:39.240Z"},{"id":2949,"surahId":26,"surah":{"id":26,"number":26,"nameArabic":"الشعراء","nameUz":"Shuaro","meaningUz":"Shoirlar","revelationPlace":"makka","totalAyahs":227,"startPage":367,"createdAt":"2026-09-17T18:45:07.530Z","updatedAt":"2026-09-18T00:07:52.427Z"},"numberInSurah":17,"textArabic":"أَنْ أَرْسِلْ مَعَنَا بَنِىٓ إِسْرَٰٓءِيلَ","translationUz":"Bani Isroilni biz bilan qo`yib yubor», deb aytinglar, dedi.","transcription":null,"tafsirUz":null,"pageNumber":367,"juz":19,"createdAt":"2026-09-17T18:45:39.244Z","updatedAt":"2026-09-17T18:45:39.244Z"},{"id":2950,"surahId":26,"surah":{"id":26,"number":26,"nameArabic":"الشعراء","nameUz":"Shuaro","meaningUz":"Shoirlar","revelationPlace":"makka","totalAyahs":227,"startPage":367,"createdAt":"2026-09-17T18:45:07.530Z","updatedAt":"2026-09-18T00:07:52.427Z"},"numberInSurah":18,"textArabic":"قَالَ أَلَمْ نُرَبِّكَ فِينَا وَلِيدًا وَلَبِثْتَ فِينَا مِنْ عُمُرِكَ سِنِينَ","translationUz":"U (Fir'avn): «Biz seni go`dakligingdan o`z ichimizda tarbiya qilmadikmi?! Umringning bir necha yilini bizning ichimizda o`tkazmadingmi?!","transcription":null,"tafsirUz":null,"pageNumber":367,"juz":19,"createdAt":"2026-09-17T18:45:39.248Z","updatedAt":"2026-09-17T18:45:39.248Z"},{"id":2951,"surahId":26,"surah":{"id":26,"number":26,"nameArabic":"الشعراء","nameUz":"Shuaro","meaningUz":"Shoirlar","revelationPlace":"makka","totalAyahs":227,"startPage":367,"createdAt":"2026-09-17T18:45:07.530Z","updatedAt":"2026-09-18T00:07:52.427Z"},"numberInSurah":19,"textArabic":"وَفَعَلْتَ فَعْلَتَكَ ٱلَّتِى فَعَلْتَ وَأَنتَ مِنَ ٱلْكَـٰفِرِينَ","translationUz":"Va nonko`rlardan bo`lib, qiladigan ishingni qilib qo`ymadingmi?!» dedi.","transcription":null,"tafsirUz":null,"pageNumber":367,"juz":19,"createdAt":"2026-09-17T18:45:39.253Z","updatedAt":"2026-09-17T18:45:39.253Z"}]}