{"number":265,"textArabic":null,"translationUz":null,"juz":null,"note":null,"updatedAt":null,"ayahs":[{"id":1854,"surahId":15,"surah":{"id":15,"number":15,"nameArabic":"الحجر","nameUz":"Hijr","meaningUz":"Hijr vodiysi","revelationPlace":"makka","totalAyahs":99,"startPage":262,"createdAt":"2026-09-17T18:45:07.474Z","updatedAt":"2026-09-18T00:07:52.373Z"},"numberInSurah":52,"textArabic":"إِذْ دَخَلُوا۟ عَلَيْهِ فَقَالُوا۟ سَلَـٰمًا قَالَ إِنَّا مِنكُمْ وَجِلُونَ","translationUz":"Ular uning huzuriga kirganlarida: «Salom», dedilar. U: «Albatta, biz sizlardan qo`rqmoqdamiz», dedi.","transcription":null,"tafsirUz":null,"pageNumber":265,"juz":14,"createdAt":"2026-09-17T18:45:27.418Z","updatedAt":"2026-09-17T18:45:27.418Z"},{"id":1855,"surahId":15,"surah":{"id":15,"number":15,"nameArabic":"الحجر","nameUz":"Hijr","meaningUz":"Hijr vodiysi","revelationPlace":"makka","totalAyahs":99,"startPage":262,"createdAt":"2026-09-17T18:45:07.474Z","updatedAt":"2026-09-18T00:07:52.373Z"},"numberInSurah":53,"textArabic":"قَالُوا۟ لَا تَوْجَلْ إِنَّا نُبَشِّرُكَ بِغُلَـٰمٍ عَلِيمٍ","translationUz":"Ular: «Qo`rqma, biz senga o`ta bilimdon o`g`ilning xushxabarini beramiz», dedilar.","transcription":null,"tafsirUz":null,"pageNumber":265,"juz":14,"createdAt":"2026-09-17T18:45:27.422Z","updatedAt":"2026-09-17T18:45:27.422Z"},{"id":1856,"surahId":15,"surah":{"id":15,"number":15,"nameArabic":"الحجر","nameUz":"Hijr","meaningUz":"Hijr vodiysi","revelationPlace":"makka","totalAyahs":99,"startPage":262,"createdAt":"2026-09-17T18:45:07.474Z","updatedAt":"2026-09-18T00:07:52.373Z"},"numberInSurah":54,"textArabic":"قَالَ أَبَشَّرْتُمُونِى عَلَىٰٓ أَن مَّسَّنِىَ ٱلْكِبَرُ فَبِمَ تُبَشِّرُونَ","translationUz":"U: «Meni keksalik tutganida, xushxabar berasizlarmi? Nimaning xushxabarini beryapsizlar, o`zi?» dedi.","transcription":null,"tafsirUz":null,"pageNumber":265,"juz":14,"createdAt":"2026-09-17T18:45:27.427Z","updatedAt":"2026-09-17T18:45:27.427Z"},{"id":1857,"surahId":15,"surah":{"id":15,"number":15,"nameArabic":"الحجر","nameUz":"Hijr","meaningUz":"Hijr vodiysi","revelationPlace":"makka","totalAyahs":99,"startPage":262,"createdAt":"2026-09-17T18:45:07.474Z","updatedAt":"2026-09-18T00:07:52.373Z"},"numberInSurah":55,"textArabic":"قَالُوا۟ بَشَّرْنَـٰكَ بِٱلْحَقِّ فَلَا تَكُن مِّنَ ٱلْقَـٰنِطِينَ","translationUz":"Ular: «Biz senga haq ila bashorat berdik. Bas, sen noumid bo`luvchilardan bo`lma», dedilar.","transcription":null,"tafsirUz":null,"pageNumber":265,"juz":14,"createdAt":"2026-09-17T18:45:27.431Z","updatedAt":"2026-09-17T18:45:27.431Z"},{"id":1858,"surahId":15,"surah":{"id":15,"number":15,"nameArabic":"الحجر","nameUz":"Hijr","meaningUz":"Hijr vodiysi","revelationPlace":"makka","totalAyahs":99,"startPage":262,"createdAt":"2026-09-17T18:45:07.474Z","updatedAt":"2026-09-18T00:07:52.373Z"},"numberInSurah":56,"textArabic":"قَالَ وَمَن يَقْنَطُ مِن رَّحْمَةِ رَبِّهِۦٓ إِلَّا ٱلضَّآلُّونَ","translationUz":"U: «Faqat zalolatga ketgan kishilargina o`z Robbisining rahmatidan noumid bo`lurlar», dedi.","transcription":null,"tafsirUz":null,"pageNumber":265,"juz":14,"createdAt":"2026-09-17T18:45:27.435Z","updatedAt":"2026-09-17T18:45:27.435Z"},{"id":1859,"surahId":15,"surah":{"id":15,"number":15,"nameArabic":"الحجر","nameUz":"Hijr","meaningUz":"Hijr vodiysi","revelationPlace":"makka","totalAyahs":99,"startPage":262,"createdAt":"2026-09-17T18:45:07.474Z","updatedAt":"2026-09-18T00:07:52.373Z"},"numberInSurah":57,"textArabic":"قَالَ فَمَا خَطْبُكُمْ أَيُّهَا ٱلْمُرْسَلُونَ","translationUz":"U: «Ey elchilar, nima ish ila yuborildingiz?» dedi.","transcription":null,"tafsirUz":null,"pageNumber":265,"juz":14,"createdAt":"2026-09-17T18:45:27.439Z","updatedAt":"2026-09-17T18:45:27.439Z"},{"id":1860,"surahId":15,"surah":{"id":15,"number":15,"nameArabic":"الحجر","nameUz":"Hijr","meaningUz":"Hijr vodiysi","revelationPlace":"makka","totalAyahs":99,"startPage":262,"createdAt":"2026-09-17T18:45:07.474Z","updatedAt":"2026-09-18T00:07:52.373Z"},"numberInSurah":58,"textArabic":"قَالُوٓا۟ إِنَّآ أُرْسِلْنَآ إِلَىٰ قَوْمٍ مُّجْرِمِينَ","translationUz":"Ular: «Biz jinoyatchi qavmlarga yuborildik.","transcription":null,"tafsirUz":null,"pageNumber":265,"juz":14,"createdAt":"2026-09-17T18:45:27.444Z","updatedAt":"2026-09-17T18:45:27.444Z"},{"id":1861,"surahId":15,"surah":{"id":15,"number":15,"nameArabic":"الحجر","nameUz":"Hijr","meaningUz":"Hijr vodiysi","revelationPlace":"makka","totalAyahs":99,"startPage":262,"createdAt":"2026-09-17T18:45:07.474Z","updatedAt":"2026-09-18T00:07:52.373Z"},"numberInSurah":59,"textArabic":"إِلَّآ ءَالَ لُوطٍ إِنَّا لَمُنَجُّوهُمْ أَجْمَعِينَ","translationUz":"Magar Lut ahliga emas. Albatta, biz ularning hammasini qutqarguvchilarmiz.","transcription":null,"tafsirUz":null,"pageNumber":265,"juz":14,"createdAt":"2026-09-17T18:45:27.448Z","updatedAt":"2026-09-17T18:45:27.448Z"},{"id":1862,"surahId":15,"surah":{"id":15,"number":15,"nameArabic":"الحجر","nameUz":"Hijr","meaningUz":"Hijr vodiysi","revelationPlace":"makka","totalAyahs":99,"startPage":262,"createdAt":"2026-09-17T18:45:07.474Z","updatedAt":"2026-09-18T00:07:52.373Z"},"numberInSurah":60,"textArabic":"إِلَّا ٱمْرَأَتَهُۥ قَدَّرْنَآ ۙ إِنَّهَا لَمِنَ ٱلْغَـٰبِرِينَ","translationUz":"Faqat uning xotinigina istisnodir. Uning albatta qoluvchilardan bo`lishini taqdir qildik», dedilar.","transcription":null,"tafsirUz":null,"pageNumber":265,"juz":14,"createdAt":"2026-09-17T18:45:27.453Z","updatedAt":"2026-09-17T18:45:27.453Z"},{"id":1863,"surahId":15,"surah":{"id":15,"number":15,"nameArabic":"الحجر","nameUz":"Hijr","meaningUz":"Hijr vodiysi","revelationPlace":"makka","totalAyahs":99,"startPage":262,"createdAt":"2026-09-17T18:45:07.474Z","updatedAt":"2026-09-18T00:07:52.373Z"},"numberInSurah":61,"textArabic":"فَلَمَّا جَآءَ ءَالَ لُوطٍ ٱلْمُرْسَلُونَ","translationUz":"Elchilar Lut ahliga kelganlarida...","transcription":null,"tafsirUz":null,"pageNumber":265,"juz":14,"createdAt":"2026-09-17T18:45:27.458Z","updatedAt":"2026-09-17T18:45:27.458Z"},{"id":1864,"surahId":15,"surah":{"id":15,"number":15,"nameArabic":"الحجر","nameUz":"Hijr","meaningUz":"Hijr vodiysi","revelationPlace":"makka","totalAyahs":99,"startPage":262,"createdAt":"2026-09-17T18:45:07.474Z","updatedAt":"2026-09-18T00:07:52.373Z"},"numberInSurah":62,"textArabic":"قَالَ إِنَّكُمْ قَوْمٌ مُّنكَرُونَ","translationUz":"U: «Albatta, siz notanish qavmsiz», dedi.","transcription":null,"tafsirUz":null,"pageNumber":265,"juz":14,"createdAt":"2026-09-17T18:45:27.462Z","updatedAt":"2026-09-17T18:45:27.462Z"},{"id":1865,"surahId":15,"surah":{"id":15,"number":15,"nameArabic":"الحجر","nameUz":"Hijr","meaningUz":"Hijr vodiysi","revelationPlace":"makka","totalAyahs":99,"startPage":262,"createdAt":"2026-09-17T18:45:07.474Z","updatedAt":"2026-09-18T00:07:52.373Z"},"numberInSurah":63,"textArabic":"قَالُوا۟ بَلْ جِئْنَـٰكَ بِمَا كَانُوا۟ فِيهِ يَمْتَرُونَ","translationUz":"Ular: «Yo`q! Biz senga ular shak qilayotgan narsa ila keldik.","transcription":null,"tafsirUz":null,"pageNumber":265,"juz":14,"createdAt":"2026-09-17T18:45:27.467Z","updatedAt":"2026-09-17T18:45:27.467Z"},{"id":1866,"surahId":15,"surah":{"id":15,"number":15,"nameArabic":"الحجر","nameUz":"Hijr","meaningUz":"Hijr vodiysi","revelationPlace":"makka","totalAyahs":99,"startPage":262,"createdAt":"2026-09-17T18:45:07.474Z","updatedAt":"2026-09-18T00:07:52.373Z"},"numberInSurah":64,"textArabic":"وَأَتَيْنَـٰكَ بِٱلْحَقِّ وَإِنَّا لَصَـٰدِقُونَ","translationUz":"Senga haq ila keldik va albatta, bizlar rostgo`ylardurmiz.","transcription":null,"tafsirUz":null,"pageNumber":265,"juz":14,"createdAt":"2026-09-17T18:45:27.471Z","updatedAt":"2026-09-17T18:45:27.471Z"},{"id":1867,"surahId":15,"surah":{"id":15,"number":15,"nameArabic":"الحجر","nameUz":"Hijr","meaningUz":"Hijr vodiysi","revelationPlace":"makka","totalAyahs":99,"startPage":262,"createdAt":"2026-09-17T18:45:07.474Z","updatedAt":"2026-09-18T00:07:52.373Z"},"numberInSurah":65,"textArabic":"فَأَسْرِ بِأَهْلِكَ بِقِطْعٍ مِّنَ ٱلَّيْلِ وَٱتَّبِعْ أَدْبَـٰرَهُمْ وَلَا يَلْتَفِتْ مِنكُمْ أَحَدٌ وَٱمْضُوا۟ حَيْثُ تُؤْمَرُونَ","translationUz":"Ahling ila kechaning bir bo`lagida yo`lga chiq, sen ularning ortidan kuzatib bor. Sizlardan hech birlaringiz ortga qaramasin. Amr qilingan tomoningizga ketaveringlar», dedilar.","transcription":null,"tafsirUz":null,"pageNumber":265,"juz":14,"createdAt":"2026-09-17T18:45:27.476Z","updatedAt":"2026-09-17T18:45:27.476Z"},{"id":1868,"surahId":15,"surah":{"id":15,"number":15,"nameArabic":"الحجر","nameUz":"Hijr","meaningUz":"Hijr vodiysi","revelationPlace":"makka","totalAyahs":99,"startPage":262,"createdAt":"2026-09-17T18:45:07.474Z","updatedAt":"2026-09-18T00:07:52.373Z"},"numberInSurah":66,"textArabic":"وَقَضَيْنَآ إِلَيْهِ ذَٰلِكَ ٱلْأَمْرَ أَنَّ دَابِرَ هَـٰٓؤُلَآءِ مَقْطُوعٌ مُّصْبِحِينَ","translationUz":"Va unga ushbu amrni vahiy qildik: «Albatta, anavilarning orqasi subh chog`i kesilajakdir».","transcription":null,"tafsirUz":null,"pageNumber":265,"juz":14,"createdAt":"2026-09-17T18:45:27.481Z","updatedAt":"2026-09-17T18:45:27.481Z"},{"id":1869,"surahId":15,"surah":{"id":15,"number":15,"nameArabic":"الحجر","nameUz":"Hijr","meaningUz":"Hijr vodiysi","revelationPlace":"makka","totalAyahs":99,"startPage":262,"createdAt":"2026-09-17T18:45:07.474Z","updatedAt":"2026-09-18T00:07:52.373Z"},"numberInSurah":67,"textArabic":"وَجَآءَ أَهْلُ ٱلْمَدِينَةِ يَسْتَبْشِرُونَ","translationUz":"Va shahar ahli sevinib, yetib keldilar.","transcription":null,"tafsirUz":null,"pageNumber":265,"juz":14,"createdAt":"2026-09-17T18:45:27.484Z","updatedAt":"2026-09-17T18:45:27.484Z"},{"id":1870,"surahId":15,"surah":{"id":15,"number":15,"nameArabic":"الحجر","nameUz":"Hijr","meaningUz":"Hijr vodiysi","revelationPlace":"makka","totalAyahs":99,"startPage":262,"createdAt":"2026-09-17T18:45:07.474Z","updatedAt":"2026-09-18T00:07:52.373Z"},"numberInSurah":68,"textArabic":"قَالَ إِنَّ هَـٰٓؤُلَآءِ ضَيْفِى فَلَا تَفْضَحُونِ","translationUz":"U: «Bular mening mehmonlarim, axir. Meni sharmanda qilmanglar», dedi.","transcription":null,"tafsirUz":null,"pageNumber":265,"juz":14,"createdAt":"2026-09-17T18:45:27.487Z","updatedAt":"2026-09-17T18:45:27.487Z"},{"id":1871,"surahId":15,"surah":{"id":15,"number":15,"nameArabic":"الحجر","nameUz":"Hijr","meaningUz":"Hijr vodiysi","revelationPlace":"makka","totalAyahs":99,"startPage":262,"createdAt":"2026-09-17T18:45:07.474Z","updatedAt":"2026-09-18T00:07:52.373Z"},"numberInSurah":69,"textArabic":"وَٱتَّقُوا۟ ٱللَّهَ وَلَا تُخْزُونِ","translationUz":"Va: «Allohdan qo`rqinglar! Meni xor qilmanglar», dedi.","transcription":null,"tafsirUz":null,"pageNumber":265,"juz":14,"createdAt":"2026-09-17T18:45:27.491Z","updatedAt":"2026-09-17T18:45:27.491Z"},{"id":1872,"surahId":15,"surah":{"id":15,"number":15,"nameArabic":"الحجر","nameUz":"Hijr","meaningUz":"Hijr vodiysi","revelationPlace":"makka","totalAyahs":99,"startPage":262,"createdAt":"2026-09-17T18:45:07.474Z","updatedAt":"2026-09-18T00:07:52.373Z"},"numberInSurah":70,"textArabic":"قَالُوٓا۟ أَوَلَمْ نَنْهَكَ عَنِ ٱلْعَـٰلَمِينَ","translationUz":"Ular: «Biz seni olamlardan qaytarmaganmidik?!» dedilar.","transcription":null,"tafsirUz":null,"pageNumber":265,"juz":14,"createdAt":"2026-09-17T18:45:27.495Z","updatedAt":"2026-09-17T18:45:27.495Z"}]}