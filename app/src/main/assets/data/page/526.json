"number":53,"nameArabic":"النجم","nameUz":"Najm","meaningUz":"Yulduz","revelationPlace":"makka","totalAyahs":62,"startPage":526,"createdAt":"2026-09-17T18:45:07.664Z","updatedAt":"2026-09-18T00:07:52.549Z"},"numberInSurah":20,"textArabic":"وَمَنَوٰةَ ٱلثَّالِثَةَ ٱلْأُخْرَىٰٓ","translationUz":"Va boshqasi, uchinchisi — Manotni ham (o`ylab ko`rdingizmi)?","transcription":null,"tafsirUz":null,"pageNumber":526,"juz":27,"createdAt":"2026-09-17T18:45:57.388Z","updatedAt":"2026-09-17T18:45:57.388Z"},{"id":4805,"surahId":53,"surah":{"id":53,"number":53,"nameArabic":"النجم","nameUz":"Najm","meaningUz":"Yulduz","revelationPlace":"makka","totalAyahs":62,"startPage":526,"createdAt":"2026-09-17T18:45:07.664Z","updatedAt":"2026-09-18T00:07:52.549Z"},"numberInSurah":21,"textArabic":"أَلَكُمُ ٱلذَّكَرُ وَلَهُ ٱلْأُنثَىٰ","translationUz":"Sizlarga erkak-u, U zotga ayolmi?","transcription":null,"tafsirUz":null,"pageNumber":526,"juz":27,"createdAt":"2026-09-17T18:45:57.392Z","updatedAt":"2026-09-17T18:45:57.392Z"},{"id":4806,"surahId":53,"surah":{"id":53,"number":53,"nameArabic":"النجم","nameUz":"Najm","meaningUz":"Yulduz","revelationPlace":"makka","totalAyahs":62,"startPage":526,"createdAt":"2026-09-17T18:45:07.664Z","updatedAt":"2026-09-18T00:07:52.549Z"},"numberInSurah":22,"textArabic":"تِلْكَ إِذًا قِسْمَةٌ ضِيزَىٰٓ","translationUz":"Undoq bo`lsa, bu noto`g`ri taqsim-ku!","transcription":null,"tafsirUz":null,"pageNumber":526,"juz":27,"createdAt":"2026-09-17T18:45:57.395Z","updatedAt":"2026-09-17T18:45:57.395Z"},{"id":4807,"surahId":53,"surah":{"id":53,"number":53,"nameArabic":"النجم","nameUz":"Najm","meaningUz":"Yulduz","revelationPlace":"makka","totalAyahs":62,"startPage":526,"createdAt":"2026-09-17T18:45:07.664Z","updatedAt":"2026-09-18T00:07:52.549Z"},"numberInSurah":23,"textArabic":"إِنْ هِىَ إِلَّآ أَسْمَآءٌ سَمَّيْتُمُوهَآ أَنتُمْ وَءَابَآؤُكُم مَّآ أَنزَلَ ٱللَّهُ بِهَا مِن سُلْطَـٰنٍ ۚ إِن يَتَّبِعُونَ إِلَّا ٱلظَّنَّ وَمَا تَهْوَى ٱلْأَنفُسُ ۖ وَلَقَدْ جَآءَهُم مِّن رَّبِّهِمُ ٱلْهُدَىٰٓ","translationUz":"U(but)lar siz va ota-bobolaringiz qo`ygan nomlardan o`zga hech narsa emas. Alloh bunga hech hujjat tushirgan emas. U(mushrik)lar, Robbilaridan hidoyat kelganiga qaramay, gumon va havoyi nafs xohishiga ergasharlar, xolos.","transcription":null,"tafsirUz":null,"pageNumber":526,"juz":27,"createdAt":"2026-09-17T18:45:57.400Z","updatedAt":"2026-09-17T18:45:57.400Z"},{"id":4808,"surahId":53,"surah":{"id":53,"number":53,"nameArabic":"النجم","nameUz":"Najm","meaningUz":"Yulduz","revelationPlace":"makka","totalAyahs":62,"startPage":526,"createdAt":"2026-09-17T18:45:07.664Z","updatedAt":"2026-09-18T00:07:52.549Z"},"numberInSurah":24,"textArabic":"أَمْ لِلْإِنسَـٰنِ مَا تَمَنَّىٰ","translationUz":"Yoki har inson nimani xohlasa, shu bo`laveradimi?","transcription":null,"tafsirUz":null,"pageNumber":526,"juz":27,"createdAt":"2026-09-17T18:45:57.404Z","updatedAt":"2026-09-17T18:45:57.404Z"},{"id":4809,"surahId":53,"surah":{"id":53,"number":53,"nameArabic":"النجم","nameUz":"Najm","meaningUz":"Yulduz","revelationPlace":"makka","totalAyahs":62,"startPage":526,"createdAt":"2026-09-17T18:45:07.664Z","updatedAt":"2026-09-18T00:07:52.549Z"},"numberInSurah":25,"textArabic":"فَلِلَّهِ ٱلْـَٔاخِرَةُ وَٱلْأُولَىٰ","translationUz":"Zero, oxirat ham, dunyo ham Allohnikidir.","transcription":null,"tafsirUz":null,"pageNumber":526,"juz":27,"createdAt":"2026-09-17T18:45:57.407Z","updatedAt":"2026-09-17T18:45:57.407Z"},{"id":4810,"surahId":53,"surah":{"id":53,"number":53,"nameArabic":"النجم","nameUz":"Najm","meaningUz":"Yulduz","revelationPlace":"makka","totalAyahs":62,"startPage":526,"createdAt":"2026-09-17T18:45:07.664Z","updatedAt":"2026-09-18T00:07:52.549Z"},"numberInSurah":26,"textArabic":"۞ وَكَم مِّن مَّلَكٍ فِى ٱلسَّمَـٰوَٰتِ لَا تُغْنِى شَفَـٰعَتُهُمْ شَيْـًٔا إِلَّا مِنۢ بَعْدِ أَن يَأْذَنَ ٱللَّهُ لِمَن يَشَآءُ وَيَرْضَىٰٓ","translationUz":"Osmonlarda qanchadan-qancha farishtalar mavjud, ularning shafoati hech foyda bermas. Magar, Alloh O`zi xohlagan va rozi bo`lganlarga izn bersa.","transcription":null,"tafsirUz":null,"pageNumber":526,"juz":27,"createdAt":"2026-09-17T18:45:57.410Z","updatedAt":"2026-09-17T18:45:57.410Z"}]}