{"number":564,"textArabic":null,"translationUz":null,"juz":null,"note":null,"updatedAt":null,"ayahs":[{"id":5268,"surahId":67,"surah":{"id":67,"number":67,"nameArabic":"الملك","nameUz":"Mulk","meaningUz":"Podshohlik","revelationPlace":"makka","totalAyahs":30,"startPage":562,"createdAt":"2026-09-17T18:45:07.731Z","updatedAt":"2026-09-18T00:07:52.602Z"},"numberInSurah":27,"textArabic":"فَلَمَّا رَأَوْهُ زُلْفَةً سِيٓـَٔتْ وُجُوهُ ٱلَّذِينَ كَفَرُوا۟ وَقِيلَ هَـٰذَا ٱلَّذِى كُنتُم بِهِۦ تَدَّعُونَ","translationUz":"Bas u(azob)ni yaqindan ko`rganda kufr keltirganlarning yuzlari qorayadir. Va ularga: «So`ragan narsangiz shu bo`lur», deyilur.","transcription":null,"tafsirUz":null,"pageNumber":564,"juz":29,"createdAt":"2026-09-17T18:46:02.898Z","updatedAt":"2026-09-17T18:46:02.898Z"},{"id":5269,"surahId":67,"surah":{"id":67,"number":67,"nameArabic":"الملك","nameUz":"Mulk","meaningUz":"Podshohlik","revelationPlace":"makka","totalAyahs":30,"startPage":562,"createdAt":"2026-09-17T18:45:07.731Z","updatedAt":"2026-09-18T00:07:52.602Z"},"numberInSurah":28,"textArabic":"قُلْ أَرَءَيْتُمْ إِنْ أَهْلَكَنِىَ ٱللَّهُ وَمَن مَّعِىَ أَوْ رَحِمَنَا فَمَن يُجِيرُ ٱلْكَـٰفِرِينَ مِنْ عَذَابٍ أَلِيمٍ","translationUz":"Ayt: «Aytinglar-chi, agar Alloh meni va men bilan bo`lganlarni halok qilsa yoki rahim qilsa, kofirlarni alamli azobdan kim qutqarib qoladir?!","transcription":null,"tafsirUz":null,"pageNumber":564,"juz":29,"createdAt":"2026-09-17T18:46:02.902Z","updatedAt":"2026-09-17T18:46:02.902Z"},{"id":5270,"surahId":67,"surah":{"id":67,"number":67,"nameArabic":"الملك","nameUz":"Mulk","meaningUz":"Podshohlik","revelationPlace":"makka","totalAyahs":30,"startPage":562,"createdAt":"2026-09-17T18:45:07.731Z","updatedAt":"2026-09-18T00:07:52.602Z"},"numberInSurah":29,"textArabic":"قُلْ هُوَ ٱلرَّحْمَـٰنُ ءَامَنَّا بِهِۦ وَعَلَيْهِ تَوَكَّلْنَا ۖ فَسَتَعْلَمُونَ مَنْ هُوَ فِى ضَلَـٰلٍ مُّبِينٍ","translationUz":"Ayt: «U Rohmandur, biz Unga iymon keltirdik va Unga tavakkal qildik. Bas, sizlar tezda kim ochiq-oydin xatoda ekanini bilursizlar».","transcription":null,"tafsirUz":null,"pageNumber":564,"juz":29,"createdAt":"2026-09-17T18:46:02.906Z","updatedAt":"2026-09-17T18:46:02.906Z"},{"id":5271,"surahId":67,"surah":{"id":67,"number":67,"nameArabic":"الملك","nameUz":"Mulk","meaningUz":"Podshohlik","revelationPlace":"makka","totalAyahs":30,"startPage":562,"createdAt":"2026-09-17T18:45:07.731Z","updatedAt":"2026-09-18T00:07:52.602Z"},"numberInSurah":30,"textArabic":"قُلْ أَرَءَيْتُمْ إِنْ أَصْبَحَ مَآؤُكُمْ غَوْرًا فَمَن يَأْتِيكُم بِمَآءٍ مَّعِينٍۭ","translationUz":"Ayt: «Aytinglar-chi, agar suvlaringiz yerga singib ketsa, sizlarga kim osongina topiladigan suvni keltirur?»","transcription":null,"tafsirUz":null,"pageNumber":564,"juz":29,"createdAt":"2026-09-17T18:46:02.909Z","updatedAt":"2026-09-17T18:46:02.909Z"},{"id":5272,"surahId":68,"surah":{"id":68,"number":68,"nameArabic":"القلم","nameUz":"Qalam","meaningUz":"Qalam","revelationPlace":"makka","totalAyahs":52,"startPage":564,"createdAt":"2026-09-17T18:45:07.736Z","updatedAt":"2026-09-18T00:07:52.605Z"},"numberInSurah":1,"textArabic":" نٓ ۚ وَٱلْقَلَمِ وَمَا يَسْطُرُونَ","translationUz":"Nuun. Qalam bilan va satrlarga yozadigan narsalar bilan qasam.","transcription":null,"tafsirUz":null,"pageNumber":564,"juz":29,"createdAt":"2026-09-17T18:46:03.376Z","updatedAt":"2026-09-17T18:46:03.376Z"},{"id":5273,"surahId":68,"surah":{"id":68,"number":68,"nameArabic":"القلم","nameUz":"Qalam","meaningUz":"Qalam","revelationPlace":"makka","totalAyahs":52,"startPage":564,"createdAt":"2026-09-17T18:45:07.736Z","updatedAt":"2026-09-18T00:07:52.605Z"},"numberInSurah":2,"textArabic":"مَآ أَنتَ بِنِعْمَةِ رَبِّكَ بِمَجْنُونٍ","translationUz":"Sen Robbing ne'mati ila majnun emassan.","transcription":null,"tafsirUz":null,"pageNumber":564,"juz":29,"createdAt":"2026-09-17T18:46:03.381Z","updatedAt":"2026-09-17T18:46:03.381Z"},{"id":5274,"surahId":68,"surah":{"id":68,"number":68,"nameArabic":"القلم","nameUz":"Qalam","meaningUz":"Qalam","revelationPlace":"makka","totalAyahs":52,"startPage":564,"createdAt":"2026-09-17T18:45:07.736Z","updatedAt":"2026-09-18T00:07:52.605Z"},"numberInSurah":3,"textArabic":"وَإِنَّ لَكَ لَأَجْرًا غَيْرَ مَمْنُونٍ","translationUz":"Va albatta, senga minnat qilinmaydigan ajr bordur.","transcription":null,"tafsirUz":null,"pageNumber":564,"juz":29,"createdAt":"2026-09-17T18:46:03.385Z","updatedAt":"2026-09-17T18:46:03.385Z"},{"id":5275,"surahId":68,"surah":{"id":68,"number":68,"nameArabic":"القلم","nameUz":"Qalam","meaningUz":"Qalam","revelationPlace":"makka","totalAyahs":52,"startPage":564,"createdAt":"2026-09-17T18:45:07.736Z","updatedAt":"2026-09-18T00:07:52.605Z"},"numberInSurah":4,"textArabic":"وَإِنَّكَ لَعَلَىٰ خُلُقٍ عَظِيمٍ","translationUz":"Va albatta, sen ulkan xulqdasan.","transcription":null,"tafsirUz":null,"pageNumber":564,"juz":29,"createdAt":"2026-09-17T18:46:03.390Z","updatedAt":"2026-09-17T18:46:03.390Z"},{"id":5276,"surahId":68,"surah":{"id":68,"number":68,"nameArabic":"القلم","nameUz":"Qalam","meaningUz":"Qalam","revelationPlace":"makka","totalAyahs":52,"startPage":564,"createdAt":"2026-09-17T18:45:07.736Z","updatedAt":"2026-09-18T00:07:52.605Z"},"numberInSurah":5,"textArabic":"فَسَتُبْصِرُ وَيُبْصِرُونَ","translationUz":"Bas, tezda ko`rasan va ular ham ko`rurlar.","transcription":null,"tafsirUz":null,"pageNumber":564,"juz":29,"createdAt":"2026-09-17T18:46:03.395Z","updatedAt":"2026-09-17T18:46:03.395Z"},{"id":5277,"surahId":68,"surah":{"id":68,"number":68,"nameArabic":"القلم","nameUz":"Qalam","meaningUz":"Qalam","revelationPlace":"makka","totalAyahs":52,"startPage":564,"createdAt":"2026-09-17T18:45:07.736Z","updatedAt":"2026-09-18T00:07:52.605Z"},"numberInSurah":6,"textArabic":"بِأَييِّكُمُ ٱلْمَفْتُونُ","translationUz":"Sizlardan qaysingizda majnunlik borligini.","transcription":null,"tafsirUz":null,"pageNumber":564,"juz":29,"createdAt":"2026-09-17T18:46:03.399Z","updatedAt":"2026-09-17T18:46:03.399Z"},{"id":5278,"surahId":68,"surah":{"id":68,"n