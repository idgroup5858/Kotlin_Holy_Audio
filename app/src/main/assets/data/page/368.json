{"number":368,"textArabic":null,"translationUz":null,"juz":null,"note":null,"updatedAt":null,"ayahs":[{"id":2952,"surahId":26,"surah":{"id":26,"number":26,"nameArabic":"الشعراء","nameUz":"Shuaro","meaningUz":"Shoirlar","revelationPlace":"makka","totalAyahs":227,"startPage":367,"createdAt":"2026-09-17T18:45:07.530Z","updatedAt":"2026-09-18T00:07:52.427Z"},"numberInSurah":20,"textArabic":"قَالَ فَعَلْتُهَآ إِذًا وَأَنَا۠ مِنَ ٱلضَّآلِّينَ","translationUz":"U (Muso): «O`sha ishni qilgan bo`lsam, bilmasdan qilganman.","transcription":null,"tafsirUz":null,"pageNumber":368,"juz":19,"createdAt":"2026-09-17T18:45:39.257Z","updatedAt":"2026-09-17T18:45:39.257Z"},{"id":2953,"surahId":26,"surah":{"id":26,"number":26,"nameArabic":"الشعراء","nameUz":"Shuaro","meaningUz":"Shoirlar","revelationPlace":"makka","totalAyahs":227,"startPage":367,"createdAt":"2026-09-17T18:45:07.530Z","updatedAt":"2026-09-18T00:07:52.427Z"},"numberInSurah":21,"textArabic":"فَفَرَرْتُ مِنكُمْ لَمَّا خِفْتُكُمْ فَوَهَبَ لِى رَبِّى حُكْمًا وَجَعَلَنِى مِنَ ٱلْمُرْسَلِينَ","translationUz":"Bas, sizlardan xavfsirab qochib ketdim. Keyin Alloh menga hikmat berdi va meni Payg`ambarlardan qildi.","transcription":null,"tafsirUz":null,"pageNumber":368,"juz":19,"createdAt":"2026-09-17T18:45:39.261Z","updatedAt":"2026-09-17T18:45:39.261Z"},{"id":2954,"surahId":26,"surah":{"id":26,"number":26,"nameArabic":"الشعراء","nameUz":"Shuaro","meaningUz":"Shoirlar","revelationPlace":"makka","totalAyahs":227,"startPage":367,"createdAt":"2026-09-17T18:45:07.530Z","updatedAt":"2026-09-18T00:07:52.427Z"},"numberInSurah":22,"textArabic":"وَتِلْكَ نِعْمَةٌ تَمُنُّهَا عَلَىَّ أَنْ عَبَّدتَّ بَنِىٓ إِسْرَٰٓءِيلَ","translationUz":"O`sha menga qilayotgan minnating Bani Isroilni qul qilib olganingdandir», dedi.","transcription":null,"tafsirUz":null,"pageNumber":368,"juz":19,"createdAt":"2026-09-17T18:45:39.265Z","updatedAt":"2026-09-17T18:45:39.265Z"},{"id":2955,"surahId":26,"surah":{"id":26,"number":26,"nameArabic":"الشعراء","nameUz":"Shuaro","meaningUz":"Shoirlar","revelationPlace":"makka","totalAyahs":227,"startPage":367,"createdAt":"2026-09-17T18:45:07.530Z","updatedAt":"2026-09-18T00:07:52.427Z"},"numberInSurah":23,"textArabic":"قَالَ فِرْعَوْنُ وَمَا رَبُّ ٱلْعَـٰلَمِينَ","translationUz":"Fir'avn: «Robbul olamiyn nima?» dedi.","transcription":null,"tafsirUz":null,"pageNumber":368,"juz":19,"createdAt":"2026-09-17T18:45:39.269Z","updatedAt":"2026-09-17T18:45:39.269Z"},{"id":2956,"surahId":26,"surah":{"id":26,"number":26,"nameArabic":"الشعراء","nameUz":"Shuaro","meaningUz":"Shoirlar","revelationPlace":"makka","totalAyahs":227,"startPage":367,"createdAt":"2026-09-17T18:45:07.530Z","updatedAt":"2026-09-18T00:07:52.427Z"},"numberInSurah":24,"textArabic":"قَالَ رَبُّ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ وَمَا بَيْنَهُمَآ ۖ إِن كُنتُم مُّوقِنِينَ","translationUz":"U (Muso): «Agar anglamoqchi bo`lsangiz, U, osmonlaru yer va ularning orasidagi narsalarning Robbidir», dedi.","transcription":null,"tafsirUz":null,"pageNumber":368,"juz":19,"createdAt":"2026-09-17T18:45:39.273Z","updatedAt":"2026-09-17T18:45:39.273Z"},{"id":2957,"surahId":26,"surah":{"id":26,"number":26,"nameArabic":"الشعراء","nameUz":"Shuaro","meaningUz":"Shoirlar","revelationPlace":"makka","totalAyahs":227,"startPage":367,"createdAt":"2026-09-17T18:45:07.530Z","updatedAt":"2026-09-18T00:07:52.427Z"},"numberInSurah":25,"textArabic":"قَالَ لِمَنْ حَوْلَهُۥٓ أَلَا تَسْتَمِعُونَ","translationUz":"U (Fir'avn) atrofidagi kishilarga: «Eshitmayapsizlarmi?!» dedi.","transcription":null,"tafsirUz":null,"pageNumber":368,"juz":19,"createdAt":"2026-09-17T18:45:39.277Z","updatedAt":"2026-09-17T18:45:39.277Z"},{"id":2958,"surahId":26,"surah":{"id":26,"number":26,"nameArabic":"الشعراء","nameUz":"Shuaro","meaningUz":"Shoirlar","revelationPlace":"makka","totalAyahs":227,"startPage":367,"createdAt":"2026-09-17T18:45:07.530Z","updatedAt":"2026-09-18T00:07:52.427Z"},"numberInSurah":26,"textArabic":"قَالَ رَبُّكُمْ وَرَبُّ ءَابَآئِكُمُ ٱلْأَوَّلِينَ","translationUz":"U: «Sizning Robbingiz va avvalgi ota-bobolaringizning Robbidir», dedi.","transcription":null,"tafsirUz":null,"pageNumber":368,"juz":19,"createdAt":"2026-09-17T18:45:39.281Z","updatedAt":"2026-09-17T18:45:39.281Z"},{"id":2959,"surahId":26,"surah":{"id":26,"number":26,"nameArabic":"الشعراء","nameUz":"Shuaro","meaningUz":"Shoirlar","revelationPlace":"makka","totalAyahs":227,"startPage":367,"createdAt":"2026-09-17T18:45:07.530Z","updatedAt":"2026-09-18T00:07:52.427Z"},"numberInSurah":27,"textArabic":"قَالَ إِنَّ رَسُولَكُمُ ٱلَّذِىٓ أُرْسِلَ إِلَيْكُمْ لَمَجْنُونٌ","translationUz":"U: «Albatta, sizga yuborilgan Payg`ambaringiz jinnidir», dedi.","transcription":null,"tafsirUz":null,"pageNumber":368,"juz":19,"createdAt":"2026-09-17T18:45:39.286Z","updatedAt":"2026-09-17T18:45:39.286Z"},{"id":2960,"surahId":26,"surah":{"id":26,"number":26,"nameArabic":"الشعراء","nameUz":"Shuaro","meaningUz":"Shoirlar","revelationPlace":"makka","totalAyahs":227,"startPage":367,"createdAt":"2026-09-17T18:45:07.530Z","updatedAt":"2026-09-18T00:07:52.427Z"},"numberInSurah":28,"textArabic":"قَالَ رَبُّ ٱلْمَشْرِقِ وَٱلْمَغْرِبِ وَمَا بَيْنَهُمَآ ۖ إِن كُنتُمْ تَعْقِلُونَ","translationUz":"U: «U zot, agar aql yuritsangiz, mashriqu mag`ribning va ular o`rtasidagi narsalarning Robbidir», dedi.","transcription":null,"tafsirUz":null,"pageNumber":368,"juz":19,"createdAt":"2026-09-17T18:45:39.290Z","updatedAt":"2026-09-17T18:45:39.290Z"},{"id":2961,"surahId":26,"surah":{"id":26,"number":26,"nameArabic":"الشعراء","nameUz":"Shuaro","meaningUz":"Shoirlar","revelationPlace":"makka","totalAyahs":227,"startPage":367,"createdAt":"2026-09-17T18:45:07.530Z","updatedAt":"2026-09-18T00:07:52.427Z"},"numberInSurah":29,"textArabic":"قَالَ لَئِنِ ٱتَّخَذْتَ إِلَـٰهًا غَيْرِى لَأَجْعَلَنَّكَ مِنَ ٱلْمَسْجُونِينَ","translationUz":"U: «Agar mendan boshqani iloh qilib olsang, albatta, men seni zindonbandlardan qilurman», dedi.","transcription":null,"tafsirUz":null,"pageNumber":368,"juz":19,"createdAt":"2026-09-17T18:45:39.295Z","updatedAt":"2026-09-17T18:45:39.295Z"},{"id":2962,"surahId":26,"surah":{"id":26,"number":26,"nameArabic":"الشعراء","nameUz":"Shuaro","meaningUz":"Shoirlar","revelationPlace":"makka","totalAyahs":227,"startPage":367,"createdAt":"2026-09-17T18:45:07.530Z","updatedAt":"2026-09-18T00:07:52.427Z"},"numberInSurah":30,"textArabic":"قَالَ أَوَلَوْ جِئْتُكَ بِشَىْءٍ مُّبِينٍ","translationUz":"U: «Agar men senga ochiq-oydin narsa keltirsam ham-a?» dedi.","transcription":null,"tafsirUz":null,"pageNumber":368,"juz":19,"createdAt":"2026-09-17T18:45:39.299Z","updatedAt":"2026-09-17T18:45:39.299Z"},{"id":2963,"surahId":26,"surah":{"id":26,"number":26,"nameArabic":"الشعراء","nameUz":"Shuaro","meaningUz":"Shoirlar","revelationPlace":"makka","totalAyahs":227,"startPage":367,"createdAt":"2026-09-17T18:45:07.530Z","updatedAt":"2026-09-18T00:07:52.427Z"},"numberInSurah":31,"textArabic":"قَالَ فَأْتِ بِهِۦٓ إِن كُنتَ مِنَ ٱلصَّـٰدِقِينَ","translationUz":"U: «Agar rostgo`ylardan bo`lsang, keltir uni!» dedi.","transcription":null,"tafsirUz":null,"pageNumber":368,"juz":19,"createdAt":"2026-09-17T18:45:39.303Z","updatedAt":"2026-09-17T18:45:39.303Z"},{"id":2964,"surahId":26,"surah":{"id":26,"number":26,"nameArabic":"الشعراء","nameUz":"Shuaro","meaningUz":"Shoirlar","revelationPlace":"makka","totalAyahs":227,"startPage":367,"createdAt":"2026-09-17T18:45:07.530Z","updatedAt":"2026-09-18T00:07:52.427Z"},"numberInSurah":32,"textArabic":"فَأَلْقَىٰ عَصَاهُ فَإِذَا هِىَ ثُعْبَانٌ مُّبِينٌ","translationUz":"Bas, u (Muso) asosini tashladi. Banogoh u aniq ajdarga aylandi.","transcription":null,"tafsirUz":null,"pageNumber":368,"juz":19,"createdAt":"2026-09-17T18:45:39.308Z","updatedAt":"2026-09-17T18:45:39.308Z"},{"id":2965,"surahId":26,"surah":{"id":26,"number":26,"nameArabic":"الشعراء","nameUz":"Shuaro","meaningUz":"Shoirlar","revelationPlace":"makka","totalAyahs":227,"startPage":367,"createdAt":"2026-09-17T18:45:07.530Z","updatedAt":"2026-09-18T00:07:52.427Z"},"numberInSurah":33,"textArabic":"وَنَزَعَ يَدَهُۥ فَإِذَا هِىَ بَيْضَآءُ لِلنَّـٰظِرِينَ","translationUz":"Va qo`lini chiqardi. Banogoh u nazar qilguvchilarga oppoq ko`rindi.","transcription":null,"tafsirUz":null,"pageNumber":368,"juz":19,"createdAt":"2026-09-17T18:45:39.312Z","updatedAt":"2026-09-17T18:45:39.312Z"},{"id":2966,"surahId":26,"surah":{"id":26,"number":26,"nameArabic":"الشعراء","nameUz":"Shuaro","meaningUz":"Shoirlar","revelationPlace":"makka","totalAyahs":227,"startPage":367,"createdAt":"2026-09-17T18:45:07.530Z","updatedAt":"2026-09-18T00:07:52.427Z"},"numberInSurah":34,"textArabic":"قَالَ لِلْمَلَإِ حَوْلَهُۥٓ إِنَّ هَـٰذَا لَسَـٰحِرٌ عَلِيمٌ","translationUz":"U (Fir'avn) atrofidagi a'yonlariga: «Albatta, bu o`ta bilimdon sehrgardir.","transcription":null,"tafsirUz":null,"pageNumber":368,"juz":19,"createdAt":"2026-09-17T18:45:39.317Z","updatedAt":"2026-09-17T18:45:39.317Z"},{"id":2967,"surahId":26,"surah":{"id":26,"number":26,"nameArabic":"الشعراء","nameUz":"Shuaro","meaningUz":"Shoirlar","revelationPlace":"makka","totalAyahs":227,"startPage":367,"createdAt":"2026-09-17T18:45:07.530Z","updatedAt":"2026-09-18T00:07:52.427Z"},"numberInSurah":35,"textArabic":"يُرِيدُ أَن يُخْرِجَكُم مِّنْ أَرْضِكُم بِسِحْرِهِۦ فَمَاذَا تَأْمُرُونَ","translationUz":"U o`z sehri bilan sizlarni yeringizdan chiqarmoqchi, nima deysizlar?» dedi.","transcription":null,"tafsirUz":null,"pageNumber":368,"juz":19,"createdAt":"2026-09-17T18:45:39.322Z","updatedAt":"2026-09-17T18:45:39.322Z"},{"id":2968,"surahId":26,"surah":{"id":26,"number":26,"nameArabic":"الشعراء","nameUz":"Shuaro","meaningUz":"Shoirlar","revelationPlace":"makka","totalAyahs":227,"startPage":367,"createdAt":"2026-09-17T18:45:07.530Z","updatedAt":"2026-09-18T00:07:52.427Z"},"numberInSurah":36,"textArabic":"قَالُوٓا۟ أَرْجِهْ وَأَخَاهُ وَٱبْعَثْ فِى ٱلْمَدَآئِنِ حَـٰشِرِينَ","translationUz":"Ular: «Uni va akasini qo`yib turgin-da, shaharlarga to`plovchilarni yubor.","transcription":null,"tafsirUz":null,"pageNumber":368,"juz":19,"createdAt":"2026-09-17T18:45:39.326Z","updatedAt":"2026-09-17T18:45:39.326Z"},{"id":2969,"surahId":26,"surah":{"id":26,"number":26,"nameArabic":"الشعراء","nameUz":"Shuaro","meaningUz":"Shoirlar","revelationPlace":"makka","totalAyahs":227,"startPage":367,"createdAt":"2026-09-17T18:45:07.530Z","updatedAt":"2026-09-18T00:07:52.427Z"},"numberInSurah":37,"textArabic":"يَأْتُوكَ بِكُلِّ سَحَّارٍ عَلِيمٍ","translationUz":"Senga barcha o`ta bilimdon sehrgarlarni olib kelsinlar», dedilar.","transcription":null,"tafsirUz":null,"pageNumber":368,"juz":19,"createdAt":"2026-09-17T18:45:39.330Z","updatedAt":"2026-09-17T18:45:39.330Z"},{"id":2970,"surahId":26,"surah":{"id":26,"number":26,"nameArabic":"الشعراء","nameUz":"Shuaro","meaningUz":"Shoirlar","revelationPlace":"makka","totalAyahs":227,"startPage":367,"createdAt":"2026-09-17T18:45:07.530Z","updatedAt":"2026-09-18T00:07:52.427Z"},"numberInSurah":38,"textArabic":"فَجُمِعَ ٱلسَّحَرَةُ لِمِيقَـٰتِ يَوْمٍ مَّعْلُومٍ","translationUz":"Bas, sehrgarlar ma'lum kuni kelishilgan vaqtda jamlandilar.","transcription":null,"tafsirUz":null,"pageNumber":368,"juz":19,"createdAt":"2026-09-17T18:45:39.335Z","updatedAt":"2026-09-17T18:45:39.335Z"},{"id":2971,"surahId":26,"surah":{"id":26,"number":26,"nameArabic":"الشعراء","nameUz":"Shuaro","meaningUz":"Shoirlar","revelationPlace":"makka","totalAyahs":227,"startPage":367,"createdAt":"2026-09-17T18:45:07.530Z","updatedAt":"2026-09-18T00:07:52.427Z"},"numberInSurah":39,"textArabic":"وَقِيلَ لِلنَّاسِ هَلْ أَنتُم مُّجْتَمِعُونَ","translationUz":"Va odamlarga: «Sizlar to`planib bo`ldingizmi?","transcription":null,"tafsirUz":null,"pageNumber":368,"juz":19,"createdAt":"2026-09-17T18:45:39.339Z","updatedAt":"2026-09-17T18:45:39.339Z"}]}