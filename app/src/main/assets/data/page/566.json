{"number":566,"textArabic":null,"translationUz":null,"juz":null,"note":null,"updatedAt":null,"ayahs":[{"id":5314,"surahId":68,"surah":{"id":68,"number":68,"nameArabic":"القلم","nameUz":"Qalam","meaningUz":"Qalam","revelationPlace":"makka","totalAyahs":52,"startPage":564,"createdAt":"2026-09-17T18:45:07.736Z","updatedAt":"2026-09-18T00:07:52.605Z"},"numberInSurah":43,"textArabic":"خَـٰشِعَةً أَبْصَـٰرُهُمْ تَرْهَقُهُمْ ذِلَّةٌ ۖ وَقَدْ كَانُوا۟ يُدْعَوْنَ إِلَى ٱلسُّجُودِ وَهُمْ سَـٰلِمُونَ","translationUz":"Ularning ko`zlari qo`rqinchga to`la, xorlik o`rab olgan. Va darhaqiqat, ular salomatlik hollarida sajda qilishga chaqirilgan edilar.","transcription":null,"tafsirUz":null,"pageNumber":566,"juz":29,"createdAt":"2026-09-17T18:46:03.552Z","updatedAt":"2026-09-17T18:46:03.552Z"},{"id":5315,"surahId":68,"surah":{"id":68,"number":68,"nameArabic":"القلم","nameUz":"Qalam","meaningUz":"Qalam","revelationPlace":"makka","totalAyahs":52,"startPage":564,"createdAt":"2026-09-17T18:45:07.736Z","updatedAt":"2026-09-18T00:07:52.605Z"},"numberInSurah":44,"textArabic":"فَذَرْنِى وَمَن يُكَذِّبُ بِهَـٰذَا ٱلْحَدِيثِ ۖ سَنَسْتَدْرِجُهُم مِّنْ حَيْثُ لَا يَعْلَمُونَ","translationUz":"Bu gapni yolg`onga chiqaruvchilarni Mening O`zimga qo`yib qo`y. Biz ularni o`zlari bilmagan tarafdan asta-sekin olamiz.","transcription":null,"tafsirUz":null,"pageNumber":566,"juz":29,"createdAt":"2026-09-17T18:46:03.557Z","updatedAt":"2026-09-17T18:46:03.557Z"},{"id":5316,"surahId":68,"surah":{"id":68,"number":68,"nameArabic":"القلم","nameUz":"Qalam","meaningUz":"Qalam","revelationPlace":"makka","totalAyahs":52,"startPage":564,"createdAt":"2026-09-17T18:45:07.736Z","updatedAt":"2026-09-18T00:07:52.605Z"},"numberInSurah":45,"textArabic":"وَأُمْلِى لَهُمْ ۚ إِنَّ كَيْدِى مَتِينٌ","translationUz":"Va ularga muhlat beraman. Albatta, Mening hiylam metindir.","transcription":null,"tafsirUz":null,"pageNumber":566,"juz":29,"createdAt":"2026-09-17T18:46:03.561Z","updatedAt":"2026-09-17T18:46:03.561Z"},{"id":5317,"surahId":68,"surah":{"id":68,"number":68,"nameArabic":"القلم","nameUz":"Qalam","meaningUz":"Qalam","revelationPlace":"makka","totalAyahs":52,"startPage":564,"createdAt":"2026-09-17T18:45:07.736Z","updatedAt":"2026-09-18T00:07:52.605Z"},"numberInSurah":46,"textArabic":"أَمْ تَسْـَٔلُهُمْ أَجْرًا فَهُم مِّن مَّغْرَمٍ مُّثْقَلُونَ","translationUz":"Yoki sen ulardan haq so`rayapsan-u, ular qarzga botib qoldilarmi?","transcription":null,"tafsirUz":null,"pageNumber":566,"juz":29,"createdAt":"2026-09-17T18:46:03.564Z","updatedAt":"2026-09-17T18:46:03.564Z"},{"id":5318,"surahId":68,"surah":{"id":68,"number":68,"nameArabic":"القلم","nameUz":"Qalam","meaningUz":"Qalam","revelationPlace":"makka","totalAyahs":52,"startPage":564,"createdAt":"2026-09-17T18:45:07.736Z","updatedAt":"2026-09-18T00:07:52.605Z"},"numberInSurah":47,"textArabic":"أَمْ عِندَهُمُ ٱلْغَيْبُ فَهُمْ يَكْتُبُونَ","translationUz":"Yoki huzurlarida g`oyib ilmi bor-u, ular yozib oladilarmi?","transcription":null,"tafsirUz":null,"pageNumber":566,"juz":29,"createdAt":"2026-09-17T18:46:03.569Z","updatedAt":"2026-09-17T18:46:03.569Z"},{"id":5319,"surahId":68,"surah":{"id":68,"number":68,"nameArabic":"القلم","nameUz":"Qalam","meaningUz":"Qalam","revelationPlace":"makka","totalAyahs":52,"startPage":564,"createdAt":"2026-09-17T18:45:07.736Z","updatedAt":"2026-09-18T00:07:52.605Z"},"numberInSurah":48,"textArabic":"فَٱصْبِرْ لِحُكْمِ رَبِّكَ وَلَا تَكُن كَصَاحِبِ ٱلْحُوتِ إِذْ نَادَىٰ وَهُوَ مَكْظُومٌ","translationUz":"Robbing hukmiga sabr qil va bir vaqtlar g`amga to`lgan holda nido qilgan baliq sohibiga o`xshama.","transcription":null,"tafsirUz":null,"pageNumber":566,"juz":29,"createdAt":"2026-09-17T18:46:03.572Z","updatedAt":"2026-09-17T18:46:03.572Z"},{"id":5320,"surahId":68,"surah":{"id":68,"number":68,"nameArabic":"القلم","nameUz":"Qalam","meaningUz":"Qalam","revelationPlace":"makka","totalAyahs":52,"startPage":564,"createdAt":"2026-09-17T18:45:07.736Z","updatedAt":"2026-09-18T00:07:52.605Z"},"numberInSurah":49,"textArabic":"لَّوْلَآ أَن تَدَٰرَكَهُۥ نِعْمَةٌ مِّن رَّبِّهِۦ لَنُبِذَ بِٱلْعَرَآءِ وَهُوَ مَذْمُومٌ","translationUz":"Agar uni Robbisining ne'mati topmaganda, ochiq sahro joyga, mazammatga qolgan holda tashlangan bo`lardi.","transcription":null,"tafsirUz":null,"pageNumber":566,"juz":29,"createdAt":"2026-09-17T18:46:03.576Z","updatedAt":"2026-09-17T18:46:03.576Z"},{"id":5321,"surahId":68,"surah":{"id":68,"number":68,"nameArabic":"القلم","nameUz":"Qalam","meaningUz":"Qalam","revelationPlace":"makka","totalAyahs":52,"startPage":564,"createdAt":"2026-09-17T18:45:07.736Z","updatedAt":"2026-09-18T00:07:52.605Z"},"numberInSurah":50,"textArabic":"فَٱجْتَبَـٰهُ رَبُّهُۥ فَجَعَلَهُۥ مِنَ ٱلصَّـٰلِحِينَ","translationUz":"Bas, uni Robbisi tanlab oldi va solih bandalaridan qildi.","transcription":null,"tafsirUz":null,"pageNumber":566,"juz":29,"createdAt":"2026-09-17T18:46:03.580Z","updatedAt":"2026-09-17T18:46:03.580Z"},{"id":5322,"surahId":68,"surah":{"id":68,"number":68,"nameArabic":"القلم","nameUz":"Qalam","meaningUz":"Qalam","revelationPlace":"makka","totalAyahs":52,"startPage":564,"createdAt":"2026-09-17T18:45:07.736Z","updatedAt":"2026-09-18T00:07:52.605Z"},"numberInSurah":51,"textArabic":"وَإِن يَكَادُ ٱلَّذِينَ كَفَرُوا۟ لَيُزْلِقُونَكَ بِأَبْصَـٰرِهِمْ لَمَّا سَمِعُوا۟ ٱلذِّكْرَ وَيَقُولُونَ إِنَّهُۥ لَمَجْنُونٌ","translationUz":"Va kofirlar zikrni eshitayotganlarida seni ko`zlari bilan toydirmoqchi bo`ldilar va, albatta, u jinnidur, derlar.","transcription":null,"tafsirUz":null,"pageNumber":566,"juz":29,"createdAt":"2026-09-17T18:46:03.584Z","updatedAt":"2026-09-17T18:46:03.584Z"},{"id":5323,"surahId":68,"surah":{"id":68,"number":68,"nameArabic":"القلم","nameUz":"Qalam","meaningUz":"Qalam","revelationPlace":"makka","totalAyahs":52,"startPage":564,"createdAt":"2026-09-17T18:45:07.736Z","updatedAt":"2026-09-18T00:07:52.605Z"},"numberInSurah":52,"textArabic":"وَمَا هُوَ إِلَّا ذِكْرٌ لِّلْعَـٰلَمِينَ","translationUz":"Holbuki, u butun olamlarga eslatmadan o`zga narsa emas.","transcription":null,"tafsirUz":null,"pageNumber":566,"juz":29,"createdAt":"2026-09-17T18:46:03.588Z","updatedAt":"2026-09-17T18:46:03.588Z"},{"id":5324,"surahId":69,"surah":{"id":69,"number":69,"nameArabic":"الحاقة","nameUz":"Haqqa","meaningUz":"Muqarrar voqea","revelationPlace":"makka","totalAyahs":52,"startPage":566,"createdAt":"2026-09-17T18:45:07.740Z","updatedAt":"2026-09-18T00:07:52.609Z"},"numberInSurah":1,"textArabic":" ٱلْحَآقَّةُ","translationUz":"Al-Haaqqoh.","transcription":null,"tafsirUz":null,"pageNumber":566,"juz":29,"createdAt":"2026-09-17T18:46:04.050Z","updatedAt":"2026-09-17T18:46:04.050Z"},{"id":5325,"surahId":69,"surah":{"id":69,"number":69,"nameArabic":"الحاقة","nameUz":"Haqqa","meaningUz":"Muqarrar voqea","revelationPlace":"makka","totalAyahs":52,"startPage":566,"createdAt":"2026-09-17T18:45:07.740Z","updatedAt":"2026-09-18T00:07:52.609Z"},"numberInSurah":2,"textArabic":"مَا ٱلْحَآقَّةُ","translationUz":"Al-Haaqqoh nima o`zi?!","transcription":null,"tafsirUz":null,"pageNumber":566,"juz":29,"createdAt":"2026-09-17T18:46:04.056Z","updatedAt":"2026-09-17T18:46:04.056Z"},{"id":5326,"surahId":69,"surah":{"id":69,"number":69,"nameArabic":"الحاقة","nameUz":"Haqqa","meaningUz":"Muqarrar voqea","revelationPlace":"makka","totalAyahs":52,"startPage":566,"createdAt":"2026-09-17T18:45:07.740Z","updatedAt":"2026-09-18T00:07:52.609Z"},"numberInSurah":3,"textArabic":"وَمَآ أَدْرَىٰكَ مَا ٱلْحَآقَّةُ","translationUz":"Al-Haaqqoh nimaligini senga nima bildirdi?!","transcription":null,"tafsirUz":null,"pageNumber":566,"juz":29,"createdAt":"2026-09-17T18:46:04.060Z","updatedAt":"2026-09-17T18:46:04.060Z"},{"id":5327,"surahId":69,"surah":{"id":69,"number":69,"nameArabic":"الحاقة","nameUz":"Haqqa","meaningUz":"Muqarrar voqea","revelationPlace":"makka","totalAyahs":52,"startPage":566,"createdAt":"2026-09-17T18:45:07.740Z","updatedAt":"2026-09-18T00:07:52.609Z"},"numberInSurah":4,"textArabic":"كَذَّبَتْ ثَمُودُ وَعَادٌۢ بِٱلْقَارِعَةِ","translationUz":"Samud va Od qori'ani yolg`onga chiqarishdi.","transcription":null,"tafsirUz":null,"pageNumber":566,"juz":29,"createdAt":"2026-09-17T18:46:04.064Z","updatedAt":"2026-09-17T18:46:04.064Z"},{"id":5328,"surahId":69,"surah":{"id":69,"number":69,"nameArabic":"الحاقة","nameUz":"Haqqa","meaningUz":"Muqarrar voqea","revelationPlace":"makka","totalAyahs":52,"startPage":566,"createdAt":"2026-09-17T18:45:07.740Z","updatedAt":"2026-09-18T00:07:52.609Z"},"numberInSurah":5,"textArabic":"فَأَمَّا ثَمُودُ فَأُهْلِكُوا۟ بِٱلطَّاغِيَةِ","translationUz":"Bas, ammo Samud haddan oshuvchi bilan halok qilindi.","transcription":null,"tafsirUz":null,"pageNumber":566,"juz":29,"createdAt":"2026-09-17T18:46:04.069Z","updatedAt":"2026-09-17T18:46:04.069Z"},{"id":5329,"surahId":69,"surah":{"id":69,"number":69,"nameArabic":"الحاقة","nameUz":"Haqqa","meaningUz":"Muqarrar voqea","revelationPlace":"makka","totalAyahs":52,"startPage":566,"createdAt":"2026-09-17T18:45:07.740Z","updatedAt":"2026-09-18T00:07:52.609Z"},"numberInSurah":6,"textArabic":"وَأَمَّا عَادٌ فَأُهْلِكُوا۟ بِرِيحٍ صَرْصَرٍ عَاتِيَةٍ","translationUz":"Va ammo Od qattiq (sovuq) shamol bilan halok qilindilar.","transcription":null,"tafsirUz":null,"pageNumber":566,"juz":29,"createdAt":"2026-09-17T18:46:04.072Z","updatedAt":"2026-09-17T18:46:04.072Z"},{"id":5330,"surahId":69,"surah":{"id":69,"number":69,"nameArabic":"الحاقة","nameUz":"Haqqa","meaningUz":"Muqarrar voqea","revelationPlace":"makka","totalAyahs":52,"startPage":566,"createdAt":"2026-09-17T18:45:07.740Z","updatedAt":"2026-09-18T00:07:52.609Z"},"numberInSurah":7,"textArabic":"سَخَّرَهَا عَلَيْهِمْ سَبْعَ لَيَالٍ وَثَمَـٰنِيَةَ أَيَّامٍ حُسُومًا فَتَرَى ٱلْقَوْمَ فِيهَا صَرْعَىٰ كَأَنَّهُمْ أَعْجَازُ نَخْلٍ خَاوِيَةٍ","translationUz":"U zot ularning ustidan bu shamolni yetti kechayu sakkiz kunduz «beminnat xizmat» qildirib qo`ydi. Bas, qavmning u yerda halok bo`lib, ag`darilib yotganini ko`rasan. Ular xuddi xurmoning chirigan tomirlariga o`xsharlar.","transcription":null,"tafsirUz":null,"pageNumber":566,"juz":29,"createdAt":"2026-09-17T18:46:04.076Z","updatedAt":"2026-09-17T18:46:04.076Z"},{"id":5331,"surahId":69,"surah":{"id":69,"number":69,"nameArabic":"الحاقة","nameUz":"Haqqa","meaningUz":"Muqarrar voqea","revelationPlace":"makka","totalAyahs":52,"startPage":566,"createdAt":"2026-09-17T18:45:07.740Z","updatedAt":"2026-09-18T00:07:52.609Z"},"numberInSurah":8,"textArabic":"فَهَلْ تَرَىٰ لَهُم مِّنۢ بَاقِيَةٍ","translationUz":"Bas, sen ulardan birortasining boqiy qolganini ko`rasanmi?","transcription":null,"tafsirUz":null,"pageNumber":566,"juz":29,"createdAt":"2026-09-17T18:46:04.081Z","updatedAt":"2026-09-17T18:46:04.081Z"}]}