{"number":456,"textArabic":null,"translationUz":null,"juz":null,"note":null,"updatedAt":null,"ayahs":[{"id":4013,"surahId":38,"surah":{"id":38,"number":38,"nameArabic":"ص","nameUz":"Sod","meaningUz":"Sod","revelationPlace":"makka","totalAyahs":88,"startPage":453,"createdAt":"2026-09-17T18:45:07.588Z","updatedAt":"2026-09-18T00:07:52.482Z"},"numberInSurah":43,"textArabic":"وَوَهَبْنَا لَهُۥٓ أَهْلَهُۥ وَمِثْلَهُم مَّعَهُمْ رَحْمَةً مِّنَّا وَذِكْرَىٰ لِأُو۟لِى ٱلْأَلْبَـٰبِ","translationUz":"Va Biz unga ahlini va yana ular bilan birga misllarichani ham hadya etdik. Bu, Bizdan rahmat o`laroq va aql egalariga eslatma uchun bo`ldi.","transcription":null,"tafsirUz":null,"pageNumber":456,"juz":23,"createdAt":"2026-09-17T18:45:49.254Z","updatedAt":"2026-09-17T18:45:49.254Z"},{"id":4014,"surahId":38,"surah":{"id":38,"number":38,"nameArabic":"ص","nameUz":"Sod","meaningUz":"Sod","revelationPlace":"makka","totalAyahs":88,"startPage":453,"createdAt":"2026-09-17T18:45:07.588Z","updatedAt":"2026-09-18T00:07:52.482Z"},"numberInSurah":44,"textArabic":"وَخُذْ بِيَدِكَ ضِغْثًا فَٱضْرِب بِّهِۦ وَلَا تَحْنَثْ ۗ إِنَّا وَجَدْنَـٰهُ صَابِرًا ۚ نِّعْمَ ٱلْعَبْدُ ۖ إِنَّهُۥٓ أَوَّابٌ","translationUz":"«Qo`lingga bir dastani ol-da, u bilan ur. Qasamingni buzma», (dedi). Biz uni sabrli topdik. U qanday ham yaxshi banda. Albatta, u o`ta qaytguvchidir.","transcription":null,"tafsirUz":null,"pageNumber":456,"juz":23,"createdAt":"2026-09-17T18:45:49.258Z","updatedAt":"2026-09-17T18:45:49.258Z"},{"id":4015,"surahId":38,"surah":{"id":38,"number":38,"nameArabic":"ص","nameUz":"Sod","meaningUz":"Sod","revelationPlace":"makka","totalAyahs":88,"startPage":453,"createdAt":"2026-09-17T18:45:07.588Z","updatedAt":"2026-09-18T00:07:52.482Z"},"numberInSurah":45,"textArabic":"وَٱذْكُرْ عِبَـٰدَنَآ إِبْرَٰهِيمَ وَإِسْحَـٰقَ وَيَعْقُوبَ أُو۟لِى ٱلْأَيْدِى وَٱلْأَبْصَـٰرِ","translationUz":"Qo`llar va ko`zlar sohiblari bo`lgan bandalarimiz Ibrohim, Is'hoq va Ya'qubni esla.","transcription":null,"tafsirUz":null,"pageNumber":456,"juz":23,"createdAt":"2026-09-17T18:45:49.263Z","updatedAt":"2026-09-17T18:45:49.263Z"},{"id":4016,"surahId":38,"surah":{"id":38,"number":38,"nameArabic":"ص","nameUz":"Sod","meaningUz":"Sod","revelationPlace":"makka","totalAyahs":88,"startPage":453,"createdAt":"2026-09-17T18:45:07.588Z","updatedAt":"2026-09-18T00:07:52.482Z"},"numberInSurah":46,"textArabic":"إِنَّآ أَخْلَصْنَـٰهُم بِخَالِصَةٍ ذِكْرَى ٱلدَّارِ","translationUz":"Albatta, Biz ularni xolis bir xislat-la ajratdik. U (oxirat) diyorini eslash edi.","transcription":null,"tafsirUz":null,"pageNumber":456,"juz":23,"createdAt":"2026-09-17T18:45:49.267Z","updatedAt":"2026-09-17T18:45:49.267Z"},{"id":4017,"surahId":38,"surah":{"id":38,"number":38,"nameArabic":"ص","nameUz":"Sod","meaningUz":"Sod","revelationPlace":"makka","totalAyahs":88,"startPage":453,"createdAt":"2026-09-17T18:45:07.588Z","updatedAt":"2026-09-18T00:07:52.482Z"},"numberInSurah":47,"textArabic":"وَإِنَّهُمْ عِندَنَا لَمِنَ ٱلْمُصْطَفَيْنَ ٱلْأَخْيَارِ","translationUz":"Albatta, ular Bizning huzurimizda tanlangan axyorlardandirlar.","transcription":null,"tafsirUz":null,"pageNumber":456,"juz":23,"createdAt":"2026-09-17T18:45:49.271Z","updatedAt":"2026-09-17T18:45:49.271Z"},{"id":4018,"surahId":38,"surah":{"id":38,"number":38,"nameArabic":"ص","nameUz":"Sod","meaningUz":"Sod","revelationPlace":"makka","totalAyahs":88,"startPage":453,"createdAt":"2026-09-17T18:45:07.588Z","updatedAt":"2026-09-18T00:07:52.482Z"},"numberInSurah":48,"textArabic":"وَٱذْكُرْ إِسْمَـٰعِيلَ وَٱلْيَسَعَ وَذَا ٱلْكِفْلِ ۖ وَكُلٌّ مِّنَ ٱلْأَخْيَارِ","translationUz":"Ismoil, al-Yasa' va Zul-Kiflni ham esla. Barchalari axyorlardandir.","transcription":null,"tafsirUz":null,"pageNumber":456,"juz":23,"createdAt":"2026-09-17T18:45:49.276Z","updatedAt":"2026-09-17T18:45:49.276Z"},{"id":4019,"surahId":38,"surah":{"id":38,"number":38,"nameArabic":"ص","nameUz":"Sod","meaningUz":"Sod","revelationPlace":"makka","totalAyahs":88,"startPage":453,"createdAt":"2026-09-17T18:45:07.588Z","updatedAt":"2026-09-18T00:07:52.482Z"},"numberInSurah":49,"textArabic":"هَـٰذَا ذِكْرٌ ۚ وَإِنَّ لِلْمُتَّقِينَ لَحُسْنَ مَـَٔابٍ","translationUz":"Bu eslatmadir. Albatta, taqvodorlar uchun go`zal oqibat.","transcription":null,"tafsirUz":null,"pageNumber":456,"juz":23,"createdAt":"2026-09-17T18:45:49.280Z","updatedAt":"2026-09-17T18:45:49.280Z"},{"id":4020,"surahId":38,"surah":{"id":38,"number":38,"nameArabic":"ص","nameUz":"Sod","meaningUz":"Sod","revelationPlace":"makka","totalAyahs":88,"startPage":453,"createdAt":"2026-09-17T18:45:07.588Z","updatedAt":"2026-09-18T00:07:52.482Z"},"numberInSurah":50,"textArabic":"جَنَّـٰتِ عَدْنٍ مُّفَتَّحَةً لَّهُمُ ٱلْأَبْوَٰبُ","translationUz":"Ular uchun eshiklari ochiq adn jannatlari bordir.","transcription":null,"tafsirUz":null,"pageNumber":456,"juz":23,"createdAt":"2026-09-17T18:45:49.284Z","updatedAt":"2026-09-17T18:45:49.284Z"},{"id":4021,"surahId":38,"surah":{"id":38,"number":38,"nameArabic":"ص","nameUz":"Sod","meaningUz":"Sod","revelationPlace":"makka","totalAyahs":88,"startPage":453,"createdAt":"2026-09-17T18:45:07.588Z","updatedAt":"2026-09-18T00:07:52.482Z"},"numberInSurah":51,"textArabic":"مُتَّكِـِٔينَ فِيهَا يَدْعُونَ فِيهَا بِفَـٰكِهَةٍ كَثِيرَةٍ وَشَرَابٍ","translationUz":"U yerda yonboshlagan hollarida undagi ko`plab mevalar va sharoblardan chaqiradilar.","transcription":null,"tafsirUz":null,"pageNumber":456,"juz":23,"createdAt":"2026-09-17T18:45:49.288Z","updatedAt":"2026-09-17T18:45:49.288Z"},{"id":4022,"surahId":38,"surah":{"id":38,"number":38,"nameArabic":"ص","nameUz":"Sod","meaningUz":"Sod","revelationPlace":"makka","totalAyahs":88,"startPage":453,"createdAt":"2026-09-17T18:45:07.588Z","updatedAt":"2026-09-18T00:07:52.482Z"},"numberInSurah":52,"textArabic":"۞ وَعِندَهُمْ قَـٰصِرَٰتُ ٱلطَّرْفِ أَتْرَابٌ","translationUz":"Ularning huzurida ko`zlarini (nomahramdan) tiygan tengdosh(hur)lar bordir.","transcription":null,"tafsirUz":null,"pageNumber":456,"juz":23,"createdAt":"2026-09-17T18:45:49.292Z","updatedAt":"2026-09-17T18:45:49.292Z"},{"id":4023,"surahId":38,"surah":{"id":38,"number":38,"nameArabic":"ص","nameUz":"Sod","meaningUz":"Sod","revelationPlace":"makka","totalAyahs":88,"startPage":453,"createdAt":"2026-09-17T18:45:07.588Z","updatedAt":"2026-09-18T00:07:52.482Z"},"numberInSurah":53,"textArabic":"هَـٰذَا مَا تُوعَدُونَ لِيَوْمِ ٱلْحِسَابِ","translationUz":"Bu sizga hisob kuni uchun va'da etilgan narsalardir.","transcription":null,"tafsirUz":null,"pageNumber":456,"juz":23,"createdAt":"2026-09-17T18:45:49.296Z","updatedAt":"2026-09-17T18:45:49.296Z"},{"id":4024,"surahId":38,"surah":{"id":38,"number":38,"nameArabic":"ص","nameUz":"Sod","meaningUz":"Sod","revelationPlace":"makka","totalAyahs":88,"startPage":453,"createdAt":"2026-09-17T18:45:07.588Z","updatedAt":"2026-09-18T00:07:52.482Z"},"numberInSurah":54,"textArabic":"إِنَّ هَـٰذَا لَرِزْقُنَا مَا لَهُۥ مِن نَّفَادٍ","translationUz":"Albatta, bu Bizning (beradigan) rizqimizdir. Uning hech tugashi yo`qdir.","transcription":null,"tafsirUz":null,"pageNumber":456,"juz":23,"createdAt":"2026-09-17T18:45:49.300Z","updatedAt":"2026-09-17T18:45:49.300Z"},{"id":4025,"surahId":38,"surah":{"id":38,"number":38,"nameArabic":"ص","nameUz":"Sod","meaningUz":"Sod","revelationPlace":"makka","totalAyahs":88,"startPage":453,"createdAt":"2026-09-17T18:45:07.588Z","updatedAt":"2026-09-18T00:07:52.482Z"},"numberInSurah":55,"textArabic":"هَـٰذَا ۚ وَإِنَّ لِلطَّـٰغِينَ لَشَرَّ مَـَٔابٍ","translationUz":"Ish bundaydir. Albatta, tug`yonga ketguvchilar uchun yomon oqibat.","transcription":null,"tafsirUz":null,"pageNumber":456,"juz":23,"createdAt":"2026-09-17T18:45:49.305Z","updatedAt":"2026-09-17T18:45:49.305Z"},{"id":4026,"surahId":38,"surah":{"id":38,"number":38,"nameArabic":"ص","nameUz":"Sod","meaningUz":"Sod","revelationPlace":"makka","totalAyahs":88,"startPage":453,"createdAt":"2026-09-17T18:45:07.588Z","updatedAt":"2026-09-18T00:07:52.482Z"},"numberInSurah":56,"textArabic":"جَهَنَّمَ يَصْلَوْنَهَا فَبِئْسَ ٱلْمِهَادُ","translationUz":"Jahannam bordir. Unga kirurlar. Bas, u qanday ham yomon yotoq!","transcription":null,"tafsirUz":null,"pageNumber":456,"juz":23,"createdAt":"2026-09-17T18:45:49.310Z","updatedAt":"2026-09-17T18:45:49.310Z"},{"id":4027,"surahId":38,"surah":{"id":38,"number":38,"nameArabic":"ص","nameUz":"Sod","meaningUz":"Sod","revelationPlace":"makka","totalAyahs":88,"startPage":453,"createdAt":"2026-09-17T18:45:07.588Z","updatedAt":"2026-09-18T00:07:52.482Z"},"numberInSurah":57,"textArabic":"هَـٰذَا فَلْيَذُوقُوهُ حَمِيمٌ وَغَسَّاقٌ","translationUz":"Mana buni tatib tursinlar: qaynoq suv va yiringni!","transcription":null,"tafsirUz":null,"pageNumber":456,"juz":23,"createdAt":"2026-09-17T18:45:49.314Z","updatedAt":"2026-09-17T18:45:49.314Z"},{"id":4028,"surahId":38,"surah":{"id":38,"number":38,"nameArabic":"ص","nameUz":"Sod","meaningUz":"Sod","revelationPlace":"makka","totalAyahs":88,"startPage":453,"createdAt":"2026-09-17T18:45:07.588Z","updatedAt":"2026-09-18T00:07:52.482Z"},"numberInSurah":58,"textArabic":"وَءَاخَرُ مِن شَكْلِهِۦٓ أَزْوَٰجٌ","translationUz":"Va boshqa uning shaklidagi qo`sha-qo`sha (azoblar) ham.","transcription":null,"tafsirUz":null,"pageNumber":456,"juz":23,"createdAt":"2026-09-17T18:45:49.318Z","updatedAt":"2026-09-17T18:45:49.318Z"},{"id":4029,"surahId":38,"surah":{"id":38,"number":38,"nameArabic":"ص","nameUz":"Sod","meaningUz":"Sod","revelationPlace":"makka","totalAyahs":88,"startPage":453,"createdAt":"2026-09-17T18:45:07.588Z","updatedAt":"2026-09-18T00:07:52.482Z"},"numberInSurah":59,"textArabic":"هَـٰذَا فَوْجٌ مُّقْتَحِمٌ مَّعَكُمْ ۖ لَا مَرْحَبًۢا بِهِمْ ۚ إِنَّهُمْ صَالُوا۟ ٱلنَّارِ","translationUz":"«Mana bu guruh ham siz bilan birga bostirib kirguvchidir. Ularga marhabo yo`q. Ular, albatta, jahannamga kirguvchilardir», derlar.","transcription":null,"tafsirUz":null,"pageNumber":456,"juz":23,"createdAt":"2026-09-17T18:45:49.322Z","updatedAt":"2026-09-17T18:45:49.322Z"},{"id":4030,"surahId":38,"surah":{"id":38,"number":38,"nameArabic":"ص","nameUz":"Sod","meaningUz":"Sod","revelationPlace":"makka","totalAyahs":88,"startPage":453,"createdAt":"2026-09-17T18:45:07.588Z","updatedAt":"2026-09-18T00:07:52.482Z"},"numberInSurah":60,"textArabic":"قَالُوا۟ بَلْ أَنتُمْ لَا مَرْحَبًۢا بِكُمْ ۖ أَنتُمْ قَدَّمْتُمُوهُ لَنَا ۖ فَبِئْسَ ٱلْقَرَارُ","translationUz":"Ular: «Yo`q! O`zingizga marhabo yo`q! Sizlar o`sha(jahannam)ni bizga taqdim qildingiz! Bas, u naqadar yomon qarorgoh!» – derlar.","transcription":null,"tafsirUz":null,"pageNumber":456,"juz":23,"createdAt":"2026-09-17T18:45:49.326Z","updatedAt":"2026-09-17T18:45:49.326Z"},{"id":4031,"surahId":38,"surah":{"id":38,"number":38,"nameArabic":"ص","nameUz":"Sod","meaningUz":"Sod","revelationPlace":"makka","totalAyahs":88,"startPage":453,"createdAt":"2026-09-17T18:45:07.588Z","updatedAt":"2026-09-18T00:07:52.482Z"},"numberInSurah":61,"textArabic":"قَالُوا۟ رَبَّنَا مَن قَدَّمَ لَنَا هَـٰذَا فَزِدْهُ عَذَابًا ضِعْفًا فِى ٱلنَّارِ","translationUz":"Ular: «Ey Robbimiz, bizga bu(jahannam)ni kim taqdim etgan bo`lsa, unga do`zaxda ikki barobar azobni ziyoda qil!» – derlar.","transcription":null,"tafsirUz":null,"pageNumber":456,"juz":23,"createdAt":"2026-09-17T18:45:49.330Z","updatedAt":"2026-09-17T18:45:49.330Z"}]}