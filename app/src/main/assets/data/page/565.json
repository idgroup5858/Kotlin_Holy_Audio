:68,"nameArabic":"القلم","nameUz":"Qalam","meaningUz":"Qalam","revelationPlace":"makka","totalAyahs":52,"startPage":564,"createdAt":"2026-09-17T18:45:07.736Z","updatedAt":"2026-09-18T00:07:52.605Z"},"numberInSurah":23,"textArabic":"فَٱنطَلَقُوا۟ وَهُمْ يَتَخَـٰفَتُونَ","translationUz":"Bas, past ovoz bilan gaplashib yurib ketdilar.","transcription":null,"tafsirUz":null,"pageNumber":565,"juz":29,"createdAt":"2026-09-17T18:46:03.470Z","updatedAt":"2026-09-17T18:46:03.470Z"},{"id":5295,"surahId":68,"surah":{"id":68,"number":68,"nameArabic":"القلم","nameUz":"Qalam","meaningUz":"Qalam","revelationPlace":"makka","totalAyahs":52,"startPage":564,"createdAt":"2026-09-17T18:45:07.736Z","updatedAt":"2026-09-18T00:07:52.605Z"},"numberInSurah":24,"textArabic":"أَن لَّا يَدْخُلَنَّهَا ٱلْيَوْمَ عَلَيْكُم مِّسْكِينٌ","translationUz":"Bugun siz boringizda u(bog`)ga miskin kira ko`rmasin, deb.","transcription":null,"tafsirUz":null,"pageNumber":565,"juz":29,"createdAt":"2026-09-17T18:46:03.475Z","updatedAt":"2026-09-17T18:46:03.475Z"},{"id":5296,"surahId":68,"surah":{"id":68,"number":68,"nameArabic":"القلم","nameUz":"Qalam","meaningUz":"Qalam","revelationPlace":"makka","totalAyahs":52,"startPage":564,"createdAt":"2026-09-17T18:45:07.736Z","updatedAt":"2026-09-18T00:07:52.605Z"},"numberInSurah":25,"textArabic":"وَغَدَوْا۟ عَلَىٰ حَرْدٍ قَـٰدِرِينَ","translationUz":"Va ertalabda qasd-la, o`zlarini qodir sezib, bordilar.","transcription":null,"tafsirUz":null,"pageNumber":565,"juz":29,"createdAt":"2026-09-17T18:46:03.479Z","updatedAt":"2026-09-17T18:46:03.479Z"},{"id":5297,"surahId":68,"surah":{"id":68,"number":68,"nameArabic":"القلم","nameUz":"Qalam","meaningUz":"Qalam","revelationPlace":"makka","totalAyahs":52,"startPage":564,"createdAt":"2026-09-17T18:45:07.736Z","updatedAt":"2026-09-18T00:07:52.605Z"},"numberInSurah":26,"textArabic":"فَلَمَّا رَأَوْهَا قَالُوٓا۟ إِنَّا لَضَآلُّونَ","translationUz":"Uni ko`rganlarida, biz adashibmiz, dedilar.","transcription":null,"tafsirUz":null,"pageNumber":565,"juz":29,"createdAt":"2026-09-17T18:46:03.483Z","updatedAt":"2026-09-17T18:46:03.483Z"},{"id":5298,"surahId":68,"surah":{"id":68,"number":68,"nameArabic":"القلم","nameUz":"Qalam","meaningUz":"Qalam","revelationPlace":"makka","totalAyahs":52,"startPage":564,"createdAt":"2026-09-17T18:45:07.736Z","updatedAt":"2026-09-18T00:07:52.605Z"},"numberInSurah":27,"textArabic":"بَلْ نَحْنُ مَحْرُومُونَ","translationUz":"Balki biz mahrum bo`lgandirmiz, dedilar.","transcription":null,"tafsirUz":null,"pageNumber":565,"juz":29,"createdAt":"2026-09-17T18:46:03.489Z","updatedAt":"2026-09-17T18:46:03.489Z"},{"id":5299,"surahId":68,"surah":{"id":68,"number":68,"nameArabic":"القلم","nameUz":"Qalam","meaningUz":"Qalam","revelationPlace":"makka","totalAyahs":52,"startPage":564,"createdAt":"2026-09-17T18:45:07.736Z","updatedAt":"2026-09-18T00:07:52.605Z"},"numberInSurah":28,"textArabic":"قَالَ أَوْسَطُهُمْ أَلَمْ أَقُل لَّكُمْ لَوْلَا تُسَبِّحُونَ","translationUz":"Ularning eng yaxshi va adolatlisi: «Sizlarga tasbih aytsalaringiz-chi, demabmidim», dedi.","transcription":null,"tafsirUz":null,"pageNumber":565,"juz":29,"createdAt":"2026-09-17T18:46:03.493Z","updatedAt":"2026-09-17T18:46:03.493Z"},{"id":5300,"surahId":68,"surah":{"id":68,"number":68,"nameArabic":"القلم","nameUz":"Qalam","meaningUz":"Qalam","revelationPlace":"makka","totalAyahs":52,"startPage":564,"createdAt":"2026-09-17T18:45:07.736Z","updatedAt":"2026-09-18T00:07:52.605Z"},"numberInSurah":29,"textArabic":"قَالُوا۟ سُبْحَـٰنَ رَبِّنَآ إِنَّا كُنَّا ظَـٰلِمِينَ","translationUz":"Robbimiz ayblardan pok bo`ldi, albatta, biz zolimlardan edik, dedilar.","transcription":null,"tafsirUz":null,"pageNumber":565,"juz":29,"createdAt":"2026-09-17T18:46:03.496Z","updatedAt":"2026-09-17T18:46:03.496Z"},{"id":5301,"surahId":68,"surah":{"id":68,"number":68,"nameArabic":"القلم","nameUz":"Qalam","meaningUz":"Qalam","revelationPlace":"makka","totalAyahs":52,"startPage":564,"createdAt":"2026-09-17T18:45:07.736Z","updatedAt":"2026-09-18T00:07:52.605Z"},"numberInSurah":30,"textArabic":"فَأَقْبَلَ بَعْضُهُمْ عَلَىٰ بَعْضٍ يَتَلَـٰوَمُونَ","translationUz":"Bas, ba'zilari ba'zilarini malomat qila boshladilar.","transcription":null,"tafsirUz":null,"pageNumber":565,"juz":29,"createdAt":"2026-09-17T18:46:03.500Z","updatedAt":"2026-09-17T18:46:03.500Z"},{"id":5302,"surahId":68,"surah":{"id":68,"number":68,"nameArabic":"القلم","nameUz":"Qalam","meaningUz":"Qalam","revelationPlace":"makka","totalAyahs":52,"startPage":564,"createdAt":"2026-09-17T18:45:07.736Z","updatedAt":"2026-09-18T00:07:52.605Z"},"numberInSurah":31,"textArabic":"قَالُوا۟ يَـٰوَيْلَنَآ إِنَّا كُنَّا طَـٰغِينَ","translationUz":"«Voy, sho`rimiz qursin, tug`yonga ketgan ekanmiz.","transcription":null,"tafsirUz":null,"pageNumber":565,"juz":29,"createdAt":"2026-09-17T18:46:03.504Z","updatedAt":"2026-09-17T18:46:03.504Z"},{"id":5303,"surahId":68,"surah":{"id":68,"number":68,"nameArabic":"القلم","nameUz":"Qalam","meaningUz":"Qalam","revelationPlace":"makka","totalAyahs":52,"startPage":564,"createdAt":"2026-09-17T18:45:07.736Z","updatedAt":"2026-09-18T00:07:52.605Z"},"numberInSurah":32,"textArabic":"عَسَىٰ رَبُّنَآ أَن يُبْدِلَنَا خَيْرًا مِّنْهَآ إِنَّآ إِلَىٰ رَبِّنَا رَٰغِبُونَ","translationUz":"Shoyad, Robbimiz uning o`rniga undan ko`ra yaxshirog`ini bersa. Biz o`z Robbimizga rag`batlimiz, dedilar.","transcription":null,"tafsirUz":null,"pageNumber":565,"juz":29,"createdAt":"2026-09-17T18:46:03.509Z","updatedAt":"2026-09-17T18:46:03.509Z"},{"id":5304,"surahId":68,"surah":{"id":68,"number":68,"nameArabic":"القلم","nameUz":"Qalam","meaningUz":"Qalam","revelationPlace":"makka","totalAyahs":52,"startPage":564,"createdAt":"2026-09-17T18:45:07.736Z","updatedAt":"2026-09-18T00:07:52.605Z"},"numberInSurah":33,"textArabic":"كَذَٰلِكَ ٱلْعَذَابُ ۖ وَلَعَذَابُ ٱلْـَٔاخِرَةِ أَكْبَرُ ۚ لَوْ كَانُوا۟ يَعْلَمُونَ","translationUz":"Azob shundoq bo`lur va agar bilsalar, albatta, oxirat azobi bundan katta bo`ladir.","transcription":null,"tafsirUz":null,"pageNumber":565,"juz":29,"createdAt":"2026-09-17T18:46:03.513Z","updatedAt":"2026-09-17T18:46:03.513Z"},{"id":5305,"surahId":68,"surah":{"id":68,"number":68,"nameArabic":"القلم","nameUz":"Qalam","meaningUz":"Qalam","revelationPlace":"makka","totalAyahs":52,"startPage":564,"createdAt":"2026-09-17T18:45:07.736Z","updatedAt":"2026-09-18T00:07:52.605Z"},"numberInSurah":34,"textArabic":"إِنَّ لِلْمُتَّقِينَ عِندَ رَبِّهِمْ جَنَّـٰتِ ٱلنَّعِيمِ","translationUz":"Albatta, taqvodorlar uchun Robbilari huzurida na'iym jannatlari bordur.","transcription":null,"tafsirUz":null,"pageNumber":565,"juz":29,"createdAt":"2026-09-17T18:46:03.516Z","updatedAt":"2026-09-17T18:46:03.516Z"},{"id":5306,"surahId":68,"surah":{"id":68,"number":68,"nameArabic":"القلم","nameUz":"Qalam","meaningUz":"Qalam","revelationPlace":"makka","totalAyahs":52,"startPage":564,"createdAt":"2026-09-17T18:45:07.736Z","updatedAt":"2026-09-18T00:07:52.605Z"},"numberInSurah":35,"textArabic":"أَفَنَجْعَلُ ٱلْمُسْلِمِينَ كَٱلْمُجْرِمِينَ","translationUz":"Musulmonlarni jinoyatkorlarga o`xshatib qo`yarmidik?!","transcription":null,"tafsirUz":null,"pageNumber":565,"juz":29,"createdAt":"2026-09-17T18:46:03.520Z","updatedAt":"2026-09-17T18:46:03.520Z"},{"id":5307,"surahId":68,"surah":{"id":68,"number":68,"nameArabic":"القلم","nameUz":"Qalam","meaningUz":"Qalam","revelationPlace":"makka","totalAyahs":52,"startPage":564,"createdAt":"2026-09-17T18:45:07.736Z","updatedAt":"2026-09-18T00:07:52.605Z"},"numberInSurah":36,"textArabic":"مَا لَكُمْ كَيْفَ تَحْكُمُونَ","translationUz":"Sizlarga nima bo`ldi, qanday hukm chiqaryapsizlar?!","transcription":null,"tafsirUz":null,"pageNumber":565,"juz":29,"createdAt":"2026-09-17T18:46:03.525Z","updatedAt":"2026-09-17T18:46:03.525Z"},{"id":5308,"surahId":68,"surah":{"id":68,"number":68,"nameArabic":"القلم","nameUz":"Qalam","meaningUz":"Qalam","revelationPlace":"makka","totalAyahs":52,"startPage":564,"createdAt":"2026-09-17T18:45:07.736Z","updatedAt":"2026-09-18T00:07:52.605Z"},"numberInSurah":37,"textArabic":"أَمْ لَكُمْ كِتَـٰبٌ فِيهِ تَدْرُسُونَ","translationUz":"Yoki sizlarning kitobingiz bor-u, undan o`qidingizmi?","transcription":null,"tafsirUz":null,"pageNumber":565,"juz":29,"createdAt":"2026-09-17T18:46:03.529Z","updatedAt":"2026-09-17T18:46:03.529Z"},{"id":5309,"surahId":68,"surah":{"id":68,"number":68,"nameArabic":"القلم","nameUz":"Qalam","meaningUz":"Qalam","revelationPlace":"makka","totalAyahs":52,"startPage":564,"createdAt":"2026-09-17T18:45:07.736Z","updatedAt":"2026-09-18T00:07:52.605Z"},"numberInSurah":38,"textArabic":"إِنَّ لَكُمْ فِيهِ لَمَا تَخَيَّرُونَ","translationUz":"Unda sizlarga nimani ixtiyor qilsangiz, albatta, (bo`laveradi) deyilganmi?!","transcription":null,"tafsirUz":null,"pageNumber":565,"juz":29,"createdAt":"2026-09-17T18:46:03.533Z","updatedAt":"2026-09-17T18:46:03.533Z"},{"id":5310,"surahId":68,"surah":{"id":68,"number":68,"nameArabic":"القلم","nameUz":"Qalam","meaningUz":"Qalam","revelationPlace":"makka","totalAyahs":52,"startPage":564,"createdAt":"2026-09-17T18:45:07.736Z","updatedAt":"2026-09-18T00:07:52.605Z"},"numberInSurah":39,"textArabic":"أَمْ لَكُمْ أَيْمَـٰنٌ عَلَيْنَا بَـٰلِغَةٌ إِلَىٰ يَوْمِ ٱلْقِيَـٰمَةِ ۙ إِنَّ لَكُمْ لَمَا تَحْكُمُونَ","translationUz":"Yoki sizlarga bizning qiyomat kunigacha yetadigan bergan va'dalarimiz bo`lib, unda, albatta, siz nima hukm qilsangiz, shu bo`ladi, deyilganmi?!","transcription":null,"tafsirUz":null,"pageNumber":565,"juz":29,"createdAt":"2026-09-17T18:46:03.536Z","updatedAt":"2026-09-17T18:46:03.536Z"},{"id":5311,"surahId":68,"surah":{"id":68,"number":68,"nameArabic":"القلم","nameUz":"Qalam","meaningUz":"Qalam","revelationPlace":"makka","totalAyahs":52,"startPage":564,"createdAt":"2026-09-17T18:45:07.736Z","updatedAt":"2026-09-18T00:07:52.605Z"},"numberInSurah":40,"textArabic":"سَلْهُمْ أَيُّهُم بِذَٰلِكَ زَعِيمٌ","translationUz":"So`ra ulardan, qay birlari bu narsaga kafil ekan?","transcription":null,"tafsirUz":null,"pageNumber":565,"juz":29,"createdAt":"2026-09-17T18:46:03.540Z","updatedAt":"2026-09-17T18:46:03.540Z"},{"id":5312,"surahId":68,"surah":{"id":68,"number":68,"nameArabic":"القلم","nameUz":"Qalam","meaningUz":"Qalam","revelationPlace":"makka","totalAyahs":52,"startPage":564,"createdAt":"2026-09-17T18:45:07.736Z","updatedAt":"2026-09-18T00:07:52.605Z"},"numberInSurah":41,"textArabic":"أَمْ لَهُمْ شُرَكَآءُ فَلْيَأْتُوا۟ بِشُرَكَآئِهِمْ إِن كَانُوا۟ صَـٰدِقِينَ","translationUz":"Yoki ularning sheriklari bormikin, agar rostgo`y bo`lsalar, o`sha sheriklarini ham olib kelsinlar.","transcription":null,"tafsirUz":null,"pageNumber":565,"juz":29,"createdAt":"2026-09-17T18:46:03.544Z","updatedAt":"2026-09-17T18:46:03.544Z"},{"id":5313,"surahId":68,"surah":{"id":68,"number":68,"nameArabic":"القلم","nameUz":"Qalam","meaningUz":"Qalam","revelationPlace":"makka","totalAyahs":52,"startPage":564,"createdAt":"2026-09-17T18:45:07.736Z","updatedAt":"2026-09-18T00:07:52.605Z"},"numberInSurah":42,"textArabic":"يَوْمَ يُكْشَفُ عَن سَاقٍ وَيُدْعَوْنَ إِلَى ٱلسُّجُودِ فَلَا يَسْتَطِيعُونَ","translationUz":"Boldirlar shimarilgan kunida va ular sajdaga chaqirilganda, qodir bo`lmaslar.","transcription":null,"tafsirUz":null,"pageNumber":565,"juz":29,"createdAt":"2026-09-17T18:46:03.549Z","updatedAt":"2026-09-17T18:46:03.549Z"}]}