{"number":345,"textArabic":null,"translationUz":null,"juz":null,"note":null,"updatedAt":null,"ayahs":[{"id":2716,"surahId":23,"surah":{"id":23,"number":23,"nameArabic":"المؤمنون","nameUz":"Moʻminun","meaningUz":"Moʻminlar","revelationPlace":"makka","totalAyahs":118,"startPage":342,"createdAt":"2026-09-17T18:45:07.515Z","updatedAt":"2026-09-18T00:07:52.412Z"},"numberInSurah":43,"textArabic":"مَا تَسْبِقُ مِنْ أُمَّةٍ أَجَلَهَا وَمَا يَسْتَـْٔخِرُونَ","translationUz":"Hech bir ummat o`z ajalidan oldin ham ketmas, ortda ham qolmas.","transcription":null,"tafsirUz":null,"pageNumber":345,"juz":18,"createdAt":"2026-09-17T18:45:36.336Z","updatedAt":"2026-09-17T18:45:36.336Z"},{"id":2717,"surahId":23,"surah":{"id":23,"number":23,"nameArabic":"المؤمنون","nameUz":"Moʻminun","meaningUz":"Moʻminlar","revelationPlace":"makka","totalAyahs":118,"startPage":342,"createdAt":"2026-09-17T18:45:07.515Z","updatedAt":"2026-09-18T00:07:52.412Z"},"numberInSurah":44,"textArabic":"ثُمَّ أَرْسَلْنَا رُسُلَنَا تَتْرَا ۖ كُلَّ مَا جَآءَ أُمَّةً رَّسُولُهَا كَذَّبُوهُ ۚ فَأَتْبَعْنَا بَعْضَهُم بَعْضًا وَجَعَلْنَـٰهُمْ أَحَادِيثَ ۚ فَبُعْدًا لِّقَوْمٍ لَّا يُؤْمِنُونَ","translationUz":"So`ngra Payg`ambarlarimizni ketma-ket yubordik. Har qachon bir ummatga o`z Payg`ambari kelsa, uni yolg`onchi qildilar. Bas, Biz ham ularni ba'zilari ortidan ba'zilarini (halokatga) ergashtiraverdik va ularni gapu so`zga aylantirdik. Bas, daf' bo`lsin iymon keltirmaydigan qavmlar!","transcription":null,"tafsirUz":null,"pageNumber":345,"juz":18,"createdAt":"2026-09-17T18:45:36.340Z","updatedAt":"2026-09-17T18:45:36.340Z"},{"id":2718,"surahId":23,"surah":{"id":23,"number":23,"nameArabic":"المؤمنون","nameUz":"Moʻminun","meaningUz":"Moʻminlar","revelationPlace":"makka","totalAyahs":118,"startPage":342,"createdAt":"2026-09-17T18:45:07.515Z","updatedAt":"2026-09-18T00:07:52.412Z"},"numberInSurah":45,"textArabic":"ثُمَّ أَرْسَلْنَا مُوسَىٰ وَأَخَاهُ هَـٰرُونَ بِـَٔايَـٰتِنَا وَسُلْطَـٰنٍ مُّبِينٍ","translationUz":"So`ngra Biz Muso va birodari Horunni oyatlarimiz va ochiq hujjat ila.","transcription":null,"tafsirUz":null,"pageNumber":345,"juz":18,"createdAt":"2026-09-17T18:45:36.345Z","updatedAt":"2026-09-17T18:45:36.345Z"},{"id":2719,"surahId":23,"surah":{"id":23,"number":23,"nameArabic":"المؤمنون","nameUz":"Moʻminun","meaningUz":"Moʻminlar","revelationPlace":"makka","totalAyahs":118,"startPage":342,"createdAt":"2026-09-17T18:45:07.515Z","updatedAt":"2026-09-18T00:07:52.412Z"},"numberInSurah":46,"textArabic":"إِلَىٰ فِرْعَوْنَ وَمَلَإِي۟هِۦ فَٱسْتَكْبَرُوا۟ وَكَانُوا۟ قَوْمًا عَالِينَ","translationUz":"Fir'avn va uning a'yonlariga yubordik. Bas, ular mutakabbirlik qildilar va o`zini yuqori qo`ygan qavm bo`ldilar.","transcription":null,"tafsirUz":null,"pageNumber":345,"juz":18,"createdAt":"2026-09-17T18:45:36.349Z","updatedAt":"2026-09-17T18:45:36.349Z"},{"id":2720,"surahId":23,"surah":{"id":23,"number":23,"nameArabic":"المؤمنون","nameUz":"Moʻminun","meaningUz":"Moʻminlar","revelationPlace":"makka","totalAyahs":118,"startPage":342,"createdAt":"2026-09-17T18:45:07.515Z","updatedAt":"2026-09-18T00:07:52.412Z"},"numberInSurah":47,"textArabic":"فَقَالُوٓا۟ أَنُؤْمِنُ لِبَشَرَيْنِ مِثْلِنَا وَقَوْمُهُمَا لَنَا عَـٰبِدُونَ","translationUz":"Bas, ular: «O`zimizga o`xshagan ikki basharga iymon keltiramizmi?! Holbuki, ularning qavmi bizga qullik qilguvchi bo`lib turibdi-ku?!» dedilar.","transcription":null,"tafsirUz":null,"pageNumber":345,"juz":18,"createdAt":"2026-09-17T18:45:36.354Z","updatedAt":"2026-09-17T18:45:36.354Z"},{"id":2721,"surahId":23,"surah":{"id":23,"number":23,"nameArabic":"المؤمنون","nameUz":"Moʻminun","meaningUz":"Moʻminlar","revelationPlace":"makka","totalAyahs":118,"startPage":342,"createdAt":"2026-09-17T18:45:07.515Z","updatedAt":"2026-09-18T00:07:52.412Z"},"numberInSurah":48,"textArabic":"فَكَذَّبُوهُمَا فَكَانُوا۟ مِنَ ٱلْمُهْلَكِينَ","translationUz":"Bas, ikkovlarini yolg`onchi qildilar va halok qilinganlardan bo`ldilar.","transcription":null,"tafsirUz":null,"pageNumber":345,"juz":18,"createdAt":"2026-09-17T18:45:36.358Z","updatedAt":"2026-09-17T18:45:36.358Z"},{"id":2722,"surahId":23,"surah":{"id":23,"number":23,"nameArabic":"المؤمنون","nameUz":"Moʻminun","meaningUz":"Moʻminlar","revelationPlace":"makka","totalAyahs":118,"startPage":342,"createdAt":"2026-09-17T18:45:07.515Z","updatedAt":"2026-09-18T00:07:52.412Z"},"numberInSurah":49,"textArabic":"وَلَقَدْ ءَاتَيْنَا مُوسَى ٱلْكِتَـٰبَ لَعَلَّهُمْ يَهْتَدُونَ","translationUz":"Batahqiq, Biz, shoyadki, hidoyat topsalar deb, Musoga Kitobni bergan edik.","transcription":null,"tafsirUz":null,"pageNumber":345,"juz":18,"createdAt":"2026-09-17T18:45:36.362Z","updatedAt":"2026-09-17T18:45:36.362Z"},{"id":2723,"surahId":23,"surah":{"id":23,"number":23,"nameArabic":"المؤمنون","nameUz":"Moʻminun","meaningUz":"Moʻminlar","revelationPlace":"makka","totalAyahs":118,"startPage":342,"createdAt":"2026-09-17T18:45:07.515Z","updatedAt":"2026-09-18T00:07:52.412Z"},"numberInSurah":50,"textArabic":"وَجَعَلْنَا ٱبْنَ مَرْيَمَ وَأُمَّهُۥٓ ءَايَةً وَءَاوَيْنَـٰهُمَآ إِلَىٰ رَبْوَةٍ ذَاتِ قَرَارٍ وَمَعِينٍ","translationUz":"Ibn Maryamni va uning onasini oyat-alomat qildik va ikkovlarini oqar suvli qarorgoh tepalikka joyladik.","transcription":null,"tafsirUz":null,"pageNumber":345,"juz":18,"createdAt":"2026-09-17T18:45:36.366Z","updatedAt":"2026-09-17T18:45:36.366Z"},{"id":2724,"surahId":23,"surah":{"id":23,"number":23,"nameArabic":"المؤمنون","nameUz":"Moʻminun","meaningUz":"Moʻminlar","revelationPlace":"makka","totalAyahs":118,"startPage":342,"createdAt":"2026-09-17T18:45:07.515Z","updatedAt":"2026-09-18T00:07:52.412Z"},"numberInSurah":51,"textArabic":"يَـٰٓأَيُّهَا ٱلرُّسُلُ كُلُوا۟ مِنَ ٱلطَّيِّبَـٰتِ وَٱعْمَلُوا۟ صَـٰلِحًا ۖ إِنِّى بِمَا تَعْمَلُونَ عَلِيمٌ","translationUz":"Ey Payg`ambarlar! Pok narsalardan yenglar va solih amallar qilinglar. Albatta, Men nima amal qilayotganingizni o`ta bilguvchiman.","transcription":null,"tafsirUz":null,"pageNumber":345,"juz":18,"createdAt":"2026-09-17T18:45:36.371Z","updatedAt":"2026-09-17T18:45:36.371Z"},{"id":2725,"surahId":23,"surah":{"id":23,"number":23,"nameArabic":"المؤمنون","nameUz":"Moʻminun","meaningUz":"Moʻminlar","revelationPlace":"makka","totalAyahs":118,"startPage":342,"createdAt":"2026-09-17T18:45:07.515Z","updatedAt":"2026-09-18T00:07:52.412Z"},"numberInSurah":52,"textArabic":"وَإِنَّ هَـٰذِهِۦٓ أُمَّتُكُمْ أُمَّةً وَٰحِدَةً وَأَنَا۠ رَبُّكُمْ فَٱتَّقُونِ","translationUz":"Albatta, sizning bu ummatingiz yagona ummatdir. Men esa, Robbingizman. Bas, Menga taqvo qiling.","transcription":null,"tafsirUz":null,"pageNumber":345,"juz":18,"createdAt":"2026-09-17T18:45:36.375Z","updatedAt":"2026-09-17T18:45:36.375Z"},{"id":2726,"surahId":23,"surah":{"id":23,"number":23,"nameArabic":"المؤمنون","nameUz":"Moʻminun","meaningUz":"Moʻminlar","revelationPlace":"makka","totalAyahs":118,"startPage":342,"createdAt":"2026-09-17T18:45:07.515Z","updatedAt":"2026-09-18T00:07:52.412Z"},"numberInSurah":53,"textArabic":"فَتَقَطَّعُوٓا۟ أَمْرَهُم بَيْنَهُمْ زُبُرًا ۖ كُلُّ حِزْبٍۭ بِمَا لَدَيْهِمْ فَرِحُونَ","translationUz":"Bas, ular ishlarini o`z oralarida pora-pora qilib bo`lib yubordilar. Har firqa o`z huzurlaridagi narsa ila xursanddirlar.","transcription":null,"tafsirUz":null,"pageNumber":345,"juz":18,"createdAt":"2026-09-17T18:45:36.378Z","updatedAt":"2026-09-17T18:45:36.378Z"},{"id":2727,"surahId":23,"surah":{"id":23,"number":23,"nameArabic":"المؤمنون","nameUz":"Moʻminun","meaningUz":"Moʻminlar","revelationPlace":"makka","totalAyahs":118,"startPage":342,"createdAt":"2026-09-17T18:45:07.515Z","updatedAt":"2026-09-18T00:07:52.412Z"},"numberInSurah":54,"textArabic":"فَذَرْهُمْ فِى غَمْرَتِهِمْ حَتَّىٰ حِينٍ","translationUz":"Bas, sen ularni g`aflatlarida bir muddat qo`yib qo`y.","transcription":null,"tafsirUz":null,"pageNumber":345,"juz":18,"createdAt":"2026-09-17T18:45:36.382Z","updatedAt":"2026-09-17T18:45:36.382Z"},{"id":2728,"surahId":23,"surah":{"id":23,"number":23,"nameArabic":"المؤمنون","nameUz":"Moʻminun","meaningUz":"Moʻminlar","revelationPlace":"makka","totalAyahs":118,"startPage":342,"createdAt":"2026-09-17T18:45:07.515Z","updatedAt":"2026-09-18T00:07:52.412Z"},"numberInSurah":55,"textArabic":"أَيَحْسَبُونَ أَنَّمَا نُمِدُّهُم بِهِۦ مِن مَّالٍ وَبَنِينَ","translationUz":"Ular Bizning o`zlariga molu dunyo va farzandlar ila madad berayotganimizni.","transcription":null,"tafsirUz":null,"pageNumber":345,"juz":18,"createdAt":"2026-09-17T18:45:36.387Z","updatedAt":"2026-09-17T18:45:36.387Z"},{"id":2729,"surahId":23,"surah":{"id":23,"number":23,"nameArabic":"المؤمنون","nameUz":"Moʻminun","meaningUz":"Moʻminlar","revelationPlace":"makka","totalAyahs":118,"startPage":342,"createdAt":"2026-09-17T18:45:07.515Z","updatedAt":"2026-09-18T00:07:52.412Z"},"numberInSurah":56,"textArabic":"نُسَارِعُ لَهُمْ فِى ٱلْخَيْرَٰتِ ۚ بَل لَّا يَشْعُرُونَ","translationUz":"Ularga yaxshiliklarni tezlatishimiz, deb hisoblaydilarmi? Yo`q! Ular sezmaslar.","transcription":null,"tafsirUz":null,"pageNumber":345,"juz":18,"createdAt":"2026-09-17T18:45:36.391Z","updatedAt":"2026-09-17T18:45:36.391Z"},{"id":2730,"surahId":23,"surah":{"id":23,"number":23,"nameArabic":"المؤمنون","nameUz":"Moʻminun","meaningUz":"Moʻminlar","revelationPlace":"makka","totalAyahs":118,"startPage":342,"createdAt":"2026-09-17T18:45:07.515Z","updatedAt":"2026-09-18T00:07:52.412Z"},"numberInSurah":57,"textArabic":"إِنَّ ٱلَّذِينَ هُم مِّنْ خَشْيَةِ رَبِّهِم مُّشْفِقُونَ","translationUz":"Albatta, Robbilaridan qo`rqib xavfda turuvchilar.","transcription":null,"tafsirUz":null,"pageNumber":345,"juz":18,"createdAt":"2026-09-17T18:45:36.395Z","updatedAt":"2026-09-17T18:45:36.395Z"},{"id":2731,"surahId":23,"surah":{"id":23,"number":23,"nameArabic":"المؤمنون","nameUz":"Moʻminun","meaningUz":"Moʻminlar","revelationPlace":"makka","totalAyahs":118,"startPage":342,"createdAt":"2026-09-17T18:45:07.515Z","updatedAt":"2026-09-18T00:07:52.412Z"},"numberInSurah":58,"textArabic":"وَٱلَّذِينَ هُم بِـَٔايَـٰتِ رَبِّهِمْ يُؤْمِنُونَ","translationUz":"Va Robbilari oyatlariga iymon keltiradiganlar.","transcription":null,"tafsirUz":null,"pageNumber":345,"juz":18,"createdAt":"2026-09-17T18:45:36.399Z","updatedAt":"2026-09-17T18:45:36.399Z"},{"id":2732,"surahId":23,"surah":{"id":23,"number":23,"nameArabic":"المؤمنون","nameUz":"Moʻminun","meaningUz":"Moʻminlar","revelationPlace":"makka","totalAyahs":118,"startPage":342,"createdAt":"2026-09-17T18:45:07.515Z","updatedAt":"2026-09-18T00:07:52.412Z"},"numberInSurah":59,"textArabic":"وَٱلَّذِينَ هُم بِرَبِّهِمْ لَا يُشْرِكُونَ","translationUz":"Va Robbilariga shirk keltirmaydiganlar.","transcription":null,"tafsirUz":null,"pageNumber":345,"juz":18,"createdAt":"2026-09-17T18:45:36.402Z","updatedAt":"2026-09-17T18:45:36.402Z"}]}