{"number":369,"textArabic":null,"translationUz":null,"juz":null,"note":null,"updatedAt":null,"ayahs":[{"id":2972,"surahId":26,"surah":{"id":26,"number":26,"nameArabic":"الشعراء","nameUz":"Shuaro","meaningUz":"Shoirlar","revelationPlace":"makka","totalAyahs":227,"startPage":367,"createdAt":"2026-09-17T18:45:07.530Z","updatedAt":"2026-09-18T00:07:52.427Z"},"numberInSurah":40,"textArabic":"لَعَلَّنَا نَتَّبِعُ ٱلسَّحَرَةَ إِن كَانُوا۟ هُمُ ٱلْغَـٰلِبِينَ","translationUz":"Ajab ermas, ustun kelsalar, sehrgarlarga ergashsak», deyildi.","transcription":null,"tafsirUz":null,"pageNumber":369,"juz":19,"createdAt":"2026-09-17T18:45:39.344Z","updatedAt":"2026-09-17T18:45:39.344Z"},{"id":2973,"surahId":26,"surah":{"id":26,"number":26,"nameArabic":"الشعراء","nameUz":"Shuaro","meaningUz":"Shoirlar","revelationPlace":"makka","totalAyahs":227,"startPage":367,"createdAt":"2026-09-17T18:45:07.530Z","updatedAt":"2026-09-18T00:07:52.427Z"},"numberInSurah":41,"textArabic":"فَلَمَّا جَآءَ ٱلسَّحَرَةُ قَالُوا۟ لِفِرْعَوْنَ أَئِنَّ لَنَا لَأَجْرًا إِن كُنَّا نَحْنُ ٱلْغَـٰلِبِينَ","translationUz":"Sehrgarlar kelgan chog`larida Fir'avnga: «Agar biz g`olib kelguvchi bo`lsak, bizga, albatta, haq beriladimi?» dedilar.","transcription":null,"tafsirUz":null,"pageNumber":369,"juz":19,"createdAt":"2026-09-17T18:45:39.348Z","updatedAt":"2026-09-17T18:45:39.348Z"},{"id":2974,"surahId":26,"surah":{"id":26,"number":26,"nameArabic":"الشعراء","nameUz":"Shuaro","meaningUz":"Shoirlar","revelationPlace":"makka","totalAyahs":227,"startPage":367,"createdAt":"2026-09-17T18:45:07.530Z","updatedAt":"2026-09-18T00:07:52.427Z"},"numberInSurah":42,"textArabic":"قَالَ نَعَمْ وَإِنَّكُمْ إِذًا لَّمِنَ ٱلْمُقَرَّبِينَ","translationUz":"U: «Ha! U holda siz, albatta, eng yaqinlarimdan bo`lasiz», dedi.","transcription":null,"tafsirUz":null,"pageNumber":369,"juz":19,"createdAt":"2026-09-17T18:45:39.355Z","updatedAt":"2026-09-17T18:45:39.355Z"},{"id":2975,"surahId":26,"surah":{"id":26,"number":26,"nameArabic":"الشعراء","nameUz":"Shuaro","meaningUz":"Shoirlar","revelationPlace":"makka","totalAyahs":227,"startPage":367,"createdAt":"2026-09-17T18:45:07.530Z","updatedAt":"2026-09-18T00:07:52.427Z"},"numberInSurah":43,"textArabic":"قَالَ لَهُم مُّوسَىٰٓ أَلْقُوا۟ مَآ أَنتُم مُّلْقُونَ","translationUz":"Muso ularga: «Siz tashlaydigan narsangizni tashlang», dedi.","transcription":null,"tafsirUz":null,"pageNumber":369,"juz":19,"createdAt":"2026-09-17T18:45:39.360Z","updatedAt":"2026-09-17T18:45:39.360Z"},{"id":2976,"surahId":26,"surah":{"id":26,"number":26,"nameArabic":"الشعراء","nameUz":"Shuaro","meaningUz":"Shoirlar","revelationPlace":"makka","totalAyahs":227,"startPage":367,"createdAt":"2026-09-17T18:45:07.530Z","updatedAt":"2026-09-18T00:07:52.427Z"},"numberInSurah":44,"textArabic":"فَأَلْقَوْا۟ حِبَالَهُمْ وَعِصِيَّهُمْ وَقَالُوا۟ بِعِزَّةِ فِرْعَوْنَ إِنَّا لَنَحْنُ ٱلْغَـٰلِبُونَ","translationUz":"Bas, ular arqonlari va asolarini tashladilar va «Fir'avnning izzati bilan qasamki, albatta, biz g`oliblarmiz», dedilar.","transcription":null,"tafsirUz":null,"pageNumber":369,"juz":19,"createdAt":"2026-09-17T18:45:39.364Z","updatedAt":"2026-09-17T18:45:39.364Z"},{"id":2977,"surahId":26,"surah":{"id":26,"number":26,"nameArabic":"الشعراء","nameUz":"Shuaro","meaningUz":"Shoirlar","revelationPlace":"makka","totalAyahs":227,"startPage":367,"createdAt":"2026-09-17T18:45:07.530Z","updatedAt":"2026-09-18T00:07:52.427Z"},"numberInSurah":45,"textArabic":"فَأَلْقَىٰ مُوسَىٰ عَصَاهُ فَإِذَا هِىَ تَلْقَفُ مَا يَأْفِكُونَ","translationUz":"So`ngra Muso asosini tashlagan edi, birdan u ularning uydirmalarini yuta boshladi.","transcription":null,"tafsirUz":null,"pageNumber":369,"juz":19,"createdAt":"2026-09-17T18:45:39.368Z","updatedAt":"2026-09-17T18:45:39.368Z"},{"id":2978,"surahId":26,"surah":{"id":26,"number":26,"nameArabic":"الشعراء","nameUz":"Shuaro","meaningUz":"Shoirlar","revelationPlace":"makka","totalAyahs":227,"startPage":367,"createdAt":"2026-09-17T18:45:07.530Z","updatedAt":"2026-09-18T00:07:52.427Z"},"numberInSurah":46,"textArabic":"فَأُلْقِىَ ٱلسَّحَرَةُ سَـٰجِدِينَ","translationUz":"Bas, sehrgarlar sajda qilgan hollarida yiqildilar.","transcription":null,"tafsirUz":null,"pageNumber":369,"juz":19,"createdAt":"2026-09-17T18:45:39.372Z","updatedAt":"2026-09-17T18:45:39.372Z"},{"id":2979,"surahId":26,"surah":{"id":26,"number":26,"nameArabic":"الشعراء","nameUz":"Shuaro","meaningUz":"Shoirlar","revelationPlace":"makka","totalAyahs":227,"startPage":367,"createdAt":"2026-09-17T18:45:07.530Z","updatedAt":"2026-09-18T00:07:52.427Z"},"numberInSurah":47,"textArabic":"قَالُوٓا۟ ءَامَنَّا بِرَبِّ ٱلْعَـٰلَمِينَ","translationUz":"Ular: «Robbul olamiynga iymon keltirdik.","transcription":null,"tafsirUz":null,"pageNumber":369,"juz":19,"createdAt":"2026-09-17T18:45:39.377Z","updatedAt":"2026-09-17T18:45:39.377Z"},{"id":2980,"surahId":26,"surah":{"id":26,"number":26,"nameArabic":"الشعراء","nameUz":"Shuaro","meaningUz":"Shoirlar","revelationPlace":"makka","totalAyahs":227,"startPage":367,"createdAt":"2026-09-17T18:45:07.530Z","updatedAt":"2026-09-18T00:07:52.427Z"},"numberInSurah":48,"textArabic":"رَبِّ مُوسَىٰ وَهَـٰرُونَ","translationUz":"Muso va Horunning Robbiga», dedilar.","transcription":null,"tafsirUz":null,"pageNumber":369,"juz":19,"createdAt":"2026-09-17T18:45:39.383Z","updatedAt":"2026-09-17T18:45:39.383Z"},{"id":2981,"surahId":26,"surah":{"id":26,"number":26,"nameArabic":"الشعراء","nameUz":"Shuaro","meaningUz":"Shoirlar","revelationPlace":"makka","totalAyahs":227,"startPage":367,"createdAt":"2026-09-17T18:45:07.530Z","updatedAt":"2026-09-18T00:07:52.427Z"},"numberInSurah":49,"textArabic":"قَالَ ءَامَنتُمْ لَهُۥ قَبْلَ أَنْ ءَاذَنَ لَكُمْ ۖ إِنَّهُۥ لَكَبِيرُكُمُ ٱلَّذِى عَلَّمَكُمُ ٱلسِّحْرَ فَلَسَوْفَ تَعْلَمُونَ ۚ لَأُقَطِّعَنَّ أَيْدِيَكُمْ وَأَرْجُلَكُم مِّنْ خِلَـٰفٍ وَلَأُصَلِّبَنَّكُمْ أَجْمَعِينَ","translationUz":"U: «Men sizga izn bermasimdan oldin unga iymon keltirdingiz! Albatta, u sizga sehr o`rgatgan kattangizdir! Endi tezda bilasiz, men, albatta, qo`l-oyog`ingizni qarama-qarshi tomonidan kesajakman va barchangizni osajakman», dedi.","transcription":null,"tafsirUz":null,"pageNumber":369,"juz":19,"createdAt":"2026-09-17T18:45:39.387Z","updatedAt":"2026-09-17T18:45:39.387Z"},{"id":2982,"surahId":26,"surah":{"id":26,"number":26,"nameArabic":"الشعراء","nameUz":"Shuaro","meaningUz":"Shoirlar","revelationPlace":"makka","totalAyahs":227,"startPage":367,"createdAt":"2026-09-17T18:45:07.530Z","updatedAt":"2026-09-18T00:07:52.427Z"},"numberInSurah":50,"textArabic":"قَالُوا۟ لَا ضَيْرَ ۖ إِنَّآ إِلَىٰ رَبِّنَا مُنقَلِبُونَ","translationUz":"Ular: «Zarari yo`q. Albatta, biz Robbimizga qaytguvchimiz.","transcription":null,"tafsirUz":null,"pageNumber":369,"juz":19,"createdAt":"2026-09-17T18:45:39.391Z","updatedAt":"2026-09-17T18:45:39.391Z"},{"id":2983,"surahId":26,"surah":{"id":26,"number":26,"nameArabic":"الشعراء","nameUz":"Shuaro","meaningUz":"Shoirlar","revelationPlace":"makka","totalAyahs":227,"startPage":367,"createdAt":"2026-09-17T18:45:07.530Z","updatedAt":"2026-09-18T00:07:52.427Z"},"numberInSurah":51,"textArabic":"إِنَّا نَطْمَعُ أَن يَغْفِرَ لَنَا رَبُّنَا خَطَـٰيَـٰنَآ أَن كُنَّآ أَوَّلَ ٱلْمُؤْمِنِينَ","translationUz":"Mo`minlarning avvalgisi bo`lganimiz uchun Robbimiz xatolarimizni kechirishidan umid qilamiz», dedilar.","transcription":null,"tafsirUz":null,"pageNumber":369,"juz":19,"createdAt":"2026-09-17T18:45:39.396Z","updatedAt":"2026-09-17T18:45:39.396Z"},{"id":2984,"surahId":26,"surah":{"id":26,"number":26,"nameArabic":"الشعراء","nameUz":"Shuaro","meaningUz":"Shoirlar","revelationPlace":"makka","totalAyahs":227,"startPage":367,"createdAt":"2026-09-17T18:45:07.530Z","updatedAt":"2026-09-18T00:07:52.427Z"},"numberInSurah":52,"textArabic":"۞ وَأَوْحَيْنَآ إِلَىٰ مُوسَىٰٓ أَنْ أَسْرِ بِعِبَادِىٓ إِنَّكُم مُّتَّبَعُونَ","translationUz":"Va Musoga: «Bandalarim bilan kechasi yo`lga chiq. Albatta, ta'qib etilursiz», deb vahiy yubordik.","transcription":null,"tafsirUz":null,"pageNumber":369,"juz":19,"createdAt":"2026-09-17T18:45:39.400Z","updatedAt":"2026-09-17T18:45:39.400Z"},{"id":2985,"surahId":26,"surah":{"id":26,"number":26,"nameArabic":"الشعراء","nameUz":"Shuaro","meaningUz":"Shoirlar","revelationPlace":"makka","totalAyahs":227,"startPage":367,"createdAt":"2026-09-17T18:45:07.530Z","updatedAt":"2026-09-18T00:07:52.427Z"},"numberInSurah":53,"textArabic":"فَأَرْسَلَ فِرْعَوْنُ فِى ٱلْمَدَآئِنِ حَـٰشِرِينَ","translationUz":"Bas, Fir'avn shaharlarga to`plovchilar yubordi:","transcription":null,"tafsirUz":null,"pageNumber":369,"juz":19,"createdAt":"2026-09-17T18:45:39.405Z","updatedAt":"2026-09-17T18:45:39.405Z"},{"id":2986,"surahId":26,"surah":{"id":26,"number":26,"nameArabic":"الشعراء","nameUz":"Shuaro","meaningUz":"Shoirlar","revelationPlace":"makka","totalAyahs":227,"startPage":367,"createdAt":"2026-09-17T18:45:07.530Z","updatedAt":"2026-09-18T00:07:52.427Z"},"numberInSurah":54,"textArabic":"إِنَّ هَـٰٓؤُلَآءِ لَشِرْذِمَةٌ قَلِيلُونَ","translationUz":"«Shubhasiz, anavilar ozgina toifadirlar.","transcription":null,"tafsirUz":null,"pageNumber":369,"juz":19,"createdAt":"2026-09-17T18:45:39.409Z","updatedAt":"2026-09-17T18:45:39.409Z"},{"id":2987,"surahId":26,"surah":{"id":26,"number":26,"nameArabic":"الشعراء","nameUz":"Shuaro","meaningUz":"Shoirlar","revelationPlace":"makka","totalAyahs":227,"startPage":367,"createdAt":"2026-09-17T18:45:07.530Z","updatedAt":"2026-09-18T00:07:52.427Z"},"numberInSurah":55,"textArabic":"وَإِنَّهُمْ لَنَا لَغَآئِظُونَ","translationUz":"Albatta, ular bizni g`azablantirguvchilardir.","transcription":null,"tafsirUz":null,"pageNumber":369,"juz":19,"createdAt":"2026-09-17T18:45:39.413Z","updatedAt":"2026-09-17T18:45:39.413Z"},{"id":2988,"surahId":26,"surah":{"id":26,"number":26,"nameArabic":"الشعراء","nameUz":"Shuaro","meaningUz":"Shoirlar","revelationPlace":"makka","totalAyahs":227,"startPage":367,"createdAt":"2026-09-17T18:45:07.530Z","updatedAt":"2026-09-18T00:07:52.427Z"},"numberInSurah":56,"textArabic":"وَإِنَّا لَجَمِيعٌ حَـٰذِرُونَ","translationUz":"Albatta, biz hammamiz hushyormiz», deb.","transcription":null,"tafsirUz":null,"pageNumber":369,"juz":19,"createdAt":"2026-09-17T18:45:39.418Z","updatedAt":"2026-09-17T18:45:39.418Z"},{"id":2989,"surahId":26,"surah":{"id":26,"number":26,"nameArabic":"الشعراء","nameUz":"Shuaro","meaningUz":"Shoirlar","revelationPlace":"makka","totalAyahs":227,"startPage":367,"createdAt":"2026-09-17T18:45:07.530Z","updatedAt":"2026-09-18T00:07:52.427Z"},"numberInSurah":57,"textArabic":"فَأَخْرَجْنَـٰهُم مِّن جَنَّـٰتٍ وَعُيُونٍ","translationUz":"Bas, Biz ularni chiqardik, bog`-rog`lar va buloqlardan.","transcription":null,"tafsirUz":null,"pageNumber":369,"juz":19,"createdAt":"2026-09-17T18:45:39.422Z","updatedAt":"2026-09-17T18:45:39.422Z"},{"id":2990,"surahId":26,"surah":{"id":26,"number":26,"nameArabic":"الشعراء","nameUz":"Shuaro","meaningUz":"Shoirlar","revelationPlace":"makka","totalAyahs":227,"startPage":367,"createdAt":"2026-09-17T18:45:07.530Z","updatedAt":"2026-09-18T00:07:52.427Z"},"numberInSurah":58,"textArabic":"وَكُنُوزٍ وَمَقَامٍ كَرِيمٍ","translationUz":"Xazinalar va muhtaram maskandan.","transcription":null,"tafsirUz":null,"pageNumber":369,"juz":19,"createdAt":"2026-09-17T18:45:39.427Z","updatedAt":"2026-09-17T18:45:39.427Z"},{"id":2991,"surahId":26,"surah":{"id":26,"number":26,"nameArabic":"الشعراء","nameUz":"Shuaro","meaningUz":"Shoirlar","revelationPlace":"makka","totalAyahs":227,"startPage":367,"createdAt":"2026-09-17T18:45:07.530Z","updatedAt":"2026-09-18T00:07:52.427Z"},"numberInSurah":59,"textArabic":"كَذَٰلِكَ وَأَوْرَثْنَـٰهَا بَنِىٓ إِسْرَٰٓءِيلَ","translationUz":"Ana shunday. O`sha(narsa)larni Bani Isroilga meros qilib berdik.","transcription":null,"tafsirUz":null,"pageNumber":369,"juz":19,"createdAt":"2026-09-17T18:45:39.431Z","updatedAt":"2026-09-17T18:45:39.431Z"},{"id":2992,"surahId":26,"surah":{"id":26,"number":26,"nameArabic":"الشعراء","nameUz":"Shuaro","meaningUz":"Shoirlar","revelationPlace":"makka","totalAyahs":227,"startPage":367,"createdAt":"2026-09-17T18:45:07.530Z","updatedAt":"2026-09-18T00:07:52.427Z"},"numberInSurah":60,"textArabic":"فَأَتْبَعُوهُم مُّشْرِقِينَ","translationUz":"Bas, ularni quyosh chiqish paytida quvib yetdilar.","transcription":null,"tafsirUz":null,"pageNumber":369,"juz":19,"createdAt":"2026-09-17T18:45:39.435Z","updatedAt":"2026-09-17T18:45:39.435Z"}]}