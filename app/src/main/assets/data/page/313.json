{"number":313,"textArabic":null,"translationUz":null,"juz":null,"note":null,"updatedAt":null,"ayahs":[{"id":2361,"surahId":20,"surah":{"id":20,"number":20,"nameArabic":"طه","nameUz":"Toha","meaningUz":"Toha","revelationPlace":"makka","totalAyahs":135,"startPage":312,"createdAt":"2026-09-17T18:45:07.499Z","updatedAt":"2026-09-18T00:07:52.398Z"},"numberInSurah":13,"textArabic":"وَأَنَا ٱخْتَرْتُكَ فَٱسْتَمِعْ لِمَا يُوحَىٰٓ","translationUz":"Men seni ixtiyor qilib oldim. Vahiy qilinadigan narsaga quloq os.","transcription":null,"tafsirUz":null,"pageNumber":313,"juz":16,"createdAt":"2026-09-17T18:45:33.169Z","updatedAt":"2026-09-17T18:45:33.169Z"},{"id":2362,"surahId":20,"surah":{"id":20,"number":20,"nameArabic":"طه","nameUz":"Toha","meaningUz":"Toha","revelationPlace":"makka","totalAyahs":135,"startPage":312,"createdAt":"2026-09-17T18:45:07.499Z","updatedAt":"2026-09-18T00:07:52.398Z"},"numberInSurah":14,"textArabic":"إِنَّنِىٓ أَنَا ٱللَّهُ لَآ إِلَـٰهَ إِلَّآ أَنَا۠ فَٱعْبُدْنِى وَأَقِمِ ٱلصَّلَوٰةَ لِذِكْرِىٓ","translationUz":"Albatta, Men O`zim Allohdirman. Mendan o`zga iloh yo`q. Bas, Menga ibodat qil va Meni zikr etish uchun namozni to`kis ado et.","transcription":null,"tafsirUz":null,"pageNumber":313,"juz":16,"createdAt":"2026-09-17T18:45:33.173Z","updatedAt":"2026-09-17T18:45:33.173Z"},{"id":2363,"surahId":20,"surah":{"id":20,"number":20,"nameArabic":"طه","nameUz":"Toha","meaningUz":"Toha","revelationPlace":"makka","totalAyahs":135,"startPage":312,"createdAt":"2026-09-17T18:45:07.499Z","updatedAt":"2026-09-18T00:07:52.398Z"},"numberInSurah":15,"textArabic":"إِنَّ ٱلسَّاعَةَ ءَاتِيَةٌ أَكَادُ أُخْفِيهَا لِتُجْزَىٰ كُلُّ نَفْسٍۭ بِمَا تَسْعَىٰ","translationUz":"Albatta, soat (qiyomat) kelguvchidir. Har bir jon sa'yi-harakatiga yarasha jazo olishi uchun uni maxfiy tuturman.","transcription":null,"tafsirUz":null,"pageNumber":313,"juz":16,"createdAt":"2026-09-17T18:45:33.177Z","updatedAt":"2026-09-17T18:45:33.177Z"},{"id":2364,"surahId":20,"surah":{"id":20,"number":20,"nameArabic":"طه","nameUz":"Toha","meaningUz":"Toha","revelationPlace":"makka","totalAyahs":135,"startPage":312,"createdAt":"2026-09-17T18:45:07.499Z","updatedAt":"2026-09-18T00:07:52.398Z"},"numberInSurah":16,"textArabic":"فَلَا يَصُدَّنَّكَ عَنْهَا مَن لَّا يُؤْمِنُ بِهَا وَٱتَّبَعَ هَوَىٰهُ فَتَرْدَىٰ","translationUz":"Unga iymon keltirmaydiganlar va havoyi nafsiga ergashganlar seni hargiz undan to`smasinlar. U holda halok bo`lasan.","transcription":null,"tafsirUz":null,"pageNumber":313,"juz":16,"createdAt":"2026-09-17T18:45:33.182Z","updatedAt":"2026-09-17T18:45:33.182Z"},{"id":2365,"surahId":20,"surah":{"id":20,"number":20,"nameArabic":"طه","nameUz":"Toha","meaningUz":"Toha","revelationPlace":"makka","totalAyahs":135,"startPage":312,"createdAt":"2026-09-17T18:45:07.499Z","updatedAt":"2026-09-18T00:07:52.398Z"},"numberInSurah":17,"textArabic":"وَمَا تِلْكَ بِيَمِينِكَ يَـٰمُوسَىٰ","translationUz":"Ey Muso, qo`lingdagi nima?»","transcription":null,"tafsirUz":null,"pageNumber":313,"juz":16,"createdAt":"2026-09-17T18:45:33.186Z","updatedAt":"2026-09-17T18:45:33.186Z"},{"id":2366,"surahId":20,"surah":{"id":20,"number":20,"nameArabic":"طه","nameUz":"Toha","meaningUz":"Toha","revelationPlace":"makka","totalAyahs":135,"startPage":312,"createdAt":"2026-09-17T18:45:07.499Z","updatedAt":"2026-09-18T00:07:52.398Z"},"numberInSurah":18,"textArabic":"قَالَ هِىَ عَصَاىَ أَتَوَكَّؤُا۟ عَلَيْهَا وَأَهُشُّ بِهَا عَلَىٰ غَنَمِى وَلِىَ فِيهَا مَـَٔارِبُ أُخْرَىٰ","translationUz":"U: «Bu asoimdir, unga suyanaman, u bilan qo`ylarimga (barg) qoqib beraman va unda mening boshqa ishlarim bor», dedi.","transcription":null,"tafsirUz":null,"pageNumber":313,"juz":16,"createdAt":"2026-09-17T18:45:33.190Z","updatedAt":"2026-09-17T18:45:33.190Z"},{"id":2367,"surahId":20,"surah":{"id":20,"number":20,"nameArabic":"طه","nameUz":"Toha","meaningUz":"Toha","revelationPlace":"makka","totalAyahs":135,"startPage":312,"createdAt":"2026-09-17T18:45:07.499Z","updatedAt":"2026-09-18T00:07:52.398Z"},"numberInSurah":19,"textArabic":"قَالَ أَلْقِهَا يَـٰمُوسَىٰ","translationUz":"U: «Ey Muso, uni tashla», dedi.","transcription":null,"tafsirUz":null,"pageNumber":313,"juz":16,"createdAt":"2026-09-17T18:45:33.194Z","updatedAt":"2026-09-17T18:45:33.194Z"},{"id":2368,"surahId":20,"surah":{"id":20,"number":20,"nameArabic":"طه","nameUz":"Toha","meaningUz":"Toha","revelationPlace":"makka","totalAyahs":135,"startPage":312,"createdAt":"2026-09-17T18:45:07.499Z","updatedAt":"2026-09-18T00:07:52.398Z"},"numberInSurah":20,"textArabic":"فَأَلْقَىٰهَا فَإِذَا هِىَ حَيَّةٌ تَسْعَىٰ","translationUz":"Bas, uni tashladi. Birdan u (aso) ilon bo`lib yura boshladi.","transcription":null,"tafsirUz":null,"pageNumber":313,"juz":16,"createdAt":"2026-09-17T18:45:33.198Z","updatedAt":"2026-09-17T18:45:33.198Z"},{"id":2369,"surahId":20,"surah":{"id":20,"number":20,"nameArabic":"طه","nameUz":"Toha","meaningUz":"Toha","revelationPlace":"makka","totalAyahs":135,"startPage":312,"createdAt":"2026-09-17T18:45:07.499Z","updatedAt":"2026-09-18T00:07:52.398Z"},"numberInSurah":21,"textArabic":"قَالَ خُذْهَا وَلَا تَخَفْ ۖ سَنُعِيدُهَا سِيرَتَهَا ٱلْأُولَىٰ","translationUz":"U zot: «Uni ol, qo`rqma. Biz uni avvalgi holiga keltiramiz.","transcription":null,"tafsirUz":null,"pageNumber":313,"juz":16,"createdAt":"2026-09-17T18:45:33.201Z","updatedAt":"2026-09-17T18:45:33.201Z"},{"id":2370,"surahId":20,"surah":{"id":20,"number":20,"nameArabic":"طه","nameUz":"Toha","meaningUz":"Toha","revelationPlace":"makka","totalAyahs":135,"startPage":312,"createdAt":"2026-09-17T18:45:07.499Z","updatedAt":"2026-09-18T00:07:52.398Z"},"numberInSurah":22,"textArabic":"وَٱضْمُمْ يَدَكَ إِلَىٰ جَنَاحِكَ تَخْرُجْ بَيْضَآءَ مِنْ غَيْرِ سُوٓءٍ ءَايَةً أُخْرَىٰ","translationUz":"Qo`lingni qo`ltig`ingga tiq, yomonliksiz oppoq bo`lib chiqadir. Bu boshqa bir mo`'jizadir.","transcription":null,"tafsirUz":null,"pageNumber":313,"juz":16,"createdAt":"2026-09-17T18:45:33.205Z","updatedAt":"2026-09-17T18:45:33.205Z"},{"id":2371,"surahId":20,"surah":{"id":20,"number":20,"nameArabic":"طه","nameUz":"Toha","meaningUz":"Toha","revelationPlace":"makka","totalAyahs":135,"startPage":312,"createdAt":"2026-09-17T18:45:07.499Z","updatedAt":"2026-09-18T00:07:52.398Z"},"numberInSurah":23,"textArabic":"لِنُرِيَكَ مِنْ ءَايَـٰتِنَا ٱلْكُبْرَى","translationUz":"Biz senga buyuk mo`'jizalarimizni ko`rsatish uchun (shunday qildik).","transcription":null,"tafsirUz":null,"pageNumber":313,"juz":16,"createdAt":"2026-09-17T18:45:33.209Z","updatedAt":"2026-09-17T18:45:33.209Z"},{"id":2372,"surahId":20,"surah":{"id":20,"number":20,"nameArabic":"طه","nameUz":"Toha","meaningUz":"Toha","revelationPlace":"makka","totalAyahs":135,"startPage":312,"createdAt":"2026-09-17T18:45:07.499Z","updatedAt":"2026-09-18T00:07:52.398Z"},"numberInSurah":24,"textArabic":"ٱذْهَبْ إِلَىٰ فِرْعَوْنَ إِنَّهُۥ طَغَىٰ","translationUz":"Sen Fir'avnga bor, chunki, u tug`yonga ketdi», dedi.","transcription":null,"tafsirUz":null,"pageNumber":313,"juz":16,"createdAt":"2026-09-17T18:45:33.213Z","updatedAt":"2026-09-17T18:45:33.213Z"},{"id":2373,"surahId":20,"surah":{"id":20,"number":20,"nameArabic":"طه","nameUz":"Toha","meaningUz":"Toha","revelationPlace":"makka","totalAyahs":135,"startPage":312,"createdAt":"2026-09-17T18:45:07.499Z","updatedAt":"2026-09-18T00:07:52.398Z"},"numberInSurah":25,"textArabic":"قَالَ رَبِّ ٱشْرَحْ لِى صَدْرِى","translationUz":"U: «Ey Robbim, mening qalbimni keng qil.","transcription":null,"tafsirUz":null,"pageNumber":313,"juz":16,"createdAt":"2026-09-17T18:45:33.217Z","updatedAt":"2026-09-17T18:45:33.217Z"},{"id":2374,"surahId":20,"surah":{"id":20,"number":20,"nameArabic":"طه","nameUz":"Toha","meaningUz":"Toha","revelationPlace":"makka","totalAyahs":135,"startPage":312,"createdAt":"2026-09-17T18:45:07.499Z","updatedAt":"2026-09-18T00:07:52.398Z"},"numberInSurah":26,"textArabic":"وَيَسِّرْ لِىٓ أَمْرِى","translationUz":"Mening ishimni oson qil.","transcription":null,"tafsirUz":null,"pageNumber":313,"juz":16,"createdAt":"2026-09-17T1