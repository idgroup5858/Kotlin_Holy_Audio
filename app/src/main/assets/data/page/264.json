{"number":264,"textArabic":null,"translationUz":null,"juz":null,"note":null,"updatedAt":null,"ayahs":[{"id":1834,"surahId":15,"surah":{"id":15,"number":15,"nameArabic":"الحجر","nameUz":"Hijr","meaningUz":"Hijr vodiysi","revelationPlace":"makka","totalAyahs":99,"startPage":262,"createdAt":"2026-09-17T18:45:07.474Z","updatedAt":"2026-09-18T00:07:52.373Z"},"numberInSurah":32,"textArabic":"قَالَ يَـٰٓإِبْلِيسُ مَا لَكَ أَلَّا تَكُونَ مَعَ ٱلسَّـٰجِدِينَ","translationUz":"U zot: «Ey, iblis! Senga ne bo`ldi, sajda qiluvchilar bilan birga bo`lmading?» dedi.","transcription":null,"tafsirUz":null,"pageNumber":264,"juz":14,"createdAt":"2026-09-17T18:45:27.325Z","updatedAt":"2026-09-17T18:45:27.325Z"},{"id":1835,"surahId":15,"surah":{"id":15,"number":15,"nameArabic":"الحجر","nameUz":"Hijr","meaningUz":"Hijr vodiysi","revelationPlace":"makka","totalAyahs":99,"startPage":262,"createdAt":"2026-09-17T18:45:07.474Z","updatedAt":"2026-09-18T00:07:52.373Z"},"numberInSurah":33,"textArabic":"قَالَ لَمْ أَكُن لِّأَسْجُدَ لِبَشَرٍ خَلَقْتَهُۥ مِن صَلْصَـٰلٍ مِّنْ حَمَإٍ مَّسْنُونٍ","translationUz":"U: «Sen quruq loydan, o`zgartirilgan qora balchiqdan yaratgan basharga sajda qila olmasdim», dedi.","transcription":null,"tafsirUz":null,"pageNumber":264,"juz":14,"createdAt":"2026-09-17T18:45:27.330Z","updatedAt":"2026-09-17T18:45:27.330Z"},{"id":1836,"surahId":15,"surah":{"id":15,"number":15,"nameArabic":"الحجر","nameUz":"Hijr","meaningUz":"Hijr vodiysi","revelationPlace":"makka","totalAyahs":99,"startPage":262,"createdAt":"2026-09-17T18:45:07.474Z","updatedAt":"2026-09-18T00:07:52.373Z"},"numberInSurah":34,"textArabic":"قَالَ فَٱخْرُجْ مِنْهَا فَإِنَّكَ رَجِيمٌ","translationUz":"U zot: «Bas, sen undan chiq! Albatta, sen quvilgansan!","transcription":null,"tafsirUz":null,"pageNumber":264,"juz":14,"createdAt":"2026-09-17T18:45:27.335Z","updatedAt":"2026-09-17T18:45:27.335Z"},{"id":1837,"surahId":15,"surah":{"id":15,"number":15,"nameArabic":"الحجر","nameUz":"Hijr","meaningUz":"Hijr vodiysi","revelationPlace":"makka","totalAyahs":99,"startPage":262,"createdAt":"2026-09-17T18:45:07.474Z","updatedAt":"2026-09-18T00:07:52.373Z"},"numberInSurah":35,"textArabic":"وَإِنَّ عَلَيْكَ ٱللَّعْنَةَ إِلَىٰ يَوْمِ ٱلدِّينِ","translationUz":"Va, albatta, senga to jazo kunigacha la'nat bo`lur!» dedi.","transcription":null,"tafsirUz":null,"pageNumber":264,"juz":14,"createdAt":"2026-09-17T18:45:27.340Z","updatedAt":"2026-09-17T18:45:27.340Z"},{"id":1838,"surahId":15,"surah":{"id":15,"number":15,"nameArabic":"الحجر","nameUz":"Hijr","meaningUz":"Hijr vodiysi","revelationPlace":"makka","totalAyahs":99,"startPage":262,"createdAt":"2026-09-17T18:45:07.474Z","updatedAt":"2026-09-18T00:07:52.373Z"},"numberInSurah":36,"textArabic":"قَالَ رَبِّ فَأَنظِرْنِىٓ إِلَىٰ يَوْمِ يُبْعَثُونَ","translationUz":"U: «Ey Robbim, meni ular qayta tiriladigan kungacha qo`yib qo`ygin», dedi.","transcription":null,"tafsirUz":null,"pageNumber":264,"juz":14,"createdAt":"2026-09-17T18:45:27.345Z","updatedAt":"2026-09-17T18:45:27.345Z"},{"id":1839,"surahId":15,"surah":{"id":15,"number":15,"nameArabic":"الحجر","nameUz":"Hijr","meaningUz":"Hijr vodiysi","revelationPlace":"makka","totalAyahs":99,"startPage":262,"createdAt":"2026-09-17T18:45:07.474Z","updatedAt":"2026-09-18T00:07:52.373Z"},"numberInSurah":37,"textArabic":"قَالَ فَإِنَّكَ مِنَ ٱلْمُنظَرِينَ","translationUz":"U zot: «Albatta, sen qo`yib qo`yilganlardansan.","transcription":null,"tafsirUz":null,"pageNumber":264,"juz":14,"createdAt":"2026-09-17T18:45:27.351Z","updatedAt":"2026-09-17T18:45:27.351Z"},{"id":1840,"surahId":15,"surah":{"id":15,"number":15,"nameArabic":"الحجر","nameUz":"Hijr","meaningUz":"Hijr vodiysi","revelationPlace":"makka","totalAyahs":99,"startPage":262,"createdAt":"2026-09-17T18:45:07.474Z","updatedAt":"2026-09-18T00:07:52.373Z"},"numberInSurah":38,"textArabic":"إِلَىٰ يَوْمِ ٱلْوَقْتِ ٱلْمَعْلُومِ","translationUz":"Ma'lum vaqt kunigacha», dedi.","transcription":null,"tafsirUz":null,"pageNumber":264,"juz":14,"createdAt":"2026-09-17T18:45:27.357Z","updatedAt":"2026-09-17T18:45:27.357Z"},{"id":1841,"surahId":15,"surah":{"id":15,"number":15,"nameArabic":"الحجر","nameUz":"Hijr","meaningUz":"Hijr vodiysi","revelationPlace":"makka","totalAyahs":99,"startPage":262,"createdAt":"2026-09-17T18:45:07.474Z","updatedAt":"2026-09-18T00:07:52.373Z"},"numberInSurah":39,"textArabic":"قَالَ رَبِّ بِمَآ أَغْوَيْتَنِى لَأُزَيِّنَنَّ لَهُمْ فِى ٱلْأَرْضِ وَلَأُغْوِيَنَّهُمْ أَجْمَعِينَ","translationUz":"U: «Ey Robbim, meni zalolatga ketkazganing sababidan, albatta, men ularga yer yuzida (gunohlarni) ziynatlab ko`rsataman va, albatta, ularning hammasini ig`vo qilaman.","transcription":null,"tafsirUz":null,"pageNumber":264,"juz":14,"createdAt":"2026-09-17T18:45:27.362Z","updatedAt":"2026-09-17T18:45:27.362Z"},{"id":1842,"surahId":15,"surah":{"id":15,"number":15,"nameArabic":"الحجر","nameUz":"Hijr","meaningUz":"Hijr vodiysi","revelationPlace":"makka","totalAyahs":99,"startPage":262,"createdAt":"2026-09-17T18:45:07.474Z","updatedAt":"2026-09-18T00:07:52.373Z"},"numberInSurah":40,"textArabic":"إِلَّا عِبَادَكَ مِنْهُمُ ٱلْمُخْلَصِينَ","translationUz":"Magar, ulardan tanlangan bandalaringni (adashtira olmasman)», dedi.","transcription":null,"tafsirUz":null,"pageNumber":264,"juz":14,"createdAt":"2026-09-17T18:45:27.367Z","updatedAt":"2026-09-17T18:45:27.367Z"},{"id":1843,"surahId":15,"surah":{"id":15,"number":15,"nameArabic":"الحجر","nameUz":"Hijr","meaningUz":"Hijr vodiysi","revelationPlace":"makka","totalAyahs":99,"startPage":262,"createdAt":"2026-09-17T18:45:07.474Z","updatedAt":"2026-09-18T00:07:52.373Z"},"numberInSurah":41,"textArabic":"قَالَ هَـٰذَا صِرَٰطٌ عَلَىَّ مُسْتَقِيمٌ","translationUz":"U zot: «Ushbu zimmamdagi to`g`ri yo`ldir:","transcription":null,"tafsirUz":null,"pageNumber":264,"juz":14,"createdAt":"2026-09-17T18:45:27.370Z","updatedAt":"2026-09-17T18:45:27.370Z"},{"id":1844,"surahId":15,"surah":{"id":15,"number":15,"nameArabic":"الحجر","nameUz":"Hijr","meaningUz":"Hijr vodiysi","revelationPlace":"makka","totalAyahs":99,"startPage":262,"createdAt":"2026-09-17T18:45:07.474Z","updatedAt":"2026-09-18T00:07:52.373Z"},"numberInSurah":42,"textArabic":"إِنَّ عِبَادِى لَيْسَ لَكَ عَلَيْهِمْ سُلْطَـٰنٌ إِلَّا مَنِ ٱتَّبَعَكَ مِنَ ٱلْغَاوِينَ","translationUz":"Albatta, Mening bandalarim ustida sening sultoning yo`qdir, magar senga ergashgan gumrohlargagina bordir.","transcription":null,"tafsirUz":null,"pageNumber":264,"juz":14,"createdAt":"2026-09-17T18:45:27.374Z","updatedAt":"2026-09-17T18:45:27.374Z"},{"id":1845,"surahId":15,"surah":{"id":15,"number":15,"nameArabic":"الحجر","nameUz":"Hijr","meaningUz":"Hijr vodiysi","revelationPlace":"makka","totalAyahs":99,"startPage":262,"createdAt":"2026-09-17T18:45:07.474Z","updatedAt":"2026-09-18T00:07:52.373Z"},"numberInSurah":43,"textArabic":"وَإِنَّ جَهَنَّمَ لَمَوْعِدُهُمْ أَجْمَعِينَ","translationUz":"Albatta, jahannam ularning barchasining va'da qilingan joyidir.","transcription":null,"tafsirUz":null,"pageNumber":264,"juz":14,"createdAt":"2026-09-17T18:45:27.378Z","updatedAt":"2026-09-17T18:45:27.378Z"},{"id":1846,"surahId":15,"surah":{"id":15,"number":15,"nameArabic":"الحجر","nameUz":"Hijr","meaningUz":"Hijr vodiysi","revelationPlace":"makka","totalAyahs":99,"startPage":262,"createdAt":"2026-09-17T18:45:07.474Z","updatedAt":"2026-09-18T00:07:52.373Z"},"numberInSurah":44,"textArabic":"لَهَا سَبْعَةُ أَبْوَٰبٍ لِّكُلِّ بَابٍ مِّنْهُمْ جُزْءٌ مَّقْسُومٌ","translationUz":"Uning yetti eshigi bordir. Har bir eshik uchun ulardan taqsimlangan bo`lagi bordir», dedi.","transcription":null,"tafsirUz":null,"pageNumber":264,"juz":14,"createdAt":"2026-09-17T18:45:27.383Z","updatedAt":"2026-09-17T18:45:27.383Z"},{"id":1847,"surahId":15,"surah":{"id":15,"number":15,"nameArabic":"الحجر","nameUz":"Hijr","meaningUz":"Hijr vodiysi","revelationPlace":"makka","totalAyahs":99,"startPage":262,"createdAt":"2026-09-17T18:45:07.474Z","updatedAt":"2026-09-18T00:07:52.373Z"},"numberInSurah":45,"textArabic":"إِنَّ ٱلْمُتَّقِينَ فِى جَنَّـٰتٍ وَعُيُونٍ","translationUz":"Albatta, taqvodorlar jannatlar va chashmalardadir.","transcription":null,"tafsirUz":null,"pageNumber":264,"juz":14,"createdAt":"2026-09-17T18:45:27.389Z","updatedAt":"2026-09-17T18:45:27.389Z"},{"id":1848,"surahId":15,"surah":{"id":15,"number":15,"nameArabic":"الحجر","nameUz":"Hijr","meaningUz":"Hijr vodiysi","revelationPlace":"makka","totalAyahs":99,"startPage":262,"createdAt":"2026-09-17T18:45:07.474Z","updatedAt":"2026-09-18T00:07:52.373Z"},"numberInSurah":46,"textArabic":"ٱدْخُلُوهَا بِسَلَـٰمٍ ءَامِنِينَ","translationUz":"Ularga tinchlik, omonlik ila kiringlar, (deyilur).","transcription":null,"tafsirUz":null,"pageNumber":264,"juz":14,"createdAt":"2026-09-17T18:45:27.394Z","updatedAt":"2026-09-17T18:45:27.394Z"},{"id":1849,"surahId":15,"surah":{"id":15,"number":15,"nameArabic":"الحجر","nameUz":"Hijr","meaningUz":"Hijr vodiysi","revelationPlace":"makka","totalAyahs":99,"startPage":262,"createdAt":"2026-09-17T18:45:07.474Z","updatedAt":"2026-09-18T00:07:52.373Z"},"numberInSurah":47,"textArabic":"وَنَزَعْنَا مَا فِى صُدُورِهِم مِّنْ غِلٍّ إِخْوَٰنًا عَلَىٰ سُرُرٍ مُّتَقَـٰبِلِينَ","translationUz":"Ularning dillaridagi g`illi-g`ishtlarni chiqarib tashladik. So`rilarda bir-birlariga boqib, do`st bo`lgan hollarida o`ltirurlar.","transcription":null,"tafsirUz":null,"pageNumber":264,"juz":14,"createdAt":"2026-09-17T18:45:27.398Z","updatedAt":"2026-09-17T18:45:27.398Z"},{"id":1850,"surahId":15,"surah":{"id":15,"number":15,"nameArabic":"الحجر","nameUz":"Hijr","meaningUz":"Hijr vodiysi","revelationPlace":"makka","totalAyahs":99,"startPage":262,"createdAt":"2026-09-17T18:45:07.474Z","updatedAt":"2026-09-18T00:07:52.373Z"},"numberInSurah":48,"textArabic":"لَا يَمَسُّهُمْ فِيهَا نَصَبٌ وَمَا هُم مِّنْهَا بِمُخْرَجِينَ","translationUz":"Ularni u joyda charchoq tutmas va ular undan chiqariluvchi ham emaslar.","transcription":null,"tafsirUz":null,"pageNumber":264,"juz":14,"createdAt":"2026-09-17T18:45:27.402Z","updatedAt":"2026-09-17T18:45:27.402Z"},{"id":1851,"surahId":15,"surah":{"id":15,"number":15,"nameArabic":"الحجر","nameUz":"Hijr","meaningUz":"Hijr vodiysi","revelationPlace":"makka","totalAyahs":99,"startPage":262,"createdAt":"2026-09-17T18:45:07.474Z","updatedAt":"2026-09-18T00:07:52.373Z"},"numberInSurah":49,"textArabic":"۞ نَبِّئْ عِبَادِىٓ أَنِّىٓ أَنَا ٱلْغَفُورُ ٱلرَّحِيمُ","translationUz":"Bandalarimga xabar bergil: «Albatta, Mening O`zim g`ofuru rohiymdirman».","transcription":null,"tafsirUz":null,"pageNumber":264,"juz":14,"createdAt":"2026-09-17T18:45:27.406Z","updatedAt":"2026-09-17T18:45:27.406Z"},{"id":1852,"surahId":15,"surah":{"id":15,"number":15,"nameArabic":"الحجر","nameUz":"Hijr","meaningUz":"Hijr vodiysi","revelationPlace":"makka","totalAyahs":99,"startPage":262,"createdAt":"2026-09-17T18:45:07.474Z","updatedAt":"2026-09-18T00:07:52.373Z"},"numberInSurah":50,"textArabic":"وَأَنَّ عَذَابِى هُوَ ٱلْعَذَابُ ٱلْأَلِيمُ","translationUz":"Va, albatta, azobim alamli azobdir.","transcription":null,"tafsirUz":null,"pageNumber":264,"juz":14,"createdAt":"2026-09-17T18:45:27.410Z","updatedAt":"2026-09-17T18:45:27.410Z"},{"id":1853,"surahId":15,"surah":{"id":15,"number":15,"nameArabic":"الحجر","nameUz":"Hijr","meaningUz":"Hijr vodiysi","revelationPlace":"makka","totalAyahs":99,"startPage":262,"createdAt":"2026-09-17T18:45:07.474Z","updatedAt":"2026-09-18T00:07:52.373Z"},"numberInSurah":51,"textArabic":"وَنَبِّئْهُمْ عَن ضَيْفِ إِبْرَٰهِيمَ","translationUz":"Ularga Ibrohimning mehmonlari xabarini ber.","transcription":null,"tafsirUz":null,"pageNumber":264,"juz":14,"createdAt":"2026-09-17T18:45:27.414Z","updatedAt":"2026-09-17T18:45:27.414Z"}]}