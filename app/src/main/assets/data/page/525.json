{"number":525,"textArabic":null,"translationUz":null,"juz":null,"note":null,"updatedAt":null,"ayahs":[{"id":4767,"surahId":52,"surah":{"id":52,"number":52,"nameArabic":"الطور","nameUz":"Tur","meaningUz":"Tur togʻi","revelationPlace":"makka","totalAyahs":49,"startPage":523,"createdAt":"2026-09-17T18:45:07.659Z","updatedAt":"2026-09-18T00:07:52.544Z"},"numberInSurah":32,"textArabic":"أَمْ تَأْمُرُهُمْ أَحْلَـٰمُهُم بِهَـٰذَآ ۚ أَمْ هُمْ قَوْمٌ طَاغُونَ","translationUz":"Yo aqllari shunga buyuradimi, yoki ular tug`yonga ketgan qavmlarmi?","transcription":null,"tafsirUz":null,"pageNumber":525,"juz":27,"createdAt":"2026-09-17T18:45:56.822Z","updatedAt":"2026-09-17T18:45:56.822Z"},{"id":4768,"surahId":52,"surah":{"id":52,"number":52,"nameArabic":"الطور","nameUz":"Tur","meaningUz":"Tur togʻi","revelationPlace":"makka","totalAyahs":49,"startPage":523,"createdAt":"2026-09-17T18:45:07.659Z","updatedAt":"2026-09-18T00:07:52.544Z"},"numberInSurah":33,"textArabic":"أَمْ يَقُولُونَ تَقَوَّلَهُۥ ۚ بَل لَّا يُؤْمِنُونَ","translationUz":"Balki, u(Qur'on)ni o`zi to`qidi, derlar? Yo`q, ular iymon keltirmaslar.","transcription":null,"tafsirUz":null,"pageNumber":525,"juz":27,"createdAt":"2026-09-17T18:45:56.826Z","updatedAt":"2026-09-17T18:45:56.826Z"},{"id":4769,"surahId":52,"surah":{"id":52,"number":52,"nameArabic":"الطور","nameUz":"Tur","meaningUz":"Tur togʻi","revelationPlace":"makka","totalAyahs":49,"startPage":523,"createdAt":"2026-09-17T18:45:07.659Z","updatedAt":"2026-09-18T00:07:52.544Z"},"numberInSurah":34,"textArabic":"فَلْيَأْتُوا۟ بِحَدِيثٍ مِّثْلِهِۦٓ إِن كَانُوا۟ صَـٰدِقِينَ","translationUz":"Agar ularning gapi rost bo`lsa, u(Qur'on)ga o`xshash so`zni keltirsinlar.","transcription":null,"tafsirUz":null,"pageNumber":525,"juz":27,"createdAt":"2026-09-17T18:45:56.831Z","updatedAt":"2026-09-17T18:45:56.831Z"},{"id":4770,"surahId":52,"surah":{"id":52,"number":52,"nameArabic":"الطور","nameUz":"Tur","meaningUz":"Tur togʻi","revelationPlace":"makka","totalAyahs":49,"startPage":523,"createdAt":"2026-09-17T18:45:07.659Z","updatedAt":"2026-09-18T00:07:52.544Z"},"numberInSurah":35,"textArabic":"أَمْ خُلِقُوا۟ مِنْ غَيْرِ شَىْءٍ أَمْ هُمُ ٱلْخَـٰلِقُونَ","translationUz":"Balki, ular, hech narsadan hech narsa yo`q, o`zlari yaralgandirlar?! Yoki ular yaratuvchilarmi?","transcription":null,"tafsirUz":null,"pageNumber":525,"juz":27,"createdAt":"2026-09-17T18:45:56.836Z","updatedAt":"2026-09-17T18:45:56.836Z"},{"id":4771,"surahId":52,"surah":{"id":52,"number":52,"nameArabic":"الطور","nameUz":"Tur","meaningUz":"Tur togʻi","revelationPlace":"makka","totalAyahs":49,"startPage":523,"createdAt":"2026-09-17T18:45:07.659Z","updatedAt":"2026-09-18T00:07:52.544Z"},"numberInSurah":36,"textArabic":"أَمْ خَلَقُوا۟ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضَ ۚ بَل لَّا يُوقِنُونَ","translationUz":"Balki, ular osmonlaru yerni yaratgandirlar?! Yo`q, ular ishonmaslar.","transcription":null,"tafsirUz":null,"pageNumber":525,"juz":27,"createdAt":"2026-09-17T18:45:56.840Z","updatedAt":"2026-09-17T18:45:56.840Z"},{"id":4772,"surahId":52,"surah":{"id":52,"number":52,"nameArabic":"الطور","nameUz":"Tur","meaningUz":"Tur togʻi","revelationPlace":"makka","totalAyahs":49,"startPage":523,"createdAt":"2026-09-17T18:45:07.659Z","updatedAt":"2026-09-18T00:07:52.544Z"},"numberInSurah":37,"textArabic":"أَمْ عِندَهُمْ خَزَآئِنُ رَبِّكَ أَمْ هُمُ ٱلْمُصَۣيْطِرُونَ","translationUz":"Balki, ularning huzurida Robbingning xaziynalari bordir?! Yoki ular boshqaruvchilarmi?","transcription":null,"tafsirUz":null,"pageNumber":525,"juz":27,"createdAt":"2026-09-17T18:45:56.844Z","updatedAt":"2026-09-17T18:45:56.844Z"},{"id":4773,"surahId":52,"surah":{"id":52,"number":52,"nameArabic":"الطور","nameUz":"Tur","meaningUz":"Tur togʻi","revelationPlace":"makka","totalAyahs":49,"startPage":523,"createdAt":"2026-09-17T18:45:07.659Z","updatedAt":"2026-09-18T00:07:52.544Z"},"numberInSurah":38,"textArabic":"أَمْ لَهُمْ سُلَّمٌ يَسْتَمِعُونَ فِيهِ ۖ فَلْيَأْتِ مُسْتَمِعُهُم بِسُلْطَـٰنٍ مُّبِينٍ","translationUz":"Balki, ularning (xabarni) eshitadigan narvonlari bordir?! Undoq bo`lsa, eshituvchilari ravshan hujjat keltirsin.","transcription":null,"tafsirUz":null,"pageNumber":525,"juz":27,"createdAt":"2026-09-17T18:45:56.848Z","updatedAt":"2026-09-17T18:45:56.848Z"},{"id":4774,"surahId":52,"surah":{"id":52,"number":52,"nameArabic":"الطور","nameUz":"Tur","meaningUz":"Tur togʻi","revelationPlace":"makka","totalAyahs":49,"startPage":523,"createdAt":"2026-09-17T18:45:07.659Z","updatedAt":"2026-09-18T00:07:52.544Z"},"numberInSurah":39,"textArabic":"أَمْ لَهُ ٱلْبَنَـٰتُ وَلَكُمُ ٱلْبَنُونَ","translationUz":"Yoki U zotga qizlar-u, sizlarga o`g`illarmi?","transcription":null,"tafsirUz":null,"pageNumber":525,"juz":27,"createdAt":"2026-09-17T18:45:56.852Z","updatedAt":"2026-09-17T18:45:56.852Z"},{"id":4775,"surahId":52,"surah":{"id":52,"number":52,"nameArabic":"الطور","nameUz":"Tur","meaningUz":"Tur togʻi","revelationPlace":"makka","totalAyahs":49,"startPage":523,"createdAt":"2026-09-17T18:45:07.659Z","updatedAt":"2026-09-18T00:07:52.544Z"},"numberInSurah":40,"textArabic":"أَمْ تَسْـَٔلُهُمْ أَجْرًا فَهُم مِّن مَّغْرَمٍ مُّثْقَلُونَ","translationUz":"Yoki sen ulardan haq so`rayapsan-u, ular to`lovdan qiynalayaptilarmi?","transcription":null,"tafsirUz":null,"pageNumber":525,"juz":27,"createdAt":"2026-09-17T18:45:56.856Z","updatedAt":"2026-09-17T18:45:56.856Z"},{"id":4776,"surahId":52,"surah":{"id":52,"number":52,"nameArabic":"الطور","nameUz":"Tur","meaningUz":"Tur togʻi","revelationPlace":"makka","totalAyahs":49,"startPage":523,"createdAt":"2026-09-17T18:45:07.659Z","updatedAt":"2026-09-18T00:07:52.544Z"},"numberInSurah":41,"textArabic":"أَمْ عِندَهُمُ ٱلْغَيْبُ فَهُمْ يَكْتُبُونَ","translationUz":"Balki, ularning ixtiyorida g`ayb (ilmi) bo`lib, ular yozib olayotgandirlar?!","transcription":null,"tafsirUz":null,"pageNumber":525,"juz":27,"createdAt":"2026-09-17T18:45:56.861Z","updatedAt":"2026-09-17T18:45:56.861Z"},{"id":4777,"surahId":52,"surah":{"id":52,"number":52,"nameArabic":"الطور","nameUz":"Tur","meaningUz":"Tur togʻi","revelationPlace":"makka","totalAyahs":49,"startPage":523,"createdAt":"2026-09-17T18:45:07.659Z","updatedAt":"2026-09-18T00:07:52.544Z"},"numberInSurah":42,"textArabic":"أَمْ يُرِيدُونَ كَيْدًا ۖ فَٱلَّذِينَ كَفَرُوا۟ هُمُ ٱلْمَكِيدُونَ","translationUz":"Balki, hiyla ko`rsatishni xohlarlar?! Bas, kofirlar hiylalarining jazosini tortarlar.","transcription":null,"tafsirUz":null,"pageNumber":525,"juz":27,"createdAt":"2026-09-17T18:45:56.865Z","updatedAt":"2026-09-17T18:45:56.865Z"},{"id":4778,"surahId":52,"surah":{"id":52,"number":52,"nameArabic":"الطور","nameUz":"Tur","meaningUz":"Tur togʻi","revelationPlace":"makka","totalAyahs":49,"startPage":523,"createdAt":"2026-09-17T18:45:07.659Z","updatedAt":"2026-09-18T00:07:52.544Z"},"numberInSurah":43,"textArabic":"أَمْ لَهُمْ إِلَـٰهٌ غَيْرُ ٱللَّهِ ۚ سُبْحَـٰنَ ٱللَّهِ عَمَّا يُشْرِكُونَ","translationUz":"Balki, ularning Allohdan boshqa xudolari bordir?! Alloh ular keltirayotgan shirkdan pok bo`ldi.","transcription":null,"tafsirUz":null,"pageNumber":525,"juz":27,"createdAt":"2026-09-17T18:45:56.869Z","updatedAt":"2026-09-17T18:45:56.869Z"},{"id":4779,"surahId":52,"surah":{"id":52,"number":52,"nameArabic":"الطور","nameUz":"Tur","meaningUz":"Tur togʻi","revelationPlace":"makka","totalAyahs":49,"startPage":523,"createdAt":"2026-09-17T18:45:07.659Z","updatedAt":"2026-09-18T00:07:52.544Z"},"numberInSurah":44,"textArabic":"وَإِن يَرَوْا۟ كِسْفًا مِّنَ ٱلسَّمَآءِ سَاقِطًا يَقُولُوا۟ سَحَابٌ مَّرْكُومٌ","translationUz":"Agar ular boshlariga tushayotgan parchani ko`rsalar ham, to`plangan bulut, derlar.","transcription":null,"tafsirUz":null,"pageNumber":525,"juz":27,"createdAt":"2026-09-17T18:45:56.873Z","updatedAt":"2026-09-17T18:45:56.873Z"},{"id":4780,"surahId":52,"surah":{"id":52,"number":52,"nameArabic":"الطور","nameUz":"Tur","meaningUz":"Tur togʻi","revelationPlace":"makka","totalAyahs":49,"startPage":523,"createdAt":"2026-09-17T18:45:07.659Z","updatedAt":"2026-09-18T00:07:52.544Z"},"numberInSurah":45,"textArabic":"فَذَرْهُمْ حَتَّىٰ يُلَـٰقُوا۟ يَوْمَهُمُ ٱلَّذِى فِيهِ يُصْعَقُونَ","translationUz":"Ularni halokatga uchraydigan kunlariga yo`liqqunlarigacha tek qo`y.","transcription":null,"tafsirUz":null,"pageNumber":525,"juz":27,"createdAt":"2026-09-17T18:45:56.877Z","updatedAt":"2026-09-17T18:45:56.877Z"},{"id":4781,"surahId":52,"surah":{"id":52,"number":52,"nameArabic":"الطور","nameUz":"Tur","meaningUz":"Tur togʻi","revelationPlace":"makka","totalAyahs":49,"startPage":523,"createdAt":"2026-09-17T18:45:07.659Z","updatedAt":"2026-09-18T00:07:52.544Z"},"numberInSurah":46,"textArabic":"يَوْمَ لَا يُغْنِى عَنْهُمْ كَيْدُهُمْ شَيْـًٔا وَلَا هُمْ يُنصَرُونَ","translationUz":"U kunda hiylalari ularga hech qanday foyda bermas va ularga yordam ham berilmas.","transcription":null,"tafsirUz":null,"pageNumber":525,"juz":27,"createdAt":"2026-09-17T18:45:56.881Z","updatedAt":"2026-09-17T18:45:56.881Z"},{"id":4782,"surahId":52,"surah":{"id":52,"number":52,"nameArabic":"الطور","nameUz":"Tur","meaningUz":"Tur togʻi","revelationPlace":"makka","totalAyahs":49,"startPage":523,"createdAt":"2026-09-17T18:45:07.659Z","updatedAt":"2026-09-18T00:07:52.544Z"},"numberInSurah":47,"textArabic":"وَإِنَّ لِلَّذِينَ ظَلَمُوا۟ عَذَابًا دُونَ ذَٰلِكَ وَلَـٰكِنَّ أَكْثَرَهُمْ لَا يَعْلَمُونَ","translationUz":"Va, albatta, zulm qilganlarga undan o`zga azob ham bor, lekin ko`plari bilmaslar.","transcription":null,"tafsirUz":null,"pageNumber":525,"juz":27,"createdAt":"2026-09-17T18:45:56.886Z","updatedAt":"2026-09-17T18:45:56.886Z"},{"id":4783,"surahId":52,"surah":{"id":52,"number":52,"nameArabic":"الطور","nameUz":"Tur","meaningUz":"Tur togʻi","revelationPlace":"makka","totalAyahs":49,"startPage":523,"createdAt":"2026-09-17T18:45:07.659Z","updatedAt":"2026-09-18T00:07:52.544Z"},"numberInSurah":48,"textArabic":"وَٱصْبِرْ لِحُكْمِ رَبِّكَ فَإِنَّكَ بِأَعْيُنِنَا ۖ وَسَبِّحْ بِحَمْدِ رَبِّكَ حِينَ تَقُومُ","translationUz":"Bas, Robbing hukmiga sabr qil. Albatta, sen ko`z o`ngimizdasan, o`rningdan turganingda Robbingga tasbih ayt!","transcription":null,"tafsirUz":null,"pageNumber":525,"juz":27,"createdAt":"2026-09-17T18:45:56.890Z","updatedAt":"2026-09-17T18:45:56.890Z"},{"id":4784,"surahId":52,"surah":{"id":52,"number":52,"nameArabic":"الطور","nameUz":"Tur","meaningUz":"Tur togʻi","revelationPlace":"makka","totalAyahs":49,"startPage":523,"createdAt":"2026-09-17T18:45:07.659Z","updatedAt":"2026-09-18T00:07:52.544Z"},"numberInSurah":49,"textArabic":"وَمِنَ ٱلَّيْلِ فَسَبِّحْهُ وَإِدْبَـٰرَ ٱلنُّجُومِ","translationUz":"Va kechasi ham. Bas, yulduzlar botgandan keyin ham tasbih ayt.","transcription":null,"tafsirUz":null,"pageNumber":525,"juz":27,"createdAt":"2026-09-17T18:45:56.894Z","updatedAt":"2026-09-17T18:45:56.894Z"}]}