{"number":262,"textArabic":null,"translationUz":null,"juz":null,"note":null,"updatedAt":null,"ayahs":[{"id":1803,"surahId":15,"surah":{"id":15,"number":15,"nameArabic":"الحجر","nameUz":"Hijr","meaningUz":"Hijr vodiysi","revelationPlace":"makka","totalAyahs":99,"startPage":262,"createdAt":"2026-09-17T18:45:07.474Z","updatedAt":"2026-09-18T00:07:52.373Z"},"numberInSurah":1,"textArabic":" الٓر ۚ تِلْكَ ءَايَـٰتُ ٱلْكِتَـٰبِ وَقُرْءَانٍ مُّبِينٍ","translationUz":"Alif. Laam. Ro. Ushbular kitobning va ravshan Qur'onning oyatlaridir.","transcription":null,"tafsirUz":null,"pageNumber":262,"juz":14,"createdAt":"2026-09-17T18:45:27.193Z","updatedAt":"2026-09-17T18:45:27.193Z"},{"id":1804,"surahId":15,"surah":{"id":15,"number":15,"nameArabic":"الحجر","nameUz":"Hijr","meaningUz":"Hijr vodiysi","revelationPlace":"makka","totalAyahs":99,"startPage":262,"createdAt":"2026-09-17T18:45:07.474Z","updatedAt":"2026-09-18T00:07:52.373Z"},"numberInSurah":2,"textArabic":"رُّبَمَا يَوَدُّ ٱلَّذِينَ كَفَرُوا۟ لَوْ كَانُوا۟ مُسْلِمِينَ","translationUz":"Hali, kufr keltirganlar musulmon bo`lishni ham istab qolurlar.","transcription":null,"tafsirUz":null,"pageNumber":262,"juz":14,"createdAt":"2026-09-17T18:45:27.197Z","updatedAt":"2026-09-17T18:45:27.197Z"},{"id":1805,"surahId":15,"surah":{"id":15,"number":15,"nameArabic":"الحجر","nameUz":"Hijr","meaningUz":"Hijr vodiysi","revelationPlace":"makka","totalAyahs":99,"startPage":262,"createdAt":"2026-09-17T18:45:07.474Z","updatedAt":"2026-09-18T00:07:52.373Z"},"numberInSurah":3,"textArabic":"ذَرْهُمْ يَأْكُلُوا۟ وَيَتَمَتَّعُوا۟ وَيُلْهِهِمُ ٱلْأَمَلُ ۖ فَسَوْفَ يَعْلَمُونَ","translationUz":"Ularni tek qo`y, yeb-ichib, huzurlanib, umidlar ila mashg`ul bo`lib yuraversinlar. Bas, tezda bilurlar.","transcription":null,"tafsirUz":null,"pageNumber":262,"juz":14,"createdAt":"2026-09-17T18:45:27.202Z","updatedAt":"2026-09-17T18:45:27.202Z"},{"id":1806,"surahId":15,"surah":{"id":15,"number":15,"nameArabic":"الحجر","nameUz":"Hijr","meaningUz":"Hijr vodiysi","revelationPlace":"makka","totalAyahs":99,"startPage":262,"createdAt":"2026-09-17T18:45:07.474Z","updatedAt":"2026-09-18T00:07:52.373Z"},"numberInSurah":4,"textArabic":"وَمَآ أَهْلَكْنَا مِن قَرْيَةٍ إِلَّا وَلَهَا كِتَابٌ مَّعْلُومٌ","translationUz":"Biz ma'lum bitiksiz hech bir shaharni halok etganimiz yo`q.","transcription":null,"tafsirUz":null,"pageNumber":262,"juz":14,"createdAt":"2026-09-17T18:45:27.206Z","updatedAt":"2026-09-17T18:45:27.206Z"},{"id":1807,"surahId":15,"surah":{"id":15,"number":15,"nameArabic":"الحجر","nameUz":"Hijr","meaningUz":"Hijr vodiysi","revelationPlace":"makka","totalAyahs":99,"startPage":262,"createdAt":"2026-09-17T18:45:07.474Z","updatedAt":"2026-09-18T00:07:52.373Z"},"numberInSurah":5,"textArabic":"مَّا تَسْبِقُ مِنْ أُمَّةٍ أَجَلَهَا وَمَا يَسْتَـْٔخِرُونَ","translationUz":"Hech bir ummat o`z ajalidan o`zib keta olmas va ortda ham qola olmas.","transcription":null,"tafsirUz":null,"pageNumber":262,"juz":14,"createdAt":"2026-09-17T18:45:27.210Z","updatedAt":"2026-09-17T18:45:27.210Z"},{"id":1808,"surahId":15,"surah":{"id":15,"number":15,"nameArabic":"الحجر","nameUz":"Hijr","meaningUz":"Hijr vodiysi","revelationPlace":"makka","totalAyahs":99,"startPage":262,"createdAt":"2026-09-17T18:45:07.474Z","updatedAt":"2026-09-18T00:07:52.373Z"},"numberInSurah":6,"textArabic":"وَقَالُوا۟ يَـٰٓأَيُّهَا ٱلَّذِى نُزِّلَ عَلَيْهِ ٱلذِّكْرُ إِنَّكَ لَمَجْنُونٌ","translationUz":"Ular: «Ey, zikr nozil qilingan kishi, albatta, sen majnunsan.","transcription":null,"tafsirUz":null,"pageNumber":262,"juz":14,"createdAt":"2026-09-17T18:45:27.214Z","updatedAt":"2026-09-17T18:45:27.214Z"},{"id":1809,"surahId":15,"surah":{"id":15,"number":15,"nameArabic":"الحجر","nameUz":"Hijr","meaningUz":"Hijr vodiysi","revelationPlace":"makka","totalAyahs":99,"startPage":262,"createdAt":"2026-09-17T18:45:07.474Z","updatedAt":"2026-09-18T00:07:52.373Z"},"numberInSurah":7,"textArabic":"لَّوْ مَا تَأْتِينَا بِٱلْمَلَـٰٓئِكَةِ إِن كُنتَ مِنَ ٱلصَّـٰدِقِينَ","translationUz":"Agar rostgo`ylardan bo`lsang, bizga farishtalarni keltirsang-chi!» derlar.","transcription":null,"tafsirUz":null,"pageNumber":262,"juz":14,"createdAt":"2026-09-17T18:45:27.218Z","updatedAt":"2026-09-17T18:45:27.218Z"},{"id":1810,"surahId":15,"surah":{"id":15,"number":15,"nameArabic":"الحجر","nameUz":"Hijr","meaningUz":"Hijr vodiysi","revelationPlace":"makka","totalAyahs":99,"startPage":262,"createdAt":"2026-09-17T18:45:07.474Z","updatedAt":"2026-09-18T00:07:52.373Z"},"numberInSurah":8,"textArabic":"مَا نُنَزِّلُ ٱلْمَلَـٰٓئِكَةَ إِلَّا بِٱلْحَقِّ وَمَا كَانُوٓا۟ إِذًا مُّنظَرِينَ","translationUz":"Biz farishtalarni faqat haq ila tushiramiz, xolos. U holda ularga qarab turilmas.","transcription":null,"tafsirUz":null,"pageNumber":262,"juz":14,"createdAt":"2026-09-17T18:45:27.223Z","updatedAt":"2026-09-17T18:45:27.223Z"},{"id":1811,"surahId":15,"surah":{"id":15,"number":15,"nameArabic":"الحجر","nameUz":"Hijr","meaningUz":"Hijr vodiysi","revelationPlace":"makka","totalAyahs":99,"startPage":262,"createdAt":"2026-09-17T18:45:07.474Z","updatedAt":"2026-09-18T00:07:52.373Z"},"numberInSurah":9,"textArabic":"إِنَّا نَحْنُ نَزَّلْنَا ٱلذِّكْرَ وَإِنَّا لَهُۥ لَحَـٰفِظُونَ","translationUz":"Albatta, Zikrni Biz nozil qildik va, albatta, uni Biz muhofaza qilurmiz.","transcription":null,"tafsirUz":null,"pageNumber":262,"juz":14,"createdAt":"2026-09-17T18:45:27.229Z","updatedAt":"2026-09-17T18:45:27.229Z"},{"id":1812,"surahId":15,"surah":{"id":15,"number":15,"nameArabic":"الحجر","nameUz":"Hijr","meaningUz":"Hijr vodiysi","revelationPlace":"makka","totalAyahs":99,"startPage":262,"createdAt":"2026-09-17T18:45:07.474Z","updatedAt":"2026-09-18T00:07:52.373Z"},"numberInSurah":10,"textArabic":"وَلَقَدْ أَرْسَلْنَا مِن قَبْلِكَ فِى شِيَعِ ٱلْأَوَّلِينَ","translationUz":"Batahqiq, sendan oldin ham avvalgilar guruhlariga (Payg`ambar) yuborganmiz.","transcription":null,"tafsirUz":null,"pageNumber":262,"juz":14,"createdAt":"2026-09-17T18:45:27.233Z","updatedAt":"2026-09-17T18:45:27.233Z"},{"id":1813,"surahId":15,"surah":{"id":15,"number":15,"nameArabic":"الحجر","nameUz":"Hijr","meaningUz":"Hijr vodiysi","revelationPlace":"makka","totalAyahs":99,"startPage":262,"createdAt":"2026-09-17T18:45:07.474Z","updatedAt":"2026-09-18T00:07:52.373Z"},"numberInSurah":11,"textArabic":"وَمَا يَأْتِيهِم مِّن رَّسُولٍ إِلَّا كَانُوا۟ بِهِۦ يَسْتَهْزِءُونَ","translationUz":"Ularga qaysi bir Payg`ambar kelsa, uni masxara qilmasdan qo`ymas edilar.","transcription":null,"tafsirUz":null,"pageNumber":262,"juz":14,"createdAt":"2026-09-17T18:45:27.237Z","updatedAt":"2026-09-17T18:45:27.237Z"},{"id":1814,"surahId":15,"surah":{"id":15,"number":15,"nameArabic":"الحجر","nameUz":"Hijr","meaningUz":"Hijr vodiysi","revelationPlace":"makka","totalAyahs":99,"startPage":262,"createdAt":"2026-09-17T18:45:07.474Z","updatedAt":"2026-09-18T00:07:52.373Z"},"numberInSurah":12,"textArabic":"كَذَٰلِكَ نَسْلُكُهُۥ فِى قُلُوبِ ٱلْمُجْرِمِينَ","translationUz":"Shunga o`xshash, Biz uni jinoyatchilar qalbiga solamiz.","transcription":null,"tafsirUz":null,"pageNumber":262,"juz":14,"createdAt":"2026-09-17T18:45:27.242Z","updatedAt":"2026-09-17T18:45:27.242Z"},{"id":1815,"surahId":15,"surah":{"id":15,"number":15,"nameArabic":"الحجر","nameUz":"Hijr","meaningUz":"Hijr vodiysi","revelationPlace":"makka","totalAyahs":99,"startPage":262,"createdAt":"2026-09-17T18:45:07.474Z","updatedAt":"2026-09-18T00:07:52.373Z"},"numberInSurah":13,"textArabic":"لَا يُؤْمِنُونَ بِهِۦ ۖ وَقَدْ خَلَتْ سُنَّةُ ٱلْأَوَّلِينَ","translationUz":"U(Qur'on)ga iymon keltirmaslar. Batahqiq, avvalgilarning sunnati — odati shundoq o`tgandir.","transcription":null,"tafsirUz":null,"pageNumber":262,"juz":14,"createdAt":"2026-09-17T18:45:27.246Z","updatedAt":"2026-09-17T18:45:27.246Z"},{"id":1816,"surahId":15,"surah":{"id":15,"number":15,"nameArabic":"الحجر","nameUz":"Hijr","meaningUz":"Hijr vodiysi","revelationPlace":"makka","totalAyahs":99,"startPage":262,"createdAt":"2026-09-17T18:45:07.474Z","updatedAt":"2026-09-18T00:07:52.373Z"},"numberInSurah":14,"textArabic":"وَلَوْ فَتَحْنَا عَلَيْهِم بَابًا مِّنَ ٱلسَّمَآءِ فَظَلُّوا۟ فِيهِ يَعْرُجُونَ","translationUz":"Agar ularga osmondan bir eshik ochsag-u, undan chiqib tursalar ham.","transcription":null,"tafsirUz":null,"pageNumber":262,"juz":14,"createdAt":"2026-09-17T18:45:27.249Z","updatedAt":"2026-09-17T18:45:27.249Z"},{"id":1817,"surahId":15,"surah":{"id":15,"number":15,"nameArabic":"الحجر","nameUz":"Hijr","meaningUz":"Hijr vodiysi","revelationPlace":"makka","totalAyahs":99,"startPage":262,"createdAt":"2026-09-17T18:45:07.474Z","updatedAt":"2026-09-18T00:07:52.373Z"},"numberInSurah":15,"textArabic":"لَقَالُوٓا۟ إِنَّمَا سُكِّرَتْ أَبْصَـٰرُنَا بَلْ نَحْنُ قَوْمٌ مَّسْحُورُونَ","translationUz":"Ular: «Albatta, ko`zlarimiz bog`landi, balki biz sehrlangan qavmdirmiz», derlar.","transcription":null,"tafsirUz":null,"pageNumber":262,"juz":14,"createdAt":"2026-09-17T18:45:27.253Z","updatedAt":"2026-09-17T18:45:27.253Z"}]}