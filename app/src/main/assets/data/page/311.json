{"number":311,"textArabic":null,"translationUz":null,"juz":null,"note":null,"updatedAt":null,"ayahs":[{"id":2327,"surahId":19,"surah":{"id":19,"number":19,"nameArabic":"مريم","nameUz":"Maryam","meaningUz":"Maryam","revelationPlace":"makka","totalAyahs":98,"startPage":305,"createdAt":"2026-09-17T18:45:07.494Z","updatedAt":"2026-09-18T00:07:52.394Z"},"numberInSurah":77,"textArabic":"أَفَرَءَيْتَ ٱلَّذِى كَفَرَ بِـَٔايَـٰتِنَا وَقَالَ لَأُوتَيَنَّ مَالًا وَوَلَدًا","translationUz":"Oyatlarimizga kufr keltirgan va: «Albatta, (oxiratda) menga molu dunyo hamda bola-chaqa berilajak», deganni ko`rdingmi?!","transcription":null,"tafsirUz":null,"pageNumber":311,"juz":16,"createdAt":"2026-09-17T18:45:32.324Z","updatedAt":"2026-09-17T18:45:32.324Z"},{"id":2328,"surahId":19,"surah":{"id":19,"number":19,"nameArabic":"مريم","nameUz":"Maryam","meaningUz":"Maryam","revelationPlace":"makka","totalAyahs":98,"startPage":305,"createdAt":"2026-09-17T18:45:07.494Z","updatedAt":"2026-09-18T00:07:52.394Z"},"numberInSurah":78,"textArabic":"أَطَّلَعَ ٱلْغَيْبَ أَمِ ٱتَّخَذَ عِندَ ٱلرَّحْمَـٰنِ عَهْدًا","translationUz":"U g`oyibni bilarmikan yoki Rohmanning huzuridan ahdu paymon oldimikan?!","transcription":null,"tafsirUz":null,"pageNumber":311,"juz":16,"createdAt":"2026-09-17T18:45:32.328Z","updatedAt":"2026-09-17T18:45:32.328Z"},{"id":2329,"surahId":19,"surah":{"id":19,"number":19,"nameArabic":"مريم","nameUz":"Maryam","meaningUz":"Maryam","revelationPlace":"makka","totalAyahs":98,"startPage":305,"createdAt":"2026-09-17T18:45:07.494Z","updatedAt":"2026-09-18T00:07:52.394Z"},"numberInSurah":79,"textArabic":"كَلَّا ۚ سَنَكْتُبُ مَا يَقُولُ وَنَمُدُّ لَهُۥ مِنَ ٱلْعَذَابِ مَدًّا","translationUz":"Yo`q! Nima deganini albatta yozib qo`yamiz va unga azobni uzundan-uzoq qilamiz.","transcription":null,"tafsirUz":null,"pageNumber":311,"juz":16,"createdAt":"2026-09-17T18:45:32.332Z","updatedAt":"2026-09-17T18:45:32.332Z"},{"id":2330,"surahId":19,"surah":{"id":19,"number":19,"nameArabic":"مريم","nameUz":"Maryam","meaningUz":"Maryam","revelationPlace":"makka","totalAyahs":98,"startPage":305,"createdAt":"2026-09-17T18:45:07.494Z","updatedAt":"2026-09-18T00:07:52.394Z"},"numberInSurah":80,"textArabic":"وَنَرِثُهُۥ مَا يَقُولُ وَيَأْتِينَا فَرْدًا","translationUz":"U aytayotgan narsaga merosxo`r bo`lurmiz va u Bizga yolg`iz holida kelur.","transcription":null,"tafsirUz":null,"pageNumber":311,"juz":16,"createdAt":"2026-09-17T18:45:32.336Z","updatedAt":"2026-09-17T18:45:32.336Z"},{"id":2331,"surahId":19,"surah":{"id":19,"number":19,"nameArabic":"مريم","nameUz":"Maryam","meaningUz":"Maryam","revelationPlace":"makka","totalAyahs":98,"startPage":305,"createdAt":"2026-09-17T18:45:07.494Z","updatedAt":"2026-09-18T00:07:52.394Z"},"numberInSurah":81,"textArabic":"وَٱتَّخَذُوا۟ مِن دُونِ ٱللَّهِ ءَالِهَةً لِّيَكُونُوا۟ لَهُمْ عِزًّا","translationUz":"Ular o`zlariga kuch-qudrat, izzat bo`lishi uchun Allohdan o`zgalarni «xudo» qilib oldilar.","transcription":null,"tafsirUz":null,"pageNumber":311,"juz":16,"createdAt":"2026-09-17T18:45:32.340Z","updatedAt":"2026-09-17T18:45:32.340Z"},{"id":2332,"surahId":19,"surah":{"id":19,"number":19,"nameArabic":"مريم","nameUz":"Maryam","meaningUz":"Maryam","revelationPlace":"makka","totalAyahs":98,"startPage":305,"createdAt":"2026-09-17T18:45:07.494Z","updatedAt":"2026-09-18T00:07:52.394Z"},"numberInSurah":82,"textArabic":"كَلَّا ۚ سَيَكْفُرُونَ بِعِبَادَتِهِمْ وَيَكُونُونَ عَلَيْهِمْ ضِدًّا","translationUz":"Yo`q! U(«xudo»)lar ularning ibodatlarini inkor eturlar va ularga zid bo`lurlar.","transcription":null,"tafsirUz":null,"pageNumber":311,"juz":16,"createdAt":"2026-09-17T18:45:32.343Z","updatedAt":"2026-09-17T18:45:32.343Z"},{"id":2333,"surahId":19,"surah":{"id":19,"number":19,"nameArabic":"مريم","nameUz":"Maryam","meaningUz":"Maryam","revelationPlace":"makka","totalAyahs":98,"startPage":305,"createdAt":"2026-09-17T18:45:07.494Z","updatedAt":"2026-09-18T00:07:52.394Z"},"numberInSurah":83,"textArabic":"أَلَمْ تَرَ أَنَّآ أَرْسَلْنَا ٱلشَّيَـ