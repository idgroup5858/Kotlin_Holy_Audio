ahId":19,"surah":{"id":19,"number":19,"nameArabic":"مريم","nameUz":"Maryam","meaningUz":"Maryam","revelationPlace":"makka","totalAyahs":98,"startPage":305,"createdAt":"2026-09-17T18:45:07.494Z","updatedAt":"2026-09-18T00:07:52.394Z"},"numberInSurah":87,"textArabic":"لَّا يَمْلِكُونَ ٱلشَّفَـٰعَةَ إِلَّا مَنِ ٱتَّخَذَ عِندَ ٱلرَّحْمَـٰنِ عَهْدًا","translationUz":"Ular shafoatga molik bo`lmaslar. Magar kim Rohman huzurida ahdu paymon olgan bo`lsa (molik bo`lar).","transcription":null,"tafsirUz":null,"pageNumber":311,"juz":16,"createdAt":"2026-09-17T18:45:32.365Z","updatedAt":"2026-09-17T18:45:32.365Z"},{"id":2338,"surahId":19,"surah":{"id":19,"number":19,"nameArabic":"مريم","nameUz":"Maryam","meaningUz":"Maryam","revelationPlace":"makka","totalAyahs":98,"startPage":305,"createdAt":"2026-09-17T18:45:07.494Z","updatedAt":"2026-09-18T00:07:52.394Z"},"numberInSurah":88,"textArabic":"وَقَالُوا۟ ٱتَّخَذَ ٱلرَّحْمَـٰنُ وَلَدًا","translationUz":"Ular: «Rohman bola tutdi», dedilar.","transcription":null,"tafsirUz":null,"pageNumber":311,"juz":16,"createdAt":"2026-09-17T18:45:32.368Z","updatedAt":"2026-09-17T18:45:32.368Z"},{"id":2339,"surahId":19,"surah":{"id":19,"number":19,"nameArabic":"مريم","nameUz":"Maryam","meaningUz":"Maryam","revelationPlace":"makka","totalAyahs":98,"startPage":305,"createdAt":"2026-09-17T18:45:07.494Z","updatedAt":"2026-09-18T00:07:52.394Z"},"numberInSurah":89,"textArabic":"لَّقَدْ جِئْتُمْ شَيْـًٔا إِدًّا","translationUz":"Batahqiq, juda og`ir narsa keltirdingiz.","transcription":null,"tafsirUz":null,"pageNumber":311,"juz":16,"createdAt":"2026-09-17T18:45:32.372Z","updatedAt":"2026-09-17T18:45:32.372Z"},{"id":2340,"surahId":19,"surah":{"id":19,"number":19,"nameArabic":"مريم","nameUz":"Maryam","meaningUz":"Maryam","revelationPlace":"makka","totalAyahs":98,"startPage":305,"createdAt":"2026-09-17T18:45:07.494Z","updatedAt":"2026-09-18T00:07:52.394Z"},"numberInSurah":90,"textArabic":"تَكَادُ ٱلسَّمَـٰوَٰتُ يَتَفَطَّرْنَ مِنْهُ وَتَنشَقُّ ٱلْأَرْضُ وَتَخِرُّ ٱلْجِبَالُ هَدًّا","translationUz":"Undan osmonlar parchalanib, yer yorilib, tog`lar qulab yiqilay deydi.","transcription":null,"tafsirUz":null,"pageNumber":311,"juz":16,"createdAt":"2026-09-17T18:45:32.376Z","updatedAt":"2026-09-17T18:45:32.376Z"},{"id":2341,"surahId":19,"surah":{"id":19,"number":19,"nameArabic":"مريم","nameUz":"Maryam","meaningUz":"Maryam","revelationPlace":"makka","totalAyahs":98,"startPage":305,"createdAt":"2026-09-17T18:45:07.494Z","updatedAt":"2026-09-18T00:07:52.394Z"},"numberInSurah":91,"textArabic":"أَن دَعَوْا۟ لِلرَّحْمَـٰنِ وَلَدًا","translationUz":"Rohmanning bolasi bor, deganlariga.","transcription":null,"tafsirUz":null,"pageNumber":311,"juz":16,"createdAt":"2026-09-17T18:45:32.381Z","updatedAt":"2026-09-17T18:45:32.381Z"},{"id":2342,"surahId":19,"surah":{"id":19,"number":19,"nameArabic":"مريم","nameUz":"Maryam","meaningUz":"Maryam","revelationPlace":"makka","totalAyahs":98,"startPage":305,"createdAt":"2026-09-17T18:45:07.494Z","updatedAt":"2026-09-18T00:07:52.394Z"},"numberInSurah":92,"textArabic":"وَمَا يَنۢبَغِى لِلرَّحْمَـٰنِ أَن يَتَّخِذَ وَلَدًا","translationUz":"Rohmanga bola tutish loyiq emasdir.","transcription":null,"tafsirUz":null,"pageNumber":311,"juz":16,"createdAt":"2026-09-17T18:45:32.385Z","updatedAt":"2026-09-17T18:45:32.385Z"},{"id":2343,"surahId":19,"surah":{"id":19,"number":19,"nameArabic":"مريم","nameUz":"Maryam","meaningUz":"Maryam","revelationPlace":"makka","totalAyahs":98,"startPage":305,"createdAt":"2026-09-17T18:45:07.494Z","updatedAt":"2026-09-18T00:07:52.394Z"},"numberInSurah":93,"textArabic":"إِن كُلُّ مَن فِى ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ إِلَّآ ءَاتِى ٱلرَّحْمَـٰنِ عَبْدًا","translationUz":"Osmonlaru yerdagi barcha kimsalar Rohmanga banda bo`lgan hollarida kelurlar.","transcription":null,"tafsirUz":null,"pageNumber":311,"juz":16,"createdAt":"2026-09-17T18:45:32.389Z","updatedAt":"2026-09-17T18:45:32.389Z"},{"id":2344,"surahId":19,"surah":{"id":19,"number":19,"nameArabic":"مريم","nameUz":"Maryam","meaningUz":"Maryam","revelationPlace":"makka","totalAyahs":98,"startPage":305,"createdAt":"2026-09-17T18:45:07.494Z","updatedAt":"2026-09-18T00:07:52.394Z"},"numberInSurah":94,"textArabic":"لَّقَدْ أَحْصَىٰهُمْ وَعَدَّهُمْ عَدًّا","translationUz":"Batahqiq, U zot ularni ihota qilgan va sanab qo`ygandir.","transcription":null,"tafsirUz":null,"pageNumber":311,"juz":16,"createdAt":"2026-09-17T18:45:32.393Z","updatedAt":"2026-09-17T18:45:32.393Z"},{"id":2345,"surahId":19,"surah":{"id":19,"number":19,"nameArabic":"مريم","nameUz":"Maryam","meaningUz":"Maryam","revelationPlace":"makka","totalAyahs":98,"startPage":305,"createdAt":"2026-09-17T18:45:07.494Z","updatedAt":"2026-09-18T00:07:52.394Z"},"numberInSurah":95,"textArabic":"وَكُلُّهُمْ ءَاتِيهِ يَوْمَ ٱلْقِيَـٰمَةِ فَرْدًا","translationUz":"Ularning barchalari U zotning huzuriga qiyomat kuni yolg`iz hollarida kelguvchidirlar.","transcription":null,"tafsirUz":null,"pageNumber":311,"juz":16,"createdAt":"2026-09-17T18:45:32.397Z","updatedAt":"2026-09-17T18:45:32.397Z"}]}