kecha)da har bir hikmatli ish ajratilib, hal qilinur.","transcription":null,"tafsirUz":null,"pageNumber":496,"juz":25,"createdAt":"2026-09-17T18:45:53.452Z","updatedAt":"2026-09-17T18:45:53.452Z"},{"id":4419,"surahId":44,"surah":{"id":44,"number":44,"nameArabic":"الدخان","nameUz":"Duxon","meaningUz":"Tutun","revelationPlace":"makka","totalAyahs":59,"startPage":496,"createdAt":"2026-09-17T18:45:07.618Z","updatedAt":"2026-09-18T00:07:52.509Z"},"numberInSurah":5,"textArabic":"أَمْرًا مِّنْ عِندِنَآ ۚ إِنَّا كُنَّا مُرْسِلِينَ","translationUz":"Biz tomonimizdan bo`lgan amrga binoan. Albatta, Biz Payg`ambar yuborguvchi bo`ldik.","transcription":null,"tafsirUz":null,"pageNumber":496,"juz":25,"createdAt":"2026-09-17T18:45:53.456Z","updatedAt":"2026-09-17T18:45:53.456Z"},{"id":4420,"surahId":44,"surah":{"id":44,"number":44,"nameArabic":"الدخان","nameUz":"Duxon","meaningUz":"Tutun","revelationPlace":"makka","totalAyahs":59,"startPage":496,"createdAt":"2026-09-17T18:45:07.618Z","updatedAt":"2026-09-18T00:07:52.509Z"},"numberInSurah":6,"textArabic":"رَحْمَةً مِّن رَّبِّكَ ۚ إِنَّهُۥ هُوَ ٱلسَّمِيعُ ٱلْعَلِيمُ","translationUz":"Bu, Robbing tomonidan (ko`rsatilgan) rahmatdir. Albatta, Uning O`zi o`ta eshitguvchi, o`ta bilguvchi Zotdir.","transcription":null,"tafsirUz":null,"pageNumber":496,"juz":25,"createdAt":"2026-09-17T18:45:53.461Z","updatedAt":"2026-09-17T18:45:53.461Z"},{"id":4421,"surahId":44,"surah":{"id":44,"number":44,"nameArabic":"الدخان","nameUz":"Duxon","meaningUz":"Tutun","revelationPlace":"makka","totalAyahs":59,"startPage":496,"createdAt":"2026-09-17T18:45:07.618Z","updatedAt":"2026-09-18T00:07:52.509Z"},"numberInSurah":7,"textArabic":"رَبِّ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ وَمَا بَيْنَهُمَآ ۖ إِن كُنتُم مُّوقِنِينَ","translationUz":"U — osmonlaru yerning va ularning orasidagi narsalarning Robbidir. Gar ishonguvchi bo`lsangiz.","transcription":null,"tafsirUz":null,"pageNumber":496,"juz":25,"createdAt":"2026-09-17T18:45:53.465Z","updatedAt":"2026-09-17T18:45:53.465Z"},{"id":4422,"surahId":44,"surah":{"id":44,"number":44,"nameArabic":"الدخان","nameUz":"Duxon","meaningUz":"Tutun","revelationPlace":"makka","totalAyahs":59,"startPage":496,"createdAt":"2026-09-17T18:45:07.618Z","updatedAt":"2026-09-18T00:07:52.509Z"},"numberInSurah":8,"textArabic":"لَآ إِلَـٰهَ إِلَّا هُوَ يُحْىِۦ وَيُمِيتُ ۖ رَبُّكُمْ وَرَبُّ ءَابَآئِكُمُ ٱلْأَوَّلِينَ","translationUz":"Undan o`zga ibodatga sazovor zot yo`q. U tiriltirur va o`ldirur. U sizning Robbingiz va ota-bobolaringizning Robbidir.","transcription":null,"tafsirUz":null,"pageNumber":496,"juz":25,"createdAt":"2026-09-17T18:45:53.470Z","updatedAt":"2026-09-17T18:45:53.470Z"},{"id":4423,"surahId":44,"surah":{"id":44,"number":44,"nameArabic":"الدخان","nameUz":"Duxon","meaningUz":"Tutun","revelationPlace":"makka","totalAyahs":59,"startPage":496,"createdAt":"2026-09-17T18:45:07.618Z","updatedAt":"2026-09-18T00:07:52.509Z"},"numberInSurah":9,"textArabic":"بَلْ هُمْ فِى شَكٍّ يَلْعَبُونَ","translationUz":"Yo`q! Ular shak-shubhada o`ynamoqdalar.","transcription":null,"tafsirUz":null,"pageNumber":496,"juz":25,"createdAt":"2026-09-17T18:45:53.474Z","updatedAt":"2026-09-17T18:45:53.474Z"},{"id":4424,"surahId":44,"surah":{"id":44,"number":44,"nameArabic":"الدخان","nameUz":"Duxon","meaningUz":"Tutun","revelationPlace":"makka","totalAyahs":59,"startPage":496,"createdAt":"2026-09-17T18:45:07.618Z","updatedAt":"2026-09-18T00:07:52.509Z"},"numberInSurah":10,"textArabic":"فَٱرْتَقِبْ يَوْمَ تَأْتِى ٱلسَّمَآءُ بِدُخَانٍ مُّبِينٍ","translationUz":"Bas, osmon aniq tutunni keltiradigan kunni kut.","transcription":null,"tafsirUz":null,"pageNumber":496,"juz":25,"createdAt":"2026-09-17T18:45:53.477Z","updatedAt":"2026-09-17T18:45:53.477Z"},{"id":4425,"surahId":44,"surah":{"id":44,"number":44,"nameArabic":"الدخان","nameUz":"Duxon","meaningUz":"Tutun","revelationPlace":"makka","totalAyahs":59,"startPage":496,"createdAt":"2026-09-17T18:45:07.618Z","updatedAt":"2026-09-18T00:07:52.509Z"},"numberInSurah":11,"textArabic":"يَغْشَى ٱلنَّاسَ ۖ هَـٰذَا عَذَابٌ أَلِيمٌ","translationUz":"U, odamlarni o`rab olur. Bu, alamli azobdir.","transcription":null,"tafsirUz":null,"pageNumber":496,"juz":25,"createdAt":"2026-09-17T18:45:53.482Z","updatedAt":"2026-09-17T18:45:53.482Z"},{"id":4426,"surahId":44,"surah":{"id":44,"number":44,"nameArabic":"الدخان","nameUz":"Duxon","meaningUz":"Tutun","revelationPlace":"makka","totalAyahs":59,"startPage":496,"createdAt":"2026-09-17T18:45:07.618Z","updatedAt":"2026-09-18T00:07:52.509Z"},"numberInSurah":12,"textArabic":"رَّبَّنَا ٱكْشِفْ عَنَّا ٱلْعَذَابَ إِنَّا مُؤْمِنُونَ","translationUz":"Ey Robbimiz! Bizdan azobni kushoyish qil! Albatta, biz iymon keltirguvchidirmiz.","transcription":null,"tafsirUz":null,"pageNumber":496,"juz":25,"createdAt":"2026-09-17T18:45:53.486Z","updatedAt":"2026-09-17T18:45:53.486Z"},{"id":4427,"surahId":44,"surah":{"id":44,"number":44,"nameArabic":"الدخان","nameUz":"Duxon","meaningUz":"Tutun","revelationPlace":"makka","totalAyahs":59,"startPage":496,"createdAt":"2026-09-17T18:45:07.618Z","updatedAt":"2026-09-18T00:07:52.509Z"},"numberInSurah":13,"textArabic":"أَنَّىٰ لَهُمُ ٱلذِّكْرَىٰ وَقَدْ جَآءَهُمْ رَسُولٌ مُّبِينٌ","translationUz":"Ularga qayoqdan ham eslatma bo`lsin. Holbuki, ularga ochiq-oydin Payg`ambar kelgan edi.","transcription":null,"tafsirUz":null,"pageNumber":496,"juz":25,"createdAt":"2026-09-17T18:45:53.490Z","updatedAt":"2026-09-17T18:45:53.490Z"},{"id":4428,"surahId":44,"surah":{"id":44,"number":44,"nameArabic":"الدخان","nameUz":"Duxon","meaningUz":"Tutun","revelationPlace":"makka","totalAyahs":59,"startPage":496,"createdAt":"2026-09-17T18:45:07.618Z","updatedAt":"2026-09-18T00:07:52.509Z"},"numberInSurah":14,"textArabic":"ثُمَّ تَوَلَّوْا۟ عَنْهُ وَقَالُوا۟ مُعَلَّمٌ مَّجْنُونٌ","translationUz":"So`ngra undan yuz o`girdilar va: «Bu — o`rgatilgan majnun», dedilar.","transcription":null,"tafsirUz":null,"pageNumber":496,"juz":25,"createdAt":"2026-09-17T18:45:53.494Z","updatedAt":"2026-09-17T18:45:53.494Z"},{"id":4429,"surahId":44,"surah":{"id":44,"number":44,"nameArabic":"الدخان","nameUz":"Duxon","meaningUz":"Tutun","revelationPlace":"makka","totalAyahs":59,"startPage":496,"createdAt":"2026-09-17T18:45:07.618Z","updatedAt":"2026-09-18T00:07:52.509Z"},"numberInSurah":15,"textArabic":"إِنَّا كَاشِفُوا۟ ٱلْعَذَابِ قَلِيلًا ۚ إِنَّكُمْ عَآئِدُونَ","translationUz":"Albatta, Biz azobni ozgina kushoyish qilguvchimiz. Albatta, sizlar qaytguvchisizlar.","transcription":null,"tafsirUz":null,"pageNumber":496,"juz":25,"createdAt":"2026-09-17T18:45:53.498Z","updatedAt":"2026-09-17T18:45:53.498Z"},{"id":4430,"surahId":44,"surah":{"id":44,"number":44,"nameArabic":"الدخان","nameUz":"Duxon","meaningUz":"Tutun","revelationPlace":"makka","totalAyahs":59,"startPage":496,"createdAt":"2026-09-17T18:45:07.618Z","updatedAt":"2026-09-18T00:07:52.509Z"},"numberInSurah":16,"textArabic":"يَوْمَ نَبْطِشُ ٱلْبَطْشَةَ ٱلْكُبْرَىٰٓ إِنَّا مُنتَقِمُونَ","translationUz":"Katta ushlash ila ushlaganimiz kuni, albatta, Biz intiqom olguvchimiz.","transcription":null,"tafsirUz":null,"pageNumber":496,"juz":25,"createdAt":"2026-09-17T18:45:53.502Z","updatedAt":"2026-09-17T18:45:53.502Z"},{"id":4431,"surahId":44,"surah":{"id":44,"number":44,"nameArabic":"الدخان","nameUz":"Duxon","meaningUz":"Tutun","revelationPlace":"makka","totalAyahs":59,"startPage":496,"createdAt":"2026-09-17T18:45:07.618Z","updatedAt":"2026-09-18T00:07:52.509Z"},"numberInSurah":17,"textArabic":"۞ وَلَقَدْ فَتَنَّا قَبْلَهُمْ قَوْمَ فِرْعَوْنَ وَجَآءَهُمْ رَسُولٌ كَرِيمٌ","translationUz":"Batahqiq, ulardan oldin Fir'avn qavmini sinadik. Ularga karamli Payg`ambar keldi.","transcription":null,"tafsirUz":null,"pageNumber":496,"juz":25,"createdAt":"2026-09-17T18:45:53.506Z","updatedAt":"2026-09-17T18:45:53.506Z"},{"id":4432,"surahId":44,"surah":{"id":44,"number":44,"nameArabic":"الدخان","nameUz":"Duxon","meaningUz":"Tutun","revelationPlace":"makka","totalAyahs":59,"startPage":496,"createdAt":"2026-09-17T18:45:07.618Z","updatedAt":"2026-09-18T00:07:52.509Z"},"numberInSurah":18,"textArabic":"أَنْ أَدُّوٓا۟ إِلَىَّ عِبَادَ ٱللَّهِ ۖ إِنِّى لَكُمْ رَسُولٌ أَمِينٌ","translationUz":"«Sizlar menga Allohning bandalarini beringlar. Albatta, men sizlarga ishonchli Payg`ambarman.","transcription":null,"tafsirUz":null,"pageNumber":496,"juz":25,"createdAt":"2026-09-17T18:45:53.510Z","updatedAt":"2026-09-17T18:45:53.510Z"}]}