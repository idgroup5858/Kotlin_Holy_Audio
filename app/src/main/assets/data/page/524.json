{"number":524,"textArabic":null,"translationUz":null,"juz":null,"note":null,"updatedAt":null,"ayahs":[{"id":4750,"surahId":52,"surah":{"id":52,"number":52,"nameArabic":"الطور","nameUz":"Tur","meaningUz":"Tur togʻi","revelationPlace":"makka","totalAyahs":49,"startPage":523,"createdAt":"2026-09-17T18:45:07.659Z","updatedAt":"2026-09-18T00:07:52.544Z"},"numberInSurah":15,"textArabic":"أَفَسِحْرٌ هَـٰذَآ أَمْ أَنتُمْ لَا تُبْصِرُونَ","translationUz":"Bu sehrmi?! Yoki sizlar ko`rmayapsizlarmi?!","transcription":null,"tafsirUz":null,"pageNumber":524,"juz":27,"createdAt":"2026-09-17T18:45:56.752Z","updatedAt":"2026-09-17T18:45:56.752Z"},{"id":4751,"surahId":52,"surah":{"id":52,"number":52,"nameArabic":"الطور","nameUz":"Tur","meaningUz":"Tur togʻi","revelationPlace":"makka","totalAyahs":49,"startPage":523,"createdAt":"2026-09-17T18:45:07.659Z","updatedAt":"2026-09-18T00:07:52.544Z"},"numberInSurah":16,"textArabic":"ٱصْلَوْهَا فَٱصْبِرُوٓا۟ أَوْ لَا تَصْبِرُوا۟ سَوَآءٌ عَلَيْكُمْ ۖ إِنَّمَا تُجْزَوْنَ مَا كُنتُمْ تَعْمَلُونَ","translationUz":"Kiringlar unga! Chidaysizlarmi, chidamaysizlarmi — bari bir. Qilib yurgan amallaringizning jazosini olasizlar, xolos.","transcription":null,"tafsirUz":null,"pageNumber":524,"juz":27,"createdAt":"2026-09-17T18:45:56.757Z","updatedAt":"2026-09-17T18:45:56.757Z"},{"id":4752,"surahId":52,"surah":{"id":52,"number":52,"nameArabic":"الطور","nameUz":"Tur","meaningUz":"Tur togʻi","revelationPlace":"makka","totalAyahs":49,"startPage":523,"createdAt":"2026-09-17T18:45:07.659Z","updatedAt":"2026-09-18T00:07:52.544Z"},"numberInSurah":17,"textArabic":"إِنَّ ٱلْمُتَّقِينَ فِى جَنَّـٰتٍ وَنَعِيمٍ","translationUz":"Albatta, taqvodorlar jannatlar va nozu ne'matlar ichidadirlar.","transcription":null,"tafsirUz":null,"pageNumber":524,"juz":27,"createdAt":"2026-09-17T18:45:56.761Z","updatedAt":"2026-09-17T18:45:56.761Z"},{"id":4753,"surahId":52,"surah":{"id":52,"number":52,"nameArabic":"الطور","nameUz":"Tur","meaningUz":"Tur togʻi","revelationPlace":"makka","totalAyahs":49,"startPage":523,"createdAt":"2026-09-17T18:45:07.659Z","updatedAt":"2026-09-18T00:07:52.544Z"},"numberInSurah":18,"textArabic":"فَـٰكِهِينَ بِمَآ ءَاتَىٰهُمْ رَبُّهُمْ وَوَقَىٰهُمْ رَبُّهُمْ عَذَابَ ٱلْجَحِيمِ","translationUz":"Robbilari ularga bergan narsalardan lazzatdadirlar. Robbilari ularni jahannam azobidan saqlar.","transcription":null,"tafsirUz":null,"pageNumber":524,"juz":27,"createdAt":"2026-09-17T18:45:56.765Z","updatedAt":"2026-09-17T18:45:56.765Z"},{"id":4754,"surahId":52,"surah":{"id":52,"number":52,"nameArabic":"الطور","nameUz":"Tur","meaningUz":"Tur togʻi","revelationPlace":"makka","totalAyahs":49,"startPage":523,"createdAt":"2026-09-17T18:45:07.659Z","updatedAt":"2026-09-18T00:07:52.544Z"},"numberInSurah":19,"textArabic":"كُلُوا۟ وَٱشْرَبُوا۟ هَنِيٓـًٔۢا بِمَا كُنتُمْ تَعْمَلُونَ","translationUz":"Yenglar, ichinglar, osh bo`lsin. (Bular) qilgan amallaringiz uchundir.","transcription":null,"tafsirUz":null,"pageNumber":524,"juz":27,"createdAt":"2026-09-17T18:45:56.769Z","updatedAt":"2026-09-17T18:45:56.769Z"},{"id":4755,"surahId":52,"surah":{"id":52,"number":52,"nameArabic":"الطور","nameUz":"Tur","meaningUz":"Tur togʻi","revelationPlace":"makka","totalAyahs":49,"startPage":523,"createdAt":"2026-09-17T18:45:07.659Z","updatedAt":"2026-09-18T00:07:52.544Z"},"numberInSurah":20,"textArabic":"مُتَّكِـِٔينَ عَلَىٰ سُرُرٍ مَّصْفُوفَةٍ ۖ وَزَوَّجْنَـٰهُم بِحُورٍ عِينٍ","translationUz":"Ular qator tizilgan so`rilarga yonboshlagan holdalar. Va ularni go`zal ko`zli hurlarga uylab qo`yganmiz.","transcription":null,"tafsirUz":null,"pageNumber":524,"juz":27,"createdAt":"2026-09-17T18:45:56.774Z","updatedAt":"2026-09-17T18:45:56.774Z"},{"id":4756,"surahId":52,"surah":{"id":52,"number":52,"nameArabic":"الطور","nameUz":"Tur","meaningUz":"Tur togʻi","revelationPlace":"makka","totalAyahs":49,"startPage":523,"createdAt":"2026-09-17T18:45:07.659Z","updatedAt":"2026-09-18T00:07:52.544Z"},"numberInSurah":21,"textArabic":"وَٱلَّذِينَ ءَامَنُوا۟ وَٱتَّبَعَتْهُمْ ذُرِّيَّتُهُم بِإِيمَـٰنٍ أَلْحَقْنَا بِهِمْ ذُرِّيَّتَهُمْ وَمَآ أَلَتْنَـٰهُم مِّنْ عَمَلِهِم مِّن شَىْءٍ ۚ كُلُّ ٱمْرِئٍۭ بِمَا كَسَبَ رَهِينٌ","translationUz":"O`zlari iymon keltirib, zurriyotlari ularga iymon bilan ergashganlarning zurriyotini ularga qo`shdik va ularning amallaridan hech narsani kamaytirmadik. Har bir kishi o`z kasbi garovidir.","transcription":null,"tafsirUz":null,"pageNumber":524,"juz":27,"createdAt":"2026-09-17T18:45:56.778Z","updatedAt":"2026-09-17T18:45:56.778Z"},{"id":4757,"surahId":52,"surah":{"id":52,"number":52,"nameArabic":"الطور","nameUz":"Tur","meaningUz":"Tur togʻi","revelationPlace":"makka","totalAyahs":49,"startPage":523,"createdAt":"2026-09-17T18:45:07.659Z","updatedAt":"2026-09-18T00:07:52.544Z"},"numberInSurah":22,"textArabic":"وَأَمْدَدْنَـٰهُم بِفَـٰكِهَةٍ وَلَحْمٍ مِّمَّا يَشْتَهُونَ","translationUz":"Va Biz ularga xohlagan mevalari va go`shtlarini muhayyo qilib qo`ydik.","transcription":null,"tafsirUz":null,"pageNumber":524,"juz":27,"createdAt":"2026-09-17T18:45:56.782Z","updatedAt":"2026-09-17T18:45:56.782Z"},{"id":4758,"surahId":52,"surah":{"id":52,"number":52,"nameArabic":"الطور","nameUz":"Tur","meaningUz":"Tur togʻi","revelationPlace":"makka","totalAyahs":49,"startPage":523,"createdAt":"2026-09-17T18:45:07.659Z","updatedAt":"2026-09-18T00:07:52.544Z"},"numberInSurah":23,"textArabic":"يَتَنَـٰزَعُونَ فِيهَا كَأْسًا لَّا لَغْوٌ فِيهَا وَلَا تَأْثِيمٌ","translationUz":"Ular unda qadahlarni bir-birlariga uzaturlar. U yerda behuda sergaplik va gunoh yo`q.","transcription":null,"tafsirUz":null,"pageNumber":524,"juz":27,"createdAt":"2026-09-17T18:45:56.786Z","updatedAt":"2026-09-17T18:45:56.786Z"},{"id":4759,"surahId":52,"surah":{"id":52,"number":52,"nameArabic":"الطور","nameUz":"Tur","meaningUz":"Tur togʻi","revelationPlace":"makka","totalAyahs":49,"startPage":523,"createdAt":"2026-09-17T18:45:07.659Z","updatedAt":"2026-09-18T00:07:52.544Z"},"numberInSurah":24,"textArabic":"۞ وَيَطُوفُ عَلَيْهِمْ غِلْمَانٌ لَّهُمْ كَأَنَّهُمْ لُؤْلُؤٌ مَّكْنُونٌ","translationUz":"Va atroflarida xuddi sadafdagi durdek g`ulomlari aylanib, xizmatda yurishar.","transcription":null,"tafsirUz":null,"pageNumber":524,"juz":27,"createdAt":"2026-09-17T18:45:56.790Z","updatedAt":"2026-09-17T18:45:56.790Z"},{"id":4760,"surahId":52,"surah":{"id":52,"number":52,"nameArabic":"الطور","nameUz":"Tur","meaningUz":"Tur togʻi","revelationPlace":"makka","totalAyahs":49,"startPage":523,"createdAt":"2026-09-17T18:45:07.659Z","updatedAt":"2026-09-18T00:07:52.544Z"},"numberInSurah":25,"textArabic":"وَأَقْبَلَ بَعْضُهُمْ عَلَىٰ بَعْضٍ يَتَسَآءَلُونَ","translationUz":"Ba'zilari boshqalaridan o`girilib so`ray boshladilar:","transcription":null,"tafsirUz":null,"pageNumber":524,"juz":27,"createdAt":"2026-09-17T18:45:56.794Z","updatedAt":"2026-09-17T18:45:56.794Z"},{"id":4761,"surahId":52,"surah":{"id":52,"number":52,"nameArabic":"الطور","nameUz":"Tur","meaningUz":"Tur togʻi","revelationPlace":"makka","totalAyahs":49,"startPage":523,"createdAt":"2026-09-17T18:45:07.659Z","updatedAt":"2026-09-18T00:07:52.544Z"},"numberInSurah":26,"textArabic":"قَالُوٓا۟ إِنَّا كُنَّا قَبْلُ فِىٓ أَهْلِنَا مُشْفِقِينَ","translationUz":"«Albatta, biz ilgari o`z ahlimiz davrasida U zotdan qo`rquvchilardan edik.","transcription":null,"tafsirUz":null,"pageNumber":524,"juz":27,"createdAt":"2026-09-17T18:45:56.798Z","updatedAt":"2026-09-17T18:45:56.798Z"},{"id":4762,"surahId":52,"surah":{"id":52,"number":52,"nameArabic":"الطور","nameUz":"Tur","meaningUz":"Tur togʻi","revelationPlace":"makka","totalAyahs":49,"startPage":523,"createdAt":"2026-09-17T18:45:07.659Z","updatedAt":"2026-09-18T00:07:52.544Z"},"numberInSurah":27,"textArabic":"فَمَنَّ ٱللَّهُ عَلَيْنَا وَوَقَىٰنَا عَذَابَ ٱلسَّمُومِ","translationUz":"Bas, Alloh bizga marhamat qildi va bizni do`zax azobidan saqladi.","transcription":null,"tafsirUz":null,"pageNumber":524,"juz":27,"createdAt":"2026-09-17T18:45:56.802Z","updatedAt":"2026-09-17T18:45:56.802Z"},{"id":4763,"surahId":52,"surah":{"id":52,"number":52,"nameArabic":"الطور","nameUz":"Tur","meaningUz":"Tur togʻi","revelationPlace":"makka","totalAyahs":49,"startPage":523,"createdAt":"2026-09-17T18:45:07.659Z","updatedAt":"2026-09-18T00:07:52.544Z"},"numberInSurah":28,"textArabic":"إِنَّا كُنَّا مِن قَبْلُ نَدْعُوهُ ۖ إِنَّهُۥ هُوَ ٱلْبَرُّ ٱلرَّحِيمُ","translationUz":"Albatta, biz ilgari Unga duo qilardik. Albatta, Uning O`zi yaxshilik qiluvchi va rahimlidur».","transcription":null,"tafsirUz":null,"pageNumber":524,"juz":27,"createdAt":"2026-09-17T18:45:56.806Z","updatedAt":"2026-09-17T18:45:56.806Z"},{"id":4764,"surahId":52,"surah":{"id":52,"number":52,"nameArabic":"الطور","nameUz":"Tur","meaningUz":"Tur togʻi","revelationPlace":"makka","totalAyahs":49,"startPage":523,"createdAt":"2026-09-17T18:45:07.659Z","updatedAt":"2026-09-18T00:07:52.544Z"},"numberInSurah":29,"textArabic":"فَذَكِّرْ فَمَآ أَنتَ بِنِعْمَتِ رَبِّكَ بِكَاهِنٍ وَلَا مَجْنُونٍ","translationUz":"Bas, eslatgin: sen Robbing ne'mati ila folbin ham emassan, majnun ham emassan.","transcription":null,"tafsirUz":null,"pageNumber":524,"juz":27,"createdAt":"2026-09-17T18:45:56.811Z","updatedAt":"2026-09-17T18:45:56.811Z"},{"id":4765,"surahId":52,"surah":{"id":52,"number":52,"nameArabic":"الطور","nameUz":"Tur","meaningUz":"Tur togʻi","revelationPlace":"makka","totalAyahs":49,"startPage":523,"createdAt":"2026-09-17T18:45:07.659Z","updatedAt":"2026-09-18T00:07:52.544Z"},"numberInSurah":30,"textArabic":"أَمْ يَقُولُونَ شَاعِرٌ نَّتَرَبَّصُ بِهِۦ رَيْبَ ٱلْمَنُونِ","translationUz":"Balki: «U — shoir, biz unga o`lim yetishini kutamiz», derlar?","transcription":null,"tafsirUz":null,"pageNumber":524,"juz":27,"createdAt":"2026-09-17T18:45:56.815Z","updatedAt":"2026-09-17T18:45:56.815Z"},{"id":4766,"surahId":52,"surah":{"id":52,"number":52,"nameArabic":"الطور","nameUz":"Tur","meaningUz":"Tur togʻi","revelationPlace":"makka","totalAyahs":49,"startPage":523,"createdAt":"2026-09-17T18:45:07.659Z","updatedAt":"2026-09-18T00:07:52.544Z"},"numberInSurah":31,"textArabic":"قُلْ تَرَبَّصُوا۟ فَإِنِّى مَعَكُم مِّنَ ٱلْمُتَرَبِّصِينَ","translationUz":"Aytgin: «Kutinglar, albatta, men ham sizlar bilan birga kutuvchidirman».","transcription":null,"tafsirUz":null,"pageNumber":524,"juz":27,"createdAt":"2026-09-17T18:45:56.818Z","updatedAt":"2026-09-17T18:45:56.818Z"}]}