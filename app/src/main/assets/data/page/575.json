{"number":575,"textArabic":null,"translationUz":null,"juz":null,"note":null,"updatedAt":null,"ayahs":[{"id":5495,"surahId":73,"surah":{"id":73,"number":73,"nameArabic":"المزمل","nameUz":"Muzzammil","meaningUz":"Oʻranib olgan","revelationPlace":"makka","totalAyahs":20,"startPage":574,"createdAt":"2026-09-17T18:45:07.759Z","updatedAt":"2026-09-18T00:07:52.622Z"},"numberInSurah":20,"textArabic":"۞ إِنَّ رَبَّكَ يَعْلَمُ أَنَّكَ تَقُومُ أَدْنَىٰ مِن ثُلُثَىِ ٱلَّيْلِ وَنِصْفَهُۥ وَثُلُثَهُۥ وَطَآئِفَةٌ مِّنَ ٱلَّذِينَ مَعَكَ ۚ وَٱللَّهُ يُقَدِّرُ ٱلَّيْلَ وَٱلنَّهَارَ ۚ عَلِمَ أَن لَّن تُحْصُوهُ فَتَابَ عَلَيْكُمْ ۖ فَٱقْرَءُوا۟ مَا تَيَسَّرَ مِنَ ٱلْقُرْءَانِ ۚ عَلِمَ أَن سَيَكُونُ مِنكُم مَّرْضَىٰ ۙ وَءَاخَرُونَ يَضْرِبُونَ فِى ٱلْأَرْضِ يَبْتَغُونَ مِن فَضْلِ ٱللَّهِ ۙ وَءَاخَرُونَ يُقَـٰتِلُونَ فِى سَبِيلِ ٱللَّهِ ۖ فَٱقْرَءُوا۟ مَا تَيَسَّرَ مِنْهُ ۚ وَأَقِيمُوا۟ ٱلصَّلَوٰةَ وَءَاتُوا۟ ٱلزَّكَوٰةَ وَأَقْرِضُوا۟ ٱللَّهَ قَرْضًا حَسَنًا ۚ وَمَا تُقَدِّمُوا۟ لِأَنفُسِكُم مِّنْ خَيْرٍ تَجِدُوهُ عِندَ ٱللَّهِ هُوَ خَيْرًا وَأَعْظَمَ أَجْرًا ۚ وَٱسْتَغْفِرُوا۟ ٱللَّهَ ۖ إِنَّ ٱللَّهَ غَفُورٌ رَّحِيمٌۢ","translationUz":"Albatta, Robbing seni kechaning uchdan ikkisidan ozrog`ini, yo yarmini, yo uchdan birini qoim bo`lib o`tkazayotganingni va sen bilan birga bo`lganlardan ham bir toifa (shundoq qilayotganlarini) biladir. Va Alloh kechayu kunduzni O`zi o`lchaydir. U sizlar hech chiday olmasligingizni bilib, sizlarga (engillikni) qaytardi. Bas (endi), Qur'ondan muyassar bo`lganicha o`qinglar. Sizlardan kelajakda kasallar bo`lishini ham bildi. Boshqalar Yer yuzida yurib, Allohning fazlini axtarishini, yana boshqalar esa, Allohning yo`lida jihod qilishlarini (ham bildi). Bas, undan muyassar bo`lganicha qiroat qilinglar. Va namozni qoim qilinglar, zakot beringlar va Allohga yaxshi qarz beringlar. O`zingiz uchun nima yaxshilik qilgan bo`lsangiz, Allohning huzurida undan yaxshirog`ini va ulkanroq ajrni toparsizlar. Allohga istig`for aytinglar. Albatta, Alloh mag`firat qiluvchi va rahmdildir.","transcription":null,"tafsirUz":null,"pageNumber":575,"juz":29,"createdAt":"2026-09-17T18:46:05.658Z","updatedAt":"2026-09-17T18:46:05.658Z"},{"id":5496,"surahId":74,"surah":{"id":74,"number":74,"nameArabic":"المدثر","nameUz":"Muddassir","meaningUz":"Kiyinib olgan","revelationPlace":"makka","totalAyahs":56,"startPage":575,"createdAt":"2026-09-17T18:45:07.764Z","updatedAt":"2026-09-18T00:07:52.626Z"},"numberInSurah":1,"textArabic":" يَـٰٓأَيُّهَا ٱلْمُدَّثِّرُ","translationUz":"Ey, burkanib yotgan!","transcription":null,"tafsirUz":null,"pageNumber":575,"juz":29,"createdAt":"2026-09-17T18:46:06.047Z","updatedAt":"2026-09-17T18:46:06.047Z"},{"id":5497,"surahId":74,"surah":{"id":74,"number":74,"nameArabic":"المدثر","nameUz":"Muddassir","meaningUz":"Kiyinib olgan","revelationPlace":"makka","totalAyahs":56,"startPage":575,"createdAt":"2026-09-17T18:45:07.764Z","updatedAt":"2026-09-18T00:07:52.626Z"},"numberInSurah":2,"textArabic":"قُمْ فَأَنذِرْ","translationUz":"Tur va ogohlantir!","transcription":null,"tafsirUz":null,"pageNumber":575,"juz":29,"createdAt":"2026-09-17T18:46:06.053Z","updatedAt":"2026-09-17T18:46:06.053Z"},{"id":5498,"surahId":74,"surah":{"id":74,"number":74,"nameArabic":"المدثر","nameUz":"Muddassir","meaningUz":"Kiyinib olgan","revelationPlace":"makka","totalAyahs":56,"startPage":575,"createdAt":"2026-09-17T18:45:07.764Z","updatedAt":"2026-09-18T00:07:52.626Z"},"numberInSurah":3,"textArabic":"وَرَبَّكَ فَكَبِّرْ","translationUz":"Va Robbingni ulug`la!","transcription":null,"tafsirUz":null,"pageNumber":575,"juz":29,"createdAt":"2026-09-17T18:46:06.057Z","updatedAt":"2026-09-17T18:46:06.057Z"},{"id":5499,"surahId":74,"surah":{"id":74,"number":74,"nameArabic":"المدثر","nameUz":"Muddassir","meaningUz":"Kiyinib olgan","revelationPlace":"makka","totalAyahs":56,"startPage":575,"createdAt":"2026-09-17T18:45:07.764Z","updatedAt":"2026-09-18T00:07:52.626Z"},"numberInSurah":4,"textArabic":"وَثِيَابَكَ فَطَهِّرْ","translationUz":"Va kiyimingni pokla!","transcription":null,"tafsirUz":null,"pageNumber":575,"juz":29,"createdAt":"2026-09-17T18:46:06.061Z","updatedAt":"2026-09-17T18:46:06.061Z"},{"id":5500,"surahId":74,"surah":{"id":74,"number":74,"nameArabic":"المدثر","nameUz":"Muddassir","meaningUz":"Kiyinib olgan","revelationPlace":"makka","totalAyahs":56,"startPage":575,"createdAt":"2026-09-17T18:45:07.764Z","updatedAt":"2026-09-18T00:07:52.626Z"},"numberInSurah":5,"textArabic":"وَٱلرُّجْزَ فَٱهْجُرْ","translationUz":"Va azob(sababchisi)dan chetlan!","transcription":null,"tafsirUz":null,"pageNumber":575,"juz":29,"createdAt":"2026-09-17T18:46:06.065Z","updatedAt":"2026-09-17T18:46:06.065Z"},{"id":5501,"surahId":74,"surah":{"id":74,"number":74,"nameArabic":"المدثر","nameUz":"Muddassir","meaningUz":"Kiyinib olgan","revelationPlace":"makka","totalAyahs":56,"startPage":575,"createdAt":"2026-09-17T18:45:07.764Z","updatedAt":"2026-09-18T00:07:52.626Z"},"numberInSurah":6,"textArabic":"وَلَا تَمْنُن تَسْتَكْثِرُ","translationUz":"Va ko`p (ish) qilgan bo`lsang ham, minnat qilma.","transcription":null,"tafsirUz":null,"pageNumber":575,"juz":29,"createdAt":"2026-09-17T18:46:06.069Z","updatedAt":"2026-09-17T18:46:06.069Z"},{"id":5502,"surahId":74,"surah":{"id":74,"number":74,"nameArabic":"المدثر","nameUz":"Muddassir","meaningUz":"Kiyinib olgan","revelationPlace":"makka","totalAyahs":56,"startPage":575,"createdAt":"2026-09-17T18:45:07.764Z","updatedAt":"2026-09-18T00:07:52.626Z"},"numberInSurah":7,"textArabic":"وَلِرَبِّكَ فَٱصْبِرْ","translationUz":"Va Robbing uchun sabr qil.","transcription":null,"tafsirUz":null,"pageNumber":575,"juz":29,"createdAt":"2026-09-17T18:46:06.073Z","updatedAt":"2026-09-17T18:46:06.073Z"},{"id":5503,"surahId":74,"surah":{"id":74,"number":74,"nameArabic":"المدثر","nameUz":"Muddassir","meaningUz":"Kiyinib olgan","revelationPlace":"makka","totalAyahs":56,"startPage":575,"createdAt":"2026-09-17T18:45:07.764Z","updatedAt":"2026-09-18T00:07:52.626Z"},"numberInSurah":8,"textArabic":"فَإِذَا نُقِرَ فِى ٱلنَّاقُورِ","translationUz":"Bas, vaqti kelib, dudga puflansa...","transcription":null,"tafsirUz":null,"pageNumber":575,"juz":29,"createdAt":"2026-09-17T18:46:06.077Z","updatedAt":"2026-09-17T18:46:06.077Z"},{"id":5504,"surahId":74,"surah":{"id":74,"number":74,"nameArabic":"المدثر","nameUz":"Muddassir","meaningUz":"Kiyinib olgan","revelationPlace":"makka","totalAyahs":56,"startPage":575,"createdAt":"2026-09-17T18:45:07.764Z","updatedAt":"2026-09-18T00:07:52.626Z"},"numberInSurah":9,"textArabic":"فَذَٰلِكَ يَوْمَئِذٍ يَوْمٌ عَسِيرٌ","translationUz":"Bas, o`sha, o`shal kun qiyin kundir.","transcription":null,"tafsirUz":null,"pageNumber":575,"juz":29,"createdAt":"2026-09-17T18:46:06.080Z","updatedAt":"2026-09-17T18:46:06.080Z"},{"id":5505,"surahId":74,"surah":{"id":74,"number":74,"nameArabic":"المدثر","nameUz":"Muddassir","meaningUz":"Kiyinib olgan","revelationPlace":"makka","totalAyahs":56,"startPage":575,"createdAt":"2026-09-17T18:45:07.764Z","updatedAt":"2026-09-18T00:07:52.626Z"},"numberInSurah":10,"textArabic":"عَلَى ٱلْكَـٰفِرِينَ غَيْرُ يَسِيرٍ","translationUz":"U kofirlarga oson emasdir.","transcription":null,"tafsirUz":null,"pageNumber":575,"juz":29,"createdAt":"2026-09-17T18:46:06.085Z","updatedAt":"2026-09-17T18:46:06.085Z"},{"id":5506,"surahId":74,"surah":{"id":74,"number":74,"nameArabic":"المدثر","nameUz":"Muddassir","meaningUz":"Kiyinib olgan","revelationPlace":"makka","totalAyahs":56,"startPage":575,"createdAt":"2026-09-17T18:45:07.764Z","updatedAt":"2026-09-18T00:07:52.626Z"},"numberInSurah":11,"textArabic":"ذَرْنِى وَمَنْ خَلَقْتُ وَحِيدًا","translationUz":"Meni O`zim yakka yaratgan kishi bilan qo`yib qo`y.","transcription":null,"tafsirUz":null,"pageNumber":575,"juz":29,"createdAt":"2026-09-17T18:46:06.088Z","updatedAt":"2026-09-17T18:46:06.088Z"},{"id":5507,"surahId":74,"surah":{"id":74,"number":74,"nameArabic":"المدثر","nameUz":"Muddassir","meaningUz":"Kiyinib olgan","revelationPlace":"makka","totalAyahs":56,"startPage":575,"createdAt":"2026-09-17T18:45:07.764Z","updatedAt":"2026-09-18T00:07:52.626Z"},"numberInSurah":12,"textArabic":"وَجَعَلْتُ لَهُۥ مَالًا مَّمْدُودًا","translationUz":"Va unga ko`plab molu dunyo berib qo`ydim.","transcription":null,"tafsirUz":null,"pageNumber":575,"juz":29,"createdAt":"2026-09-17T18:46:06.092Z","updatedAt":"2026-09-17T18:46:06.092Z"},{"id":5508,"surahId":74,"surah":{"id":74,"number":74,"nameArabic":"المدثر","nameUz":"Muddassir","meaningUz":"Kiyinib olgan","revelationPlace":"makka","totalAyahs":56,"startPage":575,"createdAt":"2026-09-17T18:45:07.764Z","updatedAt":"2026-09-18T00:07:52.626Z"},"numberInSurah":13,"textArabic":"وَبَنِينَ شُهُودًا","translationUz":"Va hoziru nozir farzandlar ham.","transcription":null,"tafsirUz":null,"pageNumber":575,"juz":29,"createdAt":"2026-09-17T18:46:06.096Z","updatedAt":"2026-09-17T18:46:06.096Z"},{"id":5509,"surahId":74,"surah":{"id":74,"number":74,"nameArabic":"المدثر","nameUz":"Muddassir","meaningUz":"Kiyinib olgan","revelationPlace":"makka","totalAyahs":56,"startPage":575,"createdAt":"2026-09-17T18:45:07.764Z","updatedAt":"2026-09-18T00:07:52.626Z"},"numberInSurah":14,"textArabic":"وَمَهَّدتُّ لَهُۥ تَمْهِيدًا","translationUz":"Va unga (hamma narsani) osonlashtirib qo`ydim.","transcription":null,"tafsirUz":null,"pageNumber":575,"juz":29,"createdAt":"2026-09-17T18:46:06.100Z","updatedAt":"2026-09-17T18:46:06.100Z"},{"id":5510,"surahId":74,"surah":{"id":74,"number":74,"nameArabic":"المدثر","nameUz":"Muddassir","meaningUz":"Kiyinib olgan","revelationPlace":"makka","totalAyahs":56,"startPage":575,"createdAt":"2026-09-17T18:45:07.764Z","updatedAt":"2026-09-18T00:07:52.626Z"},"numberInSurah":15,"textArabic":"ثُمَّ يَطْمَعُ أَنْ أَزِيدَ","translationUz":"So`ngra, yana ziyoda qilishimni tama' qilur.","transcription":null,"tafsirUz":null,"pageNumber":575,"juz":29,"createdAt":"2026-09-17T18:46:06.105Z","updatedAt":"2026-09-17T18:46:06.105Z"},{"id":5511,"surahId":74,"surah":{"id":74,"number":74,"nameArabic":"المدثر","nameUz":"Muddassir","meaningUz":"Kiyinib olgan","revelationPlace":"makka","totalAyahs":56,"startPage":575,"createdAt":"2026-09-17T18:45:07.764Z","updatedAt":"2026-09-18T00:07:52.626Z"},"numberInSurah":16,"textArabic":"كَلَّآ ۖ إِنَّهُۥ كَانَ لِـَٔايَـٰتِنَا عَنِيدًا","translationUz":"Yo`q! Chunki, u Bizning oyatlarimizga sarkash edi.","transcription":null,"tafsirUz":null,"pageNumber":575,"juz":29,"createdAt":"2026-09-17T18:46:06.109Z","updatedAt":"2026-09-17T18:46:06.109Z"},{"id":5512,"surahId":74,"surah":{"id":74,"number":74,"nameArabic":"المدثر","nameUz":"Muddassir","meaningUz":"Kiyinib olgan","revelationPlace":"makka","totalAyahs":56,"startPage":575,"createdAt":"2026-09-17T18:45:07.764Z","updatedAt":"2026-09-18T00:07:52.626Z"},"numberInSurah":17,"textArabic":"سَأُرْهِقُهُۥ صَعُودًا","translationUz":"Tezda uni mashaqqatli chiqish-la horitaman.","transcription":null,"tafsirUz":null,"pageNumber":575,"juz":29,"createdAt":"2026-09-17T18:46:06.114Z","updatedAt":"2026-09-17T18:46:06.114Z"}]}