{"number":522,"textArabic":null,"translationUz":null,"juz":null,"note":null,"updatedAt":null,"ayahs":[{"id":4706,"surahId":51,"surah":{"id":51,"number":51,"nameArabic":"الذاريات","nameUz":"Zoriyot","meaningUz":"Sochuvchi shamollar","revelationPlace":"makka","totalAyahs":60,"startPage":520,"createdAt":"2026-09-17T18:45:07.653Z","updatedAt":"2026-09-18T00:07:52.540Z"},"numberInSurah":31,"textArabic":"۞ قَالَ فَمَا خَطْبُكُمْ أَيُّهَا ٱلْمُرْسَلُونَ","translationUz":"U: «Ey elchilar! Sizning ishingiz nedir?» – dedi.","transcription":null,"tafsirUz":null,"pageNumber":522,"juz":27,"createdAt":"2026-09-17T18:45:56.339Z","updatedAt":"2026-09-17T18:45:56.339Z"},{"id":4707,"surahId":51,"surah":{"id":51,"number":51,"nameArabic":"الذاريات","nameUz":"Zoriyot","meaningUz":"Sochuvchi shamollar","revelationPlace":"makka","totalAyahs":60,"startPage":520,"createdAt":"2026-09-17T18:45:07.653Z","updatedAt":"2026-09-18T00:07:52.540Z"},"numberInSurah":32,"textArabic":"قَالُوٓا۟ إِنَّآ أُرْسِلْنَآ إِلَىٰ قَوْمٍ مُّجْرِمِينَ","translationUz":"Ular: «Albatta, biz jinoyatchi qavmga yuborilganmiz.","transcription":null,"tafsirUz":null,"pageNumber":522,"juz":27,"createdAt":"2026-09-17T18:45:56.343Z","updatedAt":"2026-09-17T18:45:56.343Z"},{"id":4708,"surahId":51,"surah":{"id":51,"number":51,"nameArabic":"الذاريات","nameUz":"Zoriyot","meaningUz":"Sochuvchi shamollar","revelationPlace":"makka","totalAyahs":60,"startPage":520,"createdAt":"2026-09-17T18:45:07.653Z","updatedAt":"2026-09-18T00:07:52.540Z"},"numberInSurah":33,"textArabic":"لِنُرْسِلَ عَلَيْهِمْ حِجَارَةً مِّن طِينٍ","translationUz":"Ularning ustidan loydan (pishirilgan) toshlarni tashlash uchun.","transcription":null,"tafsirUz":null,"pageNumber":522,"juz":27,"createdAt":"2026-09-17T18:45:56.346Z","updatedAt":"2026-09-17T18:45:56.346Z"},{"id":4709,"surahId":51,"surah":{"id":51,"number":51,"nameArabic":"الذاريات","nameUz":"Zoriyot","meaningUz":"Sochuvchi shamollar","revelationPlace":"makka","totalAyahs":60,"startPage":520,"createdAt":"2026-09-17T18:45:07.653Z","updatedAt":"2026-09-18T00:07:52.540Z"},"numberInSurah":34,"textArabic":"مُّسَوَّمَةً عِندَ رَبِّكَ لِلْمُسْرِفِينَ","translationUz":"Robbing huzurida isrofchilar uchun belgilab qo`yilganlarni», dedilar.","transcription":null,"tafsirUz":null,"pageNumber":522,"juz":27,"createdAt":"2026-09-17T18:45:56.351Z","updatedAt":"2026-09-17T18:45:56.351Z"},{"id":4710,"surahId":51,"surah":{"id":51,"number":51,"nameArabic":"الذاريات","nameUz":"Zoriyot","meaningUz":"Sochuvchi shamollar","revelationPlace":"makka","totalAyahs":60,"startPage":520,"createdAt":"2026-09-17T18:45:07.653Z","updatedAt":"2026-09-18T00:07:52.540Z"},"numberInSurah":35,"textArabic":"فَأَخْرَجْنَا مَن كَانَ فِيهَا مِنَ ٱلْمُؤْمِنِينَ","translationUz":"Va Biz u joydan mo`minlarni chiqardik.","transcription":null,"tafsirUz":null,"pageNumber":522,"juz":27,"createdAt":"2026-09-17T18:45:56.355Z","updatedAt":"2026-09-17T18:45:56.355Z"},{"id":4711,"surahId":51,"surah":{"id":51,"number":51,"nameArabic":"الذاريات","nameUz":"Zoriyot","meaningUz":"Sochuvchi shamollar","revelationPlace":"makka","totalAyahs":60,"startPage":520,"createdAt":"2026-09-17T18:45:07.653Z","updatedAt":"2026-09-18T00:07:52.540Z"},"numberInSurah":36,"textArabic":"فَمَا وَجَدْنَا فِيهَا غَيْرَ بَيْتٍ مِّنَ ٱلْمُسْلِمِينَ","translationUz":"U yerda bir xonadondan boshqa musulmonlarni topmadik.","transcription":null,"tafsirUz":null,"pageNumber":522,"juz":27,"createdAt":"2026-09-17T18:45:56.359Z","updatedAt":"2026-09-17T18:45:56.359Z"},{"id":4712,"surahId":51,"surah":{"id":51,"number":51,"nameArabic":"الذاريات","nameUz":"Zoriyot","meaningUz":"Sochuvchi shamollar","revelationPlace":"makka","totalAyahs":60,"startPage":520,"createdAt":"2026-09-17T18:45:07.653Z","updatedAt":"2026-09-18T00:07:52.540Z"},"numberInSurah":37,"textArabic":"وَتَرَكْنَا فِيهَآ ءَايَةً لِّلَّذِينَ يَخَافُونَ ٱلْعَذَابَ ٱلْأَلِيمَ","translationUz":"Va u yerda alamli azobdan qo`rqadiganlar uchun oyat(belgi) qoldirdik.","transcription":null,"tafsirUz":null,"pageNumber":522,"juz":27,"createdAt":"2026-09-17T18:45:56.364Z","updatedAt":"2026-09-17T18:45:56.364Z"},{"id":4713,"surahId":51,"surah":{"id":51,"number":51,"nameArabic":"الذاريات","nameUz":"Zoriyot","meaningUz":"Sochuvchi shamollar","revelationPlace":"makka","totalAyahs":60,"startPage":520,"createdAt":"2026-09-17T18:45:07.653Z","updatedAt":"2026-09-18T00:07:52.540Z"},"numberInSurah":38,"textArabic":"وَفِى مُوسَىٰٓ إِذْ أَرْسَلْنَـٰهُ إِلَىٰ فِرْعَوْنَ بِسُلْطَـٰنٍ مُّبِينٍ","translationUz":"Va Musoda ham (belgi) bor. Biz uni Fir'avnga ravshan hujjat ila yuborganimizda...","transcription":null,"tafsirUz":null,"pageNumber":522,"juz":27,"createdAt":"2026-09-17T18:45:56.368Z","updatedAt":"2026-09-17T18:45:56.368Z"},{"id":4714,"surahId":51,"surah":{"id":51,"number":51,"nameArabic":"الذاريات","nameUz":"Zoriyot","meaningUz":"Sochuvchi shamollar","revelationPlace":"makka","totalAyahs":60,"startPage":520,"createdAt":"2026-09-17T18:45:07.653Z","updatedAt":"2026-09-18T00:07:52.540Z"},"numberInSurah":39,"textArabic":"فَتَوَلَّىٰ بِرُكْنِهِۦ وَقَالَ سَـٰحِرٌ أَوْ مَجْنُونٌ","translationUz":"U yuz o`girib, ishongani tomon yurdi va: «(Muso) sehrgar yoki majnundir», dedi.","transcription":null,"tafsirUz":null,"pageNumber":522,"juz":27,"createdAt":"2026-09-17T18:45:56.372Z","updatedAt":"2026-09-17T18:45:56.372Z"},{"id":4715,"surahId":51,"surah":{"id":51,"number":51,"nameArabic":"الذاريات","nameUz":"Zoriyot","meaningUz":"Sochuvchi shamollar","revelationPlace":"makka","totalAyahs":60,"startPage":520,"createdAt":"2026-09-17T18:45:07.653Z","updatedAt":"2026-09-18T00:07:52.540Z"},"numberInSurah":40,"textArabic":"فَأَخَذْنَـٰهُ وَجُنُودَهُۥ فَنَبَذْنَـٰهُمْ فِى ٱلْيَمِّ وَهُوَ مُلِيمٌ","translationUz":"Bas, Biz uni va askarlarini tutib dengizga tashladik va u malomatga loyiq ish qiluvchi edi.","transcription":null,"tafsirUz":null,"pageNumber":522,"juz":27,"createdAt":"2026-09-17T18:45:56.376Z","updatedAt":"2026-09-17T18:45:56.376Z"},{"id":4716,"surahId":51,"surah":{"id":51,"number":51,"nameArabic":"الذاريات","nameUz":"Zoriyot","meaningUz":"Sochuvchi shamollar","revelationPlace":"makka","totalAyahs":60,"startPage":520,"createdAt":"2026-09-17T18:45:07.653Z","updatedAt":"2026-09-18T00:07:52.540Z"},"numberInSurah":41,"textArabic":"وَفِى عَادٍ إِذْ أَرْسَلْنَا عَلَيْهِمُ ٱلرِّيحَ ٱلْعَقِيمَ","translationUz":"Va Odda ham (belgi) bor. Vaqtiki, Biz ularga tug`mas shamolni yubordik.","transcription":null,"tafsirUz":null,"pageNumber":522,"juz":27,"createdAt":"2026-09-17T18:45:56.380Z","updatedAt":"2026-09-17T18:45:56.380Z"},{"id":4717,"surahId":51,"surah":{"id":51,"number":51,"nameArabic":"الذاريات","nameUz":"Zoriyot","meaningUz":"Sochuvchi shamollar","revelationPlace":"makka","totalAyahs":60,"startPage":520,"createdAt":"2026-09-17T18:45:07.653Z","updatedAt":"2026-09-18T00:07:52.540Z"},"numberInSurah":42,"textArabic":"مَا تَذَرُ مِن شَىْءٍ أَتَتْ عَلَيْهِ إِلَّا جَعَلَتْهُ كَٱلرَّمِيمِ","translationUz":"U qaysi narsaga yetib borsa, titib tashlamasdan qo`ymas.","transcription":null,"tafsirUz":null,"pageNumber":522,"juz":27,"createdAt":"2026-09-17T18:45:56.384Z","updatedAt":"2026-09-17T18:45:56.384Z"},{"id":4718,"surahId":51,"surah":{"id":51,"number":51,"nameArabic":"الذاريات","nameUz":"Zoriyot","meaningUz":"Sochuvchi shamollar","revelationPlace":"makka","totalAyahs":60,"startPage":520,"createdAt":"2026-09-17T18:45:07.653Z","updatedAt":"2026-09-18T00:07:52.540Z"},"numberInSurah":43,"textArabic":"وَفِى ثَمُودَ إِذْ قِيلَ لَهُمْ تَمَتَّعُوا۟ حَتَّىٰ حِينٍ","translationUz":"Va Samudda ham (belgi) bor. Ularga: «Vaqtinchalik maza qilib turinglar», deyilgan vaqtda...","transcription":null,"tafsirUz":null,"pageNumber":522,"juz":27,"createdAt":"2026-09-17T18:45:56.388Z","updatedAt":"2026-09-17T18:45:56.388Z"},{"id":4719,"surahId":51,"surah":{"id":51,"number":51,"nameArabic":"الذاريات","nameUz":"Zoriyot","meaningUz":"Sochuvchi shamollar","revelationPlace":"makka","totalAyahs":60,"startPage":520,"createdAt":"2026-09-17T18:45:07.653Z","updatedAt":"2026-09-18T00:07:52.540Z"},"numberInSurah":44,"textArabic":"فَعَتَوْا۟ عَنْ أَمْرِ رَبِّهِمْ فَأَخَذَتْهُمُ ٱلصَّـٰعِقَةُ وَهُمْ يَنظُرُونَ","translationUz":"Allohning amridan bosh tortdilar, bas, qarab turgan hollarida ularni qattiq ovoz tutdi.","transcription":null,"tafsirUz":null,"pageNumber":522,"juz":27,"createdAt":"2026-09-17T18:45:56.392Z","updatedAt":"2026-09-17T18:45:56.392Z"},{"id":4720,"surahId":51,"surah":{"id":51,"number":51,"nameArabic":"الذاريات","nameUz":"Zoriyot","meaningUz":"Sochuvchi shamollar","revelationPlace":"makka","totalAyahs":60,"startPage":520,"createdAt":"2026-09-17T18:45:07.653Z","updatedAt":"2026-09-18T00:07:52.540Z"},"numberInSurah":45,"textArabic":"فَمَا ٱسْتَطَـٰعُوا۟ مِن قِيَامٍ وَمَا كَانُوا۟ مُنتَصِرِينَ","translationUz":"Bas, ular o`rinlaridan turolmadilar va yordam ham ololmadilar.","transcription":null,"tafsirUz":null,"pageNumber":522,"juz":27,"createdAt":"2026-09-17T18:45:56.396Z","updatedAt":"2026-09-17T18:45:56.396Z"},{"id":4721,"surahId":51,"surah":{"id":51,"number":51,"nameArabic":"الذاريات","nameUz":"Zoriyot","meaningUz":"Sochuvchi shamollar","revelationPlace":"makka","totalAyahs":60,"startPage":520,"createdAt":"2026-09-17T18:45:07.653Z","updatedAt":"2026-09-18T00:07:52.540Z"},"numberInSurah":46,"textArabic":"وَقَوْمَ نُوحٍ مِّن قَبْلُ ۖ إِنَّهُمْ كَانُوا۟ قَوْمًا فَـٰسِقِينَ","translationUz":"Va bundan avval Nuh qavmini ham (halok etganmiz). Albatta, ular fosiq qavm edilar.","transcription":null,"tafsirUz":null,"pageNumber":522,"juz":27,"createdAt":"2026-09-17T18:45:56.400Z","updatedAt":"2026-09-17T18:45:56.400Z"},{"id":4722,"surahId":51,"surah":{"id":51,"number":51,"nameArabic":"الذاريات","nameUz":"Zoriyot","meaningUz":"Sochuvchi shamollar","revelationPlace":"makka","totalAyahs":60,"startPage":520,"createdAt":"2026-09-17T18:45:07.653Z","updatedAt":"2026-09-18T00:07:52.540Z"},"numberInSurah":47,"textArabic":"وَٱلسَّمَآءَ بَنَيْنَـٰهَا بِأَيْي۟دٍ وَإِنَّا لَمُوسِعُونَ","translationUz":"Osmonni O`z qo`limizda(qudratimiz) ila bino qildik. Albatta, Biz uni kengaytiruvchimiz.","transcription":null,"tafsirUz":null,"pageNumber":522,"juz":27,"createdAt":"2026-09-17T18:45:56.404Z","updatedAt":"2026-09-17T18:45:56.404Z"},{"id":4723,"surahId":51,"surah":{"id":51,"number":51,"nameArabic":"الذاريات","nameUz":"Zoriyot","meaningUz":"Sochuvchi shamollar","revelationPlace":"makka","totalAyahs":60,"startPage":520,"createdAt":"2026-09-17T18:45:07.653Z","updatedAt":"2026-09-18T00:07:52.540Z"},"numberInSurah":48,"textArabic":"وَٱلْأَرْضَ فَرَشْنَـٰهَا فَنِعْمَ ٱلْمَـٰهِدُونَ","translationUz":"Va yerni to`shab qo`ydik. Biz qandoq ham yaxshi tayyorlovchidirmiz!","transcription":null,"tafsirUz":null,"pageNumber":522,"juz":27,"createdAt":"2026-09-17T18:45:56.408Z","updatedAt":"2026-09-17T18:45:56.408Z"},{"id":4724,"surahId":51,"surah":{"id":51,"number":51,"nameArabic":"الذاريات","nameUz":"Zoriyot","meaningUz":"Sochuvchi shamollar","revelationPlace":"makka","totalAyahs":60,"startPage":520,"createdAt":"2026-09-17T18:45:07.653Z","updatedAt":"2026-09-18T00:07:52.540Z"},"numberInSurah":49,"textArabic":"وَمِن كُلِّ شَىْءٍ خَلَقْنَا زَوْجَيْنِ لَعَلَّكُمْ تَذَكَّرُونَ","translationUz":"Va Biz har bir narsani juft yaratdik. Shoyadki, eslasangizlar.","transcription":null,"tafsirUz":null,"pageNumber":522,"juz":27,"createdAt":"2026-09-17T18:45:56.412Z","updatedAt":"2026-09-17T18:45:56.412Z"},{"id":4725,"surahId":51,"surah":{"id":51,"number":51,"nameArabic":"الذاريات","nameUz":"Zoriyot","meaningUz":"Sochuvchi shamollar","revelationPlace":"makka","totalAyahs":60,"startPage":520,"createdAt":"2026-09-17T18:45:07.653Z","updatedAt":"2026-09-18T00:07:52.540Z"},"numberInSurah":50,"textArabic":"فَفِرُّوٓا۟ إِلَى ٱللَّهِ ۖ إِنِّى لَكُم مِّنْهُ نَذِيرٌ مُّبِينٌ","translationUz":"Bas, faqat Allohgagina qoching. Albatta, men sizlarga Undan (kelgan) ochiq-oydin ogohlantiruvchiman.","transcription":null,"tafsirUz":null,"pageNumber":522,"juz":27,"createdAt":"2026-09-17T18:45:56.416Z","updatedAt":"2026-09-17T18:45:56.416Z"},{"id":4726,"surahId":51,"surah":{"id":51,"number":51,"nameArabic":"الذاريات","nameUz":"Zoriyot","meaningUz":"Sochuvchi shamollar","revelationPlace":"makka","totalAyahs":60,"startPage":520,"createdAt":"2026-09-17T18:45:07.653Z","updatedAt":"2026-09-18T00:07:52.540Z"},"numberInSurah":51,"textArabic":"وَلَا تَجْعَلُوا۟ مَعَ ٱللَّهِ إِلَـٰهًا ءَاخَرَ ۖ إِنِّى لَكُم مِّنْهُ نَذِيرٌ مُّبِينٌ","translationUz":"Va Allohga boshqa ma'budni sherik qilmanglar. Albatta, men sizlarga Undan (kelgan) ochiq-oydin ogohlantiruvchiman.","transcription":null,"tafsirUz":null,"pageNumber":522,"juz":27,"createdAt":"2026-09-17T18:45:56.420Z","updatedAt":"2026-09-17T18:45:56.420Z"}]}