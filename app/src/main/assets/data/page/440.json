{"number":440,"textArabic":null,"translationUz":null,"juz":null,"note":null,"updatedAt":null,"ayahs":[{"id":3705,"surahId":35,"surah":{"id":35,"number":35,"nameArabic":"فاطر","nameUz":"Fotir","meaningUz":"Yaratuvchi","revelationPlace":"makka","totalAyahs":45,"startPage":434,"createdAt":"2026-09-17T18:45:07.574Z","updatedAt":"2026-09-18T00:07:52.468Z"},"numberInSurah":45,"textArabic":"وَلَوْ يُؤَاخِذُ ٱللَّهُ ٱلنَّاسَ بِمَا كَسَبُوا۟ مَا تَرَكَ عَلَىٰ ظَهْرِهَا مِن دَآبَّةٍ وَلَـٰكِن يُؤَخِّرُهُمْ إِلَىٰٓ أَجَلٍ مُّسَمًّى ۖ فَإِذَا جَآءَ أَجَلُهُمْ فَإِنَّ ٱللَّهَ كَانَ بِعِبَادِهِۦ بَصِيرًۢا","translationUz":"Agar Alloh odamlarni qilganlariga yarasha oladigan bo`lsa, yer ustida qimir etgan jonivorni qo`ymas edi. Lekin ularni belgilangan muddatgacha qo`yib qo`yur. O`sha ajallari kelganda esa... Bas, albatta, Alloh bandalarini ko`rib turguvchi Zotdir.","transcription":null,"tafsirUz":null,"pageNumber":440,"juz":22,"createdAt":"2026-09-17T18:45:45.683Z","updatedAt":"2026-09-17T18:45:45.683Z"},{"id":3706,"surahId":36,"surah":{"id":36,"number":36,"nameArabic":"يس","nameUz":"Yosin","meaningUz":"Yosin","revelationPlace":"makka","totalAyahs":83,"startPage":440,"createdAt":"2026-09-17T18:45:07.579Z","updatedAt":"2026-09-18T00:07:52.474Z"},"numberInSurah":1,"textArabic":" يسٓ","translationUz":"Yaasiyn.","transcription":null,"tafsirUz":null,"pageNumber":440,"juz":22,"createdAt":"2026-09-17T18:45:46.770Z","updatedAt":"2026-09-17T18:45:46.770Z"},{"id":3707,"surahId":36,"surah":{"id":36,"number":36,"nameArabic":"يس","nameUz":"Yosin","meaningUz":"Yosin","revelationPlace":"makka","totalAyahs":83,"startPage":440,"createdAt":"2026-09-17T18:45:07.579Z","updatedAt":"2026-09-18T00:07:52.474Z"},"numberInSurah":2,"textArabic":"وَٱلْقُرْءَانِ ٱلْحَكِيمِ","translationUz":"Qur'oni Hakim ila qasam.","transcription":null,"tafsirUz":null,"pageNumber":440,"juz":22,"createdAt":"2026-09-17T18:45:46.776Z","updatedAt":"2026-09-17T18:45:46.776Z"},{"id":3708,"surahId":36,"surah":{"id":36,"number":36,"nameArabic":"يس","nameUz":"Yosin","meaningUz":"Yosin","revelationPlace":"makka","totalAyahs":83,"startPage":440,"createdAt":"2026-09-17T18:45:07.579Z","updatedAt":"2026-09-18T00:07:52.474Z"},"numberInSurah":3,"textArabic":"إِنَّكَ لَمِنَ ٱلْمُرْسَلِينَ","translationUz":"Albatta, sen Payg`ambarlardandirsan.","transcription":null,"tafsirUz":null,"pageNumber":440,"juz":22,"createdAt":"2026-09-17T18:45:46.780Z","updatedAt":"2026-09-17T18:45:46.780Z"},{"id":3709,"surahId":36,"surah":{"id":36,"number":36,"nameArabic":"يس","nameUz":"Yosin","meaningUz":"Yosin","revelationPlace":"makka","totalAyahs":83,"startPage":440,"createdAt":"2026-09-17T18:45:07.579Z","updatedAt":"2026-09-18T00:07:52.474Z"},"numberInSurah":4,"textArabic":"عَلَىٰ صِرَٰطٍ مُّسْتَقِيمٍ","translationUz":"Sirotul mustaqiymdasan.","transcription":null,"tafsirUz":null,"pageNumber":440,"juz":22,"createdAt":"2026-09-17T18:45:46.784Z","updatedAt":"2026-09-17T18:45:46.784Z"},{"id":3710,"surahId":36,"surah":{"id":36,"number":36,"nameArabic":"يس","nameUz":"Yosin","meaningUz":"Yosin","revelationPlace":"makka","totalAyahs":83,"startPage":440,"createdAt":"2026-09-17T18:45:07.579Z","updatedAt":"2026-09-18T00:07:52.474Z"},"numberInSurah":5,"textArabic":"تَنزِيلَ ٱلْعَزِيزِ ٱلرَّحِيمِ","translationUz":"Bu Aziyzu Rohiymning nozil qilganidir.","transcription":null,"tafsirUz":null,"pageNumber":440,"juz":22,"createdAt":"2026-09-17T18:45:46.789Z","updatedAt":"2026-09-17T18:45:46.789Z"},{"id":3711,"surahId":36,"surah":{"id":36,"number":36,"nameArabic":"يس","nameUz":"Yosin","meaningUz":"Yosin","revelationPlace":"makka","totalAyahs":83,"startPage":440,"createdAt":"2026-09-17T18:45:07.579Z","updatedAt":"2026-09-18T00:07:52.474Z"},"numberInSurah":6,"textArabic":"لِتُنذِرَ قَوْمًا مَّآ أُنذِرَ ءَابَآؤُهُمْ فَهُمْ غَـٰفِلُونَ","translationUz":"Ota-bobolari ogohlantirilmagan, o`zlari ham g`ofil bo`lgan qavmlarni ogohlantirishing uchun.","transcription":null,"tafsirUz":null,"pageNumber":440,"juz":22,"createdAt":"2026-09-17T18:45:46.793Z","updatedAt":"2026-09-17T18:45:46.793Z"},{"id":3712,"surahId":36,"surah":{"id":36,"number":36,"nameArabic":"يس","nameUz":"Yosin","meaningUz":"Yosin","revelationPlace":"makka","totalAyahs":83,"startPage":440,"createdAt":"2026-09-17T18:45:07.579Z","updatedAt":"2026-09-18T00:07:52.474Z"},"numberInSurah":7,"textArabic":"لَقَدْ حَقَّ ٱلْقَوْلُ عَلَىٰٓ أَكْثَرِهِمْ فَهُمْ لَا يُؤْمِنُونَ","translationUz":"Batahqiq, ularning ko`plariga (azob) so`zi haq bo`ldi. Bas, ular iymon keltirmaslar.","transcription":null,"tafsirUz":null,"pageNumber":440,"juz":22,"createdAt":"2026-09-17T18:45:46.797Z","updatedAt":"2026-09-17T18:45:46.797Z"},{"id":3713,"surahId":36,"surah":{"id":36,"number":36,"nameArabic":"يس","nameUz":"Yosin","meaningUz":"Yosin","revelationPlace":"makka","totalAyahs":83,"startPage":440,"createdAt":"2026-09-17T18:45:07.579Z","updatedAt":"2026-09-18T00:07:52.474Z"},"numberInSurah":8,"textArabic":"إِنَّا جَعَلْنَا فِىٓ أَعْنَـٰقِهِمْ أَغْلَـٰلًا فَهِىَ إِلَى ٱلْأَذْقَانِ فَهُم مُّقْمَحُونَ","translationUz":"Biz ularning bo`yinlariga kishanlar soldik. Ular iyaklarigacha yetadir. Bas, ular ko`zlari yumuq, osmonga qarab g`o`dayib qoldilar.","transcription":null,"tafsirUz":null,"pageNumber":440,"juz":22,"createdAt":"2026-09-17T18:45:46.801Z","updatedAt":"2026-09-17T18:45:46.801Z"},{"id":3714,"surahId":36,"surah":{"id":36,"number":36,"nameArabic":"يس","nameUz":"Yosin","meaningUz":"Yosin","revelationPlace":"makka","totalAyahs":83,"startPage":440,"createdAt":"2026-09-17T18:45:07.579Z","updatedAt":"2026-09-18T00:07:52.474Z"},"numberInSurah":9,"textArabic":"وَجَعَلْنَا مِنۢ بَيْنِ أَيْدِيهِمْ سَدًّا وَمِنْ خَلْفِهِمْ سَدًّا فَأَغْشَيْنَـٰهُمْ فَهُمْ لَا يُبْصِرُونَ","translationUz":"Va Biz ularning oldidan ham to`siq qildik, orqalaridan ham to`siq qildik, ko`zlariga parda tortdik. Bas, ular ko`rmaslar.","transcription":null,"tafsirUz":null,"pageNumber":440,"juz":22,"createdAt":"2026-09-17T18:45:46.805Z","updatedAt":"2026-09-17T18:45:46.805Z"},{"id":3715,"surahId":36,"surah":{"id":36,"number":36,"nameArabic":"يس","nameUz":"Yosin","meaningUz":"Yosin","revelationPlace":"makka","totalAyahs":83,"startPage":440,"createdAt":"2026-09-17T18:45:07.579Z","updatedAt":"2026-09-18T00:07:52.474Z"},"numberInSurah":10,"textArabic":"وَسَوَآءٌ عَلَيْهِمْ ءَأَنذَرْتَهُمْ أَمْ لَمْ تُنذِرْهُمْ لَا يُؤْمِنُونَ","translationUz":"Va ularga bari birdir — qo`rqitsang ham va yoki qo`rqitmasang ham — iymonga kelmaslar.","transcription":null,"tafsirUz":null,"pageNumber":440,"juz":22,"createdAt":"2026-09-17T18:45:46.809Z","updatedAt":"2026-09-17T18:45:46.809Z"},{"id":3716,"surahId":36,"surah":{"id":36,"number":36,"nameArabic":"يس","nameUz":"Yosin","meaningUz":"Yosin","revelationPlace":"makka","totalAyahs":83,"startPage":440,"createdAt":"2026-09-17T18:45:07.579Z","updatedAt":"2026-09-18T00:07:52.474Z"},"numberInSurah":11,"textArabic":"إِنَّمَا تُنذِرُ مَنِ ٱتَّبَعَ ٱلذِّكْرَ وَخَشِىَ ٱلرَّحْمَـٰنَ بِٱلْغَيْبِ ۖ فَبَشِّرْهُ بِمَغْفِرَةٍ وَأَجْرٍ كَرِيمٍ","translationUz":"Sen esa, faqat Zikr(eslatma)ga ergashgan va Rohmandan g`oyibona qo`rqqan kimsani ogohlantirursan. Bas, unga mag`firat va go`zal ajrning xushxabarini ber.","transcription":null,"tafsirUz":null,"pageNumber":440,"juz":22,"createdAt":"2026-09-17T18:45:46.814Z","updatedAt":"2026-09-17T18:45:46.814Z"},{"id":3717,"surahId":36,"surah":{"id":36,"number":36,"nameArabic":"يس","nameUz":"Yosin","meaningUz":"Yosin","revelationPlace":"makka","totalAyahs":83,"startPage":440,"createdAt":"2026-09-17T18:45:07.579Z","updatedAt":"2026-09-18T00:07:52.474Z"},"numberInSurah":12,"textArabic":"إِنَّا نَحْنُ نُحْىِ ٱلْمَوْتَىٰ وَنَكْتُبُ مَا قَدَّمُوا۟ وَءَاثَـٰرَهُمْ ۚ وَكُلَّ شَىْءٍ أَحْصَيْنَـٰهُ فِىٓ إِمَامٍ مُّبِينٍ","translationUz":"Albatta, Biz O`zimiz o`liklarni tiriltirurmiz va ular taqdim qilgan narsalarni va qoldirgan asarlarni yozurmiz. Ochiq-oydin imomda(ya'ni nomai a'molda) har bir narsaning hisobini olib qo`yganmiz.","transcription":null,"tafsirUz":null,"pageNumber":440,"juz":22,"createdAt":"2026-09-17T18:45:46.818Z","updatedAt":"2026-09-17T18:45:46.818Z"}]}