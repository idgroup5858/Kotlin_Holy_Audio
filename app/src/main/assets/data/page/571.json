{"number":571,"textArabic":null,"translationUz":null,"juz":null,"note":null,"updatedAt":null,"ayahs":[{"id":5430,"surahId":71,"surah":{"id":71,"number":71,"nameArabic":"نوح","nameUz":"Nuh","meaningUz":"Nuh alayhissalom","revelationPlace":"makka","totalAyahs":28,"startPage":570,"createdAt":"2026-09-17T18:45:07.750Z","updatedAt":"2026-09-18T00:07:52.616Z"},"numberInSurah":11,"textArabic":"يُرْسِلِ ٱلسَّمَآءَ عَلَيْكُم مِّدْرَارًا","translationUz":"«U zot osmondan ustingizga ketma-ket baraka yomg`irini yuboradir.","transcription":null,"tafsirUz":null,"pageNumber":571,"juz":29,"createdAt":"2026-09-17T18:46:04.929Z","updatedAt":"2026-09-17T18:46:04.929Z"},{"id":5431,"surahId":71,"surah":{"id":71,"number":71,"nameArabic":"نوح","nameUz":"Nuh","meaningUz":"Nuh alayhissalom","revelationPlace":"makka","totalAyahs":28,"startPage":570,"createdAt":"2026-09-17T18:45:07.750Z","updatedAt":"2026-09-18T00:07:52.616Z"},"numberInSurah":12,"textArabic":"وَيُمْدِدْكُم بِأَمْوَٰلٍ وَبَنِينَ وَيَجْعَل لَّكُمْ جَنَّـٰتٍ وَيَجْعَل لَّكُمْ أَنْهَـٰرًا","translationUz":"Va sizga molu mulk va bola-chaqa ila madad beradir va sizlarga bog`u rog`lar hamda anhorlarni beradir.","transcription":null,"tafsirUz":null,"pageNumber":571,"juz":29,"createdAt":"2026-09-17T18:46:04.932Z","updatedAt":"2026-09-17T18:46:04.932Z"},{"id":5432,"surahId":71,"surah":{"id":71,"number":71,"nameArabic":"نوح","nameUz":"Nuh","meaningUz":"Nuh alayhissalom","revelationPlace":"makka","totalAyahs":28,"startPage":570,"createdAt":"2026-09-17T18:45:07.750Z","updatedAt":"2026-09-18T00:07:52.616Z"},"numberInSurah":13,"textArabic":"مَّا لَكُمْ لَا تَرْجُونَ لِلَّهِ وَقَارًا","translationUz":"Sizlarga nima bo`ldiki, Allohning azamatini o`ylab ko`rmaysizlar?","transcription":null,"tafsirUz":null,"pageNumber":571,"juz":29,"createdAt":"2026-09-17T18:46:04.936Z","updatedAt":"2026-09-17T18:46:04.936Z"},{"id":5433,"surahId":71,"surah":{"id":71,"number":71,"nameArabic":"نوح","nameUz":"Nuh","meaningUz":"Nuh alayhissalom","revelationPlace":"makka","totalAyahs":28,"startPage":570,"createdAt":"2026-09-17T18:45:07.750Z","updatedAt":"2026-09-18T00:07:52.616Z"},"numberInSurah":14,"textArabic":"وَقَدْ خَلَقَكُمْ أَطْوَارًا","translationUz":"Holbuki, U sizlarni holatma-holat yaratdi.","transcription":null,"tafsirUz":null,"pageNumber":571,"juz":29,"createdAt":"2026-09-17T18:46:04.940Z","updatedAt":"2026-09-17T18:46:04.940Z"},{"id":5434,"surahId":71,"surah":{"id":71,"number":71,"nameArabic":"نوح","nameUz":"Nuh","meaningUz":"Nuh alayhissalom","revelationPlace":"makka","totalAyahs":28,"startPage":570,"createdAt":"2026-09-17T18:45:07.750Z","updatedAt":"2026-09-18T00:07:52.616Z"},"numberInSurah":15,"textArabic":"أَلَمْ تَرَوْا۟ كَيْفَ خَلَقَ ٱللَّهُ سَبْعَ سَمَـٰوَٰتٍ طِبَاقًا","translationUz":"Alloh yetti osmonni qandoq qilib tabaqama-tabaqa yaratib qo`yganini ko`rmadingizmi?","transcription":null,"tafsirUz":null,"pageNumber":571,"juz":29,"createdAt":"2026-09-17T18:46:04.944Z","updatedAt":"2026-09-17T18:46:04.944Z"},{"id":5435,"surahId":71,"surah":{"id":71,"number":71,"nameArabic":"نوح","nameUz":"Nuh","meaningUz":"Nuh alayhissalom","revelationPlace":"makka","totalAyahs":28,"startPage":570,"createdAt":"2026-09-17T18:45:07.750Z","updatedAt":"2026-09-18T00:07:52.616Z"},"numberInSurah":16,"textArabic":"وَجَعَلَ ٱلْقَمَرَ فِيهِنَّ نُورًا وَجَعَلَ ٱلشَّمْسَ سِرَاجًا","translationUz":"Va ular ichida oyni nur va quyoshni chiroq qilib qo`yganini ko`rmadingizmi?","transcription":null,"tafsirUz":null,"pageNumber":571,"juz":29,"createdAt":"2026-09-17T18:46:04.948Z","updatedAt":"2026-09-17T18:46:04.948Z"},{"id":5436,"surahId":71,"surah":{"id":71,"number":71,"nameArabic":"نوح","nameUz":"Nuh","meaningUz":"Nuh alayhissalom","revelationPlace":"makka","totalAyahs":28,"startPage":570,"createdAt":"2026-09-17T18:45:07.750Z","updatedAt":"2026-09-18T00:07:52.616Z"},"numberInSurah":17,"textArabic":"وَٱللَّهُ أَنۢبَتَكُم مِّنَ ٱلْأَرْضِ نَبَاتًا","translationUz":"Va Alloh sizlarni yerdan o`stirib chiqaradir.","transcription":null,"tafsirUz":null,"pageNumber":571,"juz":29,"createdAt":"2026-09-17T18:46:04.951Z","updatedAt":"2026-09-17T18:46:04.951Z"},{"id":5437,"surahId":71,"surah":{"id":71,"number":71,"nameArabic":"نوح","nameUz":"Nuh","meaningUz":"Nuh alayhissalom","revelationPlace":"makka","totalAyahs":28,"startPage":570,"createdAt":"2026-09-17T18:45:07.750Z","updatedAt":"2026-09-18T00:07:52.616Z"},"numberInSurah":18,"textArabic":"ثُمَّ يُعِيدُكُمْ فِيهَا وَيُخْرِجُكُمْ إِخْرَاجًا","translationUz":"So`ngra sizlarni unga qaytaradir va yana chiqaradir.","transcription":null,"tafsirUz":null,"pageNumber":571,"juz":29,"createdAt":"2026-09-17T18:46:04.955Z","updatedAt":"2026-09-17T18:46:04.955Z"},{"id":5438,"surahId":71,"surah":{"id":71,"number":71,"nameArabic":"نوح","nameUz":"Nuh","meaningUz":"Nuh alayhissalom","revelationPlace":"makka","totalAyahs":28,"startPage":570,"createdAt":"2026-09-17T18:45:07.750Z","updatedAt":"2026-09-18T00:07:52.616Z"},"numberInSurah":19,"textArabic":"وَٱللَّهُ جَعَلَ لَكُمُ ٱلْأَرْضَ بِسَاطًا","translationUz":"Va Alloh sizlarga yerni gilamdek to`shab qo`ydi.","transcription":null,"tafsirUz":null,"pageNumber":571,"juz":29,"createdAt":"2026-09-17T18:46:04.959Z","updatedAt":"2026-09-17T18:46:04.959Z"},{"id":5439,"surahId":71,"surah":{"id":71,"number":71,"nameArabic":"نوح","nameUz":"Nuh","meaningUz":"Nuh alayhissalom","revelationPlace":"makka","totalAyahs":28,"startPage":570,"createdAt":"2026-09-17T18:45:07.750Z","updatedAt":"2026-09-18T00:07:52.616Z"},"numberInSurah":20,"textArabic":"لِّتَسْلُكُوا۟ مِنْهَا سُبُلًا فِجَاجًا","translationUz":"Unda siz keng yo`llardan yurishingiz uchun», dedi.","transcription":null,"tafsirUz":null,"pageNumber":571,"juz":29,"createdAt":"2026-09-17T18:46:04.962Z","updatedAt":"2026-09-17T18:46:04.962Z"},{"id":5440,"surahId":71,"surah":{"id":71,"number":71,"nameArabic":"نوح","nameUz":"Nuh","meaningUz":"Nuh alayhissalom","revelationPlace":"makka","totalAyahs":28,"startPage":570,"createdAt":"2026-09-17T18:45:07.750Z","updatedAt":"2026-09-18T00:07:52.616Z"},"numberInSurah":21,"textArabic":"قَالَ نُوحٌ رَّبِّ إِنَّهُمْ عَصَوْنِى وَٱتَّبَعُوا۟ مَن لَّمْ يَزِدْهُ مَالُهُۥ وَوَلَدُهُۥٓ إِلَّا خَسَارًا","translationUz":"Nuh: «Ey Robbim, albatta, ular menga isyon qildilar va moli, bola-chaqasi xusrondan boshqani ziyoda qilmaganga ergashdilar.","transcription":null,"tafsirUz":null,"pageNumber":571,"juz":29,"createdAt":"2026-09-17T18:46:04.966Z","updatedAt":"2026-09-17T18:46:04.966Z"},{"id":5441,"surahId":71,"surah":{"id":71,"number":71,"nameArabic":"نوح","nameUz":"Nuh","meaningUz":"Nuh alayhissalom","revelationPlace":"makka","totalAyahs":28,"startPage":570,"createdAt":"2026-09-17T18:45:07.750Z","updatedAt":"2026-09-18T00:07:52.616Z"},"numberInSurah":22,"textArabic":"وَمَكَرُوا۟ مَكْرًا كُبَّارًا","translationUz":"Va nihoyatda ulkan makr qildilar.","transcription":null,"tafsirUz":null,"pageNumber":571,"juz":29,"createdAt":"2026-09-17T18:46:04.969Z","updatedAt":"2026-09-17T18:46:04.969Z"},{"id":5442,"surahId":71,"surah":{"id":71,"number":71,"nameArabic":"نوح","nameUz":"Nuh","meaningUz":"Nuh alayhissalom","revelationPlace":"makka","totalAyahs":28,"startPage":570,"createdAt":"2026-09-17T18:45:07.750Z","updatedAt":"2026-09-18T00:07:52.616Z"},"numberInSurah":23,"textArabic":"وَقَالُوا۟ لَا تَذَرُنَّ ءَالِهَتَكُمْ وَلَا تَذَرُنَّ وَدًّا وَلَا سُوَاعًا وَلَا يَغُوثَ وَيَعُوقَ وَنَسْرًا","translationUz":"Va ular: «Olihalaringizni hech tark qilmanglar, va, albatta, Vaddni ham, Suva'ni ham, Yag`usni ham, Ya'uqni ham va Nasrni ham tark qilmang», dedilar.","transcription":null,"tafsirUz":null,"pageNumber":571,"juz":29,"createdAt":"2026-09-17T18:46:04.973Z","updatedAt":"2026-09-17T18:46:04.973Z"},{"id":5443,"surahId":71,"surah":{"id":71,"number":71,"nameArabic":"نوح","nameUz":"Nuh","meaningUz":"Nuh alayhissalom","revelationPlace":"makka","totalAyahs":28,"startPage":570,"createdAt":"2026-09-17T18:45:07.750Z","updatedAt":"2026-09-18T00:07:52.616Z"},"numberInSurah":24,"textArabic":"وَقَدْ أَضَلُّوا۟ كَثِيرًا ۖ وَلَا تَزِدِ ٱلظَّـٰلِمِينَ إِلَّا ضَلَـٰلًا","translationUz":"Darhaqiqat, ular ko`plarini adashtirdi. Va Sen zolimlarga zalolatdan boshqani ziyoda qilma», dedi.","transcription":null,"tafsirUz":null,"pageNumber":571,"juz":29,"createdAt":"2026-09-17T18:46:04.976Z","updatedAt":"2026-09-17T18:46:04.976Z"},{"id":5444,"surahId":71,"surah":{"id":71,"number":71,"nameArabic":"نوح","nameUz":"Nuh","meaningUz":"Nuh alayhissalom","revelationPlace":"makka","totalAyahs":28,"startPage":570,"createdAt":"2026-09-17T18:45:07.750Z","updatedAt":"2026-09-18T00:07:52.616Z"},"numberInSurah":25,"textArabic":"مِّمَّا خَطِيٓـَٔـٰتِهِمْ أُغْرِقُوا۟ فَأُدْخِلُوا۟ نَارًا فَلَمْ يَجِدُوا۟ لَهُم مِّن دُونِ ٱللَّهِ أَنصَارًا","translationUz":"Ular xatolari tufayli g`arq qilindilar, bas, olovga kiritildilar. Bas, o`zlariga Allohdan o`zga yordamchi topa olmadilar.","transcription":null,"tafsirUz":null,"pageNumber":571,"juz":29,"createdAt":"2026-09-17T18:46:04.980Z","updatedAt":"2026-09-17T18:46:04.980Z"},{"id":5445,"surahId":71,"surah":{"id":71,"number":71,"nameArabic":"نوح","nameUz":"Nuh","meaningUz":"Nuh alayhissalom","revelationPlace":"makka","totalAyahs":28,"startPage":570,"createdAt":"2026-09-17T18:45:07.750Z","updatedAt":"2026-09-18T00:07:52.616Z"},"numberInSurah":26,"textArabic":"وَقَالَ نُوحٌ رَّبِّ لَا تَذَرْ عَلَى ٱلْأَرْضِ مِنَ ٱلْكَـٰفِرِينَ دَيَّارًا","translationUz":"Va Nuh: «Ey Robbim, yer yuzida kofirlardan birorta ham harakatlanuvchini qo`ymagin.","transcription":null,"tafsirUz":null,"pageNumber":571,"juz":29,"createdAt":"2026-09-17T18:46:04.984Z","updatedAt":"2026-09-17T18:46:04.984Z"},{"id":5446,"surahId":71,"surah":{"id":71,"number":71,"nameArabic":"نوح","nameUz":"Nuh","meaningUz":"Nuh alayhissalom","revelationPlace":"makka","totalAyahs":28,"startPage":570,"createdAt":"2026-09-17T18:45:07.750Z","updatedAt":"2026-09-18T00:07:52.616Z"},"numberInSurah":27,"textArabic":"إِنَّكَ إِن تَذَرْهُمْ يُضِلُّوا۟ عِبَادَكَ وَلَا يَلِدُوٓا۟ إِلَّا فَاجِرًا كَفَّارًا","translationUz":"Albatta, sen ularni tek qo`ysang, bandalaringni adashtiradilar va fojiru kofirdan boshqa tug`maslar.","transcription":null,"tafsirUz":null,"pageNumber":571,"juz":29,"createdAt":"2026-09-17T18:46:04.988Z","updatedAt":"2026-09-17T18:46:04.988Z"},{"id":5447,"surahId":71,"surah":{"id":71,"number":71,"nameArabic":"نوح","nameUz":"Nuh","meaningUz":"Nuh alayhissalom","revelationPlace":"makka","totalAyahs":28,"startPage":570,"createdAt":"2026-09-17T18:45:07.750Z","updatedAt":"2026-09-18T00:07:52.616Z"},"numberInSurah":28,"textArabic":"رَّبِّ ٱغْفِرْ لِى وَلِوَٰلِدَىَّ وَلِمَن دَخَلَ بَيْتِىَ مُؤْمِنًا وَلِلْمُؤْمِنِينَ وَٱلْمُؤْمِنَـٰتِ وَلَا تَزِدِ ٱلظَّـٰلِمِينَ إِلَّا تَبَارًۢا","translationUz":"Robbim, meni mag`firat qilgin, mening ota-onamni ham va uyimga mo`min bo`lib kirganlarni va mo`minlaru mo`minalarni ham. Va zolimlarga halokatdan o`zga narsani ziyoda qilma», dedi.","transcription":null,"tafsirUz":null,"pageNumber":571,"juz":29,"createdAt":"2026-09-17T18:46:04.992Z","updatedAt":"2026-09-17T18:46:04.992Z"}]}