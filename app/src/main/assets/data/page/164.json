{"number":164,"textArabic":null,"translationUz":null,"juz":null,"note":null,"updatedAt":null,"ayahs":[{"id":1059,"surahId":7,"surah":{"id":7,"number":7,"nameArabic":"الأعراف","nameUz":"Aʼrof","meaningUz":"Balandliklar","revelationPlace":"makka","totalAyahs":206,"startPage":151,"createdAt":"2026-09-17T18:45:07.433Z","updatedAt":"2026-09-18T00:07:52.328Z"},"numberInSurah":105,"textArabic":"حَقِيقٌ عَلَىٰٓ أَن لَّآ أَقُولَ عَلَى ٱللَّهِ إِلَّا ٱلْحَقَّ ۚ قَدْ جِئْتُكُم بِبَيِّنَةٍ مِّن رَّبِّكُمْ فَأَرْسِلْ مَعِىَ بَنِىٓ إِسْرَٰٓءِيلَ","translationUz":"Menga Alloh haqida haqdan boshqani aytmaslik lozimdir. Batahqiq, men sizlarga Robbingizdan ochiq-oydin hujjat keltirdim. Men ila Bani Isroilni qo`yib yubor», – dedi.","transcription":null,"tafsirUz":null,"pageNumber":164,"juz":9,"createdAt":"2026-09-17T18:45:18.721Z","updatedAt":"2026-09-17T18:45:18.721Z"},{"id":1060,"surahId":7,"surah":{"id":7,"number":7,"nameArabic":"الأعراف","nameUz":"Aʼrof","meaningUz":"Balandliklar","revelationPlace":"makka","totalAyahs":206,"startPage":151,"createdAt":"2026-09-17T18:45:07.433Z","updatedAt":"2026-09-18T00:07:52.328Z"},"numberInSurah":106,"textArabic":"قَالَ إِن كُنتَ جِئْتَ بِـَٔايَةٍ فَأْتِ بِهَآ إِن كُنتَ مِنَ ٱلصَّـٰدِقِينَ","translationUz":"U: «Agar mo`'jiza keltirgan bo`lsang, rostgo`ylardan bo`lsang, keltir uni», – dedi.","transcription":null,"tafsirUz":null,"pageNumber":164,"juz":9,"createdAt":"2026-09-17T18:45:18.725Z","updatedAt":"2026-09-17T18:45:18.725Z"},{"id":1061,"surahId":7,"surah":{"id":7,"number":7,"nameArabic":"الأعراف","nameUz":"Aʼrof","meaningUz":"Balandliklar","revelationPlace":"makka","totalAyahs":206,"startPage":151,"createdAt":"2026-09-17T18:45:07.433Z","updatedAt":"2026-09-18T00:07:52.328Z"},"numberInSurah":107,"textArabic":"فَأَلْقَىٰ عَصَاهُ فَإِذَا هِىَ ثُعْبَانٌ مُّبِينٌ","translationUz":"Asosini tashlagan edi... banogoh u aniq ajdar bo`ldi.","transcription":null,"tafsirUz":null,"pageNumber":164,"juz":9,"createdAt":"2026-09-17T18:45:18.730Z","updatedAt":"2026-09-17T18:45:18.730Z"},{"id":1062,"surahId":7,"surah":{"id":7,"number":7,"nameArabic":"الأعراف","nameUz":"Aʼrof","meaningUz":"Balandliklar","revelationPlace":"makka","totalAyahs":206,"startPage":151,"createdAt":"2026-09-17T18:45:07.433Z","updatedAt":"2026-09-18T00:07:52.328Z"},"numberInSurah":108,"textArabic":"وَنَزَعَ يَدَهُۥ فَإِذَا هِىَ بَيْضَآءُ لِلنَّـٰظِرِينَ","translationUz":"Va qo`lini chiqargan edi... banogoh u nazar soluvchilarga oppoq bo`lib ko`rindi.","transcription":null,"tafsirUz":null,"pageNumber":164,"juz":9,"createdAt":"2026-09-17T18:45:18.734Z","updatedAt":"2026-09-17T18:45:18.734Z"},{"id":1063,"surahId":7,"surah":{"id":7,"number":7,"nameArabic":"الأعراف","nameUz":"Aʼrof","meaningUz":"Balandliklar","revelationPlace":"makka","totalAyahs":206,"startPage":151,"createdAt":"2026-09-17T18:45:07.433Z","updatedAt":"2026-09-18T00:07:52.328Z"},"numberInSurah":109,"textArabic":"قَالَ ٱلْمَلَأُ مِن قَوْمِ فِرْعَوْنَ إِنَّ هَـٰذَا لَسَـٰحِرٌ عَلِيمٌ","translationUz":"Fir'avn qavmidan bo`lgan zodagonlar: «Albatta, bu bilimdon sehrgardir!","transcription":null,"tafsirUz":null,"pageNumber":164,"juz":9,"createdAt":"2026-09-17T18:45:18.738Z","updatedAt":"2026-09-17T18:45:18.738Z"},{"id":1064,"surahId":7,"surah":{"id":7,"number":7,"nameArabic":"الأعراف","nameUz":"Aʼrof","meaningUz":"Balandliklar","revelationPlace":"makka","totalAyahs":206,"startPage":151,"createdAt":"2026-09-17T18:45:07.433Z","updatedAt":"2026-09-18T00:07:52.328Z"},"numberInSurah":110,"textArabic":"يُرِيدُ أَن يُخْرِجَكُم مِّنْ أَرْضِكُمْ ۖ فَمَاذَا تَأْمُرُونَ","translationUz":"Sizlarni yeringizdan chiqarishni xohlaydi. Bas, nimaga amr qilasizlar?» – dedilar.","transcription":null,"tafsirUz":null,"pageNumber":164,"juz":9,"createdAt":"2026-09-17T18:45:18.742Z","updatedAt":"2026-09-17T18:45:18.742Z"},{"id":1065,"surahId":7,"surah":{"id":7,"number":7,"nameArabic":"الأعراف","nameUz":"Aʼrof","meaningUz":"Balandliklar","revelationPlace":"makka","totalAyahs":206,"startPage":151,"createdAt":"2026-09-17T18:45:07.433Z","updatedAt":"2026-09-18T00:07:52.328Z"},"numberInSurah":111,"textArabic":"قَالُوٓا۟ أَرْجِهْ وَأَخَاهُ وَأَرْسِلْ فِى ٱلْمَدَآئِنِ حَـٰشِرِينَ","translationUz":"Ular: «Uni va akasini qo`yib turgin-da, shaharlarga to`plovchilarni yubor.","transcription":null,"tafsirUz":null,"pageNumber":164,"juz":9,"createdAt":"2026-09-17T18:45:18.746Z","updatedAt":"2026-09-17T18:45:18.746Z"},{"id":1066,"surahId":7,"surah":{"id":7,"number":7,"nameArabic":"الأعراف","nameUz":"Aʼrof","meaningUz":"Balandliklar","revelationPlace":"makka","totalAyahs":206,"startPage":151,"createdAt":"2026-09-17T18:45:07.433Z","updatedAt":"2026-09-18T00:07:52.328Z"},"numberInSurah":112,"textArabic":"يَأْتُوكَ بِكُلِّ سَـٰحِرٍ عَلِيمٍ","translationUz":"Hamma bilimdon sehrgarlarni senga olib kelsinlar», – dedilar.","transcription":null,"tafsirUz":null,"pageNumber":164,"juz":9,"createdAt":"2026-09-17T18:45:18.749Z","updatedAt":"2026-09-17T18:45:18.749Z"},{"id":1067,"surahId":7,"surah":{"id":7,"number":7,"nameArabic":"الأعراف","nameUz":"Aʼrof","meaningUz":"Balandliklar","revelationPlace":"makka","totalAyahs":206,"startPage":151,"createdAt":"2026-09-17T18:45:07.433Z","updatedAt":"2026-09-18T00:07:52.328Z"},"numberInSurah":113,"textArabic":"وَجَآءَ ٱلسَّحَرَةُ فِرْعَوْنَ قَالُوٓا۟ إِنَّ لَنَا لَأَجْرًا إِن كُنَّا نَحْنُ ٱلْغَـٰلِبِينَ","translationUz":"Sehrgarlar Fir'avnga kelib: «Agar biz g`olib bo`lsak, albatta, mukofot olsak kerak?» – dedilar.","transcription":null,"tafsirUz":null,"pageNumber":164,"juz":9,"createdAt":"2026-09-17T18:45:18.753Z","updatedAt":"2026-09-17T18:45:18.753Z"},{"id":1068,"surahId":7,"surah":{"id":7,"number":7,"nameArabic":"الأعراف","nameUz":"Aʼrof","meaningUz":"Balandliklar","revelationPlace":"makka","totalAyahs":206,"startPage":151,"createdAt":"2026-09-17T18:45:07.433Z","updatedAt":"2026-09-18T00:07:52.328Z"},"numberInSurah":114,"textArabic":"قَالَ نَعَمْ وَإِنَّكُمْ لَمِنَ ٱلْمُقَرَّبِينَ","translationUz":"U: «Ha. Va, albatta, mening yaqin kishilarimdan bo`lursizlar».","transcription":null,"tafsirUz":null,"pageNumber":164,"juz":9,"createdAt":"2026-09-17T18:45:18.757Z","updatedAt":"2026-09-17T18:45:18.757Z"},{"id":1069,"surahId":7,"surah":{"id":7,"number":7,"nameArabic":"الأعراف","nameUz":"Aʼrof","meaningUz":"Balandliklar","revelationPlace":"makka","totalAyahs":206,"startPage":151,"createdAt":"2026-09-17T18:45:07.433Z","updatedAt":"2026-09-18T00:07:52.328Z"},"numberInSurah":115,"textArabic":"قَالُوا۟ يَـٰمُوسَىٰٓ إِمَّآ أَن تُلْقِىَ وَإِمَّآ أَن نَّكُونَ نَحْنُ ٱلْمُلْقِينَ","translationUz":"Ular: «Ey Muso, yoki sen tashla, yoki biz tashlovchi bo`laylik», – dedilar.","transcription":null,"tafsirUz":null,"pageNumber":164,"juz":9,"createdAt":"2026-09-17T18:45:18.761Z","updatedAt":"2026-09-17T18:45:18.761Z"},{"id":1070,"surahId":7,"surah":{"id":7,"number":7,"nameArabic":"الأعراف","nameUz":"Aʼrof","meaningUz":"Balandliklar","revelationPlace":"makka","totalAyahs":206,"startPage":151,"createdAt":"2026-09-17T18:45:07.433Z","updatedAt":"2026-09-18T00:07:52.328Z"},"numberInSurah":116,"textArabic":"قَالَ أَلْقُوا۟ ۖ فَلَمَّآ أَلْقَوْا۟ سَحَرُوٓا۟ أَعْيُنَ ٱلنَّاسِ وَٱسْتَرْهَبُوهُمْ وَجَآءُو بِسِحْرٍ عَظِيمٍ","translationUz":"U: «Sizlar tashlanglar», – dedi. Ular tashlaganlarida, odamlarning ko`zini sehrladilar, qo`rqitdilar va zo`r sehr ko`rsatdilar.","transcription":null,"tafsirUz":null,"pageNumber":164,"juz":9,"createdAt":"2026-09-17T18:45:18.766Z","updatedAt":"2026-09-17T18:45:18.766Z"},{"id":1071,"surahId":7,"surah":{"id":7,"number":7,"nameArabic":"الأعراف","nameUz":"Aʼrof","meaningUz":"Balandliklar","revelationPlace":"makka","totalAyahs":206,"startPage":151,"createdAt":"2026-09-17T18:45:07.433Z","updatedAt":"2026-09-18T00:07:52.328Z"},"numberInSurah":117,"textArabic":"۞ وَأَوْحَيْنَآ إِلَىٰ مُوسَىٰٓ أَنْ أَلْقِ عَصَاكَ ۖ فَإِذَا هِىَ تَلْقَفُ مَا يَأْفِكُونَ","translationUz":"Biz Musoga: «Asoingni tashlagin», deb vahiy yubordik. Birdan, u ular uydirayotgan narsani yuta boshladi.","transcription":null,"tafsirUz":null,"pageNumber":164,"juz":9,"createdAt":"2026-09-17T18:45:18.770Z","updatedAt":"2026-09-17T18:45:18.770Z"},{"id":1072,"surahId":7,"surah":{"id":7,"number":7,"nameArabic":"الأعراف","nameUz":"Aʼrof","meaningUz":"Balandliklar","revelationPlace":"makka","totalAyahs":206,"startPage":151,"createdAt":"2026-09-17T18:45:07.433Z","updatedAt":"2026-09-18T00:07:52.328Z"},"numberInSurah":118,"textArabic":"فَوَقَعَ ٱلْحَقُّ وَبَطَلَ مَا كَانُوا۟ يَعْمَلُونَ","translationUz":"Bas, haq qaror topdi va ularning qilayotganlari botil bo`ldi.","transcription":null,"tafsirUz":null,"pageNumber":164,"juz":9,"createdAt":"2026-09-17T18:45:18.774Z","updatedAt":"2026-09-17T18:45:18.774Z"},{"id":1073,"surahId":7,"surah":{"id":7,"number":7,"nameArabic":"الأعراف","nameUz":"Aʼrof","meaningUz":"Balandliklar","revelationPlace":"makka","totalAyahs":206,"startPage":151,"createdAt":"2026-09-17T18:45:07.433Z","updatedAt":"2026-09-18T00:07:52.328Z"},"numberInSurah":119,"textArabic":"فَغُلِبُوا۟ هُنَالِكَ وَٱنقَلَبُوا۟ صَـٰغِرِينَ","translationUz":"O`sha yerda yengildilar va beobro` bo`ldilar.","transcription":null,"tafsirUz":null,"pageNumber":164,"juz":9,"createdAt":"2026-09-17T18:45:18.778Z","updatedAt":"2026-09-17T18:45:18.778Z"},{"id":1074,"surahId":7,"surah":{"id":7,"number":7,"nameArabic":"الأعراف","nameUz":"Aʼrof","meaningUz":"Balandliklar","revelationPlace":"makka","totalAyahs":206,"startPage":151,"createdAt":"2026-09-17T18:45:07.433Z","updatedAt":"2026-09-18T00:07:52.328Z"},"numberInSurah":120,"textArabic":"وَأُلْقِىَ ٱلسَّحَرَةُ سَـٰجِدِينَ","translationUz":"Va sehrgarlar sajdaga tashlanib:","transcription":null,"tafsirUz":null,"pageNumber":164,"juz":9,"createdAt":"2026-09-17T18:45:18.783Z","updatedAt":"2026-09-17T18:45:18.783Z"}]}