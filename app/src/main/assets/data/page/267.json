{"number":267,"textArabic":null,"translationUz":null,"juz":null,"note":null,"updatedAt":null,"ayahs":[{"id":1893,"surahId":15,"surah":{"id":15,"number":15,"nameArabic":"الحجر","nameUz":"Hijr","meaningUz":"Hijr vodiysi","revelationPlace":"makka","totalAyahs":99,"startPage":262,"createdAt":"2026-09-17T18:45:07.474Z","updatedAt":"2026-09-18T00:07:52.373Z"},"numberInSurah":91,"textArabic":"ٱلَّذِينَ جَعَلُوا۟ ٱلْقُرْءَانَ عِضِينَ","translationUz":"Qur'onni parcha-parcha qilganlarga.","transcription":null,"tafsirUz":null,"pageNumber":267,"juz":14,"createdAt":"2026-09-17T18:45:27.573Z","updatedAt":"2026-09-17T18:45:27.573Z"},{"id":1894,"surahId":15,"surah":{"id":15,"number":15,"nameArabic":"الحجر","nameUz":"Hijr","meaningUz":"Hijr vodiysi","revelationPlace":"makka","totalAyahs":99,"startPage":262,"createdAt":"2026-09-17T18:45:07.474Z","updatedAt":"2026-09-18T00:07:52.373Z"},"numberInSurah":92,"textArabic":"فَوَرَبِّكَ لَنَسْـَٔلَنَّهُمْ أَجْمَعِينَ","translationUz":"Bas, Robbing ila qasamki, albatta, ularning hammasidan so`rarmiz.","transcription":null,"tafsirUz":null,"pageNumber":267,"juz":14,"createdAt":"2026-09-17T18:45:27.576Z","updatedAt":"2026-09-17T18:45:27.576Z"},{"id":1895,"surahId":15,"surah":{"id":15,"number":15,"nameArabic":"الحجر","nameUz":"Hijr","meaningUz":"Hijr vodiysi","revelationPlace":"makka","totalAyahs":99,"startPage":262,"createdAt":"2026-09-17T18:45:07.474Z","updatedAt":"2026-09-18T00:07:52.373Z"},"numberInSurah":93,"textArabic":"عَمَّا كَانُوا۟ يَعْمَلُونَ","translationUz":"Qilib yurgan ishlari haqida.","transcription":null,"tafsirUz":null,"pageNumber":267,"juz":14,"createdAt":"2026-09-17T18:45:27.579Z","updatedAt":"2026-09-17T18:45:27.579Z"},{"id":1896,"surahId":15,"surah":{"id":15,"number":15,"nameArabic":"الحجر","nameUz":"Hijr","meaningUz":"Hijr vodiysi","revelationPlace":"makka","totalAyahs":99,"startPage":262,"createdAt":"2026-09-17T18:45:07.474Z","updatedAt":"2026-09-18T00:07:52.373Z"},"numberInSurah":94,"textArabic":"فَٱصْدَعْ بِمَا تُؤْمَرُ وَأَعْرِضْ عَنِ ٱلْمُشْرِكِينَ","translationUz":"Bas, senga amr etilgan narsani yuzaga chiqar va mushriklardan yuz o`gir.","transcription":null,"tafsirUz":null,"pageNumber":267,"juz":14,"createdAt":"2026-09-17T18:45:27.583Z","updatedAt":"2026-09-17T18:45:27.583Z"},{"id":1897,"surahId":15,"surah":{"id":15,"number":15,"nameArabic":"الحجر","nameUz":"Hijr","meaningUz":"Hijr vodiysi","revelationPlace":"makka","totalAyahs":99,"startPage":262,"createdAt":"2026-09-17T18:45:07.474Z","updatedAt":"2026-09-18T00:07:52.373Z"},"numberInSurah":95,"textArabic":"إِنَّا كَفَيْنَـٰكَ ٱلْمُسْتَهْزِءِينَ","translationUz":"Albatta, Biz senga istehzo qiluvchilardan kifoya qilurmiz.","transcription":null,"tafsirUz":null,"pageNumber":267,"juz":14,"createdAt":"2026-09-17T18:45:27.587Z","updatedAt":"2026-09-17T18:45:27.587Z"},{"id":1898,"surahId":15,"surah":{"id":15,"number":15,"nameArabic":"الحجر","nameUz":"Hijr","meaningUz":"Hijr vodiysi","revelationPlace":"makka","totalAyahs":99,"startPage":262,"createdAt":"2026-09-17T18:45:07.474Z","updatedAt":"2026-09-18T00:07:52.373Z"},"numberInSurah":96,"textArabic":"ٱلَّذِينَ يَجْعَلُونَ مَعَ ٱللَّهِ إِلَـٰهًا ءَاخَرَ ۚ فَسَوْفَ يَعْلَمُونَ","translationUz":"Ular Alloh bilan birga boshqa iloh (sherik) qilurlar. Bas, tezda bilurlar.","transcription":null,"tafsirUz":null,"pageNumber":267,"juz":14,"createdAt":"2026-09-17T18:45:27.591Z","updatedAt":"2026-09-17T18:45:27.591Z"},{"id":1899,"surahId":15,"surah":{"id":15,"number":15,"nameArabic":"الحجر","nameUz":"Hijr","meaningUz":"Hijr vodiysi","revelationPlace":"makka","totalAyahs":99,"startPage":262,"createdAt":"2026-09-17T18:45:07.474Z","updatedAt":"2026-09-18T00:07:52.373Z"},"numberInSurah":97,"textArabic":"وَلَقَدْ نَعْلَمُ أَنَّكَ يَضِيقُ صَدْرُكَ بِمَا يَقُولُونَ","translationUz":"Albatta, Biz ularning aytayotganlaridan sening diling siqilishini yaxshi bilurmiz.","transcription":null,"tafsirUz":null,"pageNumber":267,"juz":14,"createdAt":"2026-09-17T18:45:27.595Z","updatedAt":"2026-09-17T18:45:27.595Z"},{"id":1900,"surahId":15,"surah":{"id":15,"number":15,"nameArabic":"الحجر","nameUz":"Hijr","meaningUz":"Hijr vodiysi","revelationPlace":"makka","totalAyahs":99,"startPage":262,"createdAt":"2026-09-17T18:45:07.474Z","updatedAt":"2026-09-18T00:07:52.373Z"},"numberInSurah":98,"textArabic":"فَسَبِّحْ بِحَمْدِ رَبِّكَ وَكُن مِّنَ ٱلسَّـٰجِدِينَ","translationUz":"Bas, Robbing hamdi ila tasbih ayt va sajda qilguvchilardan bo`l.","transcription":null,"tafsirUz":null,"pageNumber":267,"juz":14,"createdAt":"2026-09-17T18:45:27.599Z","updatedAt":"2026-09-17T18:45:27.599Z"},{"id":1901,"surahId":15,"surah":{"id":15,"number":15,"nameArabic":"الحجر","nameUz":"Hijr","meaningUz":"Hijr vodiysi","revelationPlace":"makka","totalAyahs":99,"startPage":262,"createdAt":"2026-09-17T18:45:07.474Z","updatedAt":"2026-09-18T00:07:52.373Z"},"numberInSurah":99,"textArabic":"وَٱعْبُدْ رَبَّكَ حَتَّىٰ يَأْتِيَكَ ٱلْيَقِينُ","translationUz":"Va senga aniq narsa (o`lim) kelgunicha Robbingga ibodat qil.","transcription":null,"tafsirUz":null,"pageNumber":267,"juz":14,"createdAt":"2026-09-17T18:45:27.602Z","updatedAt":"2026-09-17T18:45:27.602Z"},{"id":1902,"surahId":16,"surah":{"id":16,"number":16,"nameArabic":"النحل","nameUz":"Nahl","meaningUz":"Asalari","revelationPlace":"makka","totalAyahs":128,"startPage":267,"createdAt":"2026-09-17T18:45:07.479Z","updatedAt":"2026-09-18T00:07:52.381Z"},"numberInSurah":1,"textArabic":" أَتَىٰٓ أَمْرُ ٱللَّهِ فَلَا تَسْتَعْجِلُوهُ ۚ سُبْحَـٰنَهُۥ وَتَعَـٰلَىٰ عَمَّا يُشْرِكُونَ","translationUz":"Allohning amri keldi. Bas, uning tezroq kelishini talab qilmay qo`ya qoling. U zot ular keltirayotgan shirklardan pok va oliy bo`ldi.","transcription":null,"tafsirUz":null,"pageNumber":267,"juz":14,"createdAt":"2026-09-17T18:45:28.392Z","updatedAt":"2026-09-17T18:45:28.392Z"},{"id":1903,"surahId":16,"surah":{"id":16,"number":16,"nameArabic":"النحل","nameUz":"Nahl","meaningUz":"Asalari","revelationPlace":"makka","totalAyahs":128,"startPage":267,"createdAt":"2026-09-17T18:45:07.479Z","updatedAt":"2026-09-18T00:07:52.381Z"},"numberInSurah":2,"textArabic":"يُنَزِّلُ ٱلْمَلَـٰٓئِكَةَ بِٱلرُّوحِ مِنْ أَمْرِهِۦ عَلَىٰ مَن يَشَآءُ مِنْ عِبَادِهِۦٓ أَنْ أَنذِرُوٓا۟ أَنَّهُۥ لَآ إِلَـٰهَ إِلَّآ أَنَا۠ فَٱتَّقُونِ","translationUz":"U O`z amri ila farishtalarni ruh — vahiy bilan bandalaridan O`zi xohlaganlariga: «Ogohlantiringlar. Albatta, Mendan o`zga iloh yo`q. Bas, Menga taqvo qilinglar», deb nozil qilur.","transcription":null,"tafsirUz":null,"pageNumber":267,"juz":14,"createdAt":"2026-09-17T18:45:28.398Z","updatedAt":"2026-09-17T18:45:28.398Z"},{"id":1904,"surahId":16,"surah":{"id":16,"number":16,"nameArabic":"النحل","nameUz":"Nahl","meaningUz":"Asalari","revelationPlace":"makka","totalAyahs":128,"startPage":267,"createdAt":"2026-09-17T18:45:07.479Z","updatedAt":"2026-09-18T00:07:52.381Z"},"numberInSurah":3,"textArabic":"خَلَقَ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضَ بِٱلْحَقِّ ۚ تَعَـٰلَىٰ عَمَّا يُشْرِكُونَ","translationUz":"U osmonlaru yerni haq ila yaratdi. U ular shirk keltirayotgan narsalardan oliy bo`ldi.","transcription":null,"tafsirUz":null,"pageNumber":267,"juz":14,"createdAt":"2026-09-17T18:45:28.403Z","updatedAt":"2026-09-17T18:45:28.403Z"},{"id":1905,"surahId":16,"surah":{"id":16,"number":16,"nameArabic":"النحل","nameUz":"Nahl","meaningUz":"Asalari","revelationPlace":"makka","totalAyahs":128,"startPage":267,"createdAt":"2026-09-17T18:45:07.479Z","updatedAt":"2026-09-18T00:07:52.381Z"},"numberInSurah":4,"textArabic":"خَلَقَ ٱلْإِنسَـٰنَ مِن نُّطْفَةٍ فَإِذَا هُوَ خَصِيمٌ مُّبِينٌ","translationUz":"U insonni nutfadan yaratdi. Endi esa, u (inson) ochiq-oydin xusumatchi bo`lib turibdi.","transcription":null,"tafsirUz":null,"pageNumber":267,"juz":14,"createdAt":"2026-09-17T18:45:28.408Z","updatedAt":"2026-09-17T18:45:28.408Z"},{"id":1906,"surahId":16,"surah":{"id":16,"number":16,"nameArabic":"النحل","nameUz":"Nahl","meaningUz":"Asalari","revelationPlace":"makka","totalAyahs":128,"startPage":267,"createdAt":"2026-09-17T18:45:07.479Z","updatedAt":"2026-09-18T00:07:52.381Z"},"numberInSurah":5,"textArabic":"وَٱلْأَنْعَـٰمَ خَلَقَهَا ۗ لَكُمْ فِيهَا دِفْءٌ وَمَنَـٰفِعُ وَمِنْهَا تَأْكُلُونَ","translationUz":"U chorva hayvonlarini ham yaratdi. Ularda siz uchun issiqlik, manfaatlar bor va ulardan yeysizlar ham.","transcription":null,"tafsirUz":null,"pageNumber":267,"juz":14,"createdAt":"2026-09-17T18:45:28.412Z","updatedAt":"2026-09-17T18:45:28.412Z"},{"id":1907,"surahId":16,"surah":{"id":16,"number":16,"nameArabic":"النحل","nameUz":"Nahl","meaningUz":"Asalari","revelationPlace":"makka","totalAyahs":128,"startPage":267,"createdAt":"2026-09-17T18:45:07.479Z","updatedAt":"2026-09-18T00:07:52.381Z"},"numberInSurah":6,"textArabic":"وَلَكُمْ فِيهَا جَمَالٌ حِينَ تُرِيحُونَ وَحِينَ تَسْرَحُونَ","translationUz":"Va siz uchun ularda kechki payt (o`tloqdan) qaytayotganlarida va ertalab (o`tloqqa) ketayotganida jamol bor.","transcription":null,"tafsirUz":null,"pageNumber":267,"juz":14,"createdAt":"2026-09-17T18:45:28.416Z","updatedAt":"2026-09-17T18:45:28.416Z"}]}